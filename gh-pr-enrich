# Fetch and normalize checks independently of their exit status. `gh pr checks`
# exits nonzero for pending and failing checks even though its JSON is complete;
# those states are evidence and must participate in the fingerprint.
fetch_live_analysis_checks_fingerprint_once() {
    local repository="$1" pr_number="$2" checks_file fingerprint="" checks_rc=0
    checks_file="$(mktemp "/tmp/gh-pr-enrich-live-checks.XXXXXX")" || return 1
    LIVE_CHECKS_TEMP_FILE="$checks_file"
    chmod 600 "$checks_file" || {
        rm -f "$checks_file"
        LIVE_CHECKS_TEMP_FILE=""
        return 1
    }
    run_report_command gh pr checks "$pr_number" --repo "$repository" \
            --json name,state,bucket,workflow,startedAt,completedAt,event,link,description \
            > "$checks_file" 2>/dev/null || checks_rc=$?
    case "$checks_rc" in
        0)
            jq -e 'type == "array"' "$checks_file" > /dev/null 2>&1 || {
                rm -f "$checks_file"
                LIVE_CHECKS_TEMP_FILE=""
                return 1
            }
            ;;
        1)
            jq -e 'type == "array" and any(.[]; .bucket == "fail")' \
                "$checks_file" > /dev/null 2>&1 || {
                rm -f "$checks_file"
                LIVE_CHECKS_TEMP_FILE=""
                return 1
            }
            ;;
        8)
            jq -e 'type == "array" and any(.[]; .bucket == "pending")' \
                "$checks_file" > /dev/null 2>&1 || {
                rm -f "$checks_file"
                LIVE_CHECKS_TEMP_FILE=""
                return 1
            }
            ;;
        *)
            rm -f "$checks_file"
            LIVE_CHECKS_TEMP_FILE=""
            return 1
            ;;
    esac
    fingerprint="$(analysis_checks_fingerprint_from_file \
        "$checks_file" 2>/dev/null || echo "")"
    rm -f "$checks_file"
    LIVE_CHECKS_TEMP_FILE=""
    [ -n "$fingerprint" ] || return 1
    printf '%s\n' "$fingerprint"
}

