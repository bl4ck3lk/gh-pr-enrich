# Treat the hosted head, complete discussion snapshot, and check results as one
# final attestation. The head is checked on both sides of the stabilized remote
# reads, and callers perform every local validation before invoking this helper.
# Nothing except signal handling and the atomic rename transaction may follow.
HOSTED_ATTESTATION_COMPONENT=""
verify_analysis_partial_hosted_attestation() {
    local context_file="$1" component="$2"
    local expected_head repository pr_number first_head
    HOSTED_ATTESTATION_COMPONENT="head"
    expected_head="$(jq -r '.pr.head_sha // .coverage.code_access.pr_head_sha // ""' \
        "$context_file" 2>/dev/null || echo "")"
    repository="$(jq -r '.pr.repository // ""' \
        "$context_file" 2>/dev/null || echo "")"
    pr_number="$(jq -r '.pr.number // ""' \
        "$context_file" 2>/dev/null || echo "")"
    [ -n "$expected_head" ] && [ -n "$repository" ] && \
        [ -n "$pr_number" ] || return 1
    case "$component" in
        discussion|checks) ;;
        *) return 1 ;;
    esac
    verify_pr_head_unchanged "$pr_number" "$expected_head" "$repository" || return 1
    first_head="$CURRENT_HOSTED_HEAD"
    HOSTED_ATTESTATION_COMPONENT="$component"
    case "$component" in
        discussion) verify_analysis_discussion_unchanged "$context_file" || return 1 ;;
        checks) verify_analysis_checks_unchanged "$context_file" || return 1 ;;
    esac
    HOSTED_ATTESTATION_COMPONENT="head"
    verify_pr_head_unchanged "$pr_number" "$expected_head" "$repository" || return 1
    [ "$CURRENT_HOSTED_HEAD" = "$first_head" ] || {
        HOSTED_HEAD_VERIFICATION_STATUS="mismatch"
        return 1
    }
    HOSTED_ATTESTATION_COMPONENT=""
}

