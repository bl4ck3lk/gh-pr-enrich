    # ============================================================================
    # Main Retrospective Logic
    # ============================================================================

    # Helper to print progress messages (to stderr for --json/--markdown modes)
    retro_log() {
        if [ "$RETRO_OUTPUT_FORMAT" = "json" ] || [ "$RETRO_OUTPUT_FORMAT" = "markdown" ]; then
            echo "$1" >&2
        else
            echo "$1"
        fi
    }

    # Check Claude CLI availability (now that retro_log is defined)
    check_claude_cli

    retro_log "Running retrospective analysis..."

    # Parse since date if provided
    if [ -n "$RETRO_SINCE" ]; then
        RETRO_SINCE=$(parse_since_date "$RETRO_SINCE") || exit 1
        retro_log "Filtering PRs since: $RETRO_SINCE"
    fi

    # One bounded lease owns every immutable report snapshot in this run. This
    # avoids a polling janitor per archived PR while preserving crash cleanup.
    if ! start_retrospective_snapshot_lease; then
        echo "Error: Could not start the retrospective snapshot lease." >&2
        exit 1
    fi

    # Discover PR reports
    if ! discover_pr_reports "$RETRO_REPORTS_DIR" "$RETRO_SINCE" "$RETRO_AUTHOR"; then
        echo "Error: Retrospective report discovery failed." >&2
        exit 1
    fi

    # Check minimum PRs requirement
    if [ ${#PR_REPORTS[@]} -eq 0 ]; then
        echo "Error: No PR reports found with structured analysis." >&2
        echo "Run a Codex analysis or 'gh pr-enrich <PR_NUMBER> --enrich' first." >&2
        exit 1
    fi

    if [ ${#PR_REPORTS[@]} -lt "$RETRO_MIN_PRS" ]; then
        retro_log "Warning: Found ${#PR_REPORTS[@]} PR(s), but minimum is $RETRO_MIN_PRS."
        retro_log "Use --min-prs to lower the threshold, or generate more PR reports."
        retro_log "Continuing with available data..."
    fi

    # Create output directory
    mkdir -p "$RETRO_OUTPUT_DIR"

    TIMESTAMP=$(date -u +"%Y%m%d-%H%M%S")

    # Aggregate data
    retro_log "Aggregating PR data..."
    AGGREGATION_OUTPUT="$(mktemp \
        "$RETRO_SNAPSHOT_ROOT/.aggregation.XXXXXX")" || exit 1
    RETRO_SNAPSHOT_WORKER_STARTING=true
    set -m
    (
        close_retrospective_snapshot_lease || exit 1
        aggregate_pr_data
    ) > "$AGGREGATION_OUTPUT" &
    RETRO_SNAPSHOT_WORKER_PID=$!
    if kill -0 -- "-$RETRO_SNAPSHOT_WORKER_PID" 2>/dev/null; then
        RETRO_SNAPSHOT_WORKER_GROUP_OWNED=true
    fi
    set +m
    RETRO_SNAPSHOT_WORKER_STARTING=false
    if [ -n "$RETRO_PENDING_SIGNAL_STATUS" ]; then
        terminate_retrospective "$RETRO_PENDING_SIGNAL_STATUS"
    fi
    if ! wait "$RETRO_SNAPSHOT_WORKER_PID"; then
        RETRO_SNAPSHOT_WORKER_PID=""
        RETRO_SNAPSHOT_WORKER_GROUP_OWNED=false
        exit 1
    fi
    RETRO_SNAPSHOT_WORKER_PID=""
    RETRO_SNAPSHOT_WORKER_GROUP_OWNED=false
    AGGREGATED="$(cat "$AGGREGATION_OUTPUT")"
    rm -f "$AGGREGATION_OUTPUT"
    if ! cleanup_retrospective_snapshots; then
        exit 1
    fi
    PR_REPORTS=()
    echo "$AGGREGATED" > "$RETRO_OUTPUT_DIR/aggregated-data.json"

    # Calculate patterns
    retro_log "Calculating cross-PR patterns..."
    PATTERNS=$(calculate_cross_pr_patterns "$AGGREGATED")
    echo "$PATTERNS" > "$RETRO_OUTPUT_DIR/cross-pr-patterns.json"

    # Calculate hotspots
    retro_log "Calculating hotspots..."
    HOTSPOTS=$(calculate_category_hotspots "$AGGREGATED")
    echo "$HOTSPOTS" > "$RETRO_OUTPUT_DIR/hotspots.json"

    # Generate guiding questions
    retro_log "Generating guiding questions..."
    QUESTIONS=$(generate_guiding_questions "$PATTERNS" "$HOTSPOTS")
    echo "$QUESTIONS" > "$RETRO_OUTPUT_DIR/guiding-questions.json"

    # Generate improvement tracking
    retro_log "Generating improvement tracking..."
    TRACKING=$(generate_improvement_tracking "$AGGREGATED")
    echo "$TRACKING" > "$RETRO_OUTPUT_DIR/improvement-tracking.json"

    # Generate summary
    retro_log "Generating summary..."
    SUMMARY=$(generate_retro_summary "$AGGREGATED" "$PATTERNS" "$HOTSPOTS")
    echo "$SUMMARY" > "$RETRO_OUTPUT_DIR/summary.json"

    # Optional Claude enrichment
    CLAUDE_ANALYSIS_FILE=""
    if [ "$RETRO_ENRICH" = true ]; then
        retro_log "Running Claude meta-analysis..."

        # Build context for Claude
        jq -n \
            --argjson summary "$SUMMARY" \
            --argjson patterns "$PATTERNS" \
            --argjson hotspots "$HOTSPOTS" \
            --argjson tracking "$TRACKING" \
            '{
                summary: $summary,
                patterns: $patterns,
                hotspots: $hotspots,
                tracking: $tracking
            }' > "$RETRO_OUTPUT_DIR/claude-context.json"

        if run_retrospective_claude_analysis "$RETRO_OUTPUT_DIR/claude-context.json" "$RETRO_OUTPUT_DIR/claude-raw-response.json"; then
            retro_log "✅ Claude meta-analysis complete"

            if jq -e '.structured_output' "$RETRO_OUTPUT_DIR/claude-raw-response.json" > /dev/null 2>&1; then
                jq '.structured_output' "$RETRO_OUTPUT_DIR/claude-raw-response.json" > "$RETRO_OUTPUT_DIR/claude-meta-analysis.json"
                CLAUDE_ANALYSIS_FILE="$RETRO_OUTPUT_DIR/claude-meta-analysis.json"
            else
                retro_log "⚠️  Claude returned no structured retrospective output; keeping only the raw diagnostic envelope."
            fi
        else
            retro_log "⚠️  Claude meta-analysis failed. Continuing without enrichment."
        fi
    fi

    # Generate markdown report
    retro_log "Generating markdown report..."
    generate_retrospective_markdown "$SUMMARY" "$PATTERNS" "$HOTSPOTS" "$QUESTIONS" "$TRACKING" "$CLAUDE_ANALYSIS_FILE" \
        > "$RETRO_OUTPUT_DIR/retrospective-report.md"

    # Generate combined JSON
    jq -n \
        --argjson summary "$SUMMARY" \
        --argjson patterns "$PATTERNS" \
        --argjson hotspots "$HOTSPOTS" \
        --argjson questions "$QUESTIONS" \
        --argjson tracking "$TRACKING" \
        --arg timestamp "$TIMESTAMP" \
        --arg version "$VERSION" \
        '{
            metadata: {
                generated_at: $timestamp,
                version: $version
            },
            summary: $summary,
            cross_pr_patterns: $patterns,
            hotspots: $hotspots,
            guiding_questions: $questions,
            improvement_tracking: $tracking
        }' > "$RETRO_OUTPUT_DIR/retrospective-data.json"

    # Add Claude analysis to combined JSON if available
    if [ -n "$CLAUDE_ANALYSIS_FILE" ] && [ -f "$CLAUDE_ANALYSIS_FILE" ]; then
        jq --argjson claude "$(cat "$CLAUDE_ANALYSIS_FILE")" \
            '. + {claude_meta_analysis: $claude}' \
            "$RETRO_OUTPUT_DIR/retrospective-data.json" > "$RETRO_OUTPUT_DIR/retrospective-data.tmp.json" && \
            mv "$RETRO_OUTPUT_DIR/retrospective-data.tmp.json" "$RETRO_OUTPUT_DIR/retrospective-data.json"
    fi

    # Handle special format output
    if [ -n "$RETRO_FORMAT" ]; then
        echo ""
        echo "=== ${RETRO_FORMAT} output ==="
        echo ""
        generate_format_output "$RETRO_FORMAT" "$QUESTIONS" "$SUMMARY" "$CLAUDE_ANALYSIS_FILE"
        exit 0
    fi

    # Standard output
    case $RETRO_OUTPUT_FORMAT in
        "json")
            cat "$RETRO_OUTPUT_DIR/retrospective-data.json"
            ;;
        "markdown")
            cat "$RETRO_OUTPUT_DIR/retrospective-report.md"
            ;;
        "combined")
            echo "✅ Retrospective analysis complete!"
            echo "📁 Directory: $RETRO_OUTPUT_DIR"
            echo "📊 Markdown: $RETRO_OUTPUT_DIR/retrospective-report.md"
            echo "🤖 JSON: $RETRO_OUTPUT_DIR/retrospective-data.json"
            if [ -n "$CLAUDE_ANALYSIS_FILE" ]; then
                echo "🧠 Claude Analysis: $RETRO_OUTPUT_DIR/claude-meta-analysis.json"
            fi
            echo ""
            echo "Quick stats:"
            echo "$SUMMARY" | jq -r '"  PRs analyzed: \(.overview.total_prs_analyzed)"'
            echo "$PATTERNS" | jq -r '"  Recurring patterns: \(length)"'
            ;;
    esac

    exit 0
fi

# Handle uninstall-skill subcommand
if [ "$1" = "uninstall-skill" ]; then
    shift
    SKILL_RUNTIME="both"
    if [ "${1:-}" = "--runtime" ]; then
        SKILL_RUNTIME="${2:-}"
        shift 2
    fi
    [ $# -eq 0 ] || { echo "Error: Unknown uninstall-skill option: $1"; exit 1; }
    case "$SKILL_RUNTIME" in codex|claude|both) ;; *) echo "Error: Invalid runtime '$SKILL_RUNTIME'"; exit 1 ;; esac

    capture_skill_uninstall() {
        local runtime_label="$1" skill_target="$2"
        local skill_parent claim_dir claim_path reference_dir reference_path
        local reference_payload reference_identity live_payload live_identity
        CAPTURED_UNINSTALL_PRESENT=false
        CAPTURED_UNINSTALL_PAYLOAD=""
        CAPTURED_UNINSTALL_IDENTITY=""
        CAPTURED_UNINSTALL_CLAIM_DIR=""
        CAPTURED_UNINSTALL_CLAIM_PATH=""
        CAPTURED_UNINSTALL_REFERENCE=""
        if [ -L "$skill_target" ]; then
            skill_parent="$(dirname "$skill_target")"
            claim_dir="$(mktemp -d \
                "$skill_parent/.gh-pr-enrich-uninstall.XXXXXX")" || {
                echo "Error: Could not create a private $runtime_label uninstall claim"
                return 1
            }
            claim_path="$claim_dir/gh-pr-enrich"
            reference_dir="$claim_dir/reference"
            reference_path="$reference_dir/gh-pr-enrich"
            if ! mkdir "$reference_dir" 2>/dev/null || \
               ! ln -P "$skill_target" "$reference_dir" 2>/dev/null; then
                rm -f "$reference_path" 2>/dev/null || true
                rmdir "$reference_dir" "$claim_dir" 2>/dev/null || true
                echo "Error: Could not retain the private $runtime_label uninstall identity"
                return 1
            fi
            reference_payload="$(readlink "$reference_path")" || {
                rm -f "$reference_path" 2>/dev/null || true
                rmdir "$reference_dir" "$claim_dir" 2>/dev/null || true
                echo "Error: Could not inspect the private $runtime_label uninstall identity"
                return 1
            }
            reference_identity="$(
                stat -c '%d:%i' "$reference_path" 2>/dev/null ||
                    stat -f '%d:%i' "$reference_path" 2>/dev/null
            )" || {
                rm -f "$reference_path" 2>/dev/null || true
                rmdir "$reference_dir" "$claim_dir" 2>/dev/null || true
                echo "Error: Could not identify the private $runtime_label uninstall identity"
                return 1
            }
            live_payload="$(readlink "$skill_target" 2>/dev/null || echo "")"
            live_identity="$(
                stat -c '%d:%i' "$skill_target" 2>/dev/null ||
                    stat -f '%d:%i' "$skill_target" 2>/dev/null
            )" || live_identity=""
            if [ -z "$live_payload" ] || [ -z "$live_identity" ] || \
               [ "$live_payload" != "$reference_payload" ] || \
               [ "$live_identity" != "$reference_identity" ]; then
                rm -f "$reference_path" 2>/dev/null || true
                rmdir "$reference_dir" "$claim_dir" 2>/dev/null || true
                echo "Error: $skill_target changed during uninstall preflight"
                return 1
            fi
            CAPTURED_UNINSTALL_PRESENT=true
            CAPTURED_UNINSTALL_PAYLOAD="$reference_payload"
            CAPTURED_UNINSTALL_IDENTITY="$reference_identity"
            CAPTURED_UNINSTALL_CLAIM_DIR="$claim_dir"
            CAPTURED_UNINSTALL_CLAIM_PATH="$claim_path"
            CAPTURED_UNINSTALL_REFERENCE="$reference_path"
        elif [ -e "$skill_target" ]; then
            echo "⚠️  $skill_target is not a symlink; leaving all requested registrations untouched"
            return 1
        fi
    }

    uninstall_recovery_path() {
        local claim_path="$1" reference_path="$2"
        if [ -L "$claim_path" ] || [ -e "$claim_path" ]; then
            printf '%s\n' "$claim_path"
        elif [ -L "$reference_path" ] || [ -e "$reference_path" ]; then
            printf '%s\n' "$reference_path"
        fi
    }

    restore_uninstall_claim() {
        local runtime_label="$1" skill_target="$2" claim_path="$3"
        local reference_path="$4" claim_dir="$5"
        local restore_source="" skill_parent reference_dir recovery_path
        [ -n "$claim_path" ] || [ -n "$reference_path" ] || return 0
        if [ -L "$skill_target" ] || [ -e "$skill_target" ]; then
            recovery_path="$(uninstall_recovery_path \
                "$claim_path" "$reference_path")"
            echo "Error: Could not restore $runtime_label registration because $skill_target was replaced concurrently; the displaced registration remains at ${recovery_path:-an unknown private recovery path}"
            return 1
        fi
        if [ -L "$claim_path" ] || [ -f "$claim_path" ]; then
            restore_source="$claim_path"
        elif [ -d "$claim_path" ]; then
            echo "Error: A concurrently claimed $runtime_label directory is preserved at $claim_path; restore it manually after verifying $skill_target is absent"
            return 1
        elif [ -L "$reference_path" ] || [ -f "$reference_path" ]; then
            restore_source="$reference_path"
        else
            echo "Error: Could not restore $runtime_label registration; no owned claim remains"
            return 1
        fi
        skill_parent="$(dirname "$skill_target")"
        # Every private restore source retains the exact public basename. Link
        # into the parent directory so a concurrently created file or directory
        # at skill_target produces EEXIST instead of receiving a nested link.
        if ! ln -P "$restore_source" "$skill_parent" 2>/dev/null; then
            recovery_path="$(uninstall_recovery_path \
                "$claim_path" "$reference_path")"
            echo "Error: Could not restore $runtime_label registration at $skill_target; the displaced registration remains at ${recovery_path:-an unknown private recovery path}"
            return 1
        fi
        if { [ -L "$claim_path" ] || [ -f "$claim_path" ]; } && \
           ! rm "$claim_path" 2>/dev/null; then
            echo "Error: Restored $runtime_label registration, but its private claim remains at $claim_path"
            return 1
        fi
        if { [ -L "$reference_path" ] || [ -f "$reference_path" ]; } && \
           ! rm "$reference_path" 2>/dev/null; then
            echo "Error: Restored $runtime_label registration, but its private reference remains at $reference_path"
            return 1
        fi
        reference_dir="$(dirname "$reference_path")"
        if [ "$reference_dir" != "$claim_dir" ] && \
           [ -d "$reference_dir" ] && \
           ! rmdir "$reference_dir" 2>/dev/null; then
            echo "Error: Restored $runtime_label registration, but its private reference directory remains at $reference_dir"
            return 1
        fi
        if [ -d "$claim_dir" ] && ! rmdir "$claim_dir" 2>/dev/null; then
            echo "Error: Restored $runtime_label registration, but its private claim directory remains at $claim_dir"
            return 1
        fi
        echo "↩️  Restored $runtime_label skill registration after uninstall failure"
    }

    rollback_uninstall_registration() {
        local runtime_label="$1" skill_target="$2" was_claimed="$3"
        local claim_path="$4" reference_path="$5" claim_dir="$6"
        if [ "$was_claimed" = true ]; then
            restore_uninstall_claim "$runtime_label" "$skill_target" \
                "$claim_path" "$reference_path" "$claim_dir"
        else
            cleanup_uninstall_reference "$runtime_label" \
                "$reference_path" "$claim_dir"
        fi
    }

    claim_captured_skill() {
        local runtime_label="$1" skill_target="$2" was_present="$3"
        local payload="$4" identity="$5" claim_dir="$6" reference_path="$7"
        local claim_path
        local claimed_payload claimed_identity
        local mv_reported_failure=false
        CAPTURED_UNINSTALL_CLAIMED=false
        CAPTURED_UNINSTALL_CLAIM_DIR="$claim_dir"
        CAPTURED_UNINSTALL_CLAIM_PATH=""
        CAPTURED_UNINSTALL_REFERENCE="$reference_path"
        if [ "$was_present" != true ]; then
            echo "ℹ️  $runtime_label skill not installed at $skill_target"
            return 0
        fi
        claim_path="$claim_dir/gh-pr-enrich"
        CAPTURED_UNINSTALL_CLAIM_PATH="$claim_path"

        # Atomically detach the public name before inspecting it. A concurrent
        # replacement after this move owns the public path and is never removed.
        if mv "$skill_target" "$claim_path" 2>/dev/null; then
            CAPTURED_UNINSTALL_CLAIMED=true
        else
            if [ ! -L "$claim_path" ] && [ ! -e "$claim_path" ]; then
                echo "Error: $skill_target changed after uninstall preflight; leaving it untouched"
                return 1
            fi
            CAPTURED_UNINSTALL_CLAIMED=true
            mv_reported_failure=true
            echo "Error: $runtime_label uninstall claim reported failure after detaching the registration; recovering the claim"
        fi

        if [ ! -L "$claim_path" ]; then
            echo "Error: $skill_target was replaced concurrently by a non-symlink"
            restore_uninstall_claim "$runtime_label" "$skill_target" \
                "$claim_path" "$reference_path" "$claim_dir" || true
            return 1
        fi
        claimed_payload="$(readlink "$claim_path")" || {
            echo "Error: Could not inspect the claimed $runtime_label registration; preserved at $claim_path"
            return 1
        }
        claimed_identity="$(
            stat -c '%d:%i' "$claim_path" 2>/dev/null ||
                stat -f '%d:%i' "$claim_path" 2>/dev/null
        )" || {
            echo "Error: Could not identify the claimed $runtime_label registration; preserved at $claim_path"
            return 1
        }
        if [ "$claimed_payload" != "$payload" ] || \
           [ "$claimed_identity" != "$identity" ]; then
            if restore_uninstall_claim "$runtime_label" "$skill_target" \
                    "$claim_path" "$reference_path" "$claim_dir"; then
                CAPTURED_UNINSTALL_CLAIMED=false
                CAPTURED_UNINSTALL_CLAIM_DIR=""
                CAPTURED_UNINSTALL_CLAIM_PATH=""
                CAPTURED_UNINSTALL_REFERENCE=""
                echo "Error: $skill_target changed after uninstall preflight; restored it unchanged"
            else
                echo "Error: $skill_target changed after uninstall preflight; preserved at $claim_path"
            fi
            return 1
        fi
        if [ "$mv_reported_failure" = true ]; then
            if restore_uninstall_claim "$runtime_label" "$skill_target" \
                    "$claim_path" "$reference_path" "$claim_dir"; then
                CAPTURED_UNINSTALL_CLAIMED=false
                CAPTURED_UNINSTALL_CLAIM_DIR=""
                CAPTURED_UNINSTALL_CLAIM_PATH=""
                CAPTURED_UNINSTALL_REFERENCE=""
                echo "Error: $runtime_label uninstall claim failed after detaching the registration; restored it unchanged"
            else
                echo "Error: $runtime_label uninstall claim failed after detaching the registration; preserved at $claim_path"
            fi
            return 1
        fi
    }

    remove_uninstall_claim() {
        local runtime_label="$1" claim_path="$2"
        [ -z "$claim_path" ] || [ ! -L "$claim_path" ] || \
            rm "$claim_path" 2>/dev/null || {
                echo "Error: Could not remove the claimed $runtime_label registration"
                return 1
            }
    }

    cleanup_uninstall_reference() {
        local runtime_label="$1" reference_path="$2" claim_dir="$3"
        local reference_dir
        [ -z "$reference_path" ] || [ ! -L "$reference_path" ] || \
            rm "$reference_path" 2>/dev/null || {
                echo "Error: Could not remove the private $runtime_label uninstall reference at $reference_path"
                return 1
            }
        reference_dir="$(dirname "$reference_path")"
        [ -z "$reference_path" ] || [ "$reference_dir" = "$claim_dir" ] || \
            [ ! -d "$reference_dir" ] || rmdir "$reference_dir" 2>/dev/null || {
                echo "Error: Could not remove the private $runtime_label uninstall reference directory at $reference_dir"
                return 1
            }
        [ -z "$claim_dir" ] || [ ! -d "$claim_dir" ] || \
            rmdir "$claim_dir" 2>/dev/null || {
                echo "Error: Could not remove the private $runtime_label uninstall directory at $claim_dir"
                return 1
            }
    }

    record_uninstall_signal() {
        case "$1" in
            INT) UNINSTALL_TRANSACTION_SIGNAL_STATUS=130 ;;
            TERM) UNINSTALL_TRANSACTION_SIGNAL_STATUS=143 ;;
        esac
    }

    cleanup_uninstall_transaction_on_exit() {
        local exit_status="$1"
        trap - EXIT
        trap '' INT TERM
        if [ "$UNINSTALL_TRANSACTION_ACTIVE" = true ]; then
            if [ "$UNINSTALL_TRANSACTION_COMMITTED" = true ]; then
                cleanup_uninstall_reference "Codex" \
                    "$CODEX_UNINSTALL_REFERENCE" \
                    "$CODEX_UNINSTALL_CLAIM_DIR" || true
                cleanup_uninstall_reference "Claude" \
                    "$CLAUDE_UNINSTALL_REFERENCE" \
                    "$CLAUDE_UNINSTALL_CLAIM_DIR" || true
            else
                rollback_uninstall_registration "Claude" \
                    "$CLAUDE_SKILL_TARGET" "$CLAUDE_UNINSTALL_CLAIMED" \
                    "$CLAUDE_UNINSTALL_CLAIM_PATH" \
                    "$CLAUDE_UNINSTALL_REFERENCE" \
                    "$CLAUDE_UNINSTALL_CLAIM_DIR" || true
                rollback_uninstall_registration "Codex" \
                    "$CODEX_SKILL_TARGET" "$CODEX_UNINSTALL_CLAIMED" \
                    "$CODEX_UNINSTALL_CLAIM_PATH" \
                    "$CODEX_UNINSTALL_REFERENCE" \
                    "$CODEX_UNINSTALL_CLAIM_DIR" || true
            fi
        fi
        [ -z "$UNINSTALL_TRANSACTION_SIGNAL_STATUS" ] || \
            exit_status="$UNINSTALL_TRANSACTION_SIGNAL_STATUS"
        exit "$exit_status"
    }

    codex_config_root="${CODEX_HOME:-$HOME/.codex}"
    claude_config_root="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
    CODEX_SKILL_TARGET="$codex_config_root/skills/gh-pr-enrich"
    CLAUDE_SKILL_TARGET="$claude_config_root/skills/gh-pr-enrich"
    CODEX_UNINSTALL_PRESENT=false
    CODEX_UNINSTALL_PAYLOAD=""
    CODEX_UNINSTALL_IDENTITY=""
    CODEX_UNINSTALL_CLAIM_DIR=""
    CODEX_UNINSTALL_CLAIM_PATH=""
    CODEX_UNINSTALL_REFERENCE=""
    CODEX_UNINSTALL_CLAIMED=false
    CLAUDE_UNINSTALL_PRESENT=false
    CLAUDE_UNINSTALL_PAYLOAD=""
    CLAUDE_UNINSTALL_IDENTITY=""
    CLAUDE_UNINSTALL_CLAIM_DIR=""
    CLAUDE_UNINSTALL_CLAIM_PATH=""
    CLAUDE_UNINSTALL_REFERENCE=""
    CLAUDE_UNINSTALL_CLAIMED=false
    UNINSTALL_TRANSACTION_ACTIVE=false
    UNINSTALL_TRANSACTION_COMMITTED=false
    UNINSTALL_TRANSACTION_SIGNAL_STATUS=""

    UNINSTALL_TRANSACTION_ACTIVE=true
    trap 'record_uninstall_signal INT' INT
    trap 'record_uninstall_signal TERM' TERM
    trap 'cleanup_uninstall_transaction_on_exit $?' EXIT

    # Capture both selected registrations and retain exact hard-link identity
    # references before removing either. Holding the original inode prevents an
    # unlink-and-recreate race from passing through immediate inode reuse. Any
    # symlink, including a stale or broken one, remains removable; non-symlink
    # entries fail the whole operation before either public path is mutated.
    if [ "$SKILL_RUNTIME" = "codex" ] || [ "$SKILL_RUNTIME" = "both" ]; then
        capture_skill_uninstall "Codex" "$CODEX_SKILL_TARGET" || exit 1
        CODEX_UNINSTALL_PRESENT="$CAPTURED_UNINSTALL_PRESENT"
        CODEX_UNINSTALL_PAYLOAD="$CAPTURED_UNINSTALL_PAYLOAD"
        CODEX_UNINSTALL_IDENTITY="$CAPTURED_UNINSTALL_IDENTITY"
        CODEX_UNINSTALL_CLAIM_DIR="$CAPTURED_UNINSTALL_CLAIM_DIR"
        CODEX_UNINSTALL_CLAIM_PATH="$CAPTURED_UNINSTALL_CLAIM_PATH"
        CODEX_UNINSTALL_REFERENCE="$CAPTURED_UNINSTALL_REFERENCE"
    fi
    if [ "$SKILL_RUNTIME" = "claude" ] || [ "$SKILL_RUNTIME" = "both" ]; then
        capture_skill_uninstall "Claude" "$CLAUDE_SKILL_TARGET" || exit 1
        CLAUDE_UNINSTALL_PRESENT="$CAPTURED_UNINSTALL_PRESENT"
        CLAUDE_UNINSTALL_PAYLOAD="$CAPTURED_UNINSTALL_PAYLOAD"
        CLAUDE_UNINSTALL_IDENTITY="$CAPTURED_UNINSTALL_IDENTITY"
        CLAUDE_UNINSTALL_CLAIM_DIR="$CAPTURED_UNINSTALL_CLAIM_DIR"
        CLAUDE_UNINSTALL_CLAIM_PATH="$CAPTURED_UNINSTALL_CLAIM_PATH"
        CLAUDE_UNINSTALL_REFERENCE="$CAPTURED_UNINSTALL_REFERENCE"
    fi
    [ -z "$UNINSTALL_TRANSACTION_SIGNAL_STATUS" ] || \
        exit "$UNINSTALL_TRANSACTION_SIGNAL_STATUS"

    if [ "$SKILL_RUNTIME" = "codex" ] || [ "$SKILL_RUNTIME" = "both" ]; then
        CODEX_UNINSTALL_CLAIM_RC=0
        claim_captured_skill "Codex" "$CODEX_SKILL_TARGET" \
                "$CODEX_UNINSTALL_PRESENT" "$CODEX_UNINSTALL_PAYLOAD" \
                "$CODEX_UNINSTALL_IDENTITY" "$CODEX_UNINSTALL_CLAIM_DIR" \
                "$CODEX_UNINSTALL_REFERENCE" || \
            CODEX_UNINSTALL_CLAIM_RC=$?
        CODEX_UNINSTALL_CLAIMED="$CAPTURED_UNINSTALL_CLAIMED"
        CODEX_UNINSTALL_CLAIM_DIR="$CAPTURED_UNINSTALL_CLAIM_DIR"
        CODEX_UNINSTALL_CLAIM_PATH="$CAPTURED_UNINSTALL_CLAIM_PATH"
        CODEX_UNINSTALL_REFERENCE="$CAPTURED_UNINSTALL_REFERENCE"
        if [ "$CODEX_UNINSTALL_CLAIM_RC" -ne 0 ]; then
            exit 1
        fi
        [ -z "$UNINSTALL_TRANSACTION_SIGNAL_STATUS" ] || \
            exit "$UNINSTALL_TRANSACTION_SIGNAL_STATUS"
    fi
    if [ "$SKILL_RUNTIME" = "claude" ] || [ "$SKILL_RUNTIME" = "both" ]; then
        CLAUDE_UNINSTALL_CLAIM_RC=0
        claim_captured_skill "Claude" "$CLAUDE_SKILL_TARGET" \
                "$CLAUDE_UNINSTALL_PRESENT" "$CLAUDE_UNINSTALL_PAYLOAD" \
                "$CLAUDE_UNINSTALL_IDENTITY" "$CLAUDE_UNINSTALL_CLAIM_DIR" \
                "$CLAUDE_UNINSTALL_REFERENCE" || \
            CLAUDE_UNINSTALL_CLAIM_RC=$?
        CLAUDE_UNINSTALL_CLAIMED="$CAPTURED_UNINSTALL_CLAIMED"
        CLAUDE_UNINSTALL_CLAIM_DIR="$CAPTURED_UNINSTALL_CLAIM_DIR"
        CLAUDE_UNINSTALL_CLAIM_PATH="$CAPTURED_UNINSTALL_CLAIM_PATH"
        CLAUDE_UNINSTALL_REFERENCE="$CAPTURED_UNINSTALL_REFERENCE"
        if [ "$CLAUDE_UNINSTALL_CLAIM_RC" -ne 0 ]; then
            exit 1
        fi
        [ -z "$UNINSTALL_TRANSACTION_SIGNAL_STATUS" ] || \
            exit "$UNINSTALL_TRANSACTION_SIGNAL_STATUS"
    fi

    [ -z "$UNINSTALL_TRANSACTION_SIGNAL_STATUS" ] || \
        exit "$UNINSTALL_TRANSACTION_SIGNAL_STATUS"
    remove_uninstall_claim "Codex" "$CODEX_UNINSTALL_CLAIM_PATH" || exit 1
    [ -z "$UNINSTALL_TRANSACTION_SIGNAL_STATUS" ] || \
        exit "$UNINSTALL_TRANSACTION_SIGNAL_STATUS"
    remove_uninstall_claim "Claude" "$CLAUDE_UNINSTALL_CLAIM_PATH" || exit 1
    [ -z "$UNINSTALL_TRANSACTION_SIGNAL_STATUS" ] || \
        exit "$UNINSTALL_TRANSACTION_SIGNAL_STATUS"

    # Both public registrations are now intentionally absent. References are
    # cleanup-only from this point; signal rollback must not reinstall them.
    UNINSTALL_TRANSACTION_COMMITTED=true
    if [ -n "$UNINSTALL_TRANSACTION_SIGNAL_STATUS" ]; then
        UNINSTALL_TRANSACTION_COMMITTED=false
        exit "$UNINSTALL_TRANSACTION_SIGNAL_STATUS"
    fi
    cleanup_uninstall_reference "Codex" "$CODEX_UNINSTALL_REFERENCE" \
        "$CODEX_UNINSTALL_CLAIM_DIR" || exit 1
    cleanup_uninstall_reference "Claude" "$CLAUDE_UNINSTALL_REFERENCE" \
        "$CLAUDE_UNINSTALL_CLAIM_DIR" || exit 1
    UNINSTALL_TRANSACTION_ACTIVE=false
    if [ "$CODEX_UNINSTALL_PRESENT" = true ] && \
       { [ "$SKILL_RUNTIME" = "codex" ] || [ "$SKILL_RUNTIME" = "both" ]; }; then
        echo "✅ Codex skill uninstalled"
    fi
    if [ "$CLAUDE_UNINSTALL_PRESENT" = true ] && \
       { [ "$SKILL_RUNTIME" = "claude" ] || [ "$SKILL_RUNTIME" = "both" ]; }; then
        echo "✅ Claude skill uninstalled"
    fi
    exit 0
fi

# Handle resolve subcommand - resolve PR review threads by ID
if [ "$1" = "resolve" ]; then
    shift
    if [ $# -eq 0 ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
        echo "Usage: gh pr-enrich resolve <THREAD_ID> [THREAD_ID...]"
        echo ""
        echo "Resolve one or more PR review threads by their GraphQL ID."
        echo "Thread IDs start with 'PRRT_' and can be found in:"
        echo "  - claude-analysis.json (task_list[].thread_ids)"
        echo "  - comment-threads.json"
        echo ""
        echo "Example:"
        echo "  gh pr-enrich resolve PRRT_kwDORDoRf85rizQq PRRT_kwDORDoRf85rizQ3"
        exit 0
    fi

    RESOLVED=0
    FAILED=0

    for THREAD_ID in "$@"; do
        # Validate thread ID format (PRRT_ prefix + base64-safe characters)
        if [[ ! "$THREAD_ID" =~ ^PRRT_[A-Za-z0-9_-]+$ ]]; then
            echo "⚠️  Skipping invalid thread ID: $THREAD_ID (must start with PRRT_ followed by valid characters)"
            ((FAILED++))
            continue
        fi

        # Resolve the thread via GraphQL (using parameterized query to prevent injection)
        RESULT=$(gh api graphql \
            -F threadId="$THREAD_ID" \
            -f query='mutation($threadId: ID!) {
                resolveReviewThread(input: {threadId: $threadId}) {
                    thread { isResolved id }
                }
            }' 2>&1)

        if echo "$RESULT" | jq -e '.data.resolveReviewThread.thread.isResolved' > /dev/null 2>&1; then
            echo "✅ Resolved: $THREAD_ID"
            ((RESOLVED++))
        else
            ERROR=$(echo "$RESULT" | jq -r '.errors[0].message // "Unknown error"' 2>/dev/null || echo "$RESULT")
            echo "❌ Failed to resolve $THREAD_ID: $ERROR"
            ((FAILED++))
        fi
    done

    echo ""
    echo "Summary: $RESOLVED resolved, $FAILED failed"
    exit 0
fi

# Handle watch subcommand - monitor PR for new comments
if [ "$1" = "watch" ]; then
    shift
    if [ $# -eq 0 ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
        echo "Usage: gh pr-enrich watch <PR_NUMBER> [OPTIONS]"
        echo ""
        echo "Monitor a PR for new comments and optionally run analysis."
        echo ""
        echo "Options:"
        echo "  --interval MIN   Check interval in minutes (default: 5)"
        echo "  --enrich         Run Claude analysis when new comments found"
        echo "  --allow-external Authorize external Claude for private/internal repositories"
        echo "  --notify         Show desktop notification (macOS only)"
        echo ""
        echo "Example:"
        echo "  gh pr-enrich watch 123 --interval 2 --enrich"
        echo ""
        echo "Press Ctrl+C to stop watching."
        exit 0
    fi

    WATCH_PR="$1"
    shift

    # Validate PR number
    if ! [[ "$WATCH_PR" =~ ^[0-9]+$ ]]; then
        echo "Error: PR number must be a positive integer"
        exit 1
    fi

    WATCH_INTERVAL=5
    WATCH_ENRICH=false
    WATCH_ALLOW_EXTERNAL=false
    WATCH_NOTIFY=false

    while [[ $# -gt 0 ]]; do
        case $1 in
            --interval)
                if [ -z "${2:-}" ]; then
                    echo "Error: --interval requires a numeric value"
                    exit 1
                fi
                if ! [[ "$2" =~ ^[0-9]+$ ]] || [ "$2" -lt 1 ]; then
                    echo "Error: --interval must be a positive integer (got: '$2')"
                    exit 1
                fi
                WATCH_INTERVAL="$2"
                shift 2
                ;;
            --enrich)
                WATCH_ENRICH=true
                shift
                ;;
            --allow-external)
                WATCH_ALLOW_EXTERNAL=true
                shift
                ;;
            --notify)
                WATCH_NOTIFY=true
                shift
                ;;
            *)
                echo "Unknown option: $1"
                exit 1
                ;;
        esac
    done

    # Validate repository access. Keep ownership in the advertised watch PID so
    # targeted cancellation cannot strand the bounded GitHub supervisor.
    WATCH_CAPTURE_FILE="$(mktemp \
        "${TMPDIR:-/tmp}/gh-pr-enrich-prelock-output.XXXXXX")" || exit 1
    if run_parent_managed_capture "$WATCH_CAPTURE_FILE" \
            run_watch_github_command gh repo view \
            --json nameWithOwner -q .nameWithOwner 2>/dev/null; then
        REPO="$(cat "$WATCH_CAPTURE_FILE")"
    else
        REPO=""
    fi
    rm -f "$WATCH_CAPTURE_FILE"
    WATCH_CAPTURE_FILE=""
    if [ -z "$REPO" ]; then
        echo "Error: Could not determine repository. Are you in a git repo with a GitHub remote?"
        exit 1
    fi

    # Verify PR exists before starting watch loop
    WATCH_CAPTURE_FILE="$(mktemp \
        "${TMPDIR:-/tmp}/gh-pr-enrich-prelock-output.XXXXXX")" || exit 1
    if ! run_parent_managed_capture "$WATCH_CAPTURE_FILE" \
            run_watch_github_command gh pr view "$WATCH_PR" \
            --json number 2>/dev/null; then
        rm -f "$WATCH_CAPTURE_FILE"
        WATCH_CAPTURE_FILE=""
        echo "Error: PR #$WATCH_PR not found in $REPO"
        echo "Verify the PR number and that you have access to the repository."
        exit 1
    fi
    rm -f "$WATCH_CAPTURE_FILE"
    WATCH_CAPTURE_FILE=""

    echo "👀 Watching PR #$WATCH_PR in $REPO"
    echo "   Checking every $WATCH_INTERVAL minute(s)"
    echo "   Enrich: $WATCH_ENRICH | Notify: $WATCH_NOTIFY"
    echo "   Press Ctrl+C to stop"
    echo ""

    # Split repo into owner and name for parameterized queries
    REPO_OWNER="${REPO%/*}"
    REPO_NAME="${REPO#*/}"

    # One bounded page is enough only when GitHub confirms it contains every
    # thread and every reply. Incomplete snapshots fail and retry instead of
    # silently advancing the watch baseline.
    WATCH_CAPTURE_FILE="$(mktemp \
        "${TMPDIR:-/tmp}/gh-pr-enrich-prelock-output.XXXXXX")" || exit 1
    if ! run_parent_managed_capture "$WATCH_CAPTURE_FILE" \
            fetch_watch_state "$REPO_OWNER" "$REPO_NAME" "$WATCH_PR"; then
        rm -f "$WATCH_CAPTURE_FILE"
        WATCH_CAPTURE_FILE=""
        echo "Error: Could not fetch the initial PR comment state." >&2
        exit 1
    fi
    LAST_WATCH_STATE="$(cat "$WATCH_CAPTURE_FILE")"
    rm -f "$WATCH_CAPTURE_FILE"
    WATCH_CAPTURE_FILE=""
    LAST_COUNT="$(jq '
        (.issue_comment_ids | length) + (.review_ids | length)
        + (.inline_comment_ids | length)
    ' <<< "$LAST_WATCH_STATE")"
    LAST_UNRESOLVED="$(jq '.unresolved' <<< "$LAST_WATCH_STATE")"

    echo "📊 Initial state: $LAST_COUNT comments/reviews, $LAST_UNRESOLVED unresolved threads"
    echo ""

    CONSECUTIVE_FAILURES=0
    MAX_FAILURES=3

    while true; do
        sleep $((WATCH_INTERVAL * 60))

        TIMESTAMP=$(date '+%H:%M:%S')

        # Check for API failures
        WATCH_CAPTURE_FILE="$(mktemp \
            "${TMPDIR:-/tmp}/gh-pr-enrich-prelock-output.XXXXXX")" || exit 1
        if ! run_parent_managed_capture "$WATCH_CAPTURE_FILE" \
                fetch_watch_state "$REPO_OWNER" "$REPO_NAME" "$WATCH_PR"; then
            rm -f "$WATCH_CAPTURE_FILE"
            WATCH_CAPTURE_FILE=""
            CONSECUTIVE_FAILURES=$((CONSECUTIVE_FAILURES + 1))
            echo "[$TIMESTAMP] ⚠️  API request failed (attempt $CONSECUTIVE_FAILURES/$MAX_FAILURES)"
            if [ "$CONSECUTIVE_FAILURES" -ge "$MAX_FAILURES" ]; then
                echo "[$TIMESTAMP] ❌ Too many consecutive failures. Check network/auth and restart watch."
                exit 1
            fi
            continue
        fi
        CURRENT_WATCH_STATE="$(cat "$WATCH_CAPTURE_FILE")"
        rm -f "$WATCH_CAPTURE_FILE"
        WATCH_CAPTURE_FILE=""
        CONSECUTIVE_FAILURES=0
        WATCH_DELTA="$(printf '%s\n%s\n' "$LAST_WATCH_STATE" \
            "$CURRENT_WATCH_STATE" | jq -sec '
            .[0] as $previous
            | .[1] as $current
            |
            def unseen($key):
                (reduce $previous[$key][] as $id ({}; .[$id] = true)) as $seen
                | [$current[$key][] as $id
                 | select($seen[$id] != true)
                 | $id]
                | length;
            {
                changed: ($current != $previous),
                current_comments: (
                    ($current.issue_comment_ids | length)
                    + ($current.review_ids | length)
                    + ($current.inline_comment_ids | length)
                ),
                current_unresolved: $current.unresolved,
                comment_count_diff: (
                    (($current.issue_comment_ids | length)
                     + ($current.review_ids | length)
                     + ($current.inline_comment_ids | length))
                    - (($previous.issue_comment_ids | length)
                       + ($previous.review_ids | length)
                       + ($previous.inline_comment_ids | length))
                ),
                thread_diff: ($current.unresolved - $previous.unresolved),
                new_issue_comments: unseen("issue_comment_ids"),
                new_reviews: unseen("review_ids"),
                new_inline_comments: unseen("inline_comment_ids")
            }
        ')"
        CURRENT_COUNT="$(jq '.current_comments' <<< "$WATCH_DELTA")"
        CURRENT_UNRESOLVED="$(jq '.current_unresolved' <<< "$WATCH_DELTA")"

        if [ "$(jq -r '.changed' <<< "$WATCH_DELTA")" = true ]; then
            COMMENT_COUNT_DIFF="$(jq '.comment_count_diff' <<< "$WATCH_DELTA")"
            THREAD_DIFF="$(jq '.thread_diff' <<< "$WATCH_DELTA")"
            NEW_ISSUE_COMMENTS="$(jq '.new_issue_comments' <<< "$WATCH_DELTA")"
            NEW_REVIEWS="$(jq '.new_reviews' <<< "$WATCH_DELTA")"
            NEW_INLINE_COMMENTS="$(jq '.new_inline_comments' <<< "$WATCH_DELTA")"
            NEW_COMMENTS=$((NEW_ISSUE_COMMENTS + NEW_REVIEWS + NEW_INLINE_COMMENTS))

            echo "[$TIMESTAMP] 🔔 Changes detected!"
            [ "$NEW_ISSUE_COMMENTS" -gt 0 ] && \
                echo "   New issue comments: +$NEW_ISSUE_COMMENTS"
            [ "$NEW_REVIEWS" -gt 0 ] && echo "   New review summaries: +$NEW_REVIEWS"
            [ "$NEW_INLINE_COMMENTS" -gt 0 ] && \
                echo "   New inline comments: +$NEW_INLINE_COMMENTS"
            [ "$COMMENT_COUNT_DIFF" -ne 0 ] && \
                echo "   Comment/review count change: $COMMENT_COUNT_DIFF"
            [ "$THREAD_DIFF" -gt 0 ] && echo "   New unresolved threads: +$THREAD_DIFF"
            [ "$THREAD_DIFF" -lt 0 ] && echo "   Threads resolved: ${THREAD_DIFF#-}"

            # Desktop notification (macOS)
            if [ "$WATCH_NOTIFY" = true ] && command -v osascript &> /dev/null; then
                osascript -e "display notification \"${NEW_COMMENTS} new comments, ${CURRENT_UNRESOLVED} unresolved\" with title \"PR #${WATCH_PR} Updated\"" 2>/dev/null || true
            fi

            ADVANCE_WATCH_BASELINE=true
            # Preserve resolution-only behavior: a final thread resolution is
            # reported but does not run analysis when no unresolved work or new
            # stable comment/review identity remains.
            if [ "$WATCH_ENRICH" = true ] && \
               { [ "$CURRENT_UNRESOLVED" -gt 0 ] || [ "$NEW_COMMENTS" -gt 0 ]; }; then
                echo "   Running analysis..."
                WATCH_EXTERNAL_ARGS=()
                [ "$WATCH_ALLOW_EXTERNAL" = true ] && WATCH_EXTERNAL_ARGS+=(--allow-external)
                WATCH_REPORT_DIR=".reports/pr-reviews/pr-$WATCH_PR"
                BEFORE_ANALYSIS_IDENTITY="$(watch_selected_analysis_identity \
                    "$WATCH_REPORT_DIR" "$REPO" "$WATCH_PR" 2>/dev/null || echo "")"
                ENRICH_EXIT=0
                "$0" "$WATCH_PR" --enrich --diff "${WATCH_EXTERNAL_ARGS[@]}" \
                    --output-dir "$WATCH_REPORT_DIR" > /dev/null 2>&1 || ENRICH_EXIT=$?
                AFTER_ANALYSIS_IDENTITY="$(watch_selected_analysis_identity \
                    "$WATCH_REPORT_DIR" "$REPO" "$WATCH_PR" 2>/dev/null || echo "")"
                if [ "$ENRICH_EXIT" -eq 0 ] && \
                   [ -n "$AFTER_ANALYSIS_IDENTITY" ] && \
                   [ "$AFTER_ANALYSIS_IDENTITY" != "$BEFORE_ANALYSIS_IDENTITY" ]; then
                    echo "   ✅ Analysis updated: $WATCH_REPORT_DIR/analysis.md"
                else
                    ADVANCE_WATCH_BASELINE=false
                    echo "   ❌ Analysis did not publish a fresh selected artifact; retaining the prior watch state for retry."
                    echo "      Check manually with: gh pr-enrich $WATCH_PR --enrich --diff"
                fi
            fi

            if [ "$ADVANCE_WATCH_BASELINE" = true ]; then
                LAST_WATCH_STATE="$CURRENT_WATCH_STATE"
            fi
            echo ""
        else
            echo "[$TIMESTAMP] No changes (comments: $CURRENT_COUNT, unresolved: $CURRENT_UNRESOLVED)"
        fi
    done
fi

# Handle address subcommand - interactive mode to work through issues
if [ "$1" = "address" ]; then
    shift
    ADDRESS_COMMAND_MANAGEMENT_ENABLED=true
    if [ $# -eq 0 ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
        echo "Usage: gh pr-enrich address <PR_NUMBER>"
        echo ""
        echo "Interactive mode to work through PR review issues one by one."
        echo "Shows each task from the selected analysis and lets you mark as fixed."
        echo ""
        echo "Requires: Previous 'gh pr-enrich <PR> --enrich' run"
        echo ""
        echo "Controls:"
        echo "  f - Mark as fixed (resolves thread)"
        echo "  s - Skip to next task"
        echo "  o - Open thread in browser"
        echo "  q - Quit"
        exit 0
    fi

    ADDRESS_PR="$1"
    if ! [[ "$ADDRESS_PR" =~ ^[0-9]+$ ]]; then
        echo "Error: PR number must be a positive integer"
        exit 1
    fi

    ANALYSIS_DIR=".reports/pr-reviews/pr-$ADDRESS_PR"
    ANALYSIS_FILE="$(select_analysis_file "$ANALYSIS_DIR" require-current-workspace 2>/dev/null || true)"

    if [ -z "$ANALYSIS_FILE" ] || [ ! -f "$ANALYSIS_FILE" ]; then
        echo "Error: Analysis not found in $ANALYSIS_DIR"
        echo "Run 'gh pr-enrich $ADDRESS_PR --enrich' first"
        exit 1
    fi

    ADDRESS_LIVE_ANALYSIS_FILE="$ANALYSIS_FILE"
    ADDRESS_LIVE_CONTEXT_FILE="$ANALYSIS_DIR/analysis-context.json"
    ADDRESS_FROZEN_ANALYSIS="$(mktemp "${TMPDIR:-/tmp}/gh-pr-enrich-address-analysis.XXXXXX")" || exit 1
    ADDRESS_FROZEN_CONTEXT="$(mktemp "${TMPDIR:-/tmp}/gh-pr-enrich-address-context.XXXXXX")" || {
        rm -f "$ADDRESS_FROZEN_ANALYSIS"
        exit 1
    }
    cleanup_address_analysis() {
        local exit_status=$?
        trap - EXIT
        trap '' INT TERM
        terminate_address_mutation_child
        cleanup_address_hosted_control
        cleanup_address_live_thread_stages
        rollback_active_address_thread_batch || true
        cleanup_address_live_thread_stages
        [ -z "$ADDRESS_MUTATION_RESULT_FILE" ] || \
            rm -f "$ADDRESS_MUTATION_RESULT_FILE"
        [ -z "$ADDRESS_HOSTED_RESULT_FILE" ] || \
            rm -f "$ADDRESS_HOSTED_RESULT_FILE"
        rm -f "$ADDRESS_FROZEN_ANALYSIS" "$ADDRESS_FROZEN_CONTEXT"
        [ -z "$ADDRESS_PENDING_SIGNAL_STATUS" ] || \
            exit_status="$ADDRESS_PENDING_SIGNAL_STATUS"
        exit "$exit_status"
    }
    trap cleanup_address_analysis EXIT
    trap 'handle_address_signal INT' INT
    trap 'handle_address_signal TERM' TERM
    ADDRESS_ANALYSIS_DIGEST="$(sha256_file "$ADDRESS_LIVE_ANALYSIS_FILE" 2>/dev/null || echo "")"
    ADDRESS_ANALYSIS_MODE="$(workspace_file_mode "$ADDRESS_LIVE_ANALYSIS_FILE" 2>/dev/null || echo "")"
    ADDRESS_CONTEXT_DIGEST="$(sha256_file "$ADDRESS_LIVE_CONTEXT_FILE" 2>/dev/null || echo "")"
    ADDRESS_CONTEXT_MODE="$(workspace_file_mode "$ADDRESS_LIVE_CONTEXT_FILE" 2>/dev/null || echo "")"
    if [ -z "$ADDRESS_ANALYSIS_DIGEST" ] || [ -z "$ADDRESS_ANALYSIS_MODE" ] || \
       [ -z "$ADDRESS_CONTEXT_DIGEST" ] || [ -z "$ADDRESS_CONTEXT_MODE" ] || \
       ! cp "$ADDRESS_LIVE_ANALYSIS_FILE" "$ADDRESS_FROZEN_ANALYSIS" || \
       ! cp "$ADDRESS_LIVE_CONTEXT_FILE" "$ADDRESS_FROZEN_CONTEXT" || \
       ! chmod 600 "$ADDRESS_FROZEN_ANALYSIS" "$ADDRESS_FROZEN_CONTEXT"; then
        echo "Error: Could not freeze selected analysis and context before displaying tasks"
        exit 1
    fi
    FROZEN_ANALYSIS_DIGEST="$(sha256_file "$ADDRESS_FROZEN_ANALYSIS" 2>/dev/null || echo "")"
    FROZEN_CONTEXT_DIGEST="$(sha256_file "$ADDRESS_FROZEN_CONTEXT" 2>/dev/null || echo "")"
    LIVE_ANALYSIS_DIGEST="$(sha256_file "$ADDRESS_LIVE_ANALYSIS_FILE" 2>/dev/null || echo "")"
    LIVE_ANALYSIS_MODE="$(workspace_file_mode "$ADDRESS_LIVE_ANALYSIS_FILE" 2>/dev/null || echo "")"
    LIVE_CONTEXT_DIGEST="$(sha256_file "$ADDRESS_LIVE_CONTEXT_FILE" 2>/dev/null || echo "")"
    LIVE_CONTEXT_MODE="$(workspace_file_mode "$ADDRESS_LIVE_CONTEXT_FILE" 2>/dev/null || echo "")"
    if [ "$FROZEN_ANALYSIS_DIGEST" != "$ADDRESS_ANALYSIS_DIGEST" ] || \
       [ "$FROZEN_CONTEXT_DIGEST" != "$ADDRESS_CONTEXT_DIGEST" ] || \
       [ "$LIVE_ANALYSIS_DIGEST" != "$ADDRESS_ANALYSIS_DIGEST" ] || \
       [ "$LIVE_ANALYSIS_MODE" != "$ADDRESS_ANALYSIS_MODE" ] || \
       [ "$LIVE_CONTEXT_DIGEST" != "$ADDRESS_CONTEXT_DIGEST" ] || \
       [ "$LIVE_CONTEXT_MODE" != "$ADDRESS_CONTEXT_MODE" ]; then
        invalidate_selected_analysis "$ANALYSIS_DIR" || true
        echo "Error: Selected analysis or context changed while address mode was starting"
        exit 1
    fi
    if [ "$(basename "$ADDRESS_LIVE_ANALYSIS_FILE")" = "analysis.json" ] && \
       ! validate_address_selection_pair "$ANALYSIS_DIR" \
            "$ADDRESS_FROZEN_ANALYSIS" "$ADDRESS_LIVE_ANALYSIS_FILE" \
            "$ADDRESS_FROZEN_CONTEXT" "$ADDRESS_LIVE_CONTEXT_FILE"; then
        invalidate_selected_analysis "$ANALYSIS_DIR" || true
        echo "Error: Selected analysis provenance changed before tasks could be displayed"
        exit 1
    fi
    if [ "$(basename "$ADDRESS_LIVE_ANALYSIS_FILE")" = "analysis.json" ] && \
       { [ "$(jq -r '.coverage.code_access.state // "disabled"' \
                    "$ADDRESS_FROZEN_CONTEXT" 2>/dev/null || echo disabled)" = "enabled" ] || \
         jq -e 'any((.issue_categories // [])[]; .verdict == "confirmed")' \
            "$ADDRESS_FROZEN_ANALYSIS" > /dev/null 2>&1; } && \
       ! validate_code_access_grant "$ADDRESS_FROZEN_CONTEXT" "$ANALYSIS_DIR"; then
        invalidate_selected_analysis "$ANALYSIS_DIR" || true
        echo "Error: Selected analysis code-access grant changed before tasks could be displayed"
        exit 1
    fi
    ANALYSIS_FILE="$ADDRESS_FROZEN_ANALYSIS"
    ADDRESS_CONTEXT_FILE="$ADDRESS_FROZEN_CONTEXT"

    # Validate JSON structure before use
    if ! jq -e '.task_list' "$ANALYSIS_FILE" > /dev/null 2>&1; then
        echo "Error: Analysis file is missing 'task_list' or contains invalid JSON"
        echo "File: $ANALYSIS_FILE"
        echo "Re-run: gh pr-enrich $ADDRESS_PR --enrich"
        exit 1
    fi

    ADDRESS_CURRENT_PROVENANCE=false
    ADDRESS_CONTEXT_PR=""
    ADDRESS_CONTEXT_REPOSITORY=""
    ADDRESS_CONTEXT_HEAD=""
    if [ "$(basename "$ADDRESS_LIVE_ANALYSIS_FILE")" = "analysis.json" ] && \
       [ -f "$ADDRESS_CONTEXT_FILE" ]; then
        ADDRESS_CONTEXT_PR="$(jq -r '.pr.number // ""' "$ADDRESS_CONTEXT_FILE")"
        ADDRESS_CONTEXT_REPOSITORY="$(jq -r '.pr.repository // ""' "$ADDRESS_CONTEXT_FILE")"
        ADDRESS_CONTEXT_HEAD="$(jq -r '.coverage.code_access.pr_head_sha // ""' "$ADDRESS_CONTEXT_FILE")"
        if [ "$ADDRESS_CONTEXT_PR" != "$ADDRESS_PR" ]; then
            echo "Error: Selected analysis belongs to PR #${ADDRESS_CONTEXT_PR:-unknown}, not PR #$ADDRESS_PR"
            exit 1
        fi
        if [ -n "$ADDRESS_CONTEXT_REPOSITORY" ] && [ -n "$ADDRESS_CONTEXT_HEAD" ]; then
            ADDRESS_CURRENT_PROVENANCE=true
        fi
    fi

    # Get task count
    TASK_COUNT=$(jq '.task_list | length' "$ANALYSIS_FILE")
    if [ "$TASK_COUNT" -eq 0 ]; then
        echo "✅ No tasks found in analysis. All done!"
        exit 0
    fi

    echo "📋 Found $TASK_COUNT tasks to address"
    echo ""

    CURRENT=0
    FIXED=0
    SKIPPED=0

    while [ $CURRENT -lt $TASK_COUNT ]; do
        TASK=$(jq -r ".task_list[$CURRENT]" "$ANALYSIS_FILE")
        PRIORITY=$(sanitize_for_terminal "$(echo "$TASK" | jq -r '.priority')")
        DESCRIPTION=$(sanitize_for_terminal "$(echo "$TASK" | jq -r '.task')")
        THREAD_IDS=$(sanitize_for_terminal "$(echo "$TASK" | jq -r '(.thread_ids // []) | join(", ")')")
        TASK_FILE=$(sanitize_for_terminal "$(echo "$TASK" | jq -r '.file // ""')")
        TASK_LINE=$(sanitize_for_terminal "$(echo "$TASK" | jq -r '.line // 0')")
        TASK_FIX=$(sanitize_for_terminal "$(echo "$TASK" | jq -r '.suggested_fix // ""')")
        TASK_VERIFY=$(sanitize_for_terminal "$(echo "$TASK" | jq -r '.verification // ""')")

        # Color based on priority
        # Literal escape constants, printed with plain `echo`: `echo -e` would
        # decode escape sequences embedded in the analyzer-controlled priority.
        case $PRIORITY in
            critical) PRIORITY_COLOR=$'\033[1;31m' ;;  # Bold red
            high)     PRIORITY_COLOR=$'\033[0;31m' ;;  # Red
            medium)   PRIORITY_COLOR=$'\033[0;33m' ;;  # Yellow
            low)      PRIORITY_COLOR=$'\033[0;32m' ;;  # Green
            *)        PRIORITY_COLOR=$'\033[0m' ;;
        esac
        COLOR_RESET=$'\033[0m'

        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo "Task $((CURRENT + 1))/$TASK_COUNT [${PRIORITY_COLOR}${PRIORITY}${COLOR_RESET}]"
        echo ""
        echo "$DESCRIPTION"
        echo ""
        if [ -n "$TASK_FILE" ] && [ "$TASK_FILE" != "n/a" ] && [ "$TASK_FILE" != "null" ]; then
            echo "Location: $TASK_FILE:$TASK_LINE"
        fi
        if [ -n "$TASK_FIX" ]; then
            echo "Suggested fix: $TASK_FIX"
        fi
        if [ -n "$TASK_VERIFY" ]; then
            echo "Verify with:   $TASK_VERIFY"
        fi
        if [ -n "$THREAD_IDS" ] && [ "$THREAD_IDS" != "null" ]; then
            echo "Threads: $THREAD_IDS"
        fi
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo ""
        echo -n "[f]ixed  [s]kip  [o]pen in browser  [q]uit > "

        read -r -n 1 ACTION
        echo ""

        case $ACTION in
            f|F)
                # Resolve all threads for this task (using parameterized query to prevent injection)
                THREAD_ARRAY=$(echo "$TASK" | jq -r '.thread_ids[]' 2>/dev/null)
                RESOLVE_FAILED=0
                if [ -n "$THREAD_ARRAY" ]; then
                    if [ "$ADDRESS_CURRENT_PROVENANCE" != true ]; then
                        echo "  ❌ Legacy analysis cannot authorize hosted thread mutations. Re-run and select a current analysis."
                        RESOLVE_FAILED=1
                    else
                        THREAD_IDS_TO_RESOLVE=()
                        for TID in $THREAD_ARRAY; do
                            if [[ ! "$TID" =~ ^PRRT_[A-Za-z0-9_-]+$ ]]; then
                                invalidate_selected_analysis "$ANALYSIS_DIR" || true
                                echo "  ❌ Invalid thread ID format: $TID"
                                exit 1
                            fi
                            for EXISTING_TID in "${THREAD_IDS_TO_RESOLVE[@]}"; do
                                if [ "$EXISTING_TID" = "$TID" ]; then
                                    invalidate_selected_analysis "$ANALYSIS_DIR" || true
                                    echo "  ❌ Duplicate thread ID in one task: $TID"
                                    exit 1
                                fi
                            done
                            THREAD_IDS_TO_RESOLVE+=("$TID")
                        done

                        # Validate the complete task batch before resolving any
                        # thread. Per-thread checks are repeated below to close
                        # the remaining preflight-to-mutation window.
                        for TID in "${THREAD_IDS_TO_RESOLVE[@]}"; do
                            LIVE_ANALYSIS_DIGEST="$(sha256_file "$ADDRESS_LIVE_ANALYSIS_FILE" 2>/dev/null || echo "")"
                            LIVE_ANALYSIS_MODE="$(workspace_file_mode "$ADDRESS_LIVE_ANALYSIS_FILE" 2>/dev/null || echo "")"
                            LIVE_CONTEXT_DIGEST="$(sha256_file "$ADDRESS_LIVE_CONTEXT_FILE" 2>/dev/null || echo "")"
                            LIVE_CONTEXT_MODE="$(workspace_file_mode "$ADDRESS_LIVE_CONTEXT_FILE" 2>/dev/null || echo "")"
                            if [ -z "$LIVE_ANALYSIS_DIGEST" ] || \
                               [ "$LIVE_ANALYSIS_DIGEST" != "$ADDRESS_ANALYSIS_DIGEST" ] || \
                               [ "$LIVE_ANALYSIS_MODE" != "$ADDRESS_ANALYSIS_MODE" ] || \
                               [ "$LIVE_CONTEXT_DIGEST" != "$ADDRESS_CONTEXT_DIGEST" ] || \
                               [ "$LIVE_CONTEXT_MODE" != "$ADDRESS_CONTEXT_MODE" ] || \
                               ! validate_address_selection_pair "$ANALYSIS_DIR" \
                                    "$ANALYSIS_FILE" "$ADDRESS_LIVE_ANALYSIS_FILE" \
                                    "$ADDRESS_CONTEXT_FILE" "$ADDRESS_LIVE_CONTEXT_FILE"; then
                                invalidate_selected_analysis "$ANALYSIS_DIR" || true
                                echo "  ❌ Selected analysis or thread provenance changed. Re-run before resolving threads."
                                exit 1
                            fi
                            if ! validate_live_review_thread \
                                    "$ADDRESS_CONTEXT_FILE" "$TID" false; then
                                invalidate_selected_analysis "$ANALYSIS_DIR" || true
                                echo "  ❌ Live review discussion changed or could not be fetched completely. Re-run before resolving threads."
                                exit 1
                            fi
                            # Hosted head is the final check immediately before
                            # the mutation; all local and discussion checks have
                            # already succeeded against the captured context.
                            if ! verify_pr_head_unchanged "$ADDRESS_CONTEXT_PR" \
                                    "$ADDRESS_CONTEXT_HEAD" "$ADDRESS_CONTEXT_REPOSITORY"; then
                                invalidate_on_confirmed_hosted_head_mismatch \
                                    "$ANALYSIS_DIR" || true
                                if [ "$HOSTED_HEAD_VERIFICATION_STATUS" = "mismatch" ]; then
                                    echo "  ❌ Hosted PR head changed since analysis (expected $ADDRESS_CONTEXT_HEAD, found $CURRENT_HOSTED_HEAD). Re-run before resolving threads."
                                else
                                    echo "  ❌ Hosted PR head could not be revalidated; no thread mutation was sent and the selected analysis was preserved."
                                fi
                                exit 1
                            fi
                        done

                        ADDRESS_BATCH_ATTEMPTED_THREAD_IDS=()
                        ADDRESS_BATCH_CONFIRMED_THREAD_IDS=()
                        ADDRESS_BATCH_ACTIVE=true
                        for TID in "${THREAD_IDS_TO_RESOLVE[@]}"; do
                            # Revalidate immediately before every mutation. If a
                            # later thread changes, stop without trying to reopen
                            # any hosted thread; GitHub provides no conditional
                            # unresolve operation that can prove ownership.
                            LIVE_ANALYSIS_DIGEST="$(sha256_file "$ADDRESS_LIVE_ANALYSIS_FILE" 2>/dev/null || echo "")"
                            LIVE_ANALYSIS_MODE="$(workspace_file_mode "$ADDRESS_LIVE_ANALYSIS_FILE" 2>/dev/null || echo "")"
                            LIVE_CONTEXT_DIGEST="$(sha256_file "$ADDRESS_LIVE_CONTEXT_FILE" 2>/dev/null || echo "")"
                            LIVE_CONTEXT_MODE="$(workspace_file_mode "$ADDRESS_LIVE_CONTEXT_FILE" 2>/dev/null || echo "")"
                            if [ -z "$LIVE_ANALYSIS_DIGEST" ] || \
                               [ "$LIVE_ANALYSIS_DIGEST" != "$ADDRESS_ANALYSIS_DIGEST" ] || \
                               [ "$LIVE_ANALYSIS_MODE" != "$ADDRESS_ANALYSIS_MODE" ] || \
                               [ "$LIVE_CONTEXT_DIGEST" != "$ADDRESS_CONTEXT_DIGEST" ] || \
                               [ "$LIVE_CONTEXT_MODE" != "$ADDRESS_CONTEXT_MODE" ] || \
                               ! validate_address_selection_pair "$ANALYSIS_DIR" \
                                    "$ANALYSIS_FILE" "$ADDRESS_LIVE_ANALYSIS_FILE" \
                                    "$ADDRESS_CONTEXT_FILE" "$ADDRESS_LIVE_CONTEXT_FILE"; then
                                rollback_active_address_thread_batch || true
                                invalidate_selected_analysis "$ANALYSIS_DIR" || true
                                echo "  ❌ Selected analysis or thread provenance changed. Re-run before resolving threads."
                                exit 1
                            fi
                            if ! validate_live_review_thread \
                                    "$ADDRESS_CONTEXT_FILE" "$TID" false; then
                                rollback_active_address_thread_batch || true
                                invalidate_selected_analysis "$ANALYSIS_DIR" || true
                                echo "  ❌ Live review discussion changed or could not be fetched completely. Re-run before resolving threads."
                                exit 1
                            fi
                            if ! verify_pr_head_unchanged "$ADDRESS_CONTEXT_PR" \
                                    "$ADDRESS_CONTEXT_HEAD" "$ADDRESS_CONTEXT_REPOSITORY"; then
                                rollback_active_address_thread_batch || true
                                invalidate_on_confirmed_hosted_head_mismatch \
                                    "$ANALYSIS_DIR" || true
                                if [ "$HOSTED_HEAD_VERIFICATION_STATUS" = "mismatch" ]; then
                                    echo "  ❌ Hosted PR head changed since analysis (expected $ADDRESS_CONTEXT_HEAD, found $CURRENT_HOSTED_HEAD). Re-run before resolving threads."
                                else
                                    echo "  ❌ Hosted PR head could not be revalidated; any attempted thread resolutions were left unchanged for manual reconciliation."
                                fi
                                exit 1
                            fi
                            RESULT=""
                            MUTATION_RESULT_FILE="$(mktemp "${TMPDIR:-/tmp}/gh-pr-enrich-resolve-result.XXXXXX")" || {
                                rollback_active_address_thread_batch || true
                                invalidate_selected_analysis "$ANALYSIS_DIR" || true
                                echo "  ❌ Could not stage the resolution response for $TID."
                                exit 1
                            }
                            ADDRESS_MUTATION_RESULT_FILE="$MUTATION_RESULT_FILE"
                            MUTATION_RC=0
                            ADDRESS_BATCH_ATTEMPTED_THREAD_IDS+=("$TID")
                            run_address_hosted_command "$MUTATION_RESULT_FILE" \
                                gh api graphql \
                                -F threadId="$TID" \
                                -f query='mutation($threadId: ID!) {
                                    resolveReviewThread(input: {threadId: $threadId}) {
                                        thread { isResolved }
                                    }
                                }' || MUTATION_RC=$?
                            RESULT="$(cat "$MUTATION_RESULT_FILE")"
                            rm -f "$MUTATION_RESULT_FILE"
                            ADDRESS_MUTATION_RESULT_FILE=""
                            MUTATION_RESPONSE_VALID=false
                            if [ "$MUTATION_RC" -eq 0 ] && \
                               echo "$RESULT" | jq -e '
                                    .data.resolveReviewThread.thread.isResolved == true
                               ' \
                                    > /dev/null 2>&1; then
                                MUTATION_RESPONSE_VALID=true
                            fi
                            # A transport failure or malformed response may still
                            # leave the thread resolved. Never try to undo that
                            # ambiguous hosted transition automatically.
                            if [ "$MUTATION_RESPONSE_VALID" != true ]; then
                                AMBIGUOUS_LIVE_FILE="$(mktemp "${TMPDIR:-/tmp}/gh-pr-enrich-ambiguous-thread.XXXXXX")" || {
                                    rollback_active_address_thread_batch || true
                                    invalidate_selected_analysis "$ANALYSIS_DIR" || true
                                    echo "  ❌ Could not inspect the ambiguous resolution for $TID. Manual reconciliation is required."
                                    exit 1
                                }
                                AMBIGUOUS_RESOLUTION_APPLIED=false
                                if fetch_live_review_thread "$TID" "$AMBIGUOUS_LIVE_FILE" && \
                                   validate_live_review_thread_snapshot \
                                        "$ADDRESS_CONTEXT_FILE" "$TID" true \
                                        "$AMBIGUOUS_LIVE_FILE"; then
                                    AMBIGUOUS_RESOLUTION_APPLIED=true
                                fi
                                rm -f "$AMBIGUOUS_LIVE_FILE"
                                rollback_active_address_thread_batch || true
                                invalidate_selected_analysis "$ANALYSIS_DIR" || true
                                if [ "$AMBIGUOUS_RESOLUTION_APPLIED" = true ]; then
                                    echo "  ❌ Resolution for $TID completed without a valid response; it was left resolved. Manual reconciliation is required."
                                else
                                    echo "  ❌ Resolution result for $TID is ambiguous; live state could not prove the captured discussion resolved. Manual reconciliation is required."
                                fi
                                exit 1
                            fi
                            ADDRESS_BATCH_CONFIRMED_THREAD_IDS+=("$TID")

                            POST_LOCAL_VALID=true
                            LIVE_ANALYSIS_DIGEST="$(sha256_file "$ADDRESS_LIVE_ANALYSIS_FILE" 2>/dev/null || echo "")"
                            LIVE_ANALYSIS_MODE="$(workspace_file_mode "$ADDRESS_LIVE_ANALYSIS_FILE" 2>/dev/null || echo "")"
                            LIVE_CONTEXT_DIGEST="$(sha256_file "$ADDRESS_LIVE_CONTEXT_FILE" 2>/dev/null || echo "")"
                            LIVE_CONTEXT_MODE="$(workspace_file_mode "$ADDRESS_LIVE_CONTEXT_FILE" 2>/dev/null || echo "")"
                            if [ -z "$LIVE_ANALYSIS_DIGEST" ] || \
                               [ "$LIVE_ANALYSIS_DIGEST" != "$ADDRESS_ANALYSIS_DIGEST" ] || \
                               [ "$LIVE_ANALYSIS_MODE" != "$ADDRESS_ANALYSIS_MODE" ] || \
                               [ "$LIVE_CONTEXT_DIGEST" != "$ADDRESS_CONTEXT_DIGEST" ] || \
                               [ "$LIVE_CONTEXT_MODE" != "$ADDRESS_CONTEXT_MODE" ] || \
                               ! validate_address_selection_pair "$ANALYSIS_DIR" \
                                    "$ANALYSIS_FILE" "$ADDRESS_LIVE_ANALYSIS_FILE" \
                                    "$ADDRESS_CONTEXT_FILE" "$ADDRESS_LIVE_CONTEXT_FILE"; then
                                POST_LOCAL_VALID=false
                            fi

                            POST_THREAD_IDENTITY_VALID=false
                            POST_THREAD_RESOLVED=false
                            POST_LIVE_FILE="$(mktemp "${TMPDIR:-/tmp}/gh-pr-enrich-post-thread.XXXXXX")" || {
                                rollback_active_address_thread_batch || true
                                invalidate_selected_analysis "$ANALYSIS_DIR" || true
                                echo "  ❌ Could not verify $TID after resolution. Manual reconciliation is required."
                                exit 1
                            }
                            if fetch_live_review_thread "$TID" "$POST_LIVE_FILE"; then
                                if live_review_thread_identity_matches_context \
                                        "$ADDRESS_CONTEXT_FILE" "$TID" \
                                        "$POST_LIVE_FILE"; then
                                    POST_THREAD_IDENTITY_VALID=true
                                fi
                                if jq -e --arg thread_id "$TID" '
                                        .data.node.id == $thread_id and
                                        .data.node.isResolved == true
                                    ' "$POST_LIVE_FILE" > /dev/null 2>&1; then
                                    POST_THREAD_RESOLVED=true
                                fi
                            fi
                            rm -f "$POST_LIVE_FILE"

                            POST_HEAD_VALID=true
                            if ! verify_pr_head_unchanged "$ADDRESS_CONTEXT_PR" \
                                    "$ADDRESS_CONTEXT_HEAD" \
                                    "$ADDRESS_CONTEXT_REPOSITORY"; then
                                POST_HEAD_VALID=false
                            fi

                            if [ "$POST_THREAD_IDENTITY_VALID" != true ]; then
                                rollback_active_address_thread_batch || true
                                invalidate_selected_analysis "$ANALYSIS_DIR" || true
                                echo "  ❌ Live review discussion changed during resolution; hosted thread state was left unchanged. Manual reconciliation is required."
                                exit 1
                            fi
                            if [ "$POST_THREAD_RESOLVED" != true ]; then
                                rollback_active_address_thread_batch || true
                                invalidate_selected_analysis "$ANALYSIS_DIR" || true
                                echo "  ❌ Resolution state for $TID changed unexpectedly. Manual reconciliation is required."
                                exit 1
                            fi
                            if [ "$POST_LOCAL_VALID" != true ] || \
                               [ "$POST_HEAD_VALID" != true ]; then
                                rollback_active_address_thread_batch || true
                                invalidate_selected_analysis "$ANALYSIS_DIR" || true
                                echo "  ❌ State changed during resolution; hosted thread state was left unchanged and the analysis was invalidated. Manual reconciliation is required."
                                exit 1
                            fi
                        done
                        BATCH_COMMIT_FAILURE=""
                        for TID in "${ADDRESS_BATCH_CONFIRMED_THREAD_IDS[@]}"; do
                            LIVE_ANALYSIS_DIGEST="$(sha256_file "$ADDRESS_LIVE_ANALYSIS_FILE" 2>/dev/null || echo "")"
                            LIVE_ANALYSIS_MODE="$(workspace_file_mode "$ADDRESS_LIVE_ANALYSIS_FILE" 2>/dev/null || echo "")"
                            LIVE_CONTEXT_DIGEST="$(sha256_file "$ADDRESS_LIVE_CONTEXT_FILE" 2>/dev/null || echo "")"
                            LIVE_CONTEXT_MODE="$(workspace_file_mode "$ADDRESS_LIVE_CONTEXT_FILE" 2>/dev/null || echo "")"
                            if [ -z "$LIVE_ANALYSIS_DIGEST" ] || \
                               [ "$LIVE_ANALYSIS_DIGEST" != "$ADDRESS_ANALYSIS_DIGEST" ] || \
                               [ "$LIVE_ANALYSIS_MODE" != "$ADDRESS_ANALYSIS_MODE" ] || \
                               [ "$LIVE_CONTEXT_DIGEST" != "$ADDRESS_CONTEXT_DIGEST" ] || \
                               [ "$LIVE_CONTEXT_MODE" != "$ADDRESS_CONTEXT_MODE" ] || \
                               ! validate_address_selection_pair "$ANALYSIS_DIR" \
                                    "$ANALYSIS_FILE" "$ADDRESS_LIVE_ANALYSIS_FILE" \
                                    "$ADDRESS_CONTEXT_FILE" "$ADDRESS_LIVE_CONTEXT_FILE"; then
                                BATCH_COMMIT_FAILURE="local_state_changed"
                                break
                            fi
                            if ! validate_live_review_thread \
                                    "$ADDRESS_CONTEXT_FILE" "$TID" true; then
                                BATCH_COMMIT_FAILURE="discussion_changed"
                                break
                            fi
                            if ! verify_pr_head_unchanged "$ADDRESS_CONTEXT_PR" \
                                    "$ADDRESS_CONTEXT_HEAD" \
                                    "$ADDRESS_CONTEXT_REPOSITORY"; then
                                if [ "$HOSTED_HEAD_VERIFICATION_STATUS" = "mismatch" ]; then
                                    BATCH_COMMIT_FAILURE="head_mismatch"
                                else
                                    BATCH_COMMIT_FAILURE="head_unavailable"
                                fi
                                break
                            fi
                        done
                        if [ -n "$BATCH_COMMIT_FAILURE" ]; then
                            rollback_active_address_thread_batch || true
                            invalidate_selected_analysis "$ANALYSIS_DIR" || true
                            if [ "$BATCH_COMMIT_FAILURE" = "head_unavailable" ]; then
                                echo "  ❌ Hosted PR head could not be revalidated before batch commit; resolved threads were left unchanged and the analysis was invalidated. Manual reconciliation is required."
                            else
                                echo "  ❌ Task thread state changed before batch commit. Re-run before resolving threads."
                            fi
                            exit 1
                        fi
                        ADDRESS_BATCH_ACTIVE=false
                        ADDRESS_BATCH_ATTEMPTED_THREAD_IDS=()
                        ADDRESS_BATCH_CONFIRMED_THREAD_IDS=()
                        for TID in "${THREAD_IDS_TO_RESOLVE[@]}"; do
                            echo "  ✅ Resolved: $TID"
                        done
                    fi
                    if [ "$RESOLVE_FAILED" -gt 0 ]; then
                        echo "  ⚠️  $RESOLVE_FAILED thread(s) failed to resolve - task may not be fully addressed"
                    fi
                fi
                ((FIXED++))
                ((CURRENT++))
                echo ""
                ;;
            s|S)
                echo "  ⏭️  Skipped"
                ((SKIPPED++))
                ((CURRENT++))
                echo ""
                ;;
            o|O)
                # Get first thread URL.
                #
                # Everything here comes from selected analyzer output, which is
                # output derived from PR content: a PR author who prompt-injects the
                # analyzer chooses these strings. The id is therefore validated
                # before use and passed to jq as data (--arg), never interpolated
                # into the program text — an id containing a quote would otherwise
                # close the string literal and supply its own jq program, which can
                # synthesize any URL and read $ENV.
                FIRST_TID=$(echo "$TASK" | jq -r '.thread_ids[0] // empty')
                if [ -n "$FIRST_TID" ]; then
                    if [[ ! "$FIRST_TID" =~ ^PRRT_[A-Za-z0-9_-]+$ ]]; then
                        echo "  ⚠️  Invalid thread ID format, refusing to open: $FIRST_TID"
                        continue
                    fi
                    # Find URL in comment threads
                    THREAD_FILE=".reports/pr-reviews/pr-$ADDRESS_PR/comment-threads.json"
                    if [ -f "$THREAD_FILE" ]; then
                        URL=$(jq -r --arg tid "$FIRST_TID" \
                            '.data.repository.pullRequest.reviewThreads.nodes[]
                             | select(.id == $tid) | .comments.nodes[0].url // empty' \
                            "$THREAD_FILE")
                        GITHUB_URL_RE='^https://github\.com/[A-Za-z0-9._/#?=&%~-]*$'
                        if [ -n "$URL" ] && [[ ! "$URL" =~ $GITHUB_URL_RE ]]; then
                            # Defense in depth: only ever hand a github.com https URL
                            # to the browser, whatever the file claims.
                            echo "  ⚠️  Refusing to open a non-GitHub URL: $URL"
                            URL=""
                        fi
                        if [ -n "$URL" ]; then
                            echo "  🌐 Opening: $URL"
                            # Try macOS 'open', then Linux 'xdg-open'; Windows not supported
                            open "$URL" 2>/dev/null || xdg-open "$URL" 2>/dev/null || echo "  Could not open browser (try manually: $URL)"
                        else
                            echo "  Could not find a usable URL for thread $FIRST_TID"
                        fi
                    else
                        echo "  Thread details file not found: $THREAD_FILE"
                        echo "  Re-run: gh pr-enrich $ADDRESS_PR to refresh data"
                    fi
                else
                    echo "  No thread ID associated with this task"
                fi
                # Don't advance - let user decide after viewing
                ;;
            q|Q)
                echo ""
                echo "Quitting..."
                break
                ;;
            *)
                echo "  Unknown action. Use f/s/o/q"
                ;;
        esac
    done

    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "Summary: $FIXED fixed, $SKIPPED skipped, $((TASK_COUNT - CURRENT)) remaining"
    exit 0
fi

