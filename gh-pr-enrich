# Function to add GraphQL IDs to comments
create_comments_with_graphql_ids() {
    local input_file="$1"
    local output_file="$2"
    local comment_type="$3"

    jq --rawfile id_map "$OUTPUT_DIR/id-mapping.txt" '
        map(. as $comment |
            . + {
                graphql_id: (
                    if ($comment.id and ($comment.id | type == "number")) then
                        ($id_map | split("\n") | map(select(length > 0) | split(":")) | map({key: .[0], value: .[1]}) | from_entries | .[$comment.id|tostring])
                    else
                        null
                    end
                ),
                comment_type: $comment_type
            }
        )
    ' "$input_file" --arg comment_type "$comment_type" > "$output_file"
}

# ============================================================================
# Claude Enrichment Functions
# ============================================================================

# Fetch every review thread, following pagination.
#
# A single page silently caps a PR at 100 threads: the 101st comment simply does
# not exist as far as the analysis is concerned. gh --paginate walks the cursor
# and emits one JSON document per page; the pages are merged back into the single
# document shape the rest of the pipeline reads.
fetch_review_threads() {
    local owner="$1"
    local repo_name="$2"
    local pr_number="$3"
    local output_file="$4"

    local query='
    query($owner: String!, $name: String!, $prNumber: Int!, $endCursor: String) {
      repository(owner: $owner, name: $name) {
        pullRequest(number: $prNumber) {
          reviewThreads(first: 100, after: $endCursor) {
            pageInfo { hasNextPage endCursor }
            nodes {
              id
              isResolved
              isOutdated
              path
              line
              originalLine
              diffSide
              comments(first: 20) {
                nodes {
                  id
                  databaseId
                  body
                  author { login }
                  createdAt
                  url
                }
              }
            }
          }
        }
      }
    }'

    local pages_file="${output_file}.pages"
    if ! gh api graphql --paginate \
            -F owner="$owner" -F name="$repo_name" -F prNumber="$pr_number" \
            -f query="$query" > "$pages_file" 2>/dev/null; then
        rm -f "$pages_file"
        return 1
    fi

    # Merge every page's nodes into one document, recording how many pages were read.
    jq -s '{
        data: {
            repository: {
                pullRequest: {
                    reviewThreads: {
                        nodes: (map(.data.repository.pullRequest.reviewThreads.nodes // []) | add // []),
                        pages_fetched: length
                    }
                }
            }
        }
    }' "$pages_file" > "$output_file"
    local rc=$?
    rm -f "$pages_file"
    return $rc
}

# Fetch the issues this PR closes, for the intent the diff cannot show.
fetch_linked_issues() {
    local owner="$1"
    local repo_name="$2"
    local pr_number="$3"
    local output_file="$4"

    local query='
    query($owner: String!, $name: String!, $prNumber: Int!) {
      repository(owner: $owner, name: $name) {
        pullRequest(number: $prNumber) {
          closingIssuesReferences(first: 10) {
            nodes { number title body url }
          }
        }
      }
    }'

    if gh api graphql -F owner="$owner" -F name="$repo_name" -F prNumber="$pr_number" \
            -f query="$query" 2>/dev/null \
            | jq '[.data.repository.pullRequest.closingIssuesReferences.nodes[]?]' > "$output_file" 2>/dev/null; then
        return 0
    fi
    echo '[]' > "$output_file"
    return 1
}

extract_unresolved_threads() {
    local threads_file="$1"
    local output_file="$2"

    # is_outdated matters: an outdated thread points at code that has since
    # changed, so the issue may already be fixed. Dropping the flag turns those
    # threads into phantom tasks.
    jq '[.data.repository.pullRequest.reviewThreads.nodes[]
        | select(.isResolved == false)
        | {
            thread_id: .id,
            is_outdated: (.isOutdated // false),
            path: (.path // null),
            line: (.line // .originalLine // null),
            comments: [.comments.nodes[] | {
                author: (.author.login // "unknown"),
                body: .body,
                url: .url
            }]
        }]' "$threads_file" > "$output_file"
}

# Bots repost their whole report on every push. Keeping all revisions burns the
# context budget and double-counts the same finding. Keep the newest revision of
# each bot report; never touch human comments, where repetition is signal.
dedupe_bot_comments() {
    local input_file="$1"
    local output_file="$2"

    jq '
    def is_bot: (.user // "") | test("\\[bot\\]$") or (ascii_downcase | IN("github-actions", "greptile", "codecov", "sonarcloud", "coderabbitai", "dependabot", "renovate"));
    # Report identity: the bot plus its first meaningful line, with digits removed
    # so "72% covered" and "84% covered" collapse to the same report.
    def signature: ((.user // "") + "::" +
        (((.body // "") | split("\n") | map(select(length > 0)) | (.[0] // ""))
         | ascii_downcase | gsub("[0-9]"; "") | gsub("[^a-z ]"; "") | .[0:80]));

    (map(select(is_bot | not))) as $humans
    | (map(select(is_bot))) as $bots
    | ($bots | group_by(signature) | map(sort_by(.created_at // "")) ) as $grouped
    | {
        kept: (($humans + ($grouped | map(.[-1]))) | sort_by(.created_at // "")),
        superseded: ($grouped | map(.[0:-1]) | add // [])
      }
    ' "$input_file" > "$output_file"
}

# Fetch the PR diff and create both raw and structured versions
# Args:
#   $1 - output_dir: Directory to save diff files
#   $2 - pr_num: PR number to fetch diff for
# Creates:
#   pr-diff.txt - Raw unified diff
#   pr-diff.json - Structured diff with file-level separation
fetch_pr_diff() {
    local output_dir="$1"
    local pr_num="$2"

    # Fetch the unified diff for the PR
    if ! gh pr diff "$pr_num" > "$output_dir/pr-diff.txt" 2>/dev/null; then
        echo "⚠️  Could not fetch PR diff (binary files only, empty PR, or access denied)"
        echo "   Analysis will proceed without code context."
        echo "" > "$output_dir/pr-diff.txt"
    fi

    # Also create a structured version with file-level diffs
    # Truncate large diffs to avoid token limits in Claude API
    # 5000 chars per file balances context richness with API constraints
    jq -n --arg diff "$(<"$output_dir/pr-diff.txt")" \
        '{
            raw_diff: $diff,
            file_diffs: ($diff | split("diff --git ") | .[1:] | map(
                . as $chunk |
                ($chunk | split("\n") | .[0] | split(" ") | .[-1] | ltrimstr("b/")) as $filepath |
                {
                    file: $filepath,
                    content: ("diff --git " + $chunk)
                }
            ))
        }' > "$output_dir/pr-diff.json" 2>/dev/null || {
            echo '{"raw_diff": "", "file_diffs": []}' > "$output_dir/pr-diff.json"
        }
}

build_claude_context() {
    local output_dir="$1"
    local include_diff="${2:-false}"
    local truncate_at="${GH_PR_ENRICH_TRUNCATE_CHARS:-5000}"

    # Missing optional inputs degrade to empty, never to a hard failure.
    if [ ! -f "$output_dir/issue-comments.json" ]; then
        echo '[]' > "$output_dir/issue-comments.json"
    fi
    if [ ! -f "$output_dir/unresolved-threads.json" ]; then
        echo '[]' > "$output_dir/unresolved-threads.json"
    fi

    # Required inputs are validated up front. Without this, a missing or corrupt
    # file surfaces as a raw jq argument error with no indication of which file
    # was at fault.
    local required_file
    for required_file in pr-summary.json unresolved-threads.json issue-comments.json; do
        if [ ! -f "$output_dir/$required_file" ]; then
            echo "❌ Cannot build analysis context: $output_dir/$required_file is missing." >&2
            return 1
        fi
        if ! jq -e . "$output_dir/$required_file" > /dev/null 2>&1; then
            echo "❌ Cannot build analysis context: $output_dir/$required_file is not valid JSON." >&2
            return 1
        fi
    done

    dedupe_bot_comments "$output_dir/issue-comments.json" "$output_dir/issue-comments-deduped.json"

    local diff_json='{"raw_diff": "", "file_diffs": []}'
    local with_diff=false
    if [ "$include_diff" = "true" ] && [ -f "$output_dir/pr-diff.json" ]; then
        diff_json="$(<"$output_dir/pr-diff.json")"
        with_diff=true
    fi

    local checks_json='[]'
    if [ -f "$output_dir/checks.json" ]; then
        checks_json="$(<"$output_dir/checks.json")"
    fi

    local linked_json='[]'
    if [ -f "$output_dir/linked-issues.json" ]; then
        linked_json="$(<"$output_dir/linked-issues.json")"
    fi

    local sast_json='[]'
    if [ -f "$output_dir/sast-findings.json" ]; then
        sast_json="$(<"$output_dir/sast-findings.json")"
    fi

    # One jq program builds the whole context. The coverage block records what was
    # dropped or shortened, so a truncated input can never read as a complete one.
    jq -n \
        --argjson pr "$(<"$output_dir/pr-summary.json")" \
        --slurpfile threads "$output_dir/unresolved-threads.json" \
        --slurpfile raw_comments "$output_dir/issue-comments.json" \
        --slurpfile deduped "$output_dir/issue-comments-deduped.json" \
        --argjson checks "$checks_json" \
        --argjson linked "$linked_json" \
        --argjson sast "$sast_json" \
        --argjson diff "$diff_json" \
        --argjson with_diff "$with_diff" \
        --argjson limit "$truncate_at" \
        '
        def trunc($text): if (($text // "") | length) > $limit
            then (($text // "")[0:$limit] + "\n... (truncated)")
            else ($text // "") end;
        def was_truncated($text): (($text // "") | length) > $limit;

        ($threads[0] // []) as $thread_list
        | ($raw_comments[0] // []) as $raw
        | (($deduped[0] // {}) | (.kept // [])) as $kept
        | (($deduped[0] // {}) | (.superseded // [])) as $superseded
        | ($diff.file_diffs // []) as $files
        | {
            pr: {
                title: $pr.title,
                body: ($pr.body // "No description"),
                author: ($pr.author.login // "unknown"),
                files_changed: [($pr.files // [])[].path],
                commits: [($pr.commits // [])[] | {
                    sha: ((.oid // "") | .[0:7]),
                    message: ((.messageHeadline // "") +
                        (if ((.messageBody // "") | length) > 0 then "\n" + (.messageBody | .[0:1000]) else "" end))
                }],
                linked_issues: [($linked // [])[] | {
                    number: .number,
                    title: .title,
                    url: .url,
                    body: trunc(.body)
                }]
            },
            unresolved_threads: $thread_list,
            issue_comments: [$kept[] | {
                user: .user,
                body: trunc(.body),
                url: .html_url,
                created_at: .created_at
            }],
            failing_checks: [($checks // [])[] | select(.bucket == "fail") | {
                name: .name,
                state: .state,
                description: (.description // ""),
                link: (.link // "")
            }],
            sast_findings: $sast,
            coverage: {
                truncation_limit_chars: $limit,
                issue_comments: {
                    total: ($raw | length),
                    included: ($kept | length),
                    superseded_bot_duplicates: ($superseded | length),
                    truncated: [$kept[] | select(was_truncated(.body)) | .html_url]
                },
                unresolved_threads: {
                    total: ($thread_list | length),
                    included: ($thread_list | length),
                    outdated: [$thread_list[] | select(.is_outdated == true)] | length
                },
                diff: {
                    included: $with_diff,
                    files_total: ($files | length),
                    files_included: (if $with_diff then ($files | length) else 0 end),
                    files_truncated: (if $with_diff
                        then [$files[] | select(was_truncated(.content)) | .file]
                        else [] end)
                },
                inputs: {
                    commits: (($pr.commits // []) | length),
                    linked_issues: (($linked // []) | length),
                    failing_checks: ([($checks // [])[] | select(.bucket == "fail")] | length),
                    sast_findings: (($sast // []) | length)
                }
            }
          }
        + (if $with_diff then {
            code_changes: {
                summary: "Diff included for context. Each file_diff contains the actual code changes.",
                file_diffs: [$files[] | {file: .file, diff: trunc(.content)}]
            }
          } else {} end)
        ' > "$output_dir/claude-context.json"
}

