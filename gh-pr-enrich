# Fetch the issues this PR closes, for the intent the diff cannot show.
fetch_linked_issues() {
    local owner="$1"
    local repo_name="$2"
    local pr_number="$3"
    local output_file="$4"

    local query='
    query($owner: String!, $name: String!, $prNumber: Int!, $pageSize: Int!, $endCursor: String) {
      repository(owner: $owner, name: $name) {
        pullRequest(number: $prNumber) {
          closingIssuesReferences(first: $pageSize, after: $endCursor) {
            totalCount
            pageInfo { hasNextPage endCursor }
            nodes {
              id number title body url
              repository { nameWithOwner visibility }
            }
          }
        }
      }
    }'

    # gh emits one JSON document per page. Keep the transport private and
    # validate the full connection before publishing any issue intent: a
    # partial issue list must remain failed coverage, never a clean input.
    local pages_file normalized_file
    pages_file="$(mktemp "${output_file}.pages.XXXXXX")" || return 1
    normalized_file="$(mktemp "${output_file}.normalized.XXXXXX")" || {
        rm -f "$pages_file"
        return 1
    }
    if ! chmod 600 "$pages_file" "$normalized_file"; then
        rm -f "$pages_file" "$normalized_file"
        return 1
    fi

    if ! run_report_command gh api graphql --paginate \
            -F owner="$owner" -F name="$repo_name" -F prNumber="$pr_number" \
            -F pageSize="$LINKED_ISSUE_PAGE_SIZE" -f query="$query" \
            > "$pages_file" 2>/dev/null; then
        printf '[]\n' > "$output_file"
        rm -f "$pages_file" "$normalized_file"
        return 1
    fi

    if [ ! -s "$pages_file" ] || ! jq -s -e '
        def connection:
            .data.repository.pullRequest.closingIssuesReferences;
        . as $pages
        | [$pages[] | connection.nodes[]] as $nodes
        | ($pages[0] | connection.totalCount) as $total
        | (
            (($pages | length) > 0) and
            (all($pages[];
              (((.errors // []) | length) == 0) and
              ((connection.nodes | type) == "array") and
              ((connection.totalCount | type) == "number") and
              (connection.totalCount >= 0) and
              (connection.totalCount == (connection.totalCount | floor)) and
              ((connection.pageInfo | type) == "object") and
              ((connection.pageInfo.hasNextPage | type) == "boolean"))) and
            (all($pages[]; (. | connection.totalCount) == $total)) and
            ($pages | to_entries | all(
              . as $entry
              | ($entry.value | connection) as $connection
              | if $entry.key < (($pages | length) - 1)
                then ($connection.pageInfo.hasNextPage == true and
                      ($connection.pageInfo.endCursor | type) == "string" and
                      ($connection.pageInfo.endCursor | length) > 0)
                else $connection.pageInfo.hasNextPage == false
                end)) and
            (($nodes | length) == $total) and
            (all($nodes[];
              ((.id | type) == "string") and (.id | length) > 0 and
              ((.number | type) == "number") and
              (.number == (.number | floor)))) and
            (([$nodes[].id] | unique | length) == ($nodes | length))
          ) as $valid
        | if $valid then
            $nodes | map(.repository = {
              nameWithOwner: (.repository.nameWithOwner // ""),
              visibility: ((.repository.visibility // "UNKNOWN") | ascii_upcase)
            })
          else error("incomplete linked-issue connection") end
    ' "$pages_file" > "$normalized_file" 2>/dev/null; then
        printf '[]\n' > "$output_file"
        rm -f "$pages_file" "$normalized_file"
        return 1
    fi
    local publish_rc=0
    mv "$normalized_file" "$output_file" || publish_rc=$?
    rm -f "$pages_file" "$normalized_file"
    return "$publish_rc"
}

# `gh pr view --json files,commits` uses connections capped at 100 items.
# Fetch either connection directly when the summary indicates that cap may have
# hidden input. Each helper validates the complete GraphQL connection before it
# publishes a normalized array; partial pages are never accepted as evidence.
fetch_pr_files() {
    local owner="$1" repo_name="$2" pr_number="$3"
    local expected_head="$4" expected_base="$5" output_file="$6"
    local pages_file="${output_file}.pages" normalized_file="${output_file}.normalized"
    local query='
    query($owner: String!, $name: String!, $prNumber: Int!, $pageSize: Int!, $endCursor: String) {
      repository(owner: $owner, name: $name) {
        pullRequest(number: $prNumber) {
          headRefOid
          baseRefOid
          files(first: $pageSize, after: $endCursor) {
            totalCount
            pageInfo { hasNextPage endCursor }
            nodes { path additions deletions }
          }
        }
      }
    }'

    if ! run_report_command gh api graphql --paginate \
            -F owner="$owner" -F name="$repo_name" -F prNumber="$pr_number" \
            -F pageSize="$PR_CONNECTION_PAGE_SIZE" -f query="$query" \
            > "$pages_file" 2>/dev/null || \
       [ ! -s "$pages_file" ] || ! jq -s -e \
            --arg expected_head "$expected_head" --arg expected_base "$expected_base" '
        def pr: .data.repository.pullRequest;
        def connection: pr.files;
        . as $pages
        | [$pages[] | connection.nodes[]] as $nodes
        | ($pages[0] | connection.totalCount) as $total
        | (($pages | length) > 0 and
           all($pages[];
             (((.errors // []) | length) == 0) and
             (pr.headRefOid == $expected_head) and
             (pr.baseRefOid == $expected_base) and
             ((connection.nodes | type) == "array") and
             ((connection.totalCount | type) == "number") and
             (connection.totalCount >= 0) and
             (connection.totalCount == (connection.totalCount | floor)) and
             ((connection.pageInfo.hasNextPage | type) == "boolean") and
             (connection.pageInfo.endCursor == null or
              (connection.pageInfo.endCursor | type) == "string")) and
           all($pages[]; (. | connection.totalCount) == $total) and
           ($pages | to_entries | all(
             . as $entry | ($entry.value | connection) as $connection
             | if $entry.key < (($pages | length) - 1)
               then ($connection.pageInfo.hasNextPage == true and
                     ($connection.pageInfo.endCursor | type) == "string" and
                     ($connection.pageInfo.endCursor | length) > 0)
               else $connection.pageInfo.hasNextPage == false end)) and
           (($nodes | length) == $total) and
           all($nodes[];
             (.path | type) == "string" and (.path | length) > 0 and
             ((.path | startswith("/")) | not) and
             ((.path | split("/") | index("..")) == null) and
             (.additions | type) == "number" and
             (.deletions | type) == "number") and
           (([$nodes[].path] | unique | length) == ($nodes | length))) as $valid
        | if $valid then
            $nodes | map({path, additions, deletions})
          else error("incomplete changed-file connection") end
    ' "$pages_file" > "$normalized_file" 2>/dev/null; then
        rm -f "$pages_file" "$normalized_file" "$output_file"
        return 1
    fi
    mv "$normalized_file" "$output_file" || {
        rm -f "$pages_file" "$normalized_file" "$output_file"
        return 1
    }
    rm -f "$pages_file"
}

fetch_pr_commits() {
    local owner="$1" repo_name="$2" pr_number="$3"
    local expected_head="$4" expected_base="$5" output_file="$6"
    local pages_file="${output_file}.pages" normalized_file="${output_file}.normalized"
    local query='
    query($owner: String!, $name: String!, $prNumber: Int!, $pageSize: Int!, $endCursor: String) {
      repository(owner: $owner, name: $name) {
        pullRequest(number: $prNumber) {
          headRefOid
          baseRefOid
          commits(first: $pageSize, after: $endCursor) {
            totalCount
            pageInfo { hasNextPage endCursor }
            nodes { commit { oid messageHeadline messageBody } }
          }
        }
      }
    }'

    if ! run_report_command gh api graphql --paginate \
            -F owner="$owner" -F name="$repo_name" -F prNumber="$pr_number" \
            -F pageSize="$PR_CONNECTION_PAGE_SIZE" -f query="$query" \
            > "$pages_file" 2>/dev/null || \
       [ ! -s "$pages_file" ] || ! jq -s -e \
            --arg expected_head "$expected_head" --arg expected_base "$expected_base" '
        def pr: .data.repository.pullRequest;
        def connection: pr.commits;
        . as $pages
        | [$pages[] | connection.nodes[]] as $nodes
        | ($pages[0] | connection.totalCount) as $total
        | (($pages | length) > 0 and
           all($pages[];
             (((.errors // []) | length) == 0) and
             (pr.headRefOid == $expected_head) and
             (pr.baseRefOid == $expected_base) and
             ((connection.nodes | type) == "array") and
             ((connection.totalCount | type) == "number") and
             (connection.totalCount >= 0) and
             (connection.totalCount == (connection.totalCount | floor)) and
             ((connection.pageInfo.hasNextPage | type) == "boolean") and
             (connection.pageInfo.endCursor == null or
              (connection.pageInfo.endCursor | type) == "string")) and
           all($pages[]; (. | connection.totalCount) == $total) and
           ($pages | to_entries | all(
             . as $entry | ($entry.value | connection) as $connection
             | if $entry.key < (($pages | length) - 1)
               then ($connection.pageInfo.hasNextPage == true and
                     ($connection.pageInfo.endCursor | type) == "string" and
                     ($connection.pageInfo.endCursor | length) > 0)
               else $connection.pageInfo.hasNextPage == false end)) and
           (($nodes | length) == $total) and
           all($nodes[];
             (.commit.oid | type) == "string" and
             (.commit.oid | length) > 0 and
             (.commit.messageHeadline | type) == "string" and
             (.commit.messageBody | type) == "string") and
           (([$nodes[].commit.oid] | unique | length) == ($nodes | length))) as $valid
        | if $valid then
            $nodes | map(.commit | {oid, messageHeadline, messageBody})
          else error("incomplete commit connection") end
    ' "$pages_file" > "$normalized_file" 2>/dev/null; then
        rm -f "$pages_file" "$normalized_file" "$output_file"
        return 1
    fi
    mv "$normalized_file" "$output_file" || {
        rm -f "$pages_file" "$normalized_file" "$output_file"
        return 1
    }
    rm -f "$pages_file"
}

PR_SUMMARY_CONNECTION_TEMP_DIR=""
cleanup_pr_summary_connection_temps() {
    local temp_dir="$PR_SUMMARY_CONNECTION_TEMP_DIR" cleanup_failed=false
    case "$temp_dir" in
        */.pr-summary-connections.??????)
            if [ -d "$temp_dir" ] && [ ! -L "$temp_dir" ]; then
                rm -f "$temp_dir/files.json" "$temp_dir/files.json.pages" \
                    "$temp_dir/files.json.normalized" "$temp_dir/commits.json" \
                    "$temp_dir/commits.json.pages" "$temp_dir/commits.json.normalized" \
                    "$temp_dir/pr-summary.json" || cleanup_failed=true
                rmdir "$temp_dir" 2>/dev/null || cleanup_failed=true
            fi
            ;;
    esac
    if [ "$cleanup_failed" = false ]; then
        PR_SUMMARY_CONNECTION_TEMP_DIR=""
        return 0
    fi
    return 1
}

complete_pr_summary_connections() {
    local repository="$1" pr_number="$2" summary_file="$3"
    local owner="${repository%%/*}" repo_name="${repository#*/}"
    local changed_total files_count commits_count summary_mode replacement_file
    local expected_head expected_base summary_dir
    [ -f "$summary_file" ] && [ ! -L "$summary_file" ] || return 1
    [ -n "$owner" ] && [ -n "$repo_name" ] && \
        [ "${repo_name#*/}" = "$repo_name" ] || return 1
    jq -e '
        (.changedFiles | type) == "number" and .changedFiles >= 0 and
        .changedFiles == (.changedFiles | floor) and
        (.files | type) == "array" and
        (.commits | type) == "array" and
        all(.files[]; (.path | type) == "string" and (.path | length) > 0) and
        all(.commits[];
          (.oid | type) == "string" and
          (.messageHeadline | type) == "string" and
          (.messageBody | type) == "string")
    ' "$summary_file" > /dev/null 2>&1 || return 1
    changed_total="$(jq -r '.changedFiles' "$summary_file")"
    files_count="$(jq -r '.files | length' "$summary_file")"
    commits_count="$(jq -r '.commits | length' "$summary_file")"
    if [ "$files_count" -eq "$changed_total" ] && \
       [ "$commits_count" -lt "$PR_CONNECTION_PAGE_SIZE" ]; then
        return 0
    fi
    jq -e '
        (.headRefOid | type) == "string" and (.headRefOid | length) > 0 and
        (.baseRefOid | type) == "string" and (.baseRefOid | length) > 0
    ' "$summary_file" > /dev/null 2>&1 || return 1
    expected_head="$(jq -r '.headRefOid' "$summary_file")"
    expected_base="$(jq -r '.baseRefOid' "$summary_file")"

    summary_dir="$(dirname "$summary_file")"
    PR_SUMMARY_CONNECTION_TEMP_DIR="$(mktemp -d \
        "$summary_dir/.pr-summary-connections.XXXXXX")" || return 1
    chmod 700 "$PR_SUMMARY_CONNECTION_TEMP_DIR" || {
        cleanup_pr_summary_connection_temps
        return 1
    }
    jq '.files' "$summary_file" > "$PR_SUMMARY_CONNECTION_TEMP_DIR/files.json" || {
        cleanup_pr_summary_connection_temps
        return 1
    }
    jq '.commits' "$summary_file" > "$PR_SUMMARY_CONNECTION_TEMP_DIR/commits.json" || {
        cleanup_pr_summary_connection_temps
        return 1
    }
    if [ "$files_count" -ne "$changed_total" ] && \
       ! fetch_pr_files "$owner" "$repo_name" "$pr_number" \
            "$expected_head" "$expected_base" \
            "$PR_SUMMARY_CONNECTION_TEMP_DIR/files.json"; then
        cleanup_pr_summary_connection_temps
        return 1
    fi
    if [ "$commits_count" -ge "$PR_CONNECTION_PAGE_SIZE" ] && \
       ! fetch_pr_commits "$owner" "$repo_name" "$pr_number" \
            "$expected_head" "$expected_base" \
            "$PR_SUMMARY_CONNECTION_TEMP_DIR/commits.json"; then
        cleanup_pr_summary_connection_temps
        return 1
    fi
    replacement_file="$PR_SUMMARY_CONNECTION_TEMP_DIR/pr-summary.json"
    if ! jq --slurpfile files "$PR_SUMMARY_CONNECTION_TEMP_DIR/files.json" \
            --slurpfile commits "$PR_SUMMARY_CONNECTION_TEMP_DIR/commits.json" \
            '.files = $files[0] | .commits = $commits[0]' \
            "$summary_file" > "$replacement_file" || \
       ! jq -e --arg expected_head "$expected_head" \
            --arg expected_base "$expected_base" '
            .headRefOid == $expected_head and
            .baseRefOid == $expected_base and
            (.files | length) == .changedFiles and
            ([.files[].path] | unique | length) == (.files | length) and
            ([.commits[].oid] | unique | length) == (.commits | length)
       ' "$replacement_file" > /dev/null 2>&1; then
        cleanup_pr_summary_connection_temps
        return 1
    fi
    summary_mode="$(workspace_file_mode "$summary_file")" || {
        cleanup_pr_summary_connection_temps
        return 1
    }
    chmod "$summary_mode" "$replacement_file" && \
        mv "$replacement_file" "$summary_file" || {
        cleanup_pr_summary_connection_temps
        return 1
    }
    cleanup_pr_summary_connection_temps || return 1
}

extract_unresolved_threads() {
    local threads_file="$1"
    local output_file="$2"

    # is_outdated matters: an outdated thread points at code that has since
    # changed, so the issue may already be fixed. Dropping the flag turns those
    # threads into phantom tasks.
    jq '[.data.repository.pullRequest.reviewThreads.nodes[]
        | select(.isResolved == false)
        | {
            thread_id: .id,
            is_outdated: (.isOutdated // false),
            path: (.path // null),
            line: (.line // .originalLine // null),
            comments: [.comments.nodes[] | {
                author: (.author.login // "unknown"),
                body: .body,
                url: .url
            }],
            comments_complete: ((.comments.pageInfo.hasNextPage // false) == false),
            comment_identity: [.comments.nodes[] | {
                id: (.id // null),
                database_id: (.databaseId // null),
                author: (.author.login // "unknown"),
                created_at: (.createdAt // null),
                last_edited_at: (.lastEditedAt // null),
                url: (.url // null)
            }]
        }]' "$threads_file" > "$output_file"
}

# Bots repost their whole report on every push. Keeping all revisions burns the
# context budget and double-counts the same finding. Keep the newest revision of
# each bot report; never touch human comments, where repetition is signal.
dedupe_bot_comments() {
    local input_file="$1"
    local output_file="$2"

    jq '
    def is_bot: (.user // "") | test("\\[bot\\]$") or (ascii_downcase | IN("github-actions", "greptile", "codecov", "sonarcloud", "coderabbitai", "dependabot", "renovate"));

    # Report identity: the bot plus the opening of its body, with digits removed
    # so successive revisions of one report ("72% covered" then "84% covered")
    # collapse while distinct reports stay apart.
    #
    # The first line alone is not enough to identify a report: bots routinely
    # prefix every comment with the same HTML marker or status heading, so
    # "### Job failed / unit-tests" and "### Job failed / e2e" would collapse and
    # a real finding would be dropped as a duplicate. HTML comments are stripped
    # and several lines are considered so unrelated reports diverge early.
    def signature: ((.user // "") + "::" +
        (((.body // "")
          | gsub("<!--(?:[\\s\\S]*?)-->"; "")
          | split("\n")
          | map(select(test("\\S")))
          | .[0:4]
          | join(" "))
         | ascii_downcase | gsub("[0-9]"; "") | gsub("[^a-z ]"; "") | .[0:200]));

    (map(select(is_bot | not))) as $humans
    | (map(select(is_bot))) as $bots
    | ($bots | group_by(signature) | map(sort_by(.created_at // "")) ) as $grouped
    | {
        kept: (($humans + ($grouped | map(.[-1]))) | sort_by(.created_at // "")),
        superseded: ($grouped | map(.[0:-1]) | add // [])
      }
    ' "$input_file" > "$output_file"
}

# Fetch the PR diff and create both raw and structured versions
# Args:
#   $1 - output_dir: Directory to save diff files
#   $2 - pr_num: PR number to fetch diff for
# Creates:
#   pr-diff.txt - Raw unified diff
#   pr-diff.json - Structured diff with file-level separation
fetch_pr_diff() {
    local output_dir="$1"
    local pr_num="$2"
    local diff_paths_file diff_paths_json diff_input_path diff_parser_root

    # Fetch the unified diff for the PR
    local diff_status="completed" diff_reason=""
    if ! run_report_command gh pr diff "$pr_num" \
            > "$output_dir/pr-diff.txt" 2>/dev/null; then
        echo "⚠️  Could not fetch PR diff (binary files only, empty PR, or access denied)"
        echo "   Analysis will proceed without code context."
        echo "" > "$output_dir/pr-diff.txt"
        diff_status="failed"
        diff_reason="GitHub diff fetch failed or returned no readable diff"
    elif [ ! -s "$output_dir/pr-diff.txt" ]; then
        diff_status="failed"
        diff_reason="GitHub diff fetch succeeded but returned no diff content"
    fi

    diff_paths_file="$(mktemp "${TMPDIR:-/tmp}/gh-pr-enrich-diff-paths.XXXXXX")" || \
        return 1
    diff_paths_json="$(mktemp "${TMPDIR:-/tmp}/gh-pr-enrich-diff-paths-json.XXXXXX")" || {
        rm -f "$diff_paths_file"
        return 1
    }
    diff_input_path="$(canonicalize_path "$output_dir/pr-diff.txt")" || {
        rm -f "$diff_paths_file" "$diff_paths_json"
        return 1
    }
    diff_parser_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"
    if [ "$diff_status" = "completed" ] && \
       git -C "$diff_parser_root" apply --numstat -z "$diff_input_path" \
            > "$diff_paths_file" 2>/dev/null && \
       jq -Rn --rawfile records "$diff_paths_file" '
            $records | split("\u0000") | .[:-1] | map(
                split("\t") | if length >= 3 then .[2:] | join("\t")
                else error("invalid numstat record") end)
       ' > "$diff_paths_json" 2>/dev/null; then
        :
    else
        echo '[]' > "$diff_paths_json"
        if [ "$diff_status" = "completed" ]; then
            diff_status="failed"
            diff_reason="Fetched diff paths could not be decoded safely"
        fi
    fi

    # Also create a structured version with file-level diffs. Git itself
    # decodes quoted, escaped, and non-ASCII path headers via --numstat; never
    # infer a path by whitespace-splitting the human-readable header.
    # Truncate large diffs to avoid token limits in Claude API
    # 5000 chars per file balances context richness with API constraints
    if ! jq -n --arg diff "$(<"$output_dir/pr-diff.txt")" \
        --slurpfile paths "$diff_paths_json" '{
            raw_diff: $diff,
            file_diffs: (("\n" + $diff) | split("\ndiff --git ") | .[1:]
              | to_entries | map(
                .key as $index | .value as $chunk |
                {
                    file: ($paths[0][$index] // null),
                    content: ("diff --git " + $chunk)
                }
            ))
        }' > "$output_dir/pr-diff.json" 2>/dev/null; then
        echo '{"raw_diff": "", "file_diffs": []}' > "$output_dir/pr-diff.json"
        diff_status="failed"
        diff_reason="Fetched diff could not be normalized"
    fi
    rm -f "$diff_paths_file" "$diff_paths_json"
    local expected_files parsed_files path_sets_match
    expected_files="$(jq -r '.changedFiles // ((.files // []) | length)' \
        "$output_dir/pr-summary.json" 2>/dev/null || echo 0)"
    parsed_files="$(jq -r '(.file_diffs // []) | length' \
        "$output_dir/pr-diff.json" 2>/dev/null || echo 0)"
    path_sets_match="$(jq -n -r \
        --slurpfile summary "$output_dir/pr-summary.json" \
        --slurpfile diff "$output_dir/pr-diff.json" '
        (($summary[0].files // []) | map(.path) | sort) ==
        (($diff[0].file_diffs // []) | map(.file) | sort)
    ' 2>/dev/null || echo false)"
    if [ "$diff_status" = "completed" ] && [ "${expected_files:-0}" -gt 0 ] && \
       [ "${parsed_files:-0}" -eq 0 ]; then
        diff_status="failed"
        diff_reason="PR reports $expected_files changed file(s), but no readable file diff was normalized"
    elif [ "$diff_status" = "completed" ] && [ "${parsed_files:-0}" -ne "${expected_files:-0}" ]; then
        diff_status="failed"
        diff_reason="Normalized file count $parsed_files does not match the PR summary count $expected_files"
    elif [ "$diff_status" = "completed" ] && [ "$path_sets_match" != true ]; then
        diff_status="failed"
        diff_reason="Normalized diff paths do not match the PR summary paths"
    fi
    write_input_status "$output_dir/diff-status.json" true "$diff_status" "$diff_reason"
}

build_analysis_context() (
    local output_dir="$1"
    local include_diff="${2:-false}"
    local repository="${4:-${REPO:-unknown}}"
    local include_sast sast_legacy_direct=false
    local context_lock_dir="" context_lock_token="" context_lock_owned=false
    local context_writer_signal=""
    local context_invalidation_rc=0
    local context_staging_dir="" context_tmp="" fingerprinted_tmp=""
    local context_publish_tmp=""
    cleanup_context_writer() {
        [ -z "$context_staging_dir" ] || \
            rm -rf "$context_staging_dir" 2>/dev/null || true
        [ -z "$context_publish_tmp" ] || \
            rm -f "$context_publish_tmp" 2>/dev/null || true
        if [ "$context_lock_owned" = true ]; then
            if ! release_selected_analysis_lock \
                    "$context_lock_dir" "$context_lock_token"; then
                echo "Error: Selected-analysis writer lock remains after context cleanup." >&2
            fi
        fi
    }
    trap cleanup_context_writer EXIT
    trap 'context_writer_signal=INT' INT
    trap 'context_writer_signal=TERM' TERM
    if [ "$#" -ge 3 ]; then
        include_sast="$3"
    elif [ -s "$output_dir/sast-findings.json" ]; then
        # Backward compatibility for direct v2.0 callers that prepared the
        # SAST file before invoking the two-argument context builder.
        include_sast=true
        sast_legacy_direct=true
    else
        include_sast=false
    fi
    local truncate_at
    if [ -n "${GH_PR_ENRICH_TRUNCATE_CHARS:-}" ]; then
        truncate_at="$(positive_integer_or_default \
            "$GH_PR_ENRICH_TRUNCATE_CHARS" "" 100000)"
        if [ -z "$truncate_at" ]; then
            echo "Error: GH_PR_ENRICH_TRUNCATE_CHARS must be an integer from 1 to 100000." >&2
            return 1
        fi
    else
        truncate_at=5000
    fi
    context_staging_dir="$(mktemp -d \
        "/tmp/gh-pr-enrich-context.XXXXXX")" || return 1
    context_tmp="$context_staging_dir/analysis-context.json"
    fingerprinted_tmp="$context_staging_dir/analysis-context.fingerprinted.json"

    # Missing optional inputs degrade to empty, never to a hard failure.
    if [ ! -f "$output_dir/issue-comments.json" ]; then
        echo '[]' > "$output_dir/issue-comments.json"
    fi
    if [ ! -f "$output_dir/unresolved-threads.json" ]; then
        echo '[]' > "$output_dir/unresolved-threads.json"
    fi
    if [ ! -f "$output_dir/review-comments.json" ]; then
        echo '[]' > "$output_dir/review-comments.json"
    fi
    if [ ! -f "$output_dir/inline-comments.json" ]; then
        echo '[]' > "$output_dir/inline-comments.json"
    fi
    if [ ! -f "$output_dir/comment-threads.json" ]; then
        echo '{"data":{"repository":{"pullRequest":{"reviewThreads":{"nodes":[],"pages_fetched":0}}}}}' \
            > "$output_dir/comment-threads.json"
    fi

    # The main CLI records each remote fetch explicitly. Direct callers from
    # older versions have no status files, so preserve compatibility without
    # claiming those inputs were requested or complete.
    local source_status
    for source_status in issue-comments review-comments inline-comments review-threads checks linked-issues; do
        if [ ! -s "$output_dir/$source_status-status.json" ] || \
           ! jq -e 'type == "object"' "$output_dir/$source_status-status.json" > /dev/null 2>&1; then
            write_input_status "$output_dir/$source_status-status.json" false "not_recorded" \
                "status unavailable from a legacy or direct context builder"
        fi
    done

    # Required inputs are validated up front. Without this, a missing or corrupt
    # file surfaces as a raw jq argument error with no indication of which file
    # was at fault.
    local required_file
    for required_file in pr-summary.json unresolved-threads.json issue-comments.json; do
        if [ ! -f "$output_dir/$required_file" ]; then
            echo "❌ Cannot build analysis context: $output_dir/$required_file is missing." >&2
            return 1
        fi
        if ! jq -e . "$output_dir/$required_file" > /dev/null 2>&1; then
            echo "❌ Cannot build analysis context: $output_dir/$required_file is not valid JSON." >&2
            return 1
        fi
    done

    dedupe_bot_comments "$output_dir/issue-comments.json" "$output_dir/issue-comments-deduped.json"

    # Optional inputs are read from disk by jq, never passed through argv: a large
    # PR diff runs to several megabytes and would fail with E2BIG ("Argument list
    # too long") on exactly the PRs that most need analysis. Absent or unreadable
    # files are replaced with an empty document so one missing input cannot take
    # the whole context down.
    local checks_source_status=""
    checks_source_status="$(jq -r '.status // ""' \
        "$output_dir/checks-status.json" 2>/dev/null || echo "")"
    if [ "$checks_source_status" = "completed" ] && \
       { [ ! -s "$output_dir/checks.json" ] || \
         ! jq -e 'type == "array"' "$output_dir/checks.json" > /dev/null 2>&1; }; then
        echo "Error: Completed GitHub checks input is missing or malformed." >&2
        return 1
    fi
    local optional
    for optional in review-comments.json inline-comments.json checks.json linked-issues.json; do
        if [ ! -s "$output_dir/$optional" ] || ! jq -e 'type == "array"' "$output_dir/$optional" > /dev/null 2>&1; then
            echo '[]' > "$output_dir/$optional"
        fi
    done
    local sast_findings_parseable=true sast_findings_error=""
    if [ ! -s "$output_dir/sast-findings.json" ]; then
        sast_findings_parseable=false
        sast_findings_error="SAST findings file is missing or empty"
    elif ! jq -e 'type == "array"' \
            "$output_dir/sast-findings.json" > /dev/null 2>&1; then
        sast_findings_parseable=false
        sast_findings_error="SAST findings file is not a valid JSON array"
    fi

    if [ "$include_diff" != true ]; then
        write_input_status "$output_dir/diff-status.json" false "not_requested" ""
    elif [ ! -s "$output_dir/diff-status.json" ] || \
         ! jq -e 'type == "object"' "$output_dir/diff-status.json" > /dev/null 2>&1; then
        if [ -s "$output_dir/pr-diff.json" ] && \
           jq -e '.file_diffs | type == "array"' "$output_dir/pr-diff.json" > /dev/null 2>&1; then
            write_input_status "$output_dir/diff-status.json" true "completed" \
                "status inferred from a prebuilt structured diff"
        else
            write_input_status "$output_dir/diff-status.json" true "failed" "diff status was not recorded"
        fi
    fi
    if [ "$include_sast" != true ]; then
        write_input_status "$output_dir/sast-status.json" false "not_requested" ""
    elif [ "$sast_findings_parseable" != true ]; then
        write_input_status "$output_dir/sast-status.json" true "failed" \
            "$sast_findings_error"
    elif [ ! -s "$output_dir/sast-status.json" ] || \
         ! jq -e 'type == "object"' "$output_dir/sast-status.json" > /dev/null 2>&1; then
        if [ "$sast_legacy_direct" = true ] && \
           [ -s "$output_dir/sast-findings.json" ] && \
           jq -e 'type == "array"' "$output_dir/sast-findings.json" > /dev/null 2>&1; then
            write_input_status "$output_dir/sast-status.json" true "completed" \
                "status inferred from prebuilt SAST findings"
        else
            write_input_status "$output_dir/sast-status.json" true "failed" "SAST status was not recorded"
        fi
    fi
    if [ "$sast_findings_parseable" != true ]; then
        # Keep jq construction safe only after coverage records that the source
        # was malformed; it must never become an inferred clean SAST result.
        echo '[]' > "$output_dir/sast-findings.json"
    fi

    local with_diff=false
    local diff_status_value
    diff_status_value="$(jq -r '.status // ""' "$output_dir/diff-status.json")"
    if [ "$include_diff" = "true" ] && \
       { [ "$diff_status_value" = "completed" ] || [ "$diff_status_value" = "partial" ]; } && \
       [ -s "$output_dir/pr-diff.json" ] \
       && jq -e '(.file_diffs? // []) | type == "array" and length > 0' "$output_dir/pr-diff.json" > /dev/null 2>&1; then
        with_diff=true
    fi
    if [ ! -s "$output_dir/pr-diff.json" ] || ! jq -e . "$output_dir/pr-diff.json" > /dev/null 2>&1; then
        echo '{"raw_diff": "", "file_diffs": []}' > "$output_dir/pr-diff.json"
    fi

    # Whether reading the working tree is meaningful depends on the revision it
    # holds, so the decision is made here and recorded in the context the
    # analyzer receives.
    local pr_head_sha
    pr_head_sha="$(jq -r '.headRefOid // ""' "$output_dir/pr-summary.json" 2>/dev/null || echo "")"
    local local_head=""
    if command -v git > /dev/null 2>&1; then
        local_head="$(git rev-parse HEAD 2>/dev/null || echo "")"
    fi
    local access_line access_state access_reason snapshot_source
    access_line="$(resolve_code_access "$pr_head_sha" "$output_dir")"
    access_state="${access_line%%:*}"
    access_reason="${access_line#*: }"
    if [ "${GH_PR_ENRICH_CODE_ACCESS:-}" = true ]; then
        snapshot_source="working_tree"
    else
        snapshot_source="git_index"
    fi
    local workspace_fingerprint="" workspace_fingerprint_check=""
    if [ "$access_state" = "enabled" ]; then
        workspace_fingerprint="$(code_access_workspace_fingerprint \
            "$output_dir" "" "$snapshot_source" 2>/dev/null || echo "")"
        workspace_fingerprint_check="$(code_access_workspace_fingerprint \
            "$output_dir" "" "$snapshot_source" 2>/dev/null || echo "")"
        if [ -z "$workspace_fingerprint" ]; then
            access_state="disabled"
            access_reason="workspace state could not be fingerprinted, so repository access cannot be revalidated"
        elif [ "$workspace_fingerprint" != "$workspace_fingerprint_check" ]; then
            access_state="disabled"
            access_reason="workspace changed while the analysis context was being built"
            workspace_fingerprint=""
        fi
    fi

    # Current CLI runs may use deterministic SAST findings only when their
    # immutable-snapshot provenance is bound to this exact context workspace.
    # The two-argument v2.0 entry point intentionally retains its historical
    # prebuilt-findings behavior because those callers have no status artifact.
    local with_sast=false sast_status_value="" sast_status_source=""
    local sast_status_reason=""
    local sast_status_fingerprint=""
    if [ "$include_sast" = true ]; then
        sast_status_value="$(jq -r '.status // ""' \
            "$output_dir/sast-status.json" 2>/dev/null || echo "")"
        sast_status_reason="$(jq -r '.reason // ""' \
            "$output_dir/sast-status.json" 2>/dev/null || echo "")"
        if [ "$sast_legacy_direct" = true ] && \
           [ "$sast_status_value" = "completed" ]; then
            with_sast=true
        else
            sast_status_source="$(jq -r '.workspace_source // ""' \
                "$output_dir/sast-status.json" 2>/dev/null || echo "")"
            sast_status_fingerprint="$(jq -r '.workspace_fingerprint // ""' \
                "$output_dir/sast-status.json" 2>/dev/null || echo "")"
            if [ "$sast_status_value" != "completed" ] && \
               [ "$sast_status_value" != "completed_with_errors" ]; then
                write_input_status "$output_dir/sast-status.json" true "failed" \
                    "SAST scan status '$sast_status_value' is not completed: ${sast_status_reason:-no reason recorded}"
            elif [ "$sast_status_source" != "immutable_snapshot" ] || \
                 [ -z "$sast_status_fingerprint" ]; then
                write_input_status "$output_dir/sast-status.json" true "failed" \
                    "SAST findings do not record immutable workspace snapshot provenance"
            elif [ "$access_state" != "enabled" ] || [ -z "$workspace_fingerprint" ]; then
                write_input_status "$output_dir/sast-status.json" true "failed" \
                    "SAST snapshot provenance cannot be matched to the current analysis workspace"
            elif [ "$sast_status_fingerprint" != "$workspace_fingerprint" ]; then
                write_input_status "$output_dir/sast-status.json" true "failed" \
                    "SAST workspace fingerprint does not match the analysis context workspace fingerprint"
            else
                with_sast=true
            fi
        fi
    fi

    local discussion_fingerprint="" checks_fingerprint=""
    if jq -e -n \
        --slurpfile issue_status "$output_dir/issue-comments-status.json" \
        --slurpfile review_status "$output_dir/review-comments-status.json" \
        --slurpfile inline_status "$output_dir/inline-comments-status.json" \
        --slurpfile threads_status "$output_dir/review-threads-status.json" '
        [$issue_status[0], $review_status[0], $inline_status[0], $threads_status[0]]
        | all(.[]; .requested == true and .status == "completed")
    ' > /dev/null 2>&1; then
        discussion_fingerprint="$(analysis_discussion_fingerprint_from_files \
            "$output_dir" 2>/dev/null || echo "")"
        if [ -z "$discussion_fingerprint" ]; then
            echo "Error: Complete GitHub discussion inputs could not be fingerprinted." >&2
            return 1
        fi
    fi
    if [ "$checks_source_status" = "completed" ]; then
        checks_fingerprint="$(analysis_checks_fingerprint_from_file \
            "$output_dir/checks.json" 2>/dev/null || echo "")"
        if [ -z "$checks_fingerprint" ]; then
            echo "Error: Complete GitHub checks input could not be fingerprinted." >&2
            return 1
        fi
    fi

    # One jq program builds the whole context. The coverage block records what was
    # dropped or shortened, so a truncated input can never read as a complete one.
    jq -n \
        --slurpfile pr_doc "$output_dir/pr-summary.json" \
        --slurpfile threads "$output_dir/unresolved-threads.json" \
        --slurpfile raw_comments "$output_dir/issue-comments.json" \
        --slurpfile review_comments_doc "$output_dir/review-comments.json" \
        --slurpfile inline_comments_doc "$output_dir/inline-comments.json" \
        --slurpfile deduped "$output_dir/issue-comments-deduped.json" \
        --slurpfile checks_doc "$output_dir/checks.json" \
        --slurpfile linked_doc "$output_dir/linked-issues.json" \
        --slurpfile sast_doc "$output_dir/sast-findings.json" \
        --slurpfile diff_doc "$output_dir/pr-diff.json" \
        --slurpfile diff_status_doc "$output_dir/diff-status.json" \
        --slurpfile sast_status_doc "$output_dir/sast-status.json" \
        --slurpfile issue_comments_status_doc "$output_dir/issue-comments-status.json" \
        --slurpfile review_comments_status_doc "$output_dir/review-comments-status.json" \
        --slurpfile inline_comments_status_doc "$output_dir/inline-comments-status.json" \
        --slurpfile review_threads_status_doc "$output_dir/review-threads-status.json" \
        --slurpfile checks_status_doc "$output_dir/checks-status.json" \
        --slurpfile linked_issues_status_doc "$output_dir/linked-issues-status.json" \
        --argjson with_diff "$with_diff" \
        --argjson with_sast "$with_sast" \
        --argjson limit "$truncate_at" \
        --arg pr_head_sha "$pr_head_sha" \
        --arg local_head "$local_head" \
        --arg access_state "$access_state" \
        --arg access_reason "$access_reason" \
        --arg snapshot_source "$snapshot_source" \
        --arg workspace_fingerprint "$workspace_fingerprint" \
        --arg discussion_fingerprint "$discussion_fingerprint" \
        --arg checks_fingerprint "$checks_fingerprint" \
        --arg repository "$repository" \
        --argjson thread_comment_limit "$THREAD_COMMENT_LIMIT" \
        '
        def trunc($text): if (($text // "") | length) > $limit
            then (($text // "")[0:$limit] + "\n... (truncated)")
            else ($text // "") end;
        def was_truncated($text): (($text // "") | length) > $limit;

        ($pr_doc[0] // {}) as $pr
        | ($checks_doc[0] // []) as $checks
        | ($linked_doc[0] // []) as $linked
        | (if $with_sast then ($sast_doc[0] // []) else [] end) as $sast
        | ($diff_doc[0] // {}) as $diff
        | ($diff_status_doc[0] // {requested:false,status:"not_requested",reason:""}) as $diff_status
        | ($sast_status_doc[0] // {requested:false,status:"not_requested",reason:""}) as $sast_status
        | ($threads[0] // []) as $thread_list
        | ($raw_comments[0] // []) as $raw
        | ($review_comments_doc[0] // []) as $review_comments
        | ($inline_comments_doc[0] // []) as $inline_comments
        | (($deduped[0] // {}) | (.kept // [])) as $kept
        | (($deduped[0] // {}) | (.superseded // [])) as $superseded
        | ($diff.file_diffs // []) as $files
        | {
            pr: {
                repository: $repository,
                number: ($pr.number // null),
                title: $pr.title,
                body: trunc($pr.body // "No description"),
                author: ($pr.author.login // "unknown"),
                files_changed: [($pr.files // [])[].path],
                commits: [($pr.commits // [])[] | {
                    sha: ((.oid // "") | .[0:7]),
                    message: ((.messageHeadline // "") +
                        (if ((.messageBody // "") | length) > 0
                         then "\n" + trunc(.messageBody) else "" end))
                }],
                linked_issues: [($linked // [])[] | {
                    id: .id,
                    number: .number,
                    title: .title,
                    url: .url,
                    body: trunc(.body),
                    repository: {
                        name_with_owner: (.repository.nameWithOwner // ""),
                        visibility: ((.repository.visibility // "UNKNOWN") | ascii_upcase)
                    }
                }]
            },
            unresolved_threads: [$thread_list[]
                | .comments = [(.comments // [])[] | .body = trunc(.body)]],
            issue_comments: [$kept[] | {
                user: .user,
                body: trunc(.body),
                url: .html_url,
                created_at: .created_at
            }],
            review_comments: [$review_comments[] | {
                user: .user,
                body: trunc(.body),
                state: (.state // ""),
                url: (.html_url // ""),
                submitted_at: (.submitted_at // "")
            }],
            inline_comments: [$inline_comments[] | {
                user: .user,
                body: trunc(.body),
                path: (.path // null),
                line: (.line // null),
                url: (.html_url // ""),
                created_at: (.created_at // "")
            }],
            failing_checks: [($checks // [])[] | select(.bucket == "fail") | {
                name: .name,
                state: .state,
                description: (.description // ""),
                link: (.link // "")
            }],
            sast_findings: $sast,
            coverage: {
                truncation_limit_chars: $limit,
                code_access: {
                    state: $access_state,
                    reason: $access_reason,
                    pr_head_sha: (if $pr_head_sha == "" then null else $pr_head_sha end),
                    inspected_sha: (if $local_head == "" then null else $local_head end),
                    revision_matches: ($pr_head_sha != "" and $pr_head_sha == $local_head),
                    snapshot_source: (if $access_state == "enabled"
                        then $snapshot_source else null end),
                    workspace_fingerprint: (if $workspace_fingerprint == ""
                        then null else $workspace_fingerprint end)
                },
                discussion: {
                    fingerprint: (if $discussion_fingerprint == ""
                        then null else $discussion_fingerprint end)
                },
                checks: {
                    fingerprint: (if $checks_fingerprint == ""
                        then null else $checks_fingerprint end)
                },
                issue_comments: {
                    total: ($raw | length),
                    included: ($kept | length),
                    superseded_bot_duplicates: ($superseded | length),
                    truncated: [$kept[] | select(was_truncated(.body)) | .html_url]
                },
                review_comments: {
                    total: ($review_comments | length),
                    truncated: [$review_comments[] | select(was_truncated(.body)) | .html_url]
                },
                inline_comments: {
                    total: ($inline_comments | length),
                    truncated: [$inline_comments[] | select(was_truncated(.body)) | .html_url]
                },
                unresolved_threads: {
                    total: ($thread_list | length),
                    included: ($thread_list | length),
                    outdated: ([$thread_list[] | select(.is_outdated == true)] | length),
                    truncated: [$thread_list[] | (.comments // [])[]
                        | select(was_truncated(.body)) | .url],
                    incomplete_comment_threads: [$thread_list[]
                        | select((.comments_complete == false) or
                            ((has("comments_complete") | not) and
                             ((.comments // []) | length) >= $thread_comment_limit))
                        | .thread_id],
                    comments_per_thread_limit: $thread_comment_limit,
                    threads_at_comment_limit: ([$thread_list[]
                        | select((.comments // []) | length >= $thread_comment_limit)] | length)
                },
                diff: {
                    requested: ($diff_status.requested // false),
                    status: ($diff_status.status // "unknown"),
                    reason: ($diff_status.reason // ""),
                    included: $with_diff,
                    files_total: ($pr.changedFiles // (($pr.files // []) | length)),
                    files_included: (if $with_diff then ($files | length) else 0 end),
                    files_truncated: (if $with_diff
                        then [$files[] | select(was_truncated(.content)) | .file]
                        else [] end)
                },
                sast: {
                    requested: ($sast_status.requested // false),
                    status: ($sast_status.status // "unknown"),
                    reason: ($sast_status.reason // ""),
                    findings: (($sast // []) | length)
                },
                commits: {
                    total: (($pr.commits // []) | length),
                    truncated: [($pr.commits // [])[]
                        | select(was_truncated(.messageBody))
                        | ((.oid // "") | .[0:7])]
                },
                linked_issues: {
                    total: (($linked // []) | length),
                    truncated: [($linked // [])[]
                        | select(was_truncated(.body)) | (.url // (.number | tostring))]
                },
                pr_description: {
                    truncated: (if was_truncated($pr.body // "")
                        then ["PR description"] else [] end)
                },
                sources: {
                    issue_comments: ($issue_comments_status_doc[0] // {}),
                    review_comments: ($review_comments_status_doc[0] // {}),
                    inline_comments: ($inline_comments_status_doc[0] // {}),
                    review_threads: ($review_threads_status_doc[0] // {}),
                    checks: ($checks_status_doc[0] // {}),
                    linked_issues: ($linked_issues_status_doc[0] // {})
                },
                inputs: {
                    commits: (($pr.commits // []) | length),
                    linked_issues: (($linked // []) | length),
                    failing_checks: ([($checks // [])[] | select(.bucket == "fail")] | length),
                    sast_findings: (($sast // []) | length)
                }
            }
          }
        + (if $with_diff then {
            code_changes: {
                summary: "Diff included for context. Each file_diff contains the actual code changes.",
                file_diffs: [$files[] | {file: .file, diff: trunc(.content)}]
            }
          } else {} end)
        ' > "$context_tmp"
    local context_fingerprint
    context_fingerprint="$(analysis_context_fingerprint "$context_tmp")"
    jq --arg fingerprint "$context_fingerprint" \
        '.coverage.context_fingerprint = $fingerprint' \
        "$context_tmp" > "$fingerprinted_tmp"
    acquire_selected_analysis_lock "$output_dir" || return 1
    context_lock_dir="$SELECTED_ANALYSIS_LOCK_DIR"
    context_lock_token="$SELECTED_ANALYSIS_LOCK_TOKEN"
    context_lock_owned="$SELECTED_ANALYSIS_LOCK_OWNED"
    if [ -n "$context_writer_signal" ]; then
        echo "Error: Analysis-context publication was cancelled before commit." >&2
        case "$context_writer_signal" in
            INT) return 130 ;;
            TERM) return 143 ;;
        esac
    fi
    # A context refresh changes immutable provenance. Remove every selected
    # view under the same lock before making the new context visible.
    invalidate_selected_analysis "$output_dir" || context_invalidation_rc=$?
    [ "$context_invalidation_rc" -eq 0 ] || return "$context_invalidation_rc"
    context_publish_tmp="$(mktemp \
        "$output_dir/.analysis-context-publish.XXXXXX")" || return 1
    cp "$fingerprinted_tmp" "$context_publish_tmp" || return 1
    mv "$context_publish_tmp" "$output_dir/analysis-context.json" || return 1
    context_publish_tmp=""

    # Backward compatibility for consumers that predate the provider-neutral
    # artifact name. Both files contain the same immutable snapshot.
    copy_compatibility_file "$output_dir/analysis-context.json" "$output_dir/claude-context.json"
    emit_analysis_schema | jq . > "$output_dir/analysis-schema.json"
    if [ "$context_lock_owned" = true ]; then
        if ! release_selected_analysis_lock \
                "$context_lock_dir" "$context_lock_token"; then
            echo "Error: Analysis context was published, but its writer lock could not be released." >&2
            return 1
        fi
        context_lock_owned=false
    fi
    case "$context_writer_signal" in
        INT) return 130 ;;
        TERM) return 143 ;;
    esac
)

# Closed taxonomy for findings. Kept in sync with default-prompt.txt by
# tests/test-analysis-contract.sh -- the analyzer must return an explicit verdict
# for every category, so "no finding" is a decision on record rather than a gap.
ANALYSIS_CATEGORIES='["logic_error", "boundary_condition", "concurrency", "error_handling", "resource_lifecycle", "security", "secrets_exposure", "data_integrity", "api_contract", "performance", "test_gap", "observability", "maintainability", "documentation", "build_ci", "dependency_risk"]'

ANALYSIS_SCHEMA='{
  "type": "object",
  "properties": {
    "issue_categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "category": { "enum": '"$ANALYSIS_CATEGORIES"' },
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "impact": { "enum": ["severe", "moderate", "minor"] },
          "likelihood": { "enum": ["certain", "likely", "possible", "unlikely"] },
          "severity_rationale": { "type": "string" },
          "verdict": { "enum": ["confirmed", "plausible", "refuted"] },
          "confidence": { "enum": ["high", "medium", "low"] },
          "description": { "type": "string" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "file": { "type": "string" },
                "line": { "type": "integer" },
                "detail": { "type": "string" }
              },
              "required": ["file", "line", "detail"]
            }
          },
          "thread_ids": { "type": "array", "items": { "type": "string" } },
          "sources": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["finding_id", "name", "category", "severity", "impact", "likelihood", "severity_rationale", "verdict", "confidence", "description", "evidence", "thread_ids"]
      }
    },
    "category_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": { "enum": '"$ANALYSIS_CATEGORIES"' },
          "verdict": { "enum": ["findings_reported", "reviewed_none_found", "not_applicable", "not_reviewable"] },
          "note": { "type": "string" }
        },
        "required": ["category", "verdict", "note"]
      }
    },
    "disputed_comments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "thread_id": { "type": "string", "minLength": 1, "description": "Exact captured PRRT thread ID or non-thread comment URL" },
          "claim": { "type": "string" },
          "why_incorrect": { "type": "string" },
          "confidence": { "enum": ["high", "medium", "low"] }
        },
        "required": ["thread_id", "claim", "why_incorrect", "confidence"]
      }
    },
    "systemic_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pattern": { "type": "string" },
          "finding_ids": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
