fi

# Fetch the issues this PR closes, for intent the diff cannot show
if fetch_linked_issues "$OWNER" "$REPO_NAME" "$PR_NUMBER" "$OUTPUT_DIR/linked-issues.json"; then
    write_input_status "$OUTPUT_DIR/linked-issues-status.json" true "completed" ""
else
    echo "Note: Could not fetch linked issues; analysis input coverage will remain incomplete."
    write_input_status "$OUTPUT_DIR/linked-issues-status.json" true "failed" \
        "GitHub linked-issue fetch or normalization failed"
fi

# Linked issues may belong to a different repository than the public PR. Keep
# their intent available to native/local analysis, but do not disclose content
# from PRIVATE, INTERNAL, or indeterminate source repositories to Claude unless
# the user explicitly authorized external disclosure.
if [ "$ENRICH_WITH_CLAUDE" = true ] && [ "$ALLOW_EXTERNAL" != true ]; then
    LINKED_ISSUE_RESTRICTED_VISIBILITIES=$(jq -r '
        [.[]
         | ((.repository.visibility // "UNKNOWN") | ascii_upcase)
         | select(. != "PUBLIC")]
        | unique | join(", ")
    ' "$OUTPUT_DIR/linked-issues.json" 2>/dev/null || echo "UNKNOWN")
    if [ -n "$LINKED_ISSUE_RESTRICTED_VISIBILITIES" ]; then
        echo "Error: Linked issue source visibility is $LINKED_ISSUE_RESTRICTED_VISIBILITIES; external Claude enrichment is blocked." >&2
        echo "Re-run with --allow-external only after the user explicitly authorizes disclosure." >&2
        exit 1
    fi
fi

# Process comment threads to create ID mapping
jq -r '.data.repository.pullRequest.reviewThreads.nodes[] |
    select(.comments.nodes | length > 0) |
    .comments.nodes[] |
    select(.databaseId != null) |
    "\(.databaseId):\(.id)"' "$OUTPUT_DIR/comment-threads.json" > "$OUTPUT_DIR/id-mapping.txt" 2>/dev/null || {
        echo "" > "$OUTPUT_DIR/id-mapping.txt"
    }


# ============================================================================
# Main Processing
# ============================================================================

# Add GraphQL IDs to all comment types
create_comments_with_graphql_ids "$OUTPUT_DIR/issue-comments.json" "$OUTPUT_DIR/issue-comments-with-graphql.json" "issue_comment"
create_comments_with_graphql_ids "$OUTPUT_DIR/review-comments.json" "$OUTPUT_DIR/review-comments-with-graphql.json" "review_comment"
create_comments_with_graphql_ids "$OUTPUT_DIR/inline-comments.json" "$OUTPUT_DIR/inline-comments-with-graphql.json" "inline_comment"

# Combine comments
#
# all-comments.json schema: array of objects discriminated by `.type`.
#   .type == "issue_comment"  -> {id, body, user, created_at, updated_at, type, html_url}
#   .type == "review_comment" -> {id, body, user, state, submitted_at, type, commit_id, html_url}
#   .type == "inline_comment" -> {id, body, path, position, line, user, created_at, updated_at, type, html_url}
#
# To select non-thread (top-level) PR comments, filter on .type == "issue_comment".
# There is NO .pull_request_review_id field — that exists only on raw GitHub REST
# /pulls/.../comments responses, which are stripped before being written here.
# all-comments-with-graphql.json is the same shape plus {graphql_id, comment_type} on each entry.
jq -s 'add | sort_by(.created_at // .submitted_at // "")' \
    "$OUTPUT_DIR"/issue-comments-with-graphql.json \
    "$OUTPUT_DIR"/review-comments-with-graphql.json \
    "$OUTPUT_DIR"/inline-comments-with-graphql.json \
    > "$OUTPUT_DIR/all-comments-with-graphql.json"

jq -s 'add | sort_by(.created_at // .submitted_at // "")' \
    "$OUTPUT_DIR"/issue-comments.json \
    "$OUTPUT_DIR"/review-comments.json \
    "$OUTPUT_DIR"/inline-comments.json \
    > "$OUTPUT_DIR/all-comments.json"

# 4. Fetch checks and status
echo "Fetching checks and status..."
# `gh pr checks` exits non-zero for states that still produce valid output —
# notably a non-zero exit while checks are pending or failing. Keep whatever it
# wrote if it parses; only fall back to an empty set when there is nothing usable.
# Otherwise a PR with pending or failing checks reports "no checks", exactly when
# the failing-checks input matters most.
CHECKS_FETCH_RC=0
run_report_command gh pr checks "$PR_NUMBER" \
    --json name,state,bucket,workflow,startedAt,completedAt,event,link,description \
    > "$OUTPUT_DIR/checks.json" 2>/dev/null || CHECKS_FETCH_RC=$?
case "$CHECKS_FETCH_RC" in
    0)
        if jq -e 'type == "array"' "$OUTPUT_DIR/checks.json" > /dev/null 2>&1; then
            write_input_status "$OUTPUT_DIR/checks-status.json" true "completed" ""
        else
            echo "Note: Checks response was not a JSON array; analysis input coverage will remain incomplete."
            echo '[]' > "$OUTPUT_DIR/checks.json"
            write_input_status "$OUTPUT_DIR/checks-status.json" true "failed" \
                "GitHub checks normalization failed"
        fi
        ;;
    1)
        if jq -e 'type == "array" and any(.[]; .bucket == "fail")' \
                "$OUTPUT_DIR/checks.json" > /dev/null 2>&1; then
            echo "Note: gh pr checks reported failing checks; using the complete results it returned."
            write_input_status "$OUTPUT_DIR/checks-status.json" true "completed" \
                "gh pr checks reported failing checks with complete parseable results"
        else
            echo "Note: Could not fetch a complete failing-checks result."
            echo '[]' > "$OUTPUT_DIR/checks.json"
            write_input_status "$OUTPUT_DIR/checks-status.json" true "failed" \
                "GitHub checks command failed without matching complete failing results"
        fi
        ;;
    8)
        if jq -e 'type == "array" and any(.[]; .bucket == "pending")' \
                "$OUTPUT_DIR/checks.json" > /dev/null 2>&1; then
            echo "Note: gh pr checks reported pending checks; using the complete results it returned."
            write_input_status "$OUTPUT_DIR/checks-status.json" true "completed" \
                "gh pr checks reported pending checks with complete parseable results"
        else
            echo "Note: Could not fetch a complete pending-checks result."
            echo '[]' > "$OUTPUT_DIR/checks.json"
            write_input_status "$OUTPUT_DIR/checks-status.json" true "failed" \
                "GitHub checks command returned pending status without matching complete results"
        fi
        ;;
    *)
        echo "Note: GitHub checks request failed or timed out (status $CHECKS_FETCH_RC)."
        echo '[]' > "$OUTPUT_DIR/checks.json"
        write_input_status "$OUTPUT_DIR/checks-status.json" true "failed" \
            "GitHub checks request failed or timed out with status $CHECKS_FETCH_RC"
        ;;
esac

# 5. Generate statistics
echo "Generating statistics..."

COMMENT_STATS=$(jq -n \
    --argjson comments "$(cat "$OUTPUT_DIR/all-comments.json")" \
    '{
        total: ($comments | length),
        by_type: ($comments | group_by(.type) | map({type: .[0].type, count: length})),
        by_user: ($comments | group_by(.user) | map({user: .[0].user, count: length}) | sort_by(-.count) | .[0:10]),
        recent: ($comments | sort_by(.created_at) | reverse | .[0:5])
    }')

# Compute overall state from individual checks (bucket field: pass, fail, pending, skipping, cancel)
CHECKS_STATS=$(jq -r '{
    total: length,
    passing: (map(select(.bucket == "pass")) | length),
    failing: (map(select(.bucket == "fail")) | length),
    pending: (map(select(.bucket == "pending")) | length),
    skipped: (map(select(.bucket == "skipping")) | length),
    cancelled: (map(select(.bucket == "cancel")) | length),
    overall_state: (
        if length == 0 then "no_checks"
        elif (map(select(.bucket == "fail")) | length) > 0 then "failure"
        elif (map(select(.bucket == "pending")) | length) > 0 then "pending"
        elif (map(select(.bucket == "pass" or .bucket == "skipping" or .bucket == "cancel")) | length) == length then "success"
        else "mixed"
        end
    )
}' "$OUTPUT_DIR/checks.json" 2>/dev/null || echo '{"overall_state": "unknown", "total": 0, "passing": 0, "failing": 0, "pending": 0, "skipped": 0, "cancelled": 0}')

# 6-7. Replace the base selected-analysis views as one coherent transaction.
# A refresh invalidates any prior selected result while readers are excluded;
# they can never observe a new combined view beside an old comprehensive view.
(
BASE_BACKUP_DIR=""
BASE_REPLACEMENT_DIR=""
BASE_LOCK_DIR=""
BASE_LOCK_TOKEN=""
BASE_LOCK_OWNED=false
BASE_WRITER_SIGNAL=""
BASE_PUBLICATION_RC=0
cleanup_base_report_writer() {
    [ -z "$BASE_BACKUP_DIR" ] || rm -rf "$BASE_BACKUP_DIR" 2>/dev/null || true
    [ -z "$BASE_REPLACEMENT_DIR" ] || \
        rm -rf "$BASE_REPLACEMENT_DIR" 2>/dev/null || true
    if [ "$BASE_LOCK_OWNED" = true ]; then
        if ! release_selected_analysis_lock "$BASE_LOCK_DIR" "$BASE_LOCK_TOKEN"; then
            echo "Error: Selected-analysis writer lock remains after base-report cleanup." >&2
        fi
    fi
}
trap cleanup_base_report_writer EXIT
trap 'BASE_WRITER_SIGNAL=INT' INT
trap 'BASE_WRITER_SIGNAL=TERM' TERM
acquire_selected_analysis_lock "$OUTPUT_DIR"
BASE_LOCK_DIR="$SELECTED_ANALYSIS_LOCK_DIR"
BASE_LOCK_TOKEN="$SELECTED_ANALYSIS_LOCK_TOKEN"
BASE_LOCK_OWNED="$SELECTED_ANALYSIS_LOCK_OWNED"
BASE_BACKUP_DIR="$(mktemp -d "/tmp/gh-pr-enrich-base-report.XXXXXX")"
BASE_REPLACEMENT_DIR="$(mktemp -d \
    "$OUTPUT_DIR/.selected-analysis-replacements.XXXXXX")"
chmod 700 "$BASE_REPLACEMENT_DIR"
for BASE_VIEW in analysis.json analysis.md context-coverage.md \
        combined-data.json comprehensive-report.md \
        claude-analysis.json claude-analysis.md; do
    [ ! -f "$OUTPUT_DIR/$BASE_VIEW" ] || \
        cp -p "$OUTPUT_DIR/$BASE_VIEW" "$BASE_BACKUP_DIR/$BASE_VIEW"
done

echo "Creating combined JSON..."
jq -n \
    --argjson summary "$(<"$OUTPUT_DIR/pr-summary.json")" \
    --argjson comments "$(<"$OUTPUT_DIR/all-comments-with-graphql.json")" \
    --argjson checks "$(<"$OUTPUT_DIR/checks.json")" \
    --argjson comment_stats "$COMMENT_STATS" \
    --argjson checks_stats "$CHECKS_STATS" \
    --argjson comment_threads "$(<"$OUTPUT_DIR/comment-threads.json")" \
    --arg timestamp "$TIMESTAMP" \
    --arg repo "$REPO" \
    '{
        metadata: {
            generated_at: $timestamp,
            repository: $repo,
            pr_number: ($summary.number | tonumber)
        },
        pr: $summary,
        comments: $comments,
        comment_threads: $comment_threads,
        checks: $checks,
        statistics: {
            comments: $comment_stats,
            checks: $checks_stats
        }
    }' > "$BASE_REPLACEMENT_DIR/combined-data.json"

echo "Creating Markdown report..."
cat > "$BASE_REPLACEMENT_DIR/comprehensive-report.md" << EOF
# Comprehensive PR Review Report: #$PR_NUMBER

**Repository:** $REPO
**Generated:** $TIMESTAMP
**PR URL:** $(jq -r '.url' "$OUTPUT_DIR/pr-summary.json")

## 📋 PR Summary

**Title:** $(jq -r '.title' "$OUTPUT_DIR/pr-summary.json")
**Author:** $(jq -r '.author.login' "$OUTPUT_DIR/pr-summary.json")
**State:** $(jq -r '.state' "$OUTPUT_DIR/pr-summary.json")
**Created:** $(jq -r '.createdAt' "$OUTPUT_DIR/pr-summary.json")
**Updated:** $(jq -r '.updatedAt' "$OUTPUT_DIR/pr-summary.json")
**Mergeable:** $(jq -r '.mergeable' "$OUTPUT_DIR/pr-summary.json")
**Draft:** $(jq -r '.isDraft' "$OUTPUT_DIR/pr-summary.json")

**Changes:**
- Files: $(jq -r '.changedFiles' "$OUTPUT_DIR/pr-summary.json")
- Additions: $(jq -r '.additions' "$OUTPUT_DIR/pr-summary.json")
- Deletions: $(jq -r '.deletions' "$OUTPUT_DIR/pr-summary.json")

**Labels:** $(jq -r '.labels[]?.name // empty' "$OUTPUT_DIR/pr-summary.json" | tr '\n' ', ' | sed 's/,$//')
**Assignees:** $(jq -r '.assignees[]?.login // empty' "$OUTPUT_DIR/pr-summary.json" | tr '\n' ', ' | sed 's/,$//')
**Reviewers:** $(jq -r '.requestedReviewers[]?.login // empty' "$OUTPUT_DIR/pr-summary.json" | tr '\n' ', ' | sed 's/,$//')

### Files Changed
$(jq -r '.files[] | "- **\(.path)** (+\(.additions) / -\(.deletions))"' "$OUTPUT_DIR/pr-summary.json")

## ✅ Checks & Status

**Overall State:** $(echo "$CHECKS_STATS" | jq -r '.overall_state // "unknown"')
**Total Checks:** $(echo "$CHECKS_STATS" | jq -r '.total // 0')
**Passing:** $(echo "$CHECKS_STATS" | jq -r '.passing // 0') | **Failing:** $(echo "$CHECKS_STATS" | jq -r '.failing // 0') | **Pending:** $(echo "$CHECKS_STATS" | jq -r '.pending // 0')

$(jq -r 'if length > 0 then "### Check Details\n" + (map("- **\(.name)**: \(.state) (\(.bucket))" + (if ((.workflow? | type) == "object" and (.workflow.name? != null)) then " - \(.workflow.name)" elif (.workflow? | type) == "string" then " - \(.workflow)" else "" end)) | join("\n")) else "No checks configured for this PR." end' "$OUTPUT_DIR/checks.json")

## 💬 Comments Analysis

$(echo "$COMMENT_STATS" | jq -r '
"**Total Comments:** " + ((.total // 0) | tostring) + "\n\n" +
"### By Type\n" + ((.by_type // []) | map("- **" + (.type // "unknown") + ":** " + ((.count // 0) | tostring)) | join("\n")) + "\n\n" +
"### Top Commenters\n" + ((.by_user // []) | map("- **" + (.user // "unknown") + ":** " + ((.count // 0) | tostring)) | join("\n"))
')

## 🧵 Comment Threads

To resolve a comment thread:
\`\`\`bash
gh api graphql -f query='mutation { resolveReviewThread(input: {threadId: "<THREAD_ID>"}) { thread { isResolved } } }'
\`\`\`

---

*Report generated by gh-pr-enrich v$VERSION at $TIMESTAMP*
EOF
for BASE_VIEW in combined-data.json comprehensive-report.md; do
    if [ -f "$BASE_BACKUP_DIR/$BASE_VIEW" ]; then
        BASE_MODE="$(workspace_file_mode "$BASE_BACKUP_DIR/$BASE_VIEW")"
        chmod "$BASE_MODE" "$BASE_REPLACEMENT_DIR/$BASE_VIEW"
    fi
done
if [ -n "$BASE_WRITER_SIGNAL" ]; then
    echo "Error: Base report publication was cancelled before commit." >&2
    case "$BASE_WRITER_SIGNAL" in
        INT) exit 130 ;;
        TERM) exit 143 ;;
    esac
fi
BASE_REPLACEMENT_IDENTITY="$(selected_analysis_replacement_identity \
    "$BASE_REPLACEMENT_DIR" 2>/dev/null || echo "")"
[ -n "$BASE_REPLACEMENT_IDENTITY" ] || exit 1
publish_selected_analysis_transaction \
    "$OUTPUT_DIR" "$BASE_BACKUP_DIR" "$BASE_REPLACEMENT_DIR" \
    "$BASE_REPLACEMENT_IDENTITY" || \
    BASE_PUBLICATION_RC=$?
if [ "$BASE_PUBLICATION_RC" -ne 0 ]; then
    echo "Error: Base report views could not be published safely." >&2
    exit "$BASE_PUBLICATION_RC"
fi
if [ "$BASE_LOCK_OWNED" = true ]; then
    if ! release_selected_analysis_lock "$BASE_LOCK_DIR" "$BASE_LOCK_TOKEN"; then
        echo "Error: Base report was published, but its writer lock could not be released." >&2
        exit 1
    fi
    BASE_LOCK_OWNED=false
fi
case "$BASE_WRITER_SIGNAL" in
    INT) exit 130 ;;
    TERM) exit 143 ;;
esac
)

# 8. Inspect analysis inputs, then prepare the provider-neutral snapshot only
# when explicitly requested or when external Claude has something to analyze.
# --diff and --sast imply preparation, so they remain useful without --enrich.
if [ "$REFRESH_EXISTING_ANALYSIS" = true ] || [ "$PREPARE_ANALYSIS" = true ] || [ "$INCLUDE_DIFF" = true ] || \
   [ "$RUN_SAST" = true ] || [ "$ENRICH_WITH_CLAUDE" = true ]; then
    extract_unresolved_threads "$OUTPUT_DIR/comment-threads.json" "$OUTPUT_DIR/unresolved-threads.json"
    UNRESOLVED_COUNT=$(jq 'length' "$OUTPUT_DIR/unresolved-threads.json")
    ISSUE_COMMENT_COUNT=$(jq 'length' "$OUTPUT_DIR/issue-comments.json" 2>/dev/null || echo "0")
    REVIEW_COMMENT_COUNT=$(jq 'length' "$OUTPUT_DIR/review-comments.json" 2>/dev/null || echo "0")
    INLINE_COMMENT_COUNT=$(jq 'length' "$OUTPUT_DIR/inline-comments.json" 2>/dev/null || echo "0")
fi

if [ "$REFRESH_EXISTING_ANALYSIS" = true ] || [ "$PREPARE_ANALYSIS" = true ] || [ "$INCLUDE_DIFF" = true ] || \
   [ "$RUN_SAST" = true ] || { [ "$ENRICH_WITH_CLAUDE" = true ] && \
   { [ "$UNRESOLVED_COUNT" -gt 0 ] || [ "$ISSUE_COMMENT_COUNT" -gt 0 ] || \
     [ "$REVIEW_COMMENT_COUNT" -gt 0 ] || [ "$INLINE_COMMENT_COUNT" -gt 0 ]; }; }; then
    echo "Preparing analysis context..."
    if [ "$INCLUDE_DIFF" = true ]; then
        echo "Fetching PR diff for analysis context..."
        fetch_pr_diff "$OUTPUT_DIR" "$PR_NUMBER"
    fi
    if [ "$RUN_SAST" = true ]; then
        echo "Running static-analysis pre-pass on changed files..."
        collect_sast_findings "$OUTPUT_DIR"
    fi
    CAPTURED_PR_HEAD=$(jq -r '.headRefOid // ""' "$OUTPUT_DIR/pr-summary.json")
    if ! verify_pr_head_unchanged "$PR_NUMBER" "$CAPTURED_PR_HEAD"; then
        invalidate_on_confirmed_hosted_head_mismatch "$OUTPUT_DIR"
        echo "Error: PR head changed or could not be revalidated while analysis inputs were collected." >&2
        [ -z "$CURRENT_HOSTED_HEAD" ] || \
            echo "Expected $CAPTURED_PR_HEAD, now $CURRENT_HOSTED_HEAD. Re-run to collect one coherent snapshot." >&2
        exit 1
    fi
    build_analysis_context "$OUTPUT_DIR" "$INCLUDE_DIFF" "$RUN_SAST" "$REPO"
    CAPTURED_DISCUSSION_IDENTITY=false
    CAPTURED_CHECKS_IDENTITY=false
    jq -e '.coverage.discussion.fingerprint | type == "string" and length > 0' \
        "$OUTPUT_DIR/analysis-context.json" > /dev/null 2>&1 && \
        CAPTURED_DISCUSSION_IDENTITY=true
    jq -e '.coverage.checks.fingerprint | type == "string" and length > 0' \
        "$OUTPUT_DIR/analysis-context.json" > /dev/null 2>&1 && \
        CAPTURED_CHECKS_IDENTITY=true
    HOSTED_INPUTS_VERIFIED=true
    if [ "$CAPTURED_DISCUSSION_IDENTITY" = true ] && \
       [ "$CAPTURED_CHECKS_IDENTITY" = true ]; then
        verify_analysis_hosted_attestation \
            "$OUTPUT_DIR/analysis-context.json" || HOSTED_INPUTS_VERIFIED=false
    elif [ "$CAPTURED_DISCUSSION_IDENTITY" = true ]; then
        verify_analysis_partial_hosted_attestation \
            "$OUTPUT_DIR/analysis-context.json" discussion || \
            HOSTED_INPUTS_VERIFIED=false
    elif [ "$CAPTURED_CHECKS_IDENTITY" = true ]; then
        verify_analysis_partial_hosted_attestation \
            "$OUTPUT_DIR/analysis-context.json" checks || \
            HOSTED_INPUTS_VERIFIED=false
    fi
    if [ "$HOSTED_INPUTS_VERIFIED" != true ]; then
        echo "Error: GitHub head, checks, or discussion state changed or could not be revalidated while analysis inputs were collected." >&2
        echo "Re-run to collect one coherent snapshot." >&2
        exit 1
    fi
fi

# 9. Optional external Claude enrichment
if [ "$ENRICH_WITH_CLAUDE" = true ]; then
    echo "Running Claude analysis on unresolved threads and issue comments..."

    if [ "$UNRESOLVED_COUNT" -gt 0 ] || [ "$ISSUE_COMMENT_COUNT" -gt 0 ] || \
       [ "$REVIEW_COMMENT_COUNT" -gt 0 ] || [ "$INLINE_COMMENT_COUNT" -gt 0 ]; then
        echo "Found $UNRESOLVED_COUNT unresolved thread(s), $ISSUE_COMMENT_COUNT issue comment(s), $REVIEW_COMMENT_COUNT review summary comment(s), and $INLINE_COMMENT_COUNT inline comment(s). Analyzing with Claude Sonnet..."

        if run_claude_analysis "$OUTPUT_DIR/analysis-context.json" "$OUTPUT_DIR/claude-raw-response.json"; then
            ANALYSIS_USABLE=false
            CAPTURED_PR_HEAD=$(jq -r '.coverage.code_access.pr_head_sha // ""' \
                "$OUTPUT_DIR/analysis-context.json")
            if ! verify_analysis_hosted_attestation \
                    "$OUTPUT_DIR/analysis-context.json"; then
                [ "$HOSTED_ATTESTATION_COMPONENT" != "head" ] || \
                    invalidate_on_confirmed_hosted_head_mismatch "$OUTPUT_DIR"
                echo "⚠️  GitHub head, checks, or discussion state changed or could not be revalidated during Claude analysis; the response was not published." >&2
                echo "   Re-run the analysis against the current hosted state." >&2
            elif jq -e '.structured_output' "$OUTPUT_DIR/claude-raw-response.json" > /dev/null 2>&1; then
                ANALYSIS_USABLE=true
            else
                # The CLI exited cleanly but returned no structured output. Copying
                # the envelope through yields an empty report that reads like a
                # clean PR, so say plainly that this is a failure, not a result.
                echo "⚠️  The analyzer returned no structured output; the analysis is not usable." >&2
                echo "   Raw response: $OUTPUT_DIR/claude-raw-response.json" >&2
                echo "   Analyzer stderr: $OUTPUT_DIR/claude-stderr.log" >&2
            fi

            if [ "$ANALYSIS_USABLE" = true ]; then
                PROVIDER_TRANSACTION_RC=0
                REPORT_RUN_CHILD_STARTING=true
                set -m
                (
                PROVIDER_SOURCE_DIR=""
                PROVIDER_BACKUP_DIR=""
                PROVIDER_REPLACEMENT_DIR=""
                PROVIDER_LOCK_DIR=""
                PROVIDER_LOCK_TOKEN=""
                PROVIDER_LOCK_OWNED=false
                PROVIDER_WRITER_SIGNAL=""
                selected_writer_signal=""
                PROVIDER_PUBLICATION_RC=0
                PROVIDER_CONTEXT_FINGERPRINT=""
                PROVIDER_EMBEDDED_FINGERPRINT=""
                cleanup_provider_combined_writer() {
                    terminate_report_run_child
                    cleanup_live_analysis_discussion_temps
                    REPORT_RUN_MANAGED=false
                    REPORT_RUN_OWNER_PID=""
                    [ -z "$PROVIDER_SOURCE_DIR" ] || \
                        rm -rf "$PROVIDER_SOURCE_DIR" 2>/dev/null || true
                    [ -z "$PROVIDER_BACKUP_DIR" ] || \
                        rm -rf "$PROVIDER_BACKUP_DIR" 2>/dev/null || true
                    [ -z "$PROVIDER_REPLACEMENT_DIR" ] || \
                        rm -rf "$PROVIDER_REPLACEMENT_DIR" 2>/dev/null || true
                    if [ "$PROVIDER_LOCK_OWNED" = true ]; then
                        if ! release_selected_analysis_lock \
                                "$PROVIDER_LOCK_DIR" "$PROVIDER_LOCK_TOKEN"; then
                            echo "Error: Selected-analysis writer lock remains after provider update cleanup." >&2
                        fi
                    fi
                }
                handle_provider_writer_signal() {
                    PROVIDER_WRITER_SIGNAL="$1"
                    selected_writer_signal="$1"
                    terminate_report_run_child
                }
                trap cleanup_provider_combined_writer EXIT
                trap 'handle_provider_writer_signal INT' INT
                trap 'handle_provider_writer_signal TERM' TERM
                selected_analysis_worker_pid || exit 1
                REPORT_RUN_OWNER_PID="$SELECTED_ANALYSIS_WORKER_PID"
                REPORT_RUN_MANAGED=true
                PROVIDER_SOURCE_DIR="$(mktemp -d \
                    "/tmp/gh-pr-enrich-provider-source.XXXXXX")" || exit 1
                chmod 700 "$PROVIDER_SOURCE_DIR" || exit 1
                jq '.structured_output' "$OUTPUT_DIR/claude-raw-response.json" \
                    > "$PROVIDER_SOURCE_DIR/claude-analysis.raw.json" || exit 1
                write_claude_analysis_artifact \
                    "$PROVIDER_SOURCE_DIR/claude-analysis.raw.json" \
                    "$PROVIDER_SOURCE_DIR/claude-analysis.json" \
                    "$REPOSITORY_VISIBILITY" "$CLAUDE_CAPTURED_PR_HEAD" \
                    "$CLAUDE_CAPTURED_CONTEXT_FINGERPRINT" \
                    "$CLAUDE_CAPTURED_WORKSPACE_FINGERPRINT" || exit 1
                rm -f "$PROVIDER_SOURCE_DIR/claude-analysis.raw.json"
                generate_analysis_report \
                    "$PROVIDER_SOURCE_DIR/claude-analysis.json" \
                    "$PROVIDER_SOURCE_DIR/claude-analysis.md" || exit 1

                acquire_selected_analysis_lock "$OUTPUT_DIR"
                PROVIDER_LOCK_DIR="$SELECTED_ANALYSIS_LOCK_DIR"
                PROVIDER_LOCK_TOKEN="$SELECTED_ANALYSIS_LOCK_TOKEN"
                PROVIDER_LOCK_OWNED="$SELECTED_ANALYSIS_LOCK_OWNED"
                PROVIDER_BACKUP_DIR="$(mktemp -d \
                    "/tmp/gh-pr-enrich-provider-update.XXXXXX")"
                PROVIDER_REPLACEMENT_DIR="$(mktemp -d \
                    "$OUTPUT_DIR/.selected-analysis-replacements.XXXXXX")"
                chmod 700 "$PROVIDER_REPLACEMENT_DIR"
                for PROVIDER_VIEW in analysis.json analysis.md context-coverage.md \
                        combined-data.json comprehensive-report.md \
                        claude-analysis.json claude-analysis.md; do
                    [ ! -f "$OUTPUT_DIR/$PROVIDER_VIEW" ] || \
                        cp -p "$OUTPUT_DIR/$PROVIDER_VIEW" \
                            "$PROVIDER_BACKUP_DIR/$PROVIDER_VIEW"
                    [ ! -f "$PROVIDER_BACKUP_DIR/$PROVIDER_VIEW" ] || \
                        cp -p "$PROVIDER_BACKUP_DIR/$PROVIDER_VIEW" \
                            "$PROVIDER_REPLACEMENT_DIR/$PROVIDER_VIEW"
                done
                cp -p "$PROVIDER_SOURCE_DIR/claude-analysis.json" \
                    "$PROVIDER_REPLACEMENT_DIR/claude-analysis.json" || exit 1
                cp -p "$PROVIDER_SOURCE_DIR/claude-analysis.md" \
                    "$PROVIDER_REPLACEMENT_DIR/claude-analysis.md" || exit 1
                [ -f "$PROVIDER_BACKUP_DIR/combined-data.json" ] || exit 1
                jq --slurpfile provider_analysis \
                   "$PROVIDER_SOURCE_DIR/claude-analysis.json" \
                   '.claude_analysis = $provider_analysis[0]' \
                   "$PROVIDER_BACKUP_DIR/combined-data.json" \
                   > "$PROVIDER_REPLACEMENT_DIR/combined-data.json"
                PROVIDER_MODE="$(workspace_file_mode \
                    "$PROVIDER_BACKUP_DIR/combined-data.json")"
                chmod "$PROVIDER_MODE" \
                    "$PROVIDER_REPLACEMENT_DIR/combined-data.json"

                PROVIDER_CONTEXT_FINGERPRINT="$(analysis_context_fingerprint \
                    "$OUTPUT_DIR/analysis-context.json" 2>/dev/null || echo "")"
                PROVIDER_EMBEDDED_FINGERPRINT="$(jq -r \
                    '.coverage.context_fingerprint // ""' \
                    "$OUTPUT_DIR/analysis-context.json" 2>/dev/null || echo "")"
                if [ -z "$PROVIDER_CONTEXT_FINGERPRINT" ] || \
                   [ "$PROVIDER_CONTEXT_FINGERPRINT" != \
                     "$CLAUDE_CAPTURED_CONTEXT_FINGERPRINT" ] || \
                   [ "$PROVIDER_EMBEDDED_FINGERPRINT" != \
                     "$CLAUDE_CAPTURED_CONTEXT_FINGERPRINT" ]; then
                    echo "Error: Analysis context changed before provider publication." >&2
                    exit 1
                fi
                if [ "$(jq -r '.coverage.code_access.state // "disabled"' \
                        "$OUTPUT_DIR/analysis-context.json")" = "enabled" ] && \
                   ! validate_code_access_grant \
                        "$OUTPUT_DIR/analysis-context.json" "$OUTPUT_DIR" \
                        "$PROVIDER_REPLACEMENT_DIR"; then
                    echo "Error: Local workspace changed before provider publication." >&2
                    exit 1
                fi
                if [ -n "$PROVIDER_WRITER_SIGNAL" ]; then
                    echo "Error: Cancellation arrived during provider update." >&2
                    case "$PROVIDER_WRITER_SIGNAL" in
                        INT) exit 130 ;;
                        TERM) exit 143 ;;
                    esac
                fi
                PROVIDER_REPLACEMENT_IDENTITY="$(selected_analysis_replacement_identity \
                    "$PROVIDER_REPLACEMENT_DIR" 2>/dev/null || echo "")"
                [ -n "$PROVIDER_REPLACEMENT_IDENTITY" ] || exit 1
                if ! verify_analysis_hosted_attestation \
                        "$OUTPUT_DIR/analysis-context.json"; then
                    [ "$HOSTED_ATTESTATION_COMPONENT" != "head" ] || \
                        invalidate_on_confirmed_hosted_head_mismatch \
                            "$OUTPUT_DIR" || true
                    echo "Error: Hosted PR head, checks, and discussion could not be attested before provider publication." >&2
                    exit 1
                fi
                if [ -n "$PROVIDER_WRITER_SIGNAL" ]; then
                    echo "Error: Cancellation arrived before provider publication." >&2
                    case "$PROVIDER_WRITER_SIGNAL" in
                        INT) exit 130 ;;
                        TERM) exit 143 ;;
                    esac
                fi
                publish_selected_analysis_transaction \
                    "$OUTPUT_DIR" "$PROVIDER_BACKUP_DIR" \
                    "$PROVIDER_REPLACEMENT_DIR" \
                    "$PROVIDER_REPLACEMENT_IDENTITY" || PROVIDER_PUBLICATION_RC=$?
                if [ "$PROVIDER_PUBLICATION_RC" -ne 0 ]; then
                    echo "Error: Provider combined update could not be published safely." >&2
                    exit "$PROVIDER_PUBLICATION_RC"
                fi
                if [ "$PROVIDER_LOCK_OWNED" = true ]; then
                    if ! release_selected_analysis_lock \
                            "$PROVIDER_LOCK_DIR" "$PROVIDER_LOCK_TOKEN"; then
                        echo "Error: Provider combined update was published, but its writer lock could not be released." >&2
                        exit 1
                    fi
                    PROVIDER_LOCK_OWNED=false
                fi
                case "$PROVIDER_WRITER_SIGNAL" in
                    INT) exit 130 ;;
                    TERM) exit 143 ;;
                esac
                ) &
                PROVIDER_TRANSACTION_PID=$!
                if kill -0 -- "-$PROVIDER_TRANSACTION_PID" 2>/dev/null; then
                    REPORT_RUN_CHILD_GROUP_OWNED=true
                else
                    REPORT_RUN_CHILD_GROUP_OWNED=false
                fi
                set +m
                REPORT_RUN_CHILD_PID="$PROVIDER_TRANSACTION_PID"
                REPORT_RUN_CHILD_SUPERVISOR=true
                REPORT_RUN_CHILD_STARTING=false
                if [ -n "$RUN_LOCK_PENDING_SIGNAL" ]; then
                    handle_report_run_signal "$RUN_LOCK_PENDING_SIGNAL" \
                        "$RUN_LOCK_PENDING_EXIT_CODE"
                fi
                wait "$PROVIDER_TRANSACTION_PID" || PROVIDER_TRANSACTION_RC=$?
                if [ "$REPORT_RUN_CHILD_PID" = "$PROVIDER_TRANSACTION_PID" ]; then
                    REPORT_RUN_CHILD_PID=""
                    REPORT_RUN_CHILD_GROUP_OWNED=false
                    REPORT_RUN_CHILD_SUPERVISOR=false
                fi
                [ "$PROVIDER_TRANSACTION_RC" -eq 0 ] || \
                    exit "$PROVIDER_TRANSACTION_RC"

                # The prompt requires a verdict for every category. The schema cannot
                # express "all 16 present", so it is checked here — an incomplete
                # sweep reported as complete is the failure this section exists to
                # prevent.
                EXPECTED_CATEGORIES=$(printf '%s' "$ANALYSIS_CATEGORIES" | jq 'length')
                REPORTED_CATEGORIES=$(jq '[(.category_coverage // [])[].category] | unique | length' \
                    "$OUTPUT_DIR/claude-analysis.json" 2>/dev/null || echo 0)
                CATEGORY_COVERAGE_COMPLETE=$(jq -r --argjson all "$ANALYSIS_CATEGORIES" \
                    '(([.category_coverage[].category] | sort) == ($all | sort))' \
                    "$OUTPUT_DIR/claude-analysis.json" 2>/dev/null || echo false)
                if [ "$CATEGORY_COVERAGE_COMPLETE" != true ]; then
                    echo "⚠️  Category coverage is incomplete: $REPORTED_CATEGORIES of $EXPECTED_CATEGORIES categories reported." >&2
                    MISSING_CATEGORIES=$(jq -r --argjson all "$ANALYSIS_CATEGORIES" \
                        '([(.category_coverage // [])[].category] | unique) as $seen
                         | [$all[] | . as $c | select(($seen | index($c)) == null)] | join(", ")' \
                        "$OUTPUT_DIR/claude-analysis.json" 2>/dev/null || echo "")
                    [ -n "$MISSING_CATEGORIES" ] && echo "   Not swept: $MISSING_CATEGORIES" >&2
                    echo "   Treat those categories as unreviewed; this source was not selected." >&2
                else
                    if ! select_analysis_artifact "$OUTPUT_DIR" "$OUTPUT_DIR/claude-analysis.json" > /dev/null; then
                        echo "⚠️  Claude returned complete categories, but required input or provenance validation failed; this source was not selected." >&2
                    fi
                fi
            fi
        else
            CLAUDE_ANALYSIS_RC=$?
            if [ "${CLAUDE_DISCLOSURE_GATE_FAILED:-false}" = true ]; then
                echo "Error: External disclosure authorization could not be revalidated; enrichment was aborted." >&2
                exit 1
            fi
            echo "⚠️  Claude analysis failed. Continuing without enrichment."
        fi
    else
        echo "No unresolved threads or issue comments found. Skipping Claude analysis."
    fi
fi

# Output
case $OUTPUT_FORMAT in
    "json")
        cat "$OUTPUT_DIR/combined-data.json"
        ;;
    "markdown")
        cat "$OUTPUT_DIR/comprehensive-report.md"
        ;;
    "combined")
        echo "✅ Report generated successfully!"
        echo "📁 Directory: $OUTPUT_DIR"
        echo "📊 Markdown: $OUTPUT_DIR/comprehensive-report.md"
        echo "🤖 JSON: $OUTPUT_DIR/combined-data.json"
        CURRENT_ANALYSIS_FILE="$(select_analysis_file "$OUTPUT_DIR" 2>/dev/null || true)"
        if [ -n "$CURRENT_ANALYSIS_FILE" ]; then
            echo "🧠 Analysis: $OUTPUT_DIR/analysis.md"
            [ ! -f "$OUTPUT_DIR/claude-analysis.json" ] || \
                echo "   Claude source: $OUTPUT_DIR/claude-analysis.json"
            cleanup_read_only_analysis_snapshot "$CURRENT_ANALYSIS_FILE"
        elif [ -f "$OUTPUT_DIR/analysis-context.json" ]; then
            echo "🧩 Analysis context: $OUTPUT_DIR/analysis-context.json"
        fi
        ;;
esac

if ! cleanup_report_run_lock; then
    exit 1
fi
REPORT_RUN_MANAGED=false
trap - EXIT INT TERM
