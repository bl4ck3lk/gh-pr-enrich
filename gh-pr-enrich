# Emit the analysis schema (used by tests to pin the analysis contract)
emit_analysis_schema() {
    printf '%s' "$CLAUDE_ANALYSIS_SCHEMA"
}

# Optional static-analysis pre-pass over the files the PR touches.
#
# Semgrep is deterministic where the model is not: its findings enter the context
# as ground truth the analyzer can confirm or refute, rather than as another
# opinion. A missing semgrep is a warning, never a failed run.
collect_sast_findings() {
    local output_dir="$1"
    local config="${GH_PR_ENRICH_SEMGREP_CONFIG:-auto}"
    local timeout_secs="${GH_PR_ENRICH_SEMGREP_TIMEOUT:-180}"
    local output_file="$output_dir/sast-findings.json"

    echo '[]' > "$output_file"

    if ! command -v semgrep > /dev/null 2>&1; then
        echo "⚠️  semgrep not found — skipping the static-analysis pre-pass." >&2
        echo "   Install it (pip install semgrep) or drop --sast." >&2
        return 0
    fi

    # Scan only the files this PR touches that still exist in the working tree.
    local -a targets=()
    local path
    while IFS= read -r path; do
        [ -n "$path" ] && [ -f "$path" ] && targets+=("$path")
    done < <(jq -r '(.files // [])[].path' "$output_dir/pr-summary.json" 2>/dev/null)

    if [ "${#targets[@]}" -eq 0 ]; then
        echo "ℹ️  No changed files present in the working tree — skipping semgrep." >&2
        return 0
    fi

    local raw_file="$output_dir/semgrep-raw.json"
    local rc=0
    if command -v timeout > /dev/null 2>&1; then
        timeout --signal=KILL --foreground "$timeout_secs" \
            semgrep --config "$config" --json --quiet "${targets[@]}" \
            > "$raw_file" 2> "$output_dir/semgrep-stderr.log" || rc=$?
    else
        semgrep --config "$config" --json --quiet "${targets[@]}" \
            > "$raw_file" 2> "$output_dir/semgrep-stderr.log" || rc=$?
    fi

    if [ "$rc" -ne 0 ] && [ ! -s "$raw_file" ]; then
        echo "⚠️  semgrep failed (exit $rc). See $output_dir/semgrep-stderr.log" >&2
        return 0
    fi

    jq '[(.results // [])[] | {
        check_id: .check_id,
        path: .path,
        line: (.start.line // 0),
        severity: (.extra.severity // "INFO"),
        message: (.extra.message // ""),
        cwe: ((.extra.metadata.cwe // []) | if type == "array" then . else [.] end)
    }]' "$raw_file" > "$output_file" 2>/dev/null || echo '[]' > "$output_file"

    local count
    count=$(jq 'length' "$output_file" 2>/dev/null || echo 0)
    echo "🔍 semgrep: $count finding(s) across ${#targets[@]} changed file(s)" >&2
    return 0
}

run_claude_analysis() {
    local context_file="$1"
    local output_file="$2"
    local code_access="${GH_PR_ENRICH_CODE_ACCESS:-true}"
    # Reading and verifying against the repository takes longer than paraphrasing
    # comments; a 300s budget truncated that work.
    local timeout_secs="${CLAUDE_TIMEOUT:-600}"
    local model="${GH_PR_ENRICH_MODEL:-sonnet}"

    local system_prompt
    system_prompt="$(load_system_prompt)"

    local context_payload
    context_payload="$(cat "$context_file")"
    local user_prompt="Analyze these unresolved PR comment threads and issue comments (including CI/bot reports) and provide structured analysis.

Verify each claim against the code before reporting it, sweep every category in the taxonomy, and anchor every finding and task to a file and line.

$context_payload"

    # Read-only tools: the analyzer verifies claims against the repository but must
    # never modify it or run commands. Bash, Write and Edit are deliberately absent.
    local -a tools=()
    if [ "$code_access" = "true" ]; then
        tools=("Read" "Grep" "Glob")
        echo "🧠 Running Claude analysis with read-only repository access (model: $model, timeout: ${timeout_secs}s)..." >&2
    else
        echo "🧠 Running Claude analysis without repository access (model: $model, timeout: ${timeout_secs}s)..." >&2
    fi

    invoke_claude "Claude analysis" "$timeout_secs" "$output_file" \
        "$system_prompt" "$CLAUDE_ANALYSIS_SCHEMA" "$user_prompt" \
        "${tools[@]+"${tools[@]}"}"
}

# Render what the analyzer was and was not shown. A bounded input that reads as a
# complete one is how a review misses things without anyone noticing.
generate_coverage_section() {
    local context_file="$1"
    local output_file="$2"

    jq -r '
    (.coverage // {}) as $c
    | "## 📥 Analysis Context Coverage\n\n" +
      "_What the analyzer was shown. Anything listed as truncated or dropped was not fully analyzed._\n\n" +
      "| Input | Included | Notes |\n|---|---|---|\n" +
      "| Review threads | " + (($c.unresolved_threads.included // 0) | tostring) + " of " + (($c.unresolved_threads.total // 0) | tostring) + " unresolved | " +
        (($c.unresolved_threads.outdated // 0) | tostring) + " outdated (code has changed since the comment) |\n" +
      "| Issue comments | " + (($c.issue_comments.included // 0) | tostring) + " of " + (($c.issue_comments.total // 0) | tostring) + " | " +
        (($c.issue_comments.superseded_bot_duplicates // 0) | tostring) + " superseded bot reposts dropped; " +
        ((($c.issue_comments.truncated // []) | length) | tostring) + " truncated |\n" +
      "| Diff | " + (if ($c.diff.included // false) then (($c.diff.files_included // 0) | tostring) + " of " + (($c.diff.files_total // 0) | tostring) + " files" else "not included (run with --diff)" end) + " | " +
        (if (($c.diff.files_truncated // []) | length) > 0
            then "truncated: " + (($c.diff.files_truncated // []) | join(", "))
            else "no files truncated" end) + " |\n" +
      "| Commits | " + (($c.inputs.commits // 0) | tostring) + " | commit messages supplied as intent |\n" +
      "| Linked issues | " + (($c.inputs.linked_issues // 0) | tostring) + " | issue bodies supplied as intent |\n" +
      "| Failing checks | " + (($c.inputs.failing_checks // 0) | tostring) + " | CI failures supplied as evidence |\n" +
      "| SAST findings | " + (($c.inputs.sast_findings // 0) | tostring) + " | static-analysis results (run with --sast) |\n\n" +
      "_Truncation limit: " + (($c.truncation_limit_chars // 0) | tostring) + " characters per comment, issue body and file diff._\n"
    ' "$context_file" > "$output_file" 2>/dev/null || echo "" > "$output_file"
}

generate_analysis_report() {
    local analysis_file="$1"
    local output_file="$2"

    # Findings lead with verdict, severity and its derivation so a reader can tell
    # a traced defect from a repeated reviewer opinion without opening the JSON.
    jq -r '
    def anchor(e): (if (e.file // "") == "" or e.file == "n/a" then "" else e.file + ":" + ((e.line // 0) | tostring) end);
    def verdict_mark(v): (if v == "confirmed" then "✅ confirmed" elif v == "refuted" then "❌ refuted" else "🟡 plausible" end);

    "# 🤖 Claude Analysis Report\n\n" +
    "## Issue Categories\n\n" +
    (if (.issue_categories | length) == 0 then
        "_No issue categories identified._\n\n"
    else
        (.issue_categories | map(
            "### " + .name + "\n\n" +
            "**Verdict:** " + verdict_mark(.verdict // "plausible") +
            " · **Confidence:** " + (.confidence // "unknown") +
            " · **Severity:** " + (.severity // "unknown") +
            " (" + (.impact // "?") + " impact × " + (.likelihood // "?") + " likelihood)" +
            " · **Category:** `" + (.category // "uncategorized") + "`\n\n" +
            (.description // "") + "\n\n" +
            (if (.severity_rationale // "") != "" then "**Why this severity:** " + .severity_rationale + "\n\n" else "" end) +
            (if ((.evidence // []) | length) > 0 then
                "**Evidence:**\n" + ((.evidence // []) | map(
                    "- " + (if anchor(.) == "" then "" else "`" + anchor(.) + "` — " end) + (.detail // "")
                ) | join("\n")) + "\n\n"
            else "" end) +
            "**Threads:** " + (if ((.thread_ids // []) | length) > 0 then (.thread_ids | join(", ")) else "N/A" end) + "\n"
        ) | join("\n"))
    end) +
    "\n## Disputed Review Comments\n\n" +
    "_Reviewer or bot claims that did not survive verification:_\n\n" +
    (if ((.disputed_comments // []) | length) == 0 then
        "_No claims were refuted._\n"
    else
        ((.disputed_comments // []) | map(
            "- **" + (.thread_id // "unknown thread") + "** (confidence: " + (.confidence // "unknown") + ")\n" +
            "  - Claim: " + (.claim // "") + "\n" +
            "  - Why it is incorrect: " + (.why_incorrect // "")
        ) | join("\n"))
    end) +
    "\n\n## Category Coverage\n\n" +
    "_Every category the analyzer swept, and what it concluded:_\n\n" +
    (if ((.category_coverage // []) | length) == 0 then
        "_No coverage reported — treat this analysis as incomplete._\n"
    else
        ("| Category | Verdict | Note |\n|---|---|---|\n" +
         ((.category_coverage // []) | map(
            "| `" + (.category // "?") + "` | " + (.verdict // "?") + " | " + ((.note // "") | gsub("\\|"; "\\\\|")) + " |"
         ) | join("\n")))
    end) +
    "\n\n## Systemic Issues\n\n" +
    (if ((.systemic_issues // []) | length) == 0 then
        "_No systemic patterns identified._\n"
    else
        ((.systemic_issues // []) | map(
            "### " + (.pattern // "") + "\n\n" +
            "**Evidence:**\n" + ((.evidence // []) | map("- " + .) | join("\n")) + "\n\n" +
            "**Recommendation:** " + (.recommendation // "") + "\n"
        ) | join("\n"))
    end) +
    "\n## Adjacent Problems to Investigate\n\n" +
    (if ((.adjacent_problems // []) | length) == 0 then
        "_No adjacent problem areas identified._\n"
    else
        ((.adjacent_problems // []) | map(
            "- " + (if .checked == true then "🔎 **checked**" else "⬜ **not checked — investigate**" end) +
            " **" + (.area // "") + "** (" + (.risk // "") + "): " + (.investigation_hint // "")
        ) | join("\n"))
    end) +
    "\n\n## Task List\n\n" +
    (if ((.task_list // []) | length) == 0 then
        "_No tasks generated._\n"
    else
        ((.task_list // []) | map(
            "### [" + (.priority // "?") + "] " + (.task // "") + "\n" +
            (if anchor(.) == "" then "" else "- **Location:** `" + anchor(.) + "`\n" end) +
            (if (.suggested_fix // "") != "" then "- **Suggested fix:** " + .suggested_fix + "\n" else "" end) +
            (if (.verification // "") != "" then "- **Verify with:** `" + .verification + "`\n" else "" end) +
            (if ((.thread_ids // []) | length) > 0 then "- **Threads:** " + (.thread_ids | join(", ")) + "\n" else "" end)
        ) | join("\n"))
    end) +
    "\n\n## Process Improvements\n\n" +
    "_Suggestions to prevent similar issues in future PRs:_\n\n" +
    (if ((.process_improvements // []) | length) == 0 then
        "_No process improvements suggested._\n"
    else
        ((.process_improvements // []) | map(
            "### " + (.suggestion // "") + "\n" +
            "**Category:** " + (.category // "") + "\n\n" +
            (.rationale // "") + "\n" +
            (if .implementation_hint then "\n**How to implement:** " + .implementation_hint + "\n" else "" end)
        ) | join("\n"))
    end) +
    "\n\n## PR Template Suggestions\n\n" +
    "_Additions to the PR template that would catch these issues earlier:_\n\n" +
    (if ((.pr_template_suggestions // []) | length) == 0 then
        "_No PR template changes suggested._\n"
    else
        ((.pr_template_suggestions // []) | map(
            "### " + (.section // "") + "\n" +
            "```\n" + (.checkbox_or_question // "") + "\n```\n" +
            "_Why:_ " + (.why // "") + "\n"
        ) | join("\n"))
    end)
    ' "$analysis_file" > "$output_file"
}

# ============================================================================
# Test dispatcher
#
# Runs after every definition above and exits before the CLI flow. Keeps the
# test suites pointed at shipped functions rather than at copies.
# ============================================================================
TEST_CALLABLE_FUNCTIONS="build_claude_context fetch_pr_diff extract_unresolved_threads run_claude_analysis generate_analysis_report generate_coverage_section dedupe_bot_comments collect_sast_findings emit_analysis_schema fetch_review_threads fetch_linked_issues"

if [ -n "$TEST_CALL_FN" ]; then
    case " $TEST_CALLABLE_FUNCTIONS " in
        *" $TEST_CALL_FN "*)
            "$TEST_CALL_FN" "${TEST_CALL_ARGS[@]+"${TEST_CALL_ARGS[@]}"}"
            exit $?
            ;;
        *)
            echo "Error: '$TEST_CALL_FN' is not test-callable." >&2
            echo "Allowed: $TEST_CALLABLE_FUNCTIONS" >&2
            exit 1
            ;;
    esac
fi

# ============================================================================
# Main PR logic
# ============================================================================
# Create output directory
mkdir -p "$OUTPUT_DIR"

echo "Fetching details for PR #$PR_NUMBER in $REPO..."
echo "Saving report to: $OUTPUT_DIR"

# 1. Fetch PR summary
echo "Fetching PR summary..."
PR_SUMMARY_FIELDS="number,title,body,author,state,url,createdAt,updatedAt,mergedAt,closedAt,labels,assignees,reviewRequests,reviews,milestone,projectCards,additions,deletions,changedFiles,mergeable,isDraft,headRefName,headRefOid,baseRefName,baseRefOid,headRepository,headRepositoryOwner,files,commits,statusCheckRollup"
gh pr view "$PR_NUMBER" --json "$PR_SUMMARY_FIELDS" \
    > "$OUTPUT_DIR/pr-summary.json" 2>/dev/null || {
        echo "Error fetching PR summary. Ensure PR #$PR_NUMBER exists and you have access."
        exit 1
    }

# 2. Fetch all comments
echo "Fetching all comments..."
gh api --paginate "repos/$REPO/issues/$PR_NUMBER/comments" \
    | jq -s 'map(select(type == "array")) | (if length == 0 then [] else add end) | map(select(type == "object")) | map({
        id: .id,
        body: (.body // ""),
        user: .user.login,
        created_at: .created_at,
        updated_at: .updated_at,
        type: "issue_comment",
        html_url: .html_url
    })' > "$OUTPUT_DIR/issue-comments.json"

gh api --paginate "repos/$REPO/pulls/$PR_NUMBER/reviews" \
    | jq -s 'map(select(type == "array")) | (if length == 0 then [] else add end) | map(select(type == "object")) | map({
        id: .id,
        body: (.body // ""),
        user: .user.login,
        state: .state,
        submitted_at: .submitted_at,
        type: "review_comment",
        commit_id: .commit_id,
        html_url: .html_url
    })' > "$OUTPUT_DIR/review-comments.json"

gh api --paginate "repos/$REPO/pulls/$PR_NUMBER/comments" \
    | jq -s 'map(select(type == "array")) | (if length == 0 then [] else add end) | map(select(type == "object")) | map({
        id: .id,
        body: (.body // ""),
        path: .path,
        position: .position,
        line: .original_line,
        user: .user.login,
        created_at: .created_at,
        updated_at: .updated_at,
        type: "inline_comment",
        html_url: .html_url
    })' > "$OUTPUT_DIR/inline-comments.json"

# 3. Fetch comment threads with GraphQL IDs (paginated)
echo "Fetching comment threads with GraphQL IDs..."
OWNER=$(echo "$REPO" | cut -d'/' -f1)
REPO_NAME=$(echo "$REPO" | cut -d'/' -f2)

if ! fetch_review_threads "$OWNER" "$REPO_NAME" "$PR_NUMBER" "$OUTPUT_DIR/comment-threads.json"; then
    echo "Note: Could not fetch comment threads with GraphQL IDs."
    echo '{"data": {"repository": {"pullRequest": {"reviewThreads": {"nodes": [], "pages_fetched": 0}}}}}' \
        > "$OUTPUT_DIR/comment-threads.json"
fi

# Fetch the issues this PR closes, for intent the diff cannot show
fetch_linked_issues "$OWNER" "$REPO_NAME" "$PR_NUMBER" "$OUTPUT_DIR/linked-issues.json" || true

# Process comment threads to create ID mapping
jq -r '.data.repository.pullRequest.reviewThreads.nodes[] |
    select(.comments.nodes | length > 0) |
    .comments.nodes[] |
    select(.databaseId != null) |
    "\(.databaseId):\(.id)"' "$OUTPUT_DIR/comment-threads.json" > "$OUTPUT_DIR/id-mapping.txt" 2>/dev/null || {
        echo "" > "$OUTPUT_DIR/id-mapping.txt"
    }


# ============================================================================
# Main Processing
# ============================================================================

# Add GraphQL IDs to all comment types
create_comments_with_graphql_ids "$OUTPUT_DIR/issue-comments.json" "$OUTPUT_DIR/issue-comments-with-graphql.json" "issue_comment"
create_comments_with_graphql_ids "$OUTPUT_DIR/review-comments.json" "$OUTPUT_DIR/review-comments-with-graphql.json" "review_comment"
create_comments_with_graphql_ids "$OUTPUT_DIR/inline-comments.json" "$OUTPUT_DIR/inline-comments-with-graphql.json" "inline_comment"

# Combine comments
#
# all-comments.json schema: array of objects discriminated by `.type`.
#   .type == "issue_comment"  -> {id, body, user, created_at, updated_at, type, html_url}
#   .type == "review_comment" -> {id, body, user, state, submitted_at, type, commit_id, html_url}
#   .type == "inline_comment" -> {id, body, path, position, line, user, created_at, updated_at, type, html_url}
#
# To select non-thread (top-level) PR comments, filter on .type == "issue_comment".
# There is NO .pull_request_review_id field — that exists only on raw GitHub REST
# /pulls/.../comments responses, which are stripped before being written here.
# all-comments-with-graphql.json is the same shape plus {graphql_id, comment_type} on each entry.
jq -s 'add | sort_by(.created_at // .submitted_at // "")' \
    "$OUTPUT_DIR"/issue-comments-with-graphql.json \
    "$OUTPUT_DIR"/review-comments-with-graphql.json \
    "$OUTPUT_DIR"/inline-comments-with-graphql.json \
    > "$OUTPUT_DIR/all-comments-with-graphql.json"

jq -s 'add | sort_by(.created_at // .submitted_at // "")' \
    "$OUTPUT_DIR"/issue-comments.json \
    "$OUTPUT_DIR"/review-comments.json \
    "$OUTPUT_DIR"/inline-comments.json \
    > "$OUTPUT_DIR/all-comments.json"

# 4. Fetch checks and status
echo "Fetching checks and status..."
gh pr checks "$PR_NUMBER" --json name,state,bucket,workflow,startedAt,completedAt,event,link,description > "$OUTPUT_DIR/checks.json" 2>/dev/null || {
    echo "Note: Could not fetch checks (may require additional permissions or no checks configured)."
    echo '[]' > "$OUTPUT_DIR/checks.json"
}

# 5. Generate statistics
echo "Generating statistics..."

COMMENT_STATS=$(jq -n \
    --argjson comments "$(cat "$OUTPUT_DIR/all-comments.json")" \
    '{
        total: ($comments | length),
        by_type: ($comments | group_by(.type) | map({type: .[0].type, count: length})),
        by_user: ($comments | group_by(.user) | map({user: .[0].user, count: length}) | sort_by(-.count) | .[0:10]),
        recent: ($comments | sort_by(.created_at) | reverse | .[0:5])
    }')

# Compute overall state from individual checks (bucket field: pass, fail, pending, skipping, cancel)
CHECKS_STATS=$(jq -r '{
    total: length,
    passing: (map(select(.bucket == "pass")) | length),
    failing: (map(select(.bucket == "fail")) | length),
    pending: (map(select(.bucket == "pending")) | length),
    skipped: (map(select(.bucket == "skipping")) | length),
    cancelled: (map(select(.bucket == "cancel")) | length),
    overall_state: (
        if length == 0 then "no_checks"
        elif (map(select(.bucket == "fail")) | length) > 0 then "failure"
        elif (map(select(.bucket == "pending")) | length) > 0 then "pending"
        elif (map(select(.bucket == "pass" or .bucket == "skipping" or .bucket == "cancel")) | length) == length then "success"
        else "mixed"
        end
    )
}' "$OUTPUT_DIR/checks.json" 2>/dev/null || echo '{"overall_state": "unknown", "total": 0, "passing": 0, "failing": 0, "pending": 0, "skipped": 0, "cancelled": 0}')

# 6. Create combined JSON
echo "Creating combined JSON..."
jq -n \
    --argjson summary "$(<"$OUTPUT_DIR/pr-summary.json")" \
    --argjson comments "$(<"$OUTPUT_DIR/all-comments-with-graphql.json")" \
    --argjson checks "$(<"$OUTPUT_DIR/checks.json")" \
    --argjson comment_stats "$COMMENT_STATS" \
    --argjson checks_stats "$CHECKS_STATS" \
    --argjson comment_threads "$(<"$OUTPUT_DIR/comment-threads.json")" \
    --arg timestamp "$TIMESTAMP" \
    --arg repo "$REPO" \
    '{
        metadata: {
            generated_at: $timestamp,
            repository: $repo,
            pr_number: ($summary.number | tonumber)
        },
        pr: $summary,
        comments: $comments,
        comment_threads: $comment_threads,
        checks: $checks,
        statistics: {
            comments: $comment_stats,
            checks: $checks_stats
        }
    }' > "$OUTPUT_DIR/combined-data.json"

# 7. Create Markdown report
echo "Creating Markdown report..."
cat > "$OUTPUT_DIR/comprehensive-report.md" << EOF
# Comprehensive PR Review Report: #$PR_NUMBER

**Repository:** $REPO
**Generated:** $TIMESTAMP
**PR URL:** $(jq -r '.url' "$OUTPUT_DIR/pr-summary.json")

## 📋 PR Summary

**Title:** $(jq -r '.title' "$OUTPUT_DIR/pr-summary.json")
**Author:** $(jq -r '.author.login' "$OUTPUT_DIR/pr-summary.json")
**State:** $(jq -r '.state' "$OUTPUT_DIR/pr-summary.json")
**Created:** $(jq -r '.createdAt' "$OUTPUT_DIR/pr-summary.json")
**Updated:** $(jq -r '.updatedAt' "$OUTPUT_DIR/pr-summary.json")
**Mergeable:** $(jq -r '.mergeable' "$OUTPUT_DIR/pr-summary.json")
**Draft:** $(jq -r '.isDraft' "$OUTPUT_DIR/pr-summary.json")

**Changes:**
- Files: $(jq -r '.changedFiles' "$OUTPUT_DIR/pr-summary.json")
- Additions: $(jq -r '.additions' "$OUTPUT_DIR/pr-summary.json")
- Deletions: $(jq -r '.deletions' "$OUTPUT_DIR/pr-summary.json")

**Labels:** $(jq -r '.labels[]?.name // empty' "$OUTPUT_DIR/pr-summary.json" | tr '\n' ', ' | sed 's/,$//')
**Assignees:** $(jq -r '.assignees[]?.login // empty' "$OUTPUT_DIR/pr-summary.json" | tr '\n' ', ' | sed 's/,$//')
**Reviewers:** $(jq -r '.requestedReviewers[]?.login // empty' "$OUTPUT_DIR/pr-summary.json" | tr '\n' ', ' | sed 's/,$//')

### Files Changed
$(jq -r '.files[] | "- **\(.path)** (+\(.additions) / -\(.deletions))"' "$OUTPUT_DIR/pr-summary.json")

## ✅ Checks & Status

**Overall State:** $(echo "$CHECKS_STATS" | jq -r '.overall_state // "unknown"')
**Total Checks:** $(echo "$CHECKS_STATS" | jq -r '.total // 0')
**Passing:** $(echo "$CHECKS_STATS" | jq -r '.passing // 0') | **Failing:** $(echo "$CHECKS_STATS" | jq -r '.failing // 0') | **Pending:** $(echo "$CHECKS_STATS" | jq -r '.pending // 0')

$(jq -r 'if length > 0 then "### Check Details\n" + (map("- **\(.name)**: \(.state) (\(.bucket))" + (if ((.workflow? | type) == "object" and (.workflow.name? != null)) then " - \(.workflow.name)" elif (.workflow? | type) == "string" then " - \(.workflow)" else "" end)) | join("\n")) else "No checks configured for this PR." end' "$OUTPUT_DIR/checks.json")

## 💬 Comments Analysis

$(echo "$COMMENT_STATS" | jq -r '
"**Total Comments:** " + ((.total // 0) | tostring) + "\n\n" +
"### By Type\n" + ((.by_type // []) | map("- **" + (.type // "unknown") + ":** " + ((.count // 0) | tostring)) | join("\n")) + "\n\n" +
"### Top Commenters\n" + ((.by_user // []) | map("- **" + (.user // "unknown") + ":** " + ((.count // 0) | tostring)) | join("\n"))
')

## 🧵 Comment Threads

To resolve a comment thread:
\`\`\`bash
gh api graphql -f query='mutation { resolveReviewThread(input: {threadId: "<THREAD_ID>"}) { thread { isResolved } } }'
\`\`\`

---

*Report generated by gh-pr-enrich v$VERSION at $TIMESTAMP*
EOF

# 8. Optional: Claude enrichment
if [ "$ENRICH_WITH_CLAUDE" = true ]; then
    echo "Running Claude analysis on unresolved threads and issue comments..."

    extract_unresolved_threads "$OUTPUT_DIR/comment-threads.json" "$OUTPUT_DIR/unresolved-threads.json"

    UNRESOLVED_COUNT=$(jq 'length' "$OUTPUT_DIR/unresolved-threads.json")
    ISSUE_COMMENT_COUNT=$(jq 'length' "$OUTPUT_DIR/issue-comments.json" 2>/dev/null || echo "0")

    if [ "$UNRESOLVED_COUNT" -gt 0 ] || [ "$ISSUE_COMMENT_COUNT" -gt 0 ]; then
        echo "Found $UNRESOLVED_COUNT unresolved thread(s) and $ISSUE_COMMENT_COUNT issue comment(s). Analyzing with Claude Sonnet..."

        # Fetch diff if requested
        if [ "$INCLUDE_DIFF" = true ]; then
            echo "Fetching PR diff for richer context..."
            fetch_pr_diff "$OUTPUT_DIR" "$PR_NUMBER"
        fi

        # Deterministic findings first, so the analyzer can confirm or refute them
        if [ "$RUN_SAST" = true ]; then
            echo "Running static-analysis pre-pass on changed files..."
            collect_sast_findings "$OUTPUT_DIR"
        fi

        build_claude_context "$OUTPUT_DIR" "$INCLUDE_DIFF"

        if run_claude_analysis "$OUTPUT_DIR/claude-context.json" "$OUTPUT_DIR/claude-raw-response.json"; then
            if jq -e '.structured_output' "$OUTPUT_DIR/claude-raw-response.json" > /dev/null 2>&1; then
                jq '.structured_output' "$OUTPUT_DIR/claude-raw-response.json" > "$OUTPUT_DIR/claude-analysis.json"
            else
                cp "$OUTPUT_DIR/claude-raw-response.json" "$OUTPUT_DIR/claude-analysis.json"
            fi

            generate_analysis_report "$OUTPUT_DIR/claude-analysis.json" "$OUTPUT_DIR/claude-analysis.md"
            generate_coverage_section "$OUTPUT_DIR/claude-context.json" "$OUTPUT_DIR/context-coverage.md"

            jq --argjson analysis "$(<"$OUTPUT_DIR/claude-analysis.json")" \
               --argjson coverage "$(jq '.coverage // {}' "$OUTPUT_DIR/claude-context.json")" \
               '. + {claude_analysis: $analysis, analysis_context_coverage: $coverage}' \
               "$OUTPUT_DIR/combined-data.json" > "$OUTPUT_DIR/combined-data.tmp.json" && \
               mv "$OUTPUT_DIR/combined-data.tmp.json" "$OUTPUT_DIR/combined-data.json"

            cat >> "$OUTPUT_DIR/comprehensive-report.md" << 'ANALYSIS_SECTION'

---

ANALYSIS_SECTION
            cat "$OUTPUT_DIR/claude-analysis.md" >> "$OUTPUT_DIR/comprehensive-report.md"
            printf '\n---\n\n' >> "$OUTPUT_DIR/comprehensive-report.md"
            cat "$OUTPUT_DIR/context-coverage.md" >> "$OUTPUT_DIR/comprehensive-report.md"
        else
            echo "⚠️  Claude analysis failed. Continuing without enrichment."
        fi
    else
        echo "No unresolved threads or issue comments found. Skipping Claude analysis."
    fi
fi

# Output
case $OUTPUT_FORMAT in
    "json")
        cat "$OUTPUT_DIR/combined-data.json"
        ;;
    "markdown")
        cat "$OUTPUT_DIR/comprehensive-report.md"
        ;;
    "combined")
        echo "✅ Report generated successfully!"
        echo "📁 Directory: $OUTPUT_DIR"
        echo "📊 Markdown: $OUTPUT_DIR/comprehensive-report.md"
        echo "🤖 JSON: $OUTPUT_DIR/combined-data.json"
        if [ -f "$OUTPUT_DIR/claude-analysis.json" ]; then
            echo "🧠 Claude Analysis: $OUTPUT_DIR/claude-analysis.md"
        fi
        ;;
esac
