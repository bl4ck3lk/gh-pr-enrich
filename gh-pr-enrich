# Re-fetch the same normalized inputs used by the original collection. The
# temporary snapshot stays outside the report directory so an untrusted branch
# cannot preplant any of its paths or observe a partially collected identity.
fetch_live_analysis_discussion_fingerprint_once() {
    local repository="$1" pr_number="$2"
    local owner="${repository%%/*}" repo_name="${repository#*/}"
    local live_dir pages_file fingerprint=""
    [ -n "$owner" ] && [ -n "$repo_name" ] && [ "$owner" != "$repo_name" ] || return 1
    live_dir="$(mktemp -d "/tmp/gh-pr-enrich-live-discussion.XXXXXX")" || return 1
    LIVE_DISCUSSION_TEMP_DIR="$live_dir"
    chmod 700 "$live_dir" || {
        rmdir "$live_dir" 2>/dev/null || true
        LIVE_DISCUSSION_TEMP_DIR=""
        return 1
    }

    pages_file="$live_dir/issue-comments.pages"
    run_report_command gh api --paginate \
        "repos/$repository/issues/$pr_number/comments" > "$pages_file" 2>/dev/null && \
        jq -s 'if length > 0 and all(.[]; type == "array")
            then (add // []) else error("invalid issue-comment pagination") end
            | if all(.[];
                type == "object" and
                (.id | type == "number" and . > 0) and
                (.body | type == "string") and
                (has("user") and
                    (.user == null or (.user.login | type) == "string")) and
                (.created_at | type == "string") and
                (.updated_at | type == "string") and
                (.html_url | type == "string")) then .
              else error("invalid issue-comment item") end | map({
                id: .id, body: .body, user: (.user.login // ""),
                created_at: .created_at, updated_at: .updated_at,
                type: "issue_comment", html_url: .html_url
            })' "$pages_file" > "$live_dir/issue-comments.json" 2>/dev/null || {
        rm -rf "$live_dir"
        LIVE_DISCUSSION_TEMP_DIR=""
        return 1
    }

    pages_file="$live_dir/review-comments.pages"
    run_report_command gh api --paginate \
        "repos/$repository/pulls/$pr_number/reviews" > "$pages_file" 2>/dev/null && \
        jq -s 'if length > 0 and all(.[]; type == "array")
            then (add // []) else error("invalid review pagination") end
            | if all(.[];
                type == "object" and
                (.id | type == "number" and . > 0) and
                (.body | type == "string") and
                (has("user") and
                    (.user == null or (.user.login | type) == "string")) and
                (.state | type == "string") and
                ((.submitted_at | type) == "string" or .submitted_at == null) and
                (.commit_id | type == "string") and
                (.html_url | type == "string")) then .
              else error("invalid review item") end | map({
                id: .id, body: .body, user: (.user.login // ""),
                state: .state, submitted_at: .submitted_at,
                type: "review_comment", commit_id: .commit_id,
                html_url: .html_url
            })' "$pages_file" > "$live_dir/review-comments.json" 2>/dev/null || {
        rm -rf "$live_dir"
        LIVE_DISCUSSION_TEMP_DIR=""
        return 1
    }

    pages_file="$live_dir/inline-comments.pages"
    run_report_command gh api --paginate \
        "repos/$repository/pulls/$pr_number/comments" > "$pages_file" 2>/dev/null && \
        jq -s 'if length > 0 and all(.[]; type == "array")
            then (add // []) else error("invalid inline-comment pagination") end
            | if all(.[];
                type == "object" and
                (.id | type == "number" and . > 0) and
                (.body | type == "string") and
                (.path | type == "string") and
                ((.position | type) == "number" or .position == null) and
                ((.original_line | type) == "number" or .original_line == null) and
                (has("user") and
                    (.user == null or (.user.login | type) == "string")) and
                (.created_at | type == "string") and
                (.updated_at | type == "string") and
                (.html_url | type == "string")) then .
              else error("invalid inline-comment item") end | map({
                id: .id, body: .body, path: .path,
                position: .position, line: .original_line,
                user: (.user.login // ""), created_at: .created_at,
                updated_at: .updated_at, type: "inline_comment",
                html_url: .html_url
            })' "$pages_file" > "$live_dir/inline-comments.json" 2>/dev/null || {
        rm -rf "$live_dir"
        LIVE_DISCUSSION_TEMP_DIR=""
        return 1
    }

    fetch_review_threads "$owner" "$repo_name" "$pr_number" \
        "$live_dir/comment-threads.json" || {
        rm -rf "$live_dir"
        LIVE_DISCUSSION_TEMP_DIR=""
        return 1
    }
    fingerprint="$(analysis_discussion_fingerprint_from_files \
        "$live_dir" 2>/dev/null || echo "")"
    rm -rf "$live_dir"
    LIVE_DISCUSSION_TEMP_DIR=""
    [ -n "$fingerprint" ] || return 1
    printf '%s\n' "$fingerprint"
}

# A discussion snapshot is assembled from four independently paginated API
# surfaces. Require two consecutive complete snapshots to agree so a mutation
# between requests cannot be accepted as one coherent hosted state.
fetch_live_analysis_discussion_fingerprint() {
    local repository="$1" pr_number="$2" fingerprint=""
    DISCUSSION_STABILITY_FIRST="$(mktemp \
        "/tmp/gh-pr-enrich-discussion-stability.XXXXXX")" || return 1
    DISCUSSION_STABILITY_SECOND="$(mktemp \
        "/tmp/gh-pr-enrich-discussion-stability.XXXXXX")" || {
