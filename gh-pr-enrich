#!/bin/bash
# gh-pr-enrich - GitHub CLI extension for comprehensive PR analysis
# Fetches PR details and prepares provider-neutral analysis context. Claude is an
# optional external analyzer; Codex can orchestrate native subagents over the
# same snapshot.
#
# Installation:
#   gh extension install bl4ck3lk/gh-pr-enrich
#
# Usage:
#   gh pr-enrich <PR_NUMBER> [--json] [--markdown] [--output-dir <DIR>] [--prepare-analysis] [--enrich] [--diff] [--sast]
#   gh pr-enrich resolve <THREAD_ID> [THREAD_ID...]
#   gh pr-enrich watch <PR_NUMBER> [--interval MIN] [--enrich] [--notify]
#   gh pr-enrich address <PR_NUMBER>
#   gh pr-enrich install-skill | uninstall-skill
#
# Examples:
#   gh pr-enrich 123                    # Fetch PR details
#   gh pr-enrich 123 --enrich           # Fetch + Claude analysis
#   gh pr-enrich 123 --enrich --diff    # Analysis with code context
#   gh pr-enrich 123 --enrich --sast    # Analysis with a semgrep pre-pass
#   gh pr-enrich 123 --json             # Output JSON only
#   gh pr-enrich resolve PRRT_xxx       # Resolve a comment thread
#   gh pr-enrich watch 123 --enrich     # Monitor PR for changes
#   gh pr-enrich address 123            # Interactive issue fixing

set -e

VERSION="2.1.0"

# Handle --version flag
if [ "$1" = "--version" ] || [ "$1" = "-v" ]; then
    echo "gh-pr-enrich version $VERSION"
    exit 0
fi

# Cross-platform path canonicalization (works on both BSD/macOS and GNU/Linux)
# Returns absolute path, resolving symlinks
canonicalize_path() {
    local path="$1"
    if [ -d "$path" ]; then
        (cd "$path" && pwd -P)
    elif [ -L "$path" ]; then
        local target
        target=$(readlink "$path")
        if [[ "$target" = /* ]]; then
            # Absolute symlink target
            canonicalize_path "$target"
        else
            # Relative symlink target - resolve from symlink's directory
            local dir
            dir=$(dirname "$path")
            canonicalize_path "$dir/$target"
        fi
    elif [ -f "$path" ]; then
        local dir
        dir=$(cd "$(dirname "$path")" && pwd -P)
        echo "$dir/$(basename "$path")"
    else
        # Path doesn't exist, just normalize it
        echo "$path"
    fi
}

absolute_path_for_write() {
    local path="$1" parent
    case "$path" in
        /*) printf '%s\n' "$path" ;;
        *)
            parent="$(cd "$(dirname "$path")" && pwd -P)" || return 1
            printf '%s/%s\n' "$parent" "$(basename "$path")"
            ;;
    esac
}

# Keep the legacy compatibility artifact byte-identical but inode-independent.
# A hard link lets an old consumer mutate the canonical immutable snapshot.
copy_compatibility_file() {
    local source_file="$1"
    local target_file="$2"
    cp "$source_file" "$target_file.tmp"
    mv "$target_file.tmp" "$target_file"
}

sha256_file() {
    local source_file="$1"
    if command -v shasum > /dev/null 2>&1; then
        shasum -a 256 "$source_file" | awk '{print $1}'
    elif command -v sha256sum > /dev/null 2>&1; then
        sha256sum "$source_file" | awk '{print $1}'
    elif command -v openssl > /dev/null 2>&1; then
        openssl dgst -sha256 "$source_file" | awk '{print $NF}'
    else
        return 1
    fi
}

positive_integer_or_default() {
    local value="${1:-}" fallback="$2" maximum="${3:-2147483647}"
    local value_length=${#value} maximum_length=${#maximum}
    if [[ "$value" =~ ^[1-9][0-9]*$ ]] && \
       { [ "$value_length" -lt "$maximum_length" ] || \
         { [ "$value_length" -eq "$maximum_length" ] && \
           { [ "$value" = "$maximum" ] || [[ "$value" < "$maximum" ]]; }; }; }; then
        printf '%s\n' "$value"
    else
        printf '%s\n' "$fallback"
    fi
}

fetch_watch_state() {
    local owner="$1" repository="$2" pr_number="$3"
    local issue_id_lines review_id_lines issue_comment_ids review_ids thread_state
    issue_id_lines="$(gh api --paginate \
        "repos/$owner/$repository/issues/$pr_number/comments?per_page=100" \
        --jq '.[] | if .id == null then error("missing issue-comment id")
              else (.id | tostring) end' \
        2>/dev/null)" || return 1
    issue_comment_ids="$(printf '%s\n' "$issue_id_lines" | jq -Rsc '
        (split("\n") | map(select(length > 0))) as $ids
        | if all($ids[]; test("^[1-9][0-9]*$")) then ($ids | unique | sort)
          else error("issue-comment pagination returned an invalid id") end
    ')" || return 1
    review_id_lines="$(gh api --paginate \
        "repos/$owner/$repository/pulls/$pr_number/reviews?per_page=100" \
        --jq '.[] | if .id == null then error("missing review id")
              else (.id | tostring) end' \
        2>/dev/null)" || return 1
    review_ids="$(printf '%s\n' "$review_id_lines" | jq -Rsc '
        (split("\n") | map(select(length > 0))) as $ids
        | if all($ids[]; test("^[1-9][0-9]*$")) then ($ids | unique | sort)
          else error("review pagination returned an invalid id") end
    ')" || return 1
    thread_state="$(gh api graphql \
        -F owner="$owner" \
        -F name="$repository" \
        -F prNumber="$pr_number" \
        -f query='query($owner: String!, $name: String!, $prNumber: Int!) {
            repository(owner: $owner, name: $name) {
                pullRequest(number: $prNumber) {
                    reviewThreads(first: 100) {
                        totalCount
                        nodes {
                            isResolved
                            comments(first: 100) { totalCount nodes { id } }
                        }
                    }
                }
            }
        }' 2>/dev/null)" || return 1

    # Feed even the projected ID sets through stdin: a PR can accumulate an
    # unbounded number of comments, so placing the complete arrays in argv
    # would only move the ARG_MAX failure from bodies to very large ID sets.
    printf '%s\n%s\n%s\n' "$issue_comment_ids" "$review_ids" "$thread_state" | \
    jq -sec '
        .[0] as $issue_comment_ids
        | .[1] as $review_ids
        | .[2] as $threads
        | ($threads.data.repository.pullRequest.reviewThreads.nodes | arrays) as $thread_nodes
        | select(($threads.data.repository.pullRequest.reviewThreads.totalCount | type) == "number")
        | select($threads.data.repository.pullRequest.reviewThreads.totalCount == ($thread_nodes | length))
        | select(all($thread_nodes[];
            (.isResolved | type) == "boolean"
            and (.comments.nodes | type) == "array"
            and (.comments.totalCount | type) == "number"
            and .comments.totalCount == (.comments.nodes | length)
            and all(.comments.nodes[]; .id != null and ((.id | tostring) | length > 0))))
        | {
            issue_comment_ids: $issue_comment_ids,
            review_ids: $review_ids,
            inline_comment_ids: ([$thread_nodes[].comments.nodes[].id | tostring] | unique | sort),
            unresolved: ([$thread_nodes[] | select(.isResolved == false)] | length)
          }
    '
}

watch_selected_analysis_identity() {
    local report_dir="$1" repository="$2" pr_number="$3" selected_file
    selected_file="$(select_analysis_file "$report_dir" read-only 2>/dev/null)" || \
        return 1
    [ "$(basename "$selected_file")" = "analysis.json" ] || return 1
    jq -e --arg repository "$repository" --argjson pr_number "$pr_number" '
        ._metadata.repository == $repository
        and ._metadata.pr_number == $pr_number
        and (._metadata.context_fingerprint | type == "string" and length > 0)
    ' "$selected_file" > /dev/null 2>&1 || return 1
    sha256_file "$selected_file"
}

# Stable content identity for one analysis snapshot. Recompute this digest at
# every trust boundary; the value embedded in the context is only a claim until
# it matches the canonical snapshot bytes.
analysis_context_fingerprint() {
    local canonical_file digest=""
    canonical_file="$(mktemp "${TMPDIR:-/tmp}/gh-pr-enrich-context.XXXXXX")"
    if ! jq -cS 'del(.coverage.context_fingerprint)' "$1" > "$canonical_file"; then
        rm -f "$canonical_file"
        return 1
    fi
    if ! digest="$(sha256_file "$canonical_file")"; then
        echo "Error: SHA-256 implementation not found (need shasum, sha256sum, or openssl)." >&2
        rm -f "$canonical_file"
        return 1
    fi
    rm -f "$canonical_file"
    [ -n "$digest" ] || return 1
    printf 'sha256:%s\n' "$digest"
}

# Return the working-tree permission bits on both BSD and GNU stat.
workspace_file_mode() {
    local mode=""
    if mode="$(stat -c '%a' "$1" 2>/dev/null)" && \
       [[ "$mode" =~ ^[0-7]+$ ]]; then
        printf '%s\n' "$mode"
        return 0
    fi
    if mode="$(stat -f '%Lp' "$1" 2>/dev/null)" && \
       [[ "$mode" =~ ^[0-7]+$ ]]; then
        printf '%s\n' "$mode"
        return 0
    fi
    return 1
}

# Write a canonical NUL-delimited manifest for every repository-visible path.
# HEAD and index identity bind staged state; hashing every working-tree file also
# catches bytes hidden from `git diff` by skip-worktree or assume-unchanged bits.
build_code_access_workspace_manifest() {
    local ignored_output_dir="${1:-}"
    local manifest="$2"
    local repo_root output_abs="" output_rel="" output_is_repo_root=false
    local records index_state head index_digest record metadata index_mode index_stage
    local relative origin file_hash file_mode artifact_relative
    repo_root="$(git rev-parse --show-toplevel 2>/dev/null || echo "")"
    [ -n "$repo_root" ] || return 1

    if [ -n "$ignored_output_dir" ]; then
        output_abs="$(canonicalize_path "$ignored_output_dir")"
        case "$output_abs" in
            "$repo_root") output_is_repo_root=true ;;
            "$repo_root"/*) output_rel="${output_abs#"$repo_root/"}" ;;
        esac
    fi

    records="$(mktemp "/tmp/gh-pr-enrich-workspace-records.XXXXXX")" || return 1
    index_state="$(mktemp "/tmp/gh-pr-enrich-index-state.XXXXXX")" || {
        rm -f "$records"
        return 1
    }
    if ! head="$(git -C "$repo_root" rev-parse HEAD 2>/dev/null)" || \
       ! { git -C "$repo_root" ls-files --stage -z -- .; \
           git -C "$repo_root" ls-files -v -z -- .; } > "$index_state" 2>/dev/null || \
       ! index_digest="$(sha256_file "$index_state")"; then
        rm -f "$records" "$index_state"
        return 1
    fi
    printf 'head\0%s\0index\0sha256:%s\0' "$head" "$index_digest" > "$manifest"

    if ! git -C "$repo_root" ls-files --stage -z -- . > "$records" 2>/dev/null; then
        rm -f "$records" "$index_state" "$manifest"
        return 1
    fi
    while IFS= read -r -d '' record; do
        metadata="${record%%$'\t'*}"
        relative="${record#*$'\t'}"
        index_mode="${metadata%% *}"
        index_stage="${metadata##* }"
        if [ "$index_stage" != "0" ] || [ "$index_mode" = "120000" ] || \
           [ "$index_mode" = "160000" ] || \
           path_has_symlink_component "$repo_root/$relative"; then
            rm -f "$records" "$index_state" "$manifest"
            return 1
        fi
        if [ ! -e "$repo_root/$relative" ]; then
            printf 'missing\0tracked\0%s\0' "$relative" >> "$manifest"
            continue
        fi
        if [ ! -f "$repo_root/$relative" ] || \
           ! file_mode="$(workspace_file_mode "$repo_root/$relative")" || \
           ! file_hash="$(sha256_file "$repo_root/$relative")"; then
            rm -f "$records" "$index_state" "$manifest"
            return 1
        fi
        printf 'file\0tracked\0%s\0%s\0%s\0' \
            "$relative" "$file_mode" "$file_hash" >> "$manifest"
    done < "$records"

    for origin in untracked ignored; do
        if [ "$origin" = "untracked" ]; then
            git -C "$repo_root" ls-files --others --exclude-standard -z -- . \
                > "$records" 2>/dev/null || {
                    rm -f "$records" "$index_state" "$manifest"
                    return 1
                }
        else
            git -C "$repo_root" ls-files --others --ignored --exclude-standard -z -- . \
                > "$records" 2>/dev/null || {
                    rm -f "$records" "$index_state" "$manifest"
                    return 1
                }
        fi
        while IFS= read -r -d '' relative; do
            if path_has_symlink_component "$repo_root/$relative" || \
               [ ! -f "$repo_root/$relative" ]; then
                # Includes nested repositories, which Git reports as directory
                # entries whose mutable descendants are otherwise invisible.
                rm -f "$records" "$index_state" "$manifest"
                return 1
            fi
            artifact_relative=""
            if [ "$output_is_repo_root" = true ]; then
                artifact_relative="$relative"
            elif [ -n "$output_rel" ]; then
                case "$relative" in
                    "$output_rel"/*) artifact_relative="${relative#"$output_rel/"}" ;;
                esac
            fi
            if [ -n "$artifact_relative" ] && \
               is_generated_report_artifact "$artifact_relative"; then
                continue
            fi
            if ! file_mode="$(workspace_file_mode "$repo_root/$relative")" || \
               ! file_hash="$(sha256_file "$repo_root/$relative")"; then
                rm -f "$records" "$index_state" "$manifest"
                return 1
            fi
            printf 'file\0%s\0%s\0%s\0%s\0' \
                "$origin" "$relative" "$file_mode" "$file_hash" >> "$manifest"
        done < "$records"
    done
    rm -f "$records" "$index_state"
}

# Bind repository tools to one exact local workspace. Generated report
# artifacts are excluded individually; every other visible path is manifested.
code_access_workspace_fingerprint() {
    local manifest digest
    manifest="$(mktemp "/tmp/gh-pr-enrich-workspace.XXXXXX")" || return 1
    if ! build_code_access_workspace_manifest "${1:-}" "$manifest" || \
       ! digest="$(sha256_file "$manifest")"; then
        rm -f "$manifest"
        return 1
    fi
    rm -f "$manifest"
    printf 'sha256:%s\n' "$digest"
}

CODE_ACCESS_SNAPSHOT_DIR=""
CODE_ACCESS_SETTINGS_FILE=""
CODE_ACCESS_TRAPS_ACTIVE=false
CODE_ACCESS_PREVIOUS_EXIT_TRAP=""
CODE_ACCESS_PREVIOUS_INT_TRAP=""
CODE_ACCESS_PREVIOUS_TERM_TRAP=""
ANALYZER_CHILD_PID=""
ANALYZER_HEARTBEAT_PID=""
ANALYZER_PROMPT_FILE=""

terminate_analyzer_child() {
    local analyzer_pid="$ANALYZER_CHILD_PID"
    [ -n "$analyzer_pid" ] || return 0
    kill -TERM "$analyzer_pid" 2>/dev/null || true
    wait "$analyzer_pid" 2>/dev/null || true
    ANALYZER_CHILD_PID=""
}

terminate_analyzer_heartbeat() {
    [ -n "$ANALYZER_HEARTBEAT_PID" ] || return 0
    kill -TERM "$ANALYZER_HEARTBEAT_PID" 2>/dev/null || true
    wait "$ANALYZER_HEARTBEAT_PID" 2>/dev/null || true
    ANALYZER_HEARTBEAT_PID=""
}

is_private_code_snapshot_path() {
    local candidate="$1" parent expected_parent basename
    case "$candidate" in
        /tmp/gh-pr-enrich-code-snapshot.*|/private/tmp/gh-pr-enrich-code-snapshot.*) ;;
        *) return 1 ;;
    esac
    [ -d "$candidate" ] && [ ! -L "$candidate" ] || return 1
    parent="$(cd "$(dirname "$candidate")" && pwd -P)" || return 1
    expected_parent="$(cd /tmp && pwd -P)" || return 1
    basename="$(basename "$candidate")"
    [ "$parent" = "$expected_parent" ] && \
        [[ "$basename" =~ ^gh-pr-enrich-code-snapshot\.[A-Za-z0-9]+$ ]]
}

restore_code_access_cleanup_traps() {
    [ "$CODE_ACCESS_TRAPS_ACTIVE" = true ] || return 0
    trap - EXIT INT TERM
    [ -z "$CODE_ACCESS_PREVIOUS_EXIT_TRAP" ] || eval "$CODE_ACCESS_PREVIOUS_EXIT_TRAP"
    [ -z "$CODE_ACCESS_PREVIOUS_INT_TRAP" ] || eval "$CODE_ACCESS_PREVIOUS_INT_TRAP"
    [ -z "$CODE_ACCESS_PREVIOUS_TERM_TRAP" ] || eval "$CODE_ACCESS_PREVIOUS_TERM_TRAP"
    CODE_ACCESS_TRAPS_ACTIVE=false
    CODE_ACCESS_PREVIOUS_EXIT_TRAP=""
    CODE_ACCESS_PREVIOUS_INT_TRAP=""
    CODE_ACCESS_PREVIOUS_TERM_TRAP=""
}

cleanup_code_access_artifacts() {
    if is_private_code_snapshot_path "$CODE_ACCESS_SNAPSHOT_DIR"; then
        chmod -R u+w "$CODE_ACCESS_SNAPSHOT_DIR" 2>/dev/null || true
        rm -rf "$CODE_ACCESS_SNAPSHOT_DIR"
    fi
    case "$CODE_ACCESS_SETTINGS_FILE" in
        /tmp/gh-pr-enrich-claude-settings.*|/private/tmp/gh-pr-enrich-claude-settings.*)
            rm -f "$CODE_ACCESS_SETTINGS_FILE"
            ;;
    esac
    case "$ANALYZER_PROMPT_FILE" in
        /tmp/gh-pr-enrich-claude-prompt.*|/private/tmp/gh-pr-enrich-claude-prompt.*)
            rm -f "$ANALYZER_PROMPT_FILE"
            ;;
    esac
    CODE_ACCESS_SNAPSHOT_DIR=""
    CODE_ACCESS_SETTINGS_FILE=""
    ANALYZER_PROMPT_FILE=""
}

handle_code_access_cleanup_signal() {
    local exit_status=$?
    local signal_name="$1"
    terminate_analyzer_child
    terminate_analyzer_heartbeat
    cleanup_code_access_artifacts
    restore_code_access_cleanup_traps
    if [ "$signal_name" = "EXIT" ]; then
        return "$exit_status"
    fi
    kill -s "$signal_name" "$$"
}

install_code_access_cleanup_traps() {
    [ "$CODE_ACCESS_TRAPS_ACTIVE" != true ] || return 0
    CODE_ACCESS_PREVIOUS_EXIT_TRAP="$(trap -p EXIT)"
    CODE_ACCESS_PREVIOUS_INT_TRAP="$(trap -p INT)"
    CODE_ACCESS_PREVIOUS_TERM_TRAP="$(trap -p TERM)"
    CODE_ACCESS_TRAPS_ACTIVE=true
    trap 'handle_code_access_cleanup_signal EXIT' EXIT
    trap 'handle_code_access_cleanup_signal INT' INT
    trap 'handle_code_access_cleanup_signal TERM' TERM
}

cleanup_code_access_snapshot() {
    cleanup_code_access_artifacts
    restore_code_access_cleanup_traps
}

create_code_access_snapshot() {
    local ignored_output_dir="$1"
    local expected_fingerprint="$2"
    local repo_root manifest manifest_digest kind header_value origin relative mode expected_hash
    local destination destination_hash destination_mode
    cleanup_code_access_snapshot
    repo_root="$(git rev-parse --show-toplevel 2>/dev/null || echo "")"
    [ -n "$repo_root" ] || return 1
    manifest="$(mktemp "/tmp/gh-pr-enrich-snapshot-manifest.XXXXXX")" || return 1
    if ! build_code_access_workspace_manifest "$ignored_output_dir" "$manifest" || \
       ! manifest_digest="$(sha256_file "$manifest")" || \
       [ "sha256:$manifest_digest" != "$expected_fingerprint" ]; then
        rm -f "$manifest"
        return 1
    fi
    CODE_ACCESS_SNAPSHOT_DIR="$(mktemp -d "/tmp/gh-pr-enrich-code-snapshot.XXXXXX")" || {
        rm -f "$manifest"
        return 1
    }
    install_code_access_cleanup_traps
    while IFS= read -r -d '' kind <&3; do
        case "$kind" in
            head|index)
                IFS= read -r -d '' header_value <&3 || {
                    rm -f "$manifest"
                    cleanup_code_access_snapshot
                    return 1
                }
                ;;
            missing)
                IFS= read -r -d '' origin <&3 && \
                    IFS= read -r -d '' relative <&3 || {
                        rm -f "$manifest"
                        cleanup_code_access_snapshot
                        return 1
                    }
                ;;
            file)
                IFS= read -r -d '' origin <&3 && \
                    IFS= read -r -d '' relative <&3 && \
                    IFS= read -r -d '' mode <&3 && \
                    IFS= read -r -d '' expected_hash <&3 || {
                        rm -f "$manifest"
                        cleanup_code_access_snapshot
                        return 1
                    }
                case "$relative" in ""|/*|../*|*/../*|*/..)
                    rm -f "$manifest"
                    cleanup_code_access_snapshot
                    return 1
                    ;;
                esac
                destination="$CODE_ACCESS_SNAPSHOT_DIR/$relative"
                mkdir -p "$(dirname "$destination")" || {
                    rm -f "$manifest"
                    cleanup_code_access_snapshot
                    return 1
                }
                if [ -L "$repo_root/$relative" ] || [ ! -f "$repo_root/$relative" ] || \
                   ! cp "$repo_root/$relative" "$destination" || \
                   ! chmod "$mode" "$destination" || \
                   ! destination_hash="$(sha256_file "$destination")" || \
                   ! destination_mode="$(workspace_file_mode "$destination")" || \
                   [ "$destination_hash" != "$expected_hash" ] || \
                   [ "$destination_mode" != "$mode" ]; then
                    rm -f "$manifest"
                    cleanup_code_access_snapshot
                    return 1
                fi
                ;;
            *)
                rm -f "$manifest"
                cleanup_code_access_snapshot
                return 1
                ;;
        esac
    done 3< "$manifest"
    rm -f "$manifest"
    chmod -R a-w "$CODE_ACCESS_SNAPSHOT_DIR" || {
        cleanup_code_access_snapshot
        return 1
    }
}

create_claude_code_access_settings() {
    local repository_root="$1" claude_absolute_root
    [ -n "$repository_root" ] || return 1
    claude_absolute_root="//${repository_root#/}"
    CODE_ACCESS_SETTINGS_FILE="$(mktemp "/tmp/gh-pr-enrich-claude-settings.XXXXXX")" || return 1
    install_code_access_cleanup_traps
    if ! jq -n --arg repository_root "$claude_absolute_root" '{
        permissions: {
            deny: ["Read(" + $repository_root + "/**)"]
        }
    }' > "$CODE_ACCESS_SETTINGS_FILE" || \
       ! chmod 600 "$CODE_ACCESS_SETTINGS_FILE"; then
        cleanup_code_access_snapshot
        return 1
    fi
}

write_input_status() {
    local output_file="$1"
    local requested="$2"
    local status="$3"
    local reason="$4"
    jq -n --argjson requested "$requested" --arg status "$status" --arg reason "$reason" \
        '{requested: $requested, status: $status, reason: $reason}' > "$output_file"
}

CURRENT_HOSTED_HEAD=""
verify_pr_head_unchanged() {
    local pr_number="$1" expected_head="$2" repository="${3:-}" head_json
    CURRENT_HOSTED_HEAD=""
    if [ -n "$repository" ]; then
        if ! head_json="$(gh pr view "$pr_number" --repo "$repository" --json headRefOid 2>/dev/null)"; then
            return 1
        fi
    elif ! head_json="$(gh pr view "$pr_number" --json headRefOid 2>/dev/null)"; then
        return 1
    fi
    CURRENT_HOSTED_HEAD="$(printf '%s' "$head_json" | jq -r '.headRefOid // ""' 2>/dev/null || echo "")"
    [ -n "$expected_head" ] && [ "$CURRENT_HOSTED_HEAD" = "$expected_head" ]
}

fetch_live_review_thread() {
    local thread_id="$1"
    local output_file="$2"
    local comment_limit="${THREAD_COMMENT_LIMIT:-20}"
    local query='query($threadId: ID!) {
      node(id: $threadId) {
        __typename
        ... on PullRequestReviewThread {
          id
          isResolved
          comments(first: '"$comment_limit"') {
            pageInfo { hasNextPage endCursor }
            nodes {
              id
              databaseId
              author { login }
              createdAt
              lastEditedAt
              url
            }
          }
        }
      }
    }'
    if ! gh api graphql -F threadId="$thread_id" -f query="$query" \
            > "$output_file" 2>/dev/null || \
       ! jq -e '
            ((.errors // []) | length) == 0 and
            .data.node.__typename == "PullRequestReviewThread" and
            (.data.node.comments.nodes | type) == "array" and
            (.data.node.comments.pageInfo.hasNextPage | type) == "boolean"
       ' "$output_file" > /dev/null 2>&1; then
        rm -f "$output_file"
        return 1
    fi
}

live_review_thread_identity_matches_context() {
    local context_file="$1"
    local thread_id="$2"
    local live_file="$3"
    jq -e -n \
            --arg thread_id "$thread_id" \
            --slurpfile context "$context_file" \
            --slurpfile live "$live_file" '
          def identity_is_complete:
            (.id | type == "string" and length > 0) and
            (.database_id | type == "number") and
            (.author | type == "string" and length > 0) and
            (.created_at | type == "string" and length > 0) and
            (.last_edited_at == null or (.last_edited_at | type == "string")) and
            (.url | type == "string" and startswith("https://"));
          [($context[0].unresolved_threads // [])[]
            | select(.thread_id == $thread_id)] as $captured
          | ($live[0].data.node) as $current
          | ($current.comments.nodes | map({
                id: (.id // null),
                database_id: (.databaseId // null),
                author: (.author.login // "unknown"),
                created_at: (.createdAt // null),
                last_edited_at: (.lastEditedAt // null),
                url: (.url // null)
            })) as $live_identity
          | ($captured | length) == 1 and
            ($captured[0].comments_complete == true) and
            (($captured[0].comment_identity | type) == "array") and
            (all($captured[0].comment_identity[]; identity_is_complete)) and
            ($current.id == $thread_id) and
            ($current.comments.pageInfo.hasNextPage == false) and
            (all($live_identity[]; identity_is_complete)) and
            (($captured[0].comment_identity | sort_by(.id)) ==
                ($live_identity | sort_by(.id)))
       ' > /dev/null 2>&1
}

validate_live_review_thread_snapshot() {
    local context_file="$1"
    local thread_id="$2"
    local expected_resolved="$3"
    local live_file="$4"
    live_review_thread_identity_matches_context "$context_file" "$thread_id" \
        "$live_file" || return 1
    jq -e --arg thread_id "$thread_id" --argjson expected "$expected_resolved" '
        .data.node.id == $thread_id and .data.node.isResolved == $expected
    ' "$live_file" > /dev/null 2>&1
}

validate_live_review_thread() {
    local context_file="$1"
    local thread_id="$2"
    local expected_resolved="$3"
    local live_file
    live_file="$(mktemp "/tmp/gh-pr-enrich-live-thread.XXXXXX")" || return 1
    if ! fetch_live_review_thread "$thread_id" "$live_file" || \
       ! validate_live_review_thread_snapshot "$context_file" "$thread_id" \
            "$expected_resolved" "$live_file"; then
        rm -f "$live_file"
        return 1
    fi
    rm -f "$live_file"
}

unresolve_review_thread_and_verify() {
    local context_file="$1"
    local thread_id="$2"
    local result
    result="$(gh api graphql \
        -F threadId="$thread_id" \
        -f query='mutation($threadId: ID!) {
            unresolveReviewThread(input: {threadId: $threadId}) {
                thread { isResolved }
            }
        }' 2>&1)" || return 1
    echo "$result" | jq -e \
        '.data.unresolveReviewThread.thread.isResolved == false' \
        > /dev/null 2>&1 || return 1
    local live_file
    live_file="$(mktemp "/tmp/gh-pr-enrich-reopened-thread.XXXXXX")" || return 1
    if ! fetch_live_review_thread "$thread_id" "$live_file" || \
       ! jq -e --arg thread_id "$thread_id" '
            .data.node.id == $thread_id and
            .data.node.isResolved == false
       ' "$live_file" > /dev/null 2>&1; then
        rm -f "$live_file"
        return 1
    fi
    rm -f "$live_file"
}

invalidate_selected_analysis() {
    local report_dir="$1" combined_tmp=""
    if [ -L "$report_dir/combined-data.json" ] || \
       path_is_git_tracked "$report_dir/combined-data.json"; then
        echo "Error: Refusing unsafe combined-data artifact during invalidation." >&2
        return 1
    fi
    rm -f "$report_dir/analysis.json" "$report_dir/analysis.md" \
        "$report_dir/context-coverage.md"
    if [ -f "$report_dir/combined-data.json" ]; then
        combined_tmp="$(mktemp "$report_dir/.combined-data.XXXXXX")" || return 1
        if jq 'del(.analysis, .analysis_context_coverage)' \
                "$report_dir/combined-data.json" > "$combined_tmp" 2>/dev/null; then
            mv "$combined_tmp" "$report_dir/combined-data.json"
        else
            rm -f "$combined_tmp"
            return 1
        fi
    fi
}

is_generated_report_artifact() {
    case "$1" in
        pr-summary.json|comment-threads.json|comment-threads.json.pages|unresolved-threads.json|id-mapping.txt|\
        issue-comments.json|review-comments.json|inline-comments.json|\
        issue-comments.pages|review-comments.pages|inline-comments.pages|\
        issue-comments.tmp.json|review-comments.tmp.json|inline-comments.tmp.json|\
        issue-comments-with-graphql.json|review-comments-with-graphql.json|inline-comments-with-graphql.json|\
        issue-comments-deduped.json|all-comments.json|all-comments-with-graphql.json|\
        checks.json|linked-issues.json|linked-issues.json.raw|pr-diff.txt|pr-diff.json|\
        sast-findings.json|semgrep-raw.json|\
        issue-comments-status.json|review-comments-status.json|inline-comments-status.json|\
        review-threads-status.json|checks-status.json|linked-issues-status.json|\
        diff-status.json|sast-status.json|analysis-context.json|analysis-context.tmp.json|\
        analysis-context.fingerprinted.tmp.json|claude-context.json|analysis-schema.json|\
        analysis.json|codex-analysis.json|claude-analysis.json|claude-analysis.raw.tmp.json|\
        claude-code-analysis.json|hybrid-analysis.json|analysis.md|codex-analysis.md|\
        claude-analysis.md|claude-code-analysis.md|hybrid-analysis.md|context-coverage.md|\
        combined-data.json|combined-data.tmp.json|comprehensive-report.md|\
        claude-raw-response.json|claude-stderr.log|semgrep-stderr.log)
            return 0
            ;;
    esac
    return 1
}

path_is_git_tracked() {
    local path="$1" path_abs parent repo_root relative
    [ -e "$path" ] || [ -L "$path" ] || return 1
    path_abs="$(canonicalize_path "$path")"
    parent="$(dirname "$path_abs")"
    repo_root="$(git -C "$parent" rev-parse --show-toplevel 2>/dev/null || echo "")"
    [ -n "$repo_root" ] || return 1
    case "$path_abs" in
        "$repo_root"/*)
            relative="${path_abs#"$repo_root/"}"
            git -C "$repo_root" ls-files --error-unmatch -- "$relative" > /dev/null 2>&1
            ;;
        *) return 1 ;;
    esac
}

path_has_symlink_component() {
    local probe="$1" parent
    # `test -L path/` follows the final link on Bash/macOS. Strip trailing
    # separators first so they cannot hide the output link itself.
    while [ "$probe" != "/" ] && [[ "$probe" = */ ]]; do
        probe="${probe%/}"
    done
    while [ "$probe" != "." ] && [ "$probe" != "/" ] && [ -n "$probe" ]; do
        parent="$(dirname "$probe")"
        if [ -L "$probe" ]; then
            # macOS exposes system directories such as /tmp and /var through
            # root-level aliases into /private. Those links are outside a
            # checkout's control; nested links remain unsafe because a reviewed
            # branch can supply them and redirect report writes.
            [ "$parent" = "/" ] || return 0
        fi
        [ "$parent" != "$probe" ] || break
        probe="$parent"
    done
    return 1
}

# Validate an existing report directory before any redirection can follow a
# branch-supplied symlink or overwrite unrelated user content.
validate_output_directory_for_writes() {
    local output_dir="$1" candidate relative repo_root output_abs output_rel tracked=""
    local inventory invalid_reason=""
    if [ -L "$output_dir" ]; then
        echo "Error: Report output directory cannot be a symbolic link: $output_dir" >&2
        return 1
    fi
    output_abs="$(canonicalize_path "$output_dir")"
    [ -d "$output_abs" ] || return 1

    inventory="$(mktemp "${TMPDIR:-/tmp}/gh-pr-enrich-preflight.XXXXXX")"
    if ! find "$output_abs" -mindepth 1 \( -type f -o -type l \) \
            -print > "$inventory" 2>/dev/null; then
        rm -f "$inventory"
        echo "Error: Report output directory could not be inspected safely." >&2
        return 1
    fi
    while IFS= read -r candidate; do
        relative="${candidate#"$output_abs/"}"
        if [ -L "$candidate" ]; then
            invalid_reason="symbolic link: $relative"
            break
        elif ! is_generated_report_artifact "$relative"; then
            invalid_reason="unrelated file: $relative"
            break
        fi
    done < "$inventory"
    rm -f "$inventory"
    if [ -n "$invalid_reason" ]; then
        echo "Error: Report output contains a $invalid_reason" >&2
        return 1
    fi

    repo_root="$(git -C "$output_abs" rev-parse --show-toplevel 2>/dev/null || echo "")"
    if [ -n "$repo_root" ]; then
        if [ "$output_abs" = "$repo_root" ]; then
            tracked="$(git -C "$repo_root" ls-files 2>/dev/null || echo "")"
        else
            output_rel="${output_abs#"$repo_root/"}"
            tracked="$(git -C "$repo_root" ls-files -- ":(literal)$output_rel" 2>/dev/null || echo "")"
        fi
    fi
    if [ -n "$tracked" ]; then
        echo "Error: Report output contains files tracked by the reviewed branch." >&2
        return 1
    fi
}

# Strip terminal control sequences from analyzer-controlled text.
#
# Task text, priorities and fixes come from analysis.json, which may be shaped
# by PR content. Escape sequences printed straight to a terminal can repaint the
# screen or fake this tool's own prompts, misrepresenting what the user is
# approving. Newlines and tabs are kept; every other control byte is dropped.
sanitize_for_terminal() {
    printf '%s' "$1" | tr -d '\000-\010\013\014\016-\037\177'
}

# The fingerprinted context is the grant. Later boundaries require the same
# workspace; they never replay the override that created the grant. A current
# explicit opt-out can still revoke it.
validate_code_access_grant() {
    local context_file="$1"
    local report_dir="$2"
    local expected_fingerprint current_fingerprint
    if [ "${GH_PR_ENRICH_CODE_ACCESS:-}" = "false" ]; then
        echo "Error: Repository code access was revoked by --no-code-access." >&2
        return 1
    fi
    if [ "$(jq -r '.coverage.code_access.state // "disabled"' \
            "$context_file" 2>/dev/null || echo "disabled")" != "enabled" ]; then
        echo "Error: Repository code access is not enabled in the fingerprinted context." >&2
        return 1
    fi
    expected_fingerprint="$(jq -r \
        '.coverage.code_access.workspace_fingerprint // ""' \
        "$context_file" 2>/dev/null || echo "")"
    current_fingerprint="$(code_access_workspace_fingerprint \
        "$report_dir" 2>/dev/null || echo "")"
    if [ -z "$expected_fingerprint" ] || \
       [ "$current_fingerprint" != "$expected_fingerprint" ]; then
        echo "Error: Current local code access no longer matches the fingerprinted context." >&2
        return 1
    fi
}

analysis_snapshot_sidecar_matches() {
    local snapshot_path="$1" sidecar_path="$2" expected_token="${3:-}"
    local expected_state="${4:-}" token janitor_pid state parent expected_parent
    [ "$sidecar_path" = "$snapshot_path.janitor" ] || return 1
    [ -f "$sidecar_path" ] && [ ! -L "$sidecar_path" ] || return 1
    parent="$(cd "$(dirname "$sidecar_path")" && pwd -P)" || return 1
    expected_parent="$(cd /tmp && pwd -P)" || return 1
    [ "$parent" = "$expected_parent" ] || return 1
    IFS=$'\t' read -r token janitor_pid state < "$sidecar_path" || return 1
    [[ "$token" =~ ^[A-Za-z0-9]+$ ]] || return 1
    [[ "$janitor_pid" =~ ^[1-9][0-9]*$ ]] || return 1
    case "$state" in active|cancel) ;; *) return 1 ;; esac
    { [ -z "$expected_token" ] || [ "$token" = "$expected_token" ]; } && \
        { [ -z "$expected_state" ] || [ "$state" = "$expected_state" ]; }
}

run_analysis_snapshot_janitor() {
    local snapshot_path="$1" sidecar_path="$2" token="$3" ttl_seconds="$4"
    local poll_seconds="${GH_PR_ENRICH_SNAPSHOT_POLL_SECONDS:-0.1}"
    local recorded_token recorded_pid state sleep_pid="" deadline
    is_private_code_snapshot_path "$snapshot_path" || return 1
    [[ "$ttl_seconds" =~ ^[1-9][0-9]*$ ]] || return 1
    [[ "$poll_seconds" =~ ^[0-9]+([.][0-9]+)?$ ]] || return 1
    [ "$poll_seconds" != "0" ] && [ "$poll_seconds" != "0.0" ] || return 1
    if ! (umask 077; set -o noclobber; \
            printf '%s\t%s\tactive\n' "$token" "$$" > "$sidecar_path") \
            2>/dev/null; then
        return 1
    fi
    trap '' HUP
    trap '[ -n "$sleep_pid" ] && kill "$sleep_pid" 2>/dev/null; [ -z "$sleep_pid" ] || wait "$sleep_pid" 2>/dev/null; exit 0' TERM INT
    deadline=$((SECONDS + ttl_seconds))
    while [ "$SECONDS" -lt "$deadline" ]; do
        analysis_snapshot_sidecar_matches "$snapshot_path" "$sidecar_path" \
            "$token" || return 0
        IFS=$'\t' read -r recorded_token recorded_pid state \
            < "$sidecar_path" || return 0
        [ "$recorded_pid" = "$$" ] || return 0
        if [ "$state" = "cancel" ]; then
            rm -f "$sidecar_path"
            return 0
        fi
        sleep "$poll_seconds" &
        sleep_pid=$!
        wait "$sleep_pid" 2>/dev/null || return 0
        sleep_pid=""
    done
    trap - TERM INT
    analysis_snapshot_sidecar_matches "$snapshot_path" "$sidecar_path" \
        "$token" active || return 0
    IFS=$'\t' read -r recorded_token recorded_pid state \
        < "$sidecar_path" || return 0
    [ "$recorded_pid" = "$$" ] || return 0
    chmod -R u+w "$snapshot_path" 2>/dev/null || true
    rm -rf "$snapshot_path"
    rm -f "$sidecar_path"
}

stop_analysis_snapshot_janitor() {
    local snapshot_path="$1" sidecar_path="$snapshot_path.janitor"
    local token janitor_pid state attempt cancel_tmp
    if ! analysis_snapshot_sidecar_matches "$snapshot_path" "$sidecar_path"; then
        rm -f "$sidecar_path" 2>/dev/null || true
        return 0
    fi
    IFS=$'\t' read -r token janitor_pid state < "$sidecar_path" || return 0
    cancel_tmp="$(mktemp "$sidecar_path.cancel.XXXXXX")" || return 1
    if ! printf '%s\t%s\tcancel\n' "$token" "$janitor_pid" > "$cancel_tmp" || \
       ! chmod 600 "$cancel_tmp" || ! mv "$cancel_tmp" "$sidecar_path"; then
        rm -f "$cancel_tmp"
        return 1
    fi
    for attempt in $(seq 1 300); do
        [ ! -e "$sidecar_path" ] && return 0
        sleep 0.01
    done
    rm -f "$sidecar_path"
}

start_analysis_snapshot_janitor() {
    local snapshot_path="$1" ttl_seconds="$2"
    local cleanup_command sidecar_path token_file token janitor_pid attempt
    local recorded_token recorded_pid state ready=false
    is_private_code_snapshot_path "$snapshot_path" || return 1
    [[ "$ttl_seconds" =~ ^[1-9][0-9]*$ ]] || return 1
    cleanup_command="$(canonicalize_path "${BASH_SOURCE[0]}")"
    [ -f "$cleanup_command" ] && [ -x "$cleanup_command" ] || return 1
    sidecar_path="$snapshot_path.janitor"
    token_file="$(mktemp "/tmp/gh-pr-enrich-janitor-token.XXXXXX")" || return 1
    token="${token_file##*.}"
    rm -f "$token_file"
    "$cleanup_command" __snapshot-janitor "$snapshot_path" "$sidecar_path" \
        "$token" "$ttl_seconds" </dev/null >/dev/null 2>&1 &
    janitor_pid=$!
    for attempt in $(seq 1 300); do
        if analysis_snapshot_sidecar_matches "$snapshot_path" "$sidecar_path" \
                "$token" active; then
            IFS=$'\t' read -r recorded_token recorded_pid state \
                < "$sidecar_path" || break
            if [ "$recorded_pid" = "$janitor_pid" ]; then
                ready=true
                break
            fi
        fi
        kill -0 "$janitor_pid" 2>/dev/null || break
        sleep 0.01
    done
    if [ "$ready" != true ]; then
        stop_analysis_snapshot_janitor "$snapshot_path" || true
        wait "$janitor_pid" 2>/dev/null || true
        return 1
    fi
    disown "$janitor_pid" 2>/dev/null || true
}

materialize_analysis_snapshot() {
    local report_dir="$1"
    local context_file="$report_dir/analysis-context.json"
    local embedded_context_fingerprint current_context_fingerprint
    local expected_workspace_fingerprint current_workspace_fingerprint
    local captured_pr_head snapshot_path result
    local snapshot_ttl_seconds="${GH_PR_ENRICH_SNAPSHOT_TTL_SECONDS:-3600}"
    if [ ! -f "$context_file" ] || [ -L "$context_file" ] || \
       path_is_git_tracked "$context_file"; then
        echo "Error: A safe analysis-context.json is required to materialize a snapshot." >&2
        return 1
    fi
    embedded_context_fingerprint="$(jq -r '.coverage.context_fingerprint // ""' \
        "$context_file" 2>/dev/null || echo "")"
    current_context_fingerprint="$(analysis_context_fingerprint \
        "$context_file" 2>/dev/null || echo "")"
    if [ -z "$current_context_fingerprint" ] || \
       [ "$embedded_context_fingerprint" != "$current_context_fingerprint" ]; then
        echo "Error: Analysis context fingerprint is missing or invalid." >&2
        return 1
    fi
    validate_code_access_grant "$context_file" "$report_dir" || return 1
    expected_workspace_fingerprint="$(jq -r \
        '.coverage.code_access.workspace_fingerprint // ""' "$context_file")"
    captured_pr_head="$(jq -r '.coverage.code_access.pr_head_sha // ""' \
        "$context_file")"
    if [ -z "$captured_pr_head" ] || \
       ! create_code_access_snapshot "$report_dir" "$expected_workspace_fingerprint"; then
        echo "Error: Could not materialize a verified immutable analysis snapshot." >&2
        return 1
    fi
    current_workspace_fingerprint="$(code_access_workspace_fingerprint \
        "$report_dir" 2>/dev/null || echo "")"
    if [ "$current_workspace_fingerprint" != "$expected_workspace_fingerprint" ]; then
        cleanup_code_access_snapshot
        echo "Error: Local workspace changed while the analysis snapshot was materialized." >&2
        return 1
    fi
    snapshot_path="$CODE_ACCESS_SNAPSHOT_DIR"
    if ! start_analysis_snapshot_janitor "$snapshot_path" \
            "$snapshot_ttl_seconds"; then
        cleanup_code_access_snapshot
        echo "Error: Could not start the bounded analysis-snapshot lease." >&2
        return 1
    fi
    result="$(jq -n \
        --arg path "$snapshot_path" \
        --arg workspace_fingerprint "$expected_workspace_fingerprint" \
        --arg context_fingerprint "$current_context_fingerprint" \
        --arg pr_head_sha "$captured_pr_head" \
        --argjson expires_in_seconds "$snapshot_ttl_seconds" \
        '{path:$path, workspace_fingerprint:$workspace_fingerprint,
          context_fingerprint:$context_fingerprint, pr_head_sha:$pr_head_sha,
          expires_in_seconds:$expires_in_seconds}')" || {
        cleanup_code_access_snapshot
        return 1
    }

    # The native orchestrator owns this lease after the command returns and
    # must call cleanup-analysis-snapshot when every subagent is done.
    CODE_ACCESS_SNAPSHOT_DIR=""
    restore_code_access_cleanup_traps
    printf '%s\n' "$result"
}

cleanup_materialized_analysis_snapshot() {
    local snapshot_path="$1"
    if ! is_private_code_snapshot_path "$snapshot_path"; then
        echo "Error: Refusing to remove an invalid analysis snapshot path." >&2
        return 1
    fi
    stop_analysis_snapshot_janitor "$snapshot_path"
    chmod -R u+w "$snapshot_path" 2>/dev/null || true
    rm -rf "$snapshot_path"
}

validate_analysis_thread_ids() {
    local context_file="$1"
    local analysis_file="$2"
    [ -f "$context_file" ] && [ -f "$analysis_file" ] || return 1
    jq -e --slurpfile analysis "$analysis_file" '
        [(.unresolved_threads // [])[] | .thread_id
            | select(type == "string" and test("^PRRT_[A-Za-z0-9_-]+$"))] as $allowed
        | ($analysis[0]) as $a
        | def known_thread:
            type == "string" and test("^PRRT_[A-Za-z0-9_-]+$") and
            (. as $id | $allowed | index($id) != null);
          all($a.task_list[]?.thread_ids[]?; known_thread) and
          all($a.issue_categories[]?.thread_ids[]?; known_thread) and
          all($a.disputed_comments[]?.thread_id; known_thread)
    ' "$context_file" > /dev/null 2>&1
}

validate_selected_provenance() {
    local report_dir="$1"
    local analysis_file="$2"
    local context_file="${3:-$report_dir/analysis-context.json}"
    local context_fingerprint embedded_fingerprint
    local context_repository context_pr context_head
    local analysis_repository analysis_pr analysis_head analysis_fingerprint
    local expected_workspace_fingerprint analysis_workspace_fingerprint
    if [ ! -f "$analysis_file" ] || [ ! -f "$context_file" ] || \
       [ -L "$analysis_file" ] || [ -L "$context_file" ] || \
       path_is_git_tracked "$analysis_file" || path_is_git_tracked "$context_file" || \
       ! jq -e 'type == "object" and (._metadata | type == "object")' \
            "$analysis_file" > /dev/null 2>&1 || \
       ! jq -e 'type == "object" and (.pr | type == "object") and
            (.coverage | type == "object")' "$context_file" > /dev/null 2>&1; then
        return 1
    fi
    context_fingerprint="$(analysis_context_fingerprint "$context_file" 2>/dev/null || echo "")"
    embedded_fingerprint="$(jq -r '.coverage.context_fingerprint // ""' "$context_file")"
    context_repository="$(jq -r '.pr.repository // ""' "$context_file")"
    context_pr="$(jq -r '.pr.number // ""' "$context_file")"
    context_head="$(jq -r '.coverage.code_access.pr_head_sha // ""' "$context_file")"
    analysis_repository="$(jq -r '._metadata.repository // ""' "$analysis_file")"
    analysis_pr="$(jq -r '._metadata.pr_number // ""' "$analysis_file")"
    analysis_head="$(jq -r '._metadata.pr_head_sha // ""' "$analysis_file")"
    analysis_fingerprint="$(jq -r '._metadata.context_fingerprint // ""' "$analysis_file")"
    expected_workspace_fingerprint="$(jq -r \
        '.coverage.code_access.workspace_fingerprint // ""' "$context_file")"
    analysis_workspace_fingerprint="$(jq -r \
        '._metadata.workspace_fingerprint // ""' "$analysis_file")"
    if [ -z "$context_fingerprint" ] || [ "$embedded_fingerprint" != "$context_fingerprint" ] || \
       [ -z "$context_repository" ] || [ -z "$context_pr" ] || [ -z "$context_head" ] || \
       [ "$analysis_repository" != "$context_repository" ] || \
       [ "$analysis_pr" != "$context_pr" ] || [ "$analysis_head" != "$context_head" ] || \
       [ "$analysis_fingerprint" != "$context_fingerprint" ]; then
        return 1
    fi
    if jq -e 'any((.issue_categories // [])[]; .verdict == "confirmed")' \
            "$analysis_file" > /dev/null 2>&1 && \
       { [ -z "$expected_workspace_fingerprint" ] || \
         [ "$analysis_workspace_fingerprint" != "$expected_workspace_fingerprint" ]; }; then
        return 1
    fi
    validate_analysis_thread_ids "$context_file" "$analysis_file"
}

validate_selected_workspace() {
    local report_dir="$1"
    local analysis_file="$2"
    local context_file="${3:-$report_dir/analysis-context.json}"
    validate_selected_provenance "$report_dir" "$analysis_file" "$context_file" || return 1
    if jq -e 'any((.issue_categories // [])[]; .verdict == "confirmed")' \
            "$analysis_file" > /dev/null 2>&1; then
        validate_code_access_grant "$context_file" "$report_dir"
    fi
}

validate_address_selection_pair() {
    local report_dir="$1"
    local frozen_analysis_file="$2"
    local live_analysis_file="$3"
    local context_file="${4:-$report_dir/analysis-context.json}"
    local require_workspace=false
    validate_selected_provenance "$report_dir" "$frozen_analysis_file" \
        "$context_file" || return 1
    validate_selected_provenance "$report_dir" "$live_analysis_file" \
        "$context_file" || return 1
    if [ "$(jq -r '.coverage.code_access.state // "disabled"' \
            "$context_file" 2>/dev/null || echo "disabled")" = "enabled" ] || \
       jq -e 'any((.issue_categories // [])[]; .verdict == "confirmed")' \
            "$frozen_analysis_file" > /dev/null 2>&1 || \
       jq -e 'any((.issue_categories // [])[]; .verdict == "confirmed")' \
            "$live_analysis_file" > /dev/null 2>&1; then
        require_workspace=true
    fi
    [ "$require_workspace" = false ] || \
        validate_code_access_grant "$context_file" "$report_dir"
}

# Prefer the provider-neutral selected analysis while retaining compatibility
# with reports generated before v2.1.
select_analysis_file() {
    local report_dir="$1"
    local selection_mode="${2:-read-only}"
    local expected_head="" expected_fingerprint="" expected_repository=""
    local expected_pr_number="" has_current_context=false
    case "$selection_mode" in
        read-only|require-current-workspace) ;;
        *) return 1 ;;
    esac
    if [ -f "$report_dir/analysis-context.json" ]; then
        local embedded_fingerprint
        has_current_context=true
        expected_head="$(jq -r '.coverage.code_access.pr_head_sha // ""' \
            "$report_dir/analysis-context.json" 2>/dev/null || echo "")"
        expected_repository="$(jq -r '.pr.repository // ""' \
            "$report_dir/analysis-context.json" 2>/dev/null || echo "")"
        expected_pr_number="$(jq -r '.pr.number // ""' \
            "$report_dir/analysis-context.json" 2>/dev/null || echo "")"
        embedded_fingerprint="$(jq -r '.coverage.context_fingerprint // ""' \
            "$report_dir/analysis-context.json" 2>/dev/null || echo "")"
        expected_fingerprint="$(analysis_context_fingerprint \
            "$report_dir/analysis-context.json" 2>/dev/null || echo "")"
        if [ -z "$embedded_fingerprint" ] || \
           [ "$embedded_fingerprint" != "$expected_fingerprint" ]; then
            return 1
        fi
        if [ -f "$report_dir/pr-summary.json" ]; then
            local summary_head
            summary_head="$(jq -r '.headRefOid // ""' \
                "$report_dir/pr-summary.json" 2>/dev/null || echo "")"
            if [ -n "$summary_head" ] && [ "$summary_head" != "$expected_head" ]; then
                return 1
            fi
        fi
    elif [ -f "$report_dir/pr-summary.json" ]; then
        expected_head="$(jq -r '.headRefOid // ""' \
            "$report_dir/pr-summary.json" 2>/dev/null || echo "")"
    fi

    if [ -f "$report_dir/analysis.json" ]; then
        local selected_has_metadata
        selected_has_metadata="$(jq -r 'type == "object" and has("_metadata")' \
            "$report_dir/analysis.json" 2>/dev/null || echo false)"
        # Provider-neutral analysis.json exists only in the v2.1 selection
        # workflow. Context-free compatibility applies solely to the old
        # claude-analysis.json name below; otherwise a reviewed branch could
        # plant a metadata-less selected result for address/retrospective.
        [ "$selected_has_metadata" = true ] || return 1
        [ "$has_current_context" = true ] || return 1
        [ -n "$expected_head" ] && [ -n "$expected_fingerprint" ] && \
            [ -n "$expected_repository" ] && [ -n "$expected_pr_number" ] || return 1
        if [ -L "$report_dir/analysis.json" ] || \
           [ -L "$report_dir/analysis-context.json" ] || \
           path_is_git_tracked "$report_dir/analysis.json" || \
           path_is_git_tracked "$report_dir/analysis-context.json"; then
            return 1
        fi
        if [ "$selection_mode" = "require-current-workspace" ]; then
            if ! validate_selected_workspace "$report_dir" "$report_dir/analysis.json"; then
                invalidate_selected_analysis "$report_dir" || true
                return 1
            fi
        elif ! validate_selected_provenance "$report_dir" \
                "$report_dir/analysis.json"; then
            return 1
        fi
        printf '%s\n' "$report_dir/analysis.json"
    elif [ -f "$report_dir/claude-analysis.json" ]; then
        # Old Claude-only reports had no provider-neutral provenance metadata.
        # Read-only retrospective discovery may still inspect them, but strict
        # mutation consumers cannot prove their workspace or PR identity.
        [ "$selection_mode" = "read-only" ] || return 1
        # A current source file can exist even when selection rejected it (for
        # example, incomplete category coverage or failed source fetches). Never
        # let a downstream consumer bypass that rejection by treating the source
        # artifact as a legacy selected result.
        if [ "$has_current_context" = true ] || \
           [ -L "$report_dir/claude-analysis.json" ] || \
           path_is_git_tracked "$report_dir/claude-analysis.json" || \
           ! jq -e 'type == "object" and (has("_metadata") | not)' \
                "$report_dir/claude-analysis.json" > /dev/null 2>&1; then
            return 1
        fi
        printf '%s\n' "$report_dir/claude-analysis.json"
    else
        return 1
    fi
}

# Invoke the Claude CLI for a structured-output analysis.
#
# Shared by the PR analysis and the retrospective meta-analysis. Both need the
# same handling for nested invocation, plugin bypass, timeouts, stderr capture
# and progress reporting; keeping one implementation means a fix to any of that
# reaches both.
#
# Usage: invoke_claude LABEL TIMEOUT OUT_FILE SYSTEM_PROMPT SCHEMA USER_PROMPT [TOOL...]
ANALYZER_WORKING_DIRECTORY=""
ANALYZER_SETTINGS_FILE=""
invoke_claude() {
    local label="$1"
    local timeout_secs="$2"
    local output_file="$3"
    local system_prompt="$4"
    local schema="$5"
    local user_prompt="$6"
    shift 6
    local -a tools=("$@")

    local model="${GH_PR_ENRICH_MODEL:-sonnet}"
    local stderr_log
    stderr_log="$(dirname "$output_file")/claude-stderr.log"

    local -a tool_args=(--tools "")
    if [ "${#tools[@]}" -gt 0 ]; then
        local -a available_tools=()
        local tool_rule
        for tool_rule in "${tools[@]}"; do
            case "$tool_rule" in
                Read\(*\)) available_tools+=("Read") ;;
                *) available_tools+=("$tool_rule") ;;
            esac
        done
        tool_args=(--tools "${available_tools[@]}" \
            --allowedTools "${tools[@]}")
    fi
    local -a settings_args=()
    if [ -n "$ANALYZER_SETTINGS_FILE" ]; then
        settings_args=(--settings "$ANALYZER_SETTINGS_FILE")
    fi
    [[ "$timeout_secs" =~ ^[1-9][0-9]*$ ]] || {
        echo "Error: Analyzer timeout must be a positive integer." >&2
        return 1
    }
    ANALYZER_PROMPT_FILE="$(mktemp "/tmp/gh-pr-enrich-claude-prompt.XXXXXX")" || \
        return 1
    install_code_access_cleanup_traps
    if ! chmod 600 "$ANALYZER_PROMPT_FILE" || \
       ! printf '%s\n' "$user_prompt" > "$ANALYZER_PROMPT_FILE"; then
        cleanup_code_access_artifacts
        return 1
    fi

    # Elapsed time is the only progress signal available: --output-format json
    # writes nothing until the run completes. The heartbeat is the background job
    # and the analyzer runs in the foreground, because backgrounding the analyzer
    # makes the shell print its own job-death notice on an external kill.
    local heartbeat_interval
    heartbeat_interval="$(positive_integer_or_default \
        "${GH_PR_ENRICH_HEARTBEAT_SECONDS:-}" 60 86400)"
    local start_ts=$SECONDS
    (
        # The sleep runs as a killable child: terminating only the subshell would
        # orphan a sleeping process that still holds this function's stderr open,
        # which stalls any caller reading the output through a pipe.
        sleep_pid=""
        # Guard the empty case explicitly: `kill 0` signals the entire process
        # group, which would take the parent script and the analyzer with it.
        trap '[ -n "$sleep_pid" ] && kill "$sleep_pid" 2>/dev/null; exit 0' TERM
        waited=0
        while true; do
            sleep "$heartbeat_interval" &
            sleep_pid=$!
            if ! wait "$sleep_pid" 2>/dev/null; then
                sleep_pid=""
                exit 0
            fi
            sleep_pid=""
            waited=$((waited + heartbeat_interval))
            echo "   ⏳ still running ${label} — ${waited}s elapsed of ${timeout_secs}s" >&2
        done
    ) &
    ANALYZER_HEARTBEAT_PID=$!
    disown "$ANALYZER_HEARTBEAT_PID" 2>/dev/null || true

    local exit_code=0
    # --setting-sources "" bypasses plugin loading, which can hang.
    # CLAUDECODE is unset so this can run nested inside a Claude Code session.
    # stderr goes to a log rather than /dev/null: a discarded error message is the
    # difference between a diagnosable failure and a mysterious empty analysis.
    # The subshell's own stderr is dropped so the shell's job-death diagnostic
    # ("Killed: 9" plus the whole command line) never reaches the user.
    (
        claude_pid=""
        timeout_watcher_pid=""
        stop_timeout_watcher() {
            [ -n "$timeout_watcher_pid" ] || return 0
            kill -TERM "$timeout_watcher_pid" 2>/dev/null || true
            wait "$timeout_watcher_pid" 2>/dev/null || true
            timeout_watcher_pid=""
        }
        stop_claude_child() {
            [ -n "$claude_pid" ] || return 0
            kill -KILL "$claude_pid" 2>/dev/null || true
            wait "$claude_pid" 2>/dev/null || true
            claude_pid=""
        }
        stop_analyzer_wrapper() {
            local signal_exit="$1"
            stop_timeout_watcher
            stop_claude_child
            exit "$signal_exit"
        }
        trap 'stop_analyzer_wrapper 143' TERM
        trap 'stop_analyzer_wrapper 130' INT

        if [ -n "$ANALYZER_WORKING_DIRECTORY" ]; then
            cd "$ANALYZER_WORKING_DIRECTORY" || exit 1
        fi
        env -u CLAUDECODE -u CLAUDE_CODE_ENTRYPOINT \
            GH_PR_ENRICH_CLEANUP_OWNER_PID="$$" \
            GH_PR_ENRICH_ANALYZER_TIMEOUT_SECONDS="$timeout_secs" \
            claude --print \
            --setting-sources "" \
            "${settings_args[@]+"${settings_args[@]}"}" \
            --permission-mode dontAsk \
            --no-session-persistence \
            --model "$model" \
            --output-format json \
            --json-schema "$schema" \
            --system-prompt "$system_prompt" \
            "${tool_args[@]+"${tool_args[@]}"}" \
            < "$ANALYZER_PROMPT_FILE" > "$output_file" 2> "$stderr_log" &
        claude_pid=$!

        (
            watcher_sleep_pid=""
            trap '[ -n "$watcher_sleep_pid" ] && kill "$watcher_sleep_pid" 2>/dev/null; [ -z "$watcher_sleep_pid" ] || wait "$watcher_sleep_pid" 2>/dev/null; exit 0' TERM INT
            sleep "$timeout_secs" &
            watcher_sleep_pid=$!
            wait "$watcher_sleep_pid" 2>/dev/null || exit 0
            watcher_sleep_pid=""
            kill -KILL "$claude_pid" 2>/dev/null || true
        ) &
        timeout_watcher_pid=$!

        claude_exit=0
        wait "$claude_pid" || claude_exit=$?
        claude_pid=""
        stop_timeout_watcher
        exit "$claude_exit"
    ) 2>/dev/null &
    ANALYZER_CHILD_PID=$!
    if wait "$ANALYZER_CHILD_PID"; then
        ANALYZER_CHILD_PID=""
        terminate_analyzer_heartbeat
        echo "✅ ${label} complete ($((SECONDS - start_ts))s)" >&2
    else
        exit_code=$?
        ANALYZER_CHILD_PID=""
        terminate_analyzer_heartbeat
        # 124 = timeout with SIGTERM, 137 = timeout with SIGKILL (128 + 9)
        if [ "$exit_code" -eq 124 ] || [ "$exit_code" -eq 137 ]; then
            echo "⏱️  ${label} timed out after ${timeout_secs}s (set CLAUDE_TIMEOUT to increase)" >&2
        else
            echo "❌ ${label} failed (exit code: $exit_code)" >&2
        fi
        if [ -s "$stderr_log" ]; then
            echo "   Analyzer stderr (tail): $(tail -3 "$stderr_log" | tr '\n' ' ')" >&2
            echo "   Full log: $stderr_log" >&2
        fi
    fi

    rm -f "$ANALYZER_PROMPT_FILE"
    ANALYZER_PROMPT_FILE=""

    return $exit_code
}

