# Function to add GraphQL IDs to comments
create_comments_with_graphql_ids() {
    local input_file="$1"
    local output_file="$2"
    local comment_type="$3"

    jq --rawfile id_map "$OUTPUT_DIR/id-mapping.txt" '
        map(. as $comment |
            . + {
                graphql_id: (
                    if ($comment.id and ($comment.id | type == "number")) then
                        ($id_map | split("\n") | map(select(length > 0) | split(":")) | map({key: .[0], value: .[1]}) | from_entries | .[$comment.id|tostring])
                    else
                        null
                    end
                ),
                comment_type: $comment_type
            }
        )
    ' "$input_file" --arg comment_type "$comment_type" > "$output_file"
}

# ============================================================================
# Claude Enrichment Functions
# ============================================================================

# Fetch every review thread, following pagination.
#
# A single page silently caps a PR at 100 threads: the 101st comment simply does
# not exist as far as the analysis is concerned. gh --paginate walks the cursor
# and emits one JSON document per page; the pages are merged back into the single
# document shape the rest of the pipeline reads.
# Per-thread reply page used by the GraphQL fetch. The nested connection's
# pageInfo records exactly which threads have later replies the analyzer did
# not receive.
THREAD_COMMENT_LIMIT=20
LINKED_ISSUE_PAGE_SIZE=100
PR_CONNECTION_PAGE_SIZE=100

fetch_review_threads() {
    local owner="$1"
    local repo_name="$2"
    local pr_number="$3"
    local output_file="$4"

    local query='
    query($owner: String!, $name: String!, $prNumber: Int!, $endCursor: String) {
      repository(owner: $owner, name: $name) {
        pullRequest(number: $prNumber) {
          reviewThreads(first: 100, after: $endCursor) {
            totalCount
            pageInfo { hasNextPage endCursor }
            nodes {
              id
              isResolved
              isOutdated
              path
              line
              originalLine
              diffSide
              comments(first: '"$THREAD_COMMENT_LIMIT"') {
                totalCount
                pageInfo { hasNextPage endCursor }
                nodes {
                  id
                  databaseId
                  body
                  author { login }
                  createdAt
                  lastEditedAt
                  url
                }
              }
            }
          }
        }
      }
    }'

    local pages_file="${output_file}.pages"
    if ! run_report_command gh api graphql --paginate \
            -F owner="$owner" -F name="$repo_name" -F prNumber="$pr_number" \
            -f query="$query" > "$pages_file" 2>/dev/null; then
        rm -f "$pages_file"
        return 1
    fi
    if [ ! -s "$pages_file" ] || ! jq -s -e --argjson comment_limit \
            "$THREAD_COMMENT_LIMIT" '
        def threads: .data.repository.pullRequest.reviewThreads;
        length > 0 and
        all(.[];
            (((.errors // []) | length) == 0) and
            ((threads.nodes | type) == "array") and
            ((threads.totalCount | type) == "number") and
            (threads.totalCount >= 0) and
            ((threads.pageInfo.hasNextPage | type) == "boolean") and
            ((threads.pageInfo.endCursor | type) == "string" or
                threads.pageInfo.endCursor == null) and
            (if threads.pageInfo.hasNextPage then
                ((threads.pageInfo.endCursor | type) == "string" and
                    (threads.pageInfo.endCursor | length) > 0)
             else true end) and
            all(threads.nodes[];
                (.id | type) == "string" and (.id | length) > 0 and
                (.isResolved | type) == "boolean" and
                (.isOutdated | type) == "boolean" and
                (.comments.nodes | type) == "array" and
                (.comments.totalCount | type) == "number" and
                .comments.totalCount >= 0 and
                (.comments.nodes | length) <= $comment_limit and
                (.comments.nodes | length) <= .comments.totalCount and
                ((.comments.pageInfo.hasNextPage | type) == "boolean") and
                (if .comments.pageInfo.hasNextPage then
                    .comments.totalCount > (.comments.nodes | length) and
                    ((.comments.pageInfo.endCursor | type) == "string" and
                        (.comments.pageInfo.endCursor | length) > 0)
                 else .comments.totalCount == (.comments.nodes | length) end) and
                ([.comments.nodes[].id] | length) ==
                    ([.comments.nodes[].id] | unique | length))) and
        ([.[].data.repository.pullRequest.reviewThreads.totalCount] | unique | length) == 1 and
        ([.[].data.repository.pullRequest.reviewThreads.nodes[]] | map(.id) | length) ==
            ([.[].data.repository.pullRequest.reviewThreads.nodes[]] | map(.id) | unique | length) and
        ([.[].data.repository.pullRequest.reviewThreads.nodes[]] | length) ==
            .[0].data.repository.pullRequest.reviewThreads.totalCount and
        (.[-1].data.repository.pullRequest.reviewThreads.pageInfo.hasNextPage == false) and
        (if length > 1 then
            all(.[0:-1][];
                .data.repository.pullRequest.reviewThreads.pageInfo.hasNextPage == true)
         else true end)
    ' "$pages_file" > /dev/null 2>&1; then
        rm -f "$pages_file"
        return 1
    fi

    # Merge every page's nodes into one document, recording how many pages were read.
    jq -s '{
        data: {
            repository: {
                pullRequest: {
                    reviewThreads: {
                        nodes: (map(.data.repository.pullRequest.reviewThreads.nodes // []) | add // []),
                        totalCount: .[0].data.repository.pullRequest.reviewThreads.totalCount,
                        pages_fetched: length
                    }
                }
            }
        }
    }' "$pages_file" > "$output_file"
    local rc=$?
    rm -f "$pages_file"
    return $rc
}

# Canonical identity for every GitHub discussion input supplied to an analyzer.
# Arrays are treated as sets keyed by GitHub IDs so harmless API ordering does
# not invalidate a result, while additions, edits, deletions, thread moves, and
# resolution changes all do. Inline comments cover every review-thread reply,
# including replies beyond the bounded thread excerpt supplied to the model.
analysis_discussion_snapshot_from_files() {
    local report_dir="$1"
    local issue_file="$report_dir/issue-comments.json"
    local review_file="$report_dir/review-comments.json"
    local inline_file="$report_dir/inline-comments.json"
    local threads_file="$report_dir/comment-threads.json"
    local discussion_file

    for discussion_file in "$issue_file" "$review_file" "$inline_file" "$threads_file"; do
        [ -f "$discussion_file" ] && ! [ -L "$discussion_file" ] && \
            jq -e . "$discussion_file" > /dev/null 2>&1 || return 1
    done

    jq -cS -n \
        --slurpfile issue_doc "$issue_file" \
        --slurpfile review_doc "$review_file" \
        --slurpfile inline_doc "$inline_file" \
        --slurpfile threads_doc "$threads_file" '
        def text: if . == null then "" else tostring end;
        def stable_sort: sort_by(.id);
        ($issue_doc[0] // []) as $issues
        | ($review_doc[0] // []) as $reviews
        | ($inline_doc[0] // []) as $inline
        | (($threads_doc[0].data.repository.pullRequest.reviewThreads.nodes // [])) as $threads
        | if ($issues | type) != "array" or
             ($reviews | type) != "array" or
             ($inline | type) != "array" or
             ($threads | type) != "array" or
             any($issues[]; (.id | (type == "number" or type == "string") | not) or
                 ((.id | tostring | length) == 0) or (.body | type) != "string") or
             any($reviews[]; (.id | (type == "number" or type == "string") | not) or
                 ((.id | tostring | length) == 0) or (.body | type) != "string") or
             any($inline[]; (.id | (type == "number" or type == "string") | not) or
                 ((.id | tostring | length) == 0) or (.body | type) != "string") or
             ([$issues[].id | tostring] | length) !=
                 ([$issues[].id | tostring] | unique | length) or
             ([$reviews[].id | tostring] | length) !=
                 ([$reviews[].id | tostring] | unique | length) or
             ([$inline[].id | tostring] | length) !=
                 ([$inline[].id | tostring] | unique | length) or
             any($threads[];
                 (.id | type) != "string" or (.id | length) == 0 or
                 (.isResolved | type) != "boolean" or
                 (.isOutdated | type) != "boolean" or
                 (.comments.nodes | type) != "array" or
                 any(.comments.nodes[];
                     (.id | type) != "string" or (.id | length) == 0 or
                     (.body | type) != "string") or
                 ([.comments.nodes[].id] | length) !=
                     ([.comments.nodes[].id] | unique | length)) or
             ([$threads[].id] | length) != ([$threads[].id] | unique | length)
          then error("discussion inputs have invalid shapes")
          else {
            issue_comments: ([$issues[] | {
                id: (.id | text), body: (.body | text), user: (.user | text),
                created_at: (.created_at | text), updated_at: (.updated_at | text),
                html_url: (.html_url | text)
            }] | stable_sort),
            reviews: ([$reviews[] | {
                id: (.id | text), body: (.body | text), user: (.user | text),
                state: (.state | text), submitted_at: (.submitted_at | text),
                commit_id: (.commit_id | text), html_url: (.html_url | text)
            }] | stable_sort),
            inline_comments: ([$inline[] | {
                id: (.id | text), body: (.body | text), user: (.user | text),
                path: (.path | text), position: (.position | text),
                line: (.line | text), created_at: (.created_at | text),
                updated_at: (.updated_at | text), html_url: (.html_url | text)
            }] | stable_sort),
            review_threads: ([$threads[] | {
                id: (.id | text),
                is_resolved: .isResolved,
                is_outdated: .isOutdated,
                path: (.path | text), line: (.line | text),
                original_line: (.originalLine | text), diff_side: (.diffSide | text),
                comments: ([((.comments.nodes // [])[]) | {
                    id: (.id | text), database_id: (.databaseId | text),
                    body: (.body | text), author: (.author.login | text),
                    created_at: (.createdAt | text), last_edited_at: (.lastEditedAt | text),
                    url: (.url | text)
                }] | stable_sort)
            }] | stable_sort)
          }
          end
    '
}

analysis_discussion_fingerprint_from_files() {
    local report_dir="$1" digest=""
    digest="$(
        set -o pipefail
        analysis_discussion_snapshot_from_files "$report_dir" | sha256_stream
    )" || return 1
    [ -n "$digest" ] || return 1
    printf '%s\n' "$digest"
}

# Normalize the check fields that can affect analysis while ignoring response
# ordering. GitHub does not promise a stable order for `gh pr checks`, and a
# check transition must change this identity even when the PR head does not.
analysis_checks_snapshot_from_file() {
    local checks_file="$1"
    jq -cS '
        def text:
            if . == null then ""
            elif type == "string" then .
            else error("check field is not text")
            end;
        if type != "array" or any(.[]; type != "object") then
            error("checks input is not an array of objects")
        else
            [ .[] | {
                name: (.name | text),
                state: (.state | text),
                bucket: (.bucket | text),
                workflow: (
                    if (.workflow | type) == "object" then
                        (.workflow.name | text)
                    else
                        (.workflow | text)
                    end
                ),
                started_at: (.startedAt | text),
                completed_at: (.completedAt | text),
                event: (.event | text),
                link: (.link | text),
                description: (.description | text)
            } ]
            | sort_by([
                .name, .workflow, .event, .link, .state, .bucket,
                .started_at, .completed_at, .description
            ])
        end
    ' "$checks_file"
}

analysis_checks_fingerprint_from_file() {
    local checks_file="$1" digest=""
    digest="$(
        set -o pipefail
        analysis_checks_snapshot_from_file "$checks_file" | sha256_stream
    )" || return 1
    [ -n "$digest" ] || return 1
    printf '%s\n' "$digest"
}

