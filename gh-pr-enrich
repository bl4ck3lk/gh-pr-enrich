# Hidden test dispatcher (checked before PR_NUMBER validation).
#
#   gh-pr-enrich --test-call <function> [args...]
#
# Invokes one internal function directly so test suites exercise shipped code
# instead of a copy. Only functions named in TEST_CALLABLE_FUNCTIONS are
# dispatchable — argv must never be able to call arbitrary shell functions.
TEST_CALL_FN=""
TEST_CALL_ARGS=()
if [ "${1:-}" = "--test-call" ]; then
    if [ -z "${2:-}" ]; then
        echo "Error: --test-call requires a function name." >&2
        exit 1
    fi
    TEST_CALL_FN="$2"
    shift 2
    TEST_CALL_ARGS=("$@")
fi

# Skip CLI argument handling in test-call mode ($1 is not a PR number there)
if [ -z "$TEST_CALL_FN" ]; then
    PR_NUMBER=$1

    # Validate PR_NUMBER is a positive integer (prevent path traversal)
    if ! [[ "$PR_NUMBER" =~ ^[0-9]+$ ]]; then
        echo "Error: PR_NUMBER must be a positive integer, got: '$PR_NUMBER'"
        exit 1
    fi

    shift
    OUTPUT_FORMAT="combined"
    DEFAULT_OUTPUT_ROOT="${PR_REVIEW_OUTPUT_ROOT:-.reports/pr-reviews}"
    OUTPUT_DIR="$DEFAULT_OUTPUT_ROOT/pr-$PR_NUMBER"
    ENRICH_WITH_CLAUDE=false
    PREPARE_ANALYSIS=false
    ALLOW_EXTERNAL=false
    INCLUDE_DIFF=false
    RUN_SAST=false
    CUSTOM_PROMPT_FILE=""
    REPO_INFO=$(gh repo view --json nameWithOwner,visibility 2>/dev/null || echo '{}')
    REPO=$(printf '%s' "$REPO_INFO" | jq -r '.nameWithOwner // "current-repo"' 2>/dev/null || echo "current-repo")
    REPOSITORY_VISIBILITY=$(printf '%s' "$REPO_INFO" | jq -r '.visibility // "UNKNOWN"' 2>/dev/null || echo "UNKNOWN")
    REPOSITORY_VISIBILITY=$(printf '%s' "$REPOSITORY_VISIBILITY" | tr '[:lower:]' '[:upper:]')
fi

TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

# Get the directory where this extension is installed
get_extension_dir() {
    local script_path
    script_path="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    echo "$script_path"
}

# Load system prompt from file, filtering out comments
# Priority: --prompt arg > $GH_PR_ENRICH_PROMPT > default-prompt.txt.
# Repository-owned files never become system prompts implicitly: PR branches are
# untrusted input, and an override there could remove the bundled injection and
# tool-safety rules before external analysis begins.
load_system_prompt() {
    local prompt_file=""
    local extension_dir
    extension_dir="$(get_extension_dir)"

    # Check --prompt argument first (highest priority)
    if [ -n "$CUSTOM_PROMPT_FILE" ] && [ -f "$CUSTOM_PROMPT_FILE" ]; then
        prompt_file="$CUSTOM_PROMPT_FILE"
    # Check environment variable
    elif [ -n "${GH_PR_ENRICH_PROMPT:-}" ] && [ -f "$GH_PR_ENRICH_PROMPT" ]; then
        prompt_file="$GH_PR_ENRICH_PROMPT"
    # Fall back to bundled default
    elif [ -f "$extension_dir/default-prompt.txt" ]; then
        prompt_file="$extension_dir/default-prompt.txt"
    fi

    if [ -z "$prompt_file" ]; then
        # No inline fallback: the prompt and the JSON schema are one contract, and
        # a built-in prompt describing a different one would steer the model one
        # way while validating it another. A missing bundled prompt means a broken
        # install, which is worth failing on.
        echo "❌ No analysis prompt found: $extension_dir/default-prompt.txt is missing." >&2
        echo "   Reinstall the extension (gh extension upgrade pr-enrich), or pass --prompt FILE." >&2
        return 1
    fi

    # Filter out comment lines and leading blank lines (portable: works on BSD and GNU)
    grep -v '^#' "$prompt_file" | awk 'NF{found=1} found'
}

# Parse options (skipped in test-call mode)
if [ -z "$TEST_CALL_FN" ]; then
    while [[ $# -gt 0 ]]; do
    case $1 in
        --json)
            OUTPUT_FORMAT="json"
            shift
            ;;
        --markdown)
            OUTPUT_FORMAT="markdown"
            shift
            ;;
        --output-dir)
            if [ -z "${2:-}" ]; then
                echo "Error: --output-dir requires a directory path."
                exit 1
            fi
            OUTPUT_DIR="$2"
            shift 2
            ;;
        --enrich)
            ENRICH_WITH_CLAUDE=true
            shift
            ;;
        --prepare-analysis)
            PREPARE_ANALYSIS=true
            shift
            ;;
        --allow-external)
            ALLOW_EXTERNAL=true
            shift
            ;;
        --diff)
            INCLUDE_DIFF=true
            shift
            ;;
        --sast)
            RUN_SAST=true
            shift
            ;;
        --no-code-access)
            # For sandboxed or offline runs: the analyzer reasons from the supplied
            # context only and cannot open the repository to verify claims.
            export GH_PR_ENRICH_CODE_ACCESS=false
            shift
            ;;
        --code-access)
            # Analyze the working tree even when it is not the PR's revision.
            # Findings may then cite code this PR does not contain.
            export GH_PR_ENRICH_CODE_ACCESS=true
            shift
            ;;
        --model)
            if [ -z "${2:-}" ]; then
                echo "Error: --model requires a model name."
                exit 1
            fi
            export GH_PR_ENRICH_MODEL="$2"
            shift 2
            ;;
        --prompt)
            if [ -z "${2:-}" ]; then
                echo "Error: --prompt requires a file path."
                exit 1
            fi
            if [ ! -f "$2" ]; then
                echo "Error: Prompt file not found: $2"
                exit 1
            fi
            CUSTOM_PROMPT_FILE="$2"
            shift 2
            ;;
        *)
            echo "Unknown option: $1"
            echo "Run 'gh pr-enrich --help' for usage"
            exit 1
            ;;
    esac
done
fi  # End of: if [ -z "$TEST_CALL_FN" ] for argument parsing

# Ensure jq is available
if ! command -v jq &> /dev/null; then
    echo "Error: jq is required but not installed."
    echo "Install with: brew install jq (macOS) or apt-get install jq (Linux)"
    exit 1
fi

# External disclosure gate. PR content is untrusted and may be private; an agent
# selecting --enrich is not itself evidence that the user authorized disclosure.
# Public PRs need no extra flag. PRIVATE, INTERNAL, and unknown visibility fail
# closed until --allow-external is present.
if [ "$ENRICH_WITH_CLAUDE" = true ]; then
    case "$REPOSITORY_VISIBILITY" in PUBLIC) ;; *)
        if [ "$ALLOW_EXTERNAL" != true ]; then
            echo "Error: Repository visibility is $REPOSITORY_VISIBILITY; external Claude enrichment is blocked." >&2
            echo "Re-run with --allow-external only after the user explicitly authorizes disclosure." >&2
            exit 1
        fi
        ;;
    esac

    # A requested provider that cannot run is a failed operation, not a reason to
    # fall back to an older selected result in the report directory.
    if ! command -v claude &> /dev/null; then
        echo "Error: Claude CLI not found; requested enrichment cannot run." >&2
        echo "Install from: https://claude.ai/code" >&2
        exit 1
    fi
fi

