# External disclosure gate. PR content is untrusted and may be private; an agent
# selecting --enrich is not itself evidence that the user authorized disclosure.
# Public PRs need no extra flag. PRIVATE, INTERNAL, and unknown visibility fail
# closed until --allow-external is present.
if [ "$ENRICH_WITH_CLAUDE" = true ]; then
