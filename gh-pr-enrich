}

# Optional static-analysis pre-pass over the files the PR touches.
#
# Semgrep rule execution is deterministic for fixed inputs, but its matches can
# still be false positives. Matches enter the context as evidence candidates the
# analyzer must confirm or refute. A missing semgrep is a warning, never a failed run.
# Run Semgrep with an owned watchdog instead of depending on GNU timeout, which
# is absent on stock macOS. The wrapper owns, terminates, and reaps both direct
# children on completion or interruption.
run_semgrep_with_watchdog() {
    local timeout_secs="$1" raw_file="$2" stderr_file="$3" config="$4"
    local working_directory="$5"
    shift 5
    local -a targets=("$@")
    local semgrep_pid="" watchdog_pid="" semgrep_rc=0 watchdog_rc=0
    local semgrep_group_owned=false
    local semgrep_starting=false watchdog_starting=false semgrep_wrapper_signal=""
    local launch_attempts=0
    local semgrep_launch_dir="" watchdog_launch_dir=""
    cleanup_semgrep_launch() {
        [ -n "$semgrep_launch_dir" ] || return 0
        rm -f "$semgrep_launch_dir/ready" "$semgrep_launch_dir/go" 2>/dev/null || true
        rmdir "$semgrep_launch_dir" 2>/dev/null || true
        semgrep_launch_dir=""
    }
    cleanup_semgrep_watchdog_launch() {
        [ -n "$watchdog_launch_dir" ] || return 0
        rm -f "$watchdog_launch_dir/ready" "$watchdog_launch_dir/go" \
            "$watchdog_launch_dir/started" \
            "$watchdog_launch_dir/completed" 2>/dev/null || true
        rmdir "$watchdog_launch_dir" 2>/dev/null || true
        watchdog_launch_dir=""
    }
    stop_semgrep_watchdog() {
        if [ -n "$watchdog_pid" ]; then
            kill -TERM "$watchdog_pid" 2>/dev/null || true
            wait "$watchdog_pid" 2>/dev/null || true
            watchdog_pid=""
        fi
        cleanup_semgrep_watchdog_launch
    }
    stop_semgrep_group() {
        [ -n "$semgrep_pid" ] || return 0
        # Job control gives the scanner an isolated process group on Bash 3.2,
        # including stock macOS where setsid is unavailable. Terminate every
        # descendant in that group, then reap the direct scanner child.
        if [ "$semgrep_group_owned" = true ]; then
            kill -TERM -- "-$semgrep_pid" 2>/dev/null || true
            kill -KILL -- "-$semgrep_pid" 2>/dev/null || true
        else
            kill -TERM "$semgrep_pid" 2>/dev/null || true
            kill -KILL "$semgrep_pid" 2>/dev/null || true
        fi
        wait "$semgrep_pid" 2>/dev/null || true
        semgrep_pid=""
        cleanup_semgrep_launch
    }
    stop_semgrep_wrapper() {
        local signal_exit="$1"
        stop_semgrep_watchdog
        stop_semgrep_group
        exit "$signal_exit"
    }
    handle_semgrep_wrapper_signal() {
        local signal_name="$1"
        [ -n "$semgrep_wrapper_signal" ] || semgrep_wrapper_signal="$signal_name"
        if [ "$semgrep_starting" = true ] || [ "$watchdog_starting" = true ]; then
            return 0
        fi
        case "$semgrep_wrapper_signal" in
            TERM) stop_semgrep_wrapper 143 ;;
            INT) stop_semgrep_wrapper 130 ;;
        esac
    }
    trap 'handle_semgrep_wrapper_signal TERM' TERM
    trap 'handle_semgrep_wrapper_signal INT' INT
    is_private_code_snapshot_path "$working_directory" || return 125

    # Keep the direct child behind a private launch gate while the wrapper proves
    # that Bash put it in the expected isolated process group. Never use a
    # negative PID until that proof succeeds: a failed job-control assumption
    # must not target the caller's process group.
    semgrep_launch_dir="$(mktemp -d "${TMPDIR:-/tmp}/gh-pr-enrich-semgrep-launch.XXXXXX")" || return 125
    set -m
    semgrep_starting=true
    GH_PR_ENRICH_SEMGREP_TIMEOUT_SECONDS="$timeout_secs" \
        /bin/sh -c '
            launch_dir="$1"
            working_directory="$2"
            shift 2
            : > "$launch_dir/ready"
            while [ ! -f "$launch_dir/go" ]; do :; done
            cd "$working_directory" || exit 125
            exec "$@"
        ' sh "$semgrep_launch_dir" "$working_directory" \
            semgrep --config "$config" --json --quiet -- "${targets[@]}" \
        > "$raw_file" 2> "$stderr_file" &
    semgrep_pid=$!
    semgrep_starting=false
    [ -z "$semgrep_wrapper_signal" ] || handle_semgrep_wrapper_signal "$semgrep_wrapper_signal"
    launch_attempts=0
    while [ ! -f "$semgrep_launch_dir/ready" ] && [ "$launch_attempts" -lt 100 ]; do
        kill -0 "$semgrep_pid" 2>/dev/null || break
        /bin/sleep 0.01
        launch_attempts=$((launch_attempts + 1))
    done
    if [ -f "$semgrep_launch_dir/ready" ] && \
       kill -0 -- "-$semgrep_pid" 2>/dev/null; then
        semgrep_group_owned=true
        : > "$semgrep_launch_dir/go"
    else
        set +m
        stop_semgrep_group
        echo "Error: Could not isolate the Semgrep process group." >&2
        return 125
    fi
    set +m
    watchdog_launch_dir="$(mktemp -d "${TMPDIR:-/tmp}/gh-pr-enrich-semgrep-watchdog.XXXXXX")" || {
        stop_semgrep_group
        return 125
    }
    watchdog_starting=true
    (
        watchdog_fired=false watchdog_attempt=0
        watchdog_limit=$((timeout_secs * 10))
        trap '[ "$watchdog_fired" = true ] || exit 0' TERM INT
        : > "$watchdog_launch_dir/ready"
        while [ ! -f "$watchdog_launch_dir/go" ]; do :; done
        : > "$watchdog_launch_dir/started"
        while [ "$watchdog_attempt" -lt "$watchdog_limit" ]; do
            [ ! -f "$watchdog_launch_dir/completed" ] || exit 0
            if ! sleep 0.1; then
                [ "$semgrep_group_owned" != true ] || \
                    kill -TERM -- "-$semgrep_pid" 2>/dev/null || true
                [ "$semgrep_group_owned" != true ] || \
                    kill -KILL -- "-$semgrep_pid" 2>/dev/null || true
                exit 1
            fi
            watchdog_attempt=$((watchdog_attempt + 1))
        done
        [ ! -f "$watchdog_launch_dir/completed" ] || exit 0
        watchdog_fired=true
        if [ "$semgrep_group_owned" = true ]; then
            kill -TERM -- "-$semgrep_pid" 2>/dev/null || true
            kill -KILL -- "-$semgrep_pid" 2>/dev/null || true
        else
            kill -TERM "$semgrep_pid" 2>/dev/null || true
            kill -KILL "$semgrep_pid" 2>/dev/null || true
        fi
        exit 124
    ) &
    watchdog_pid=$!
    watchdog_starting=false
    [ -z "$semgrep_wrapper_signal" ] || handle_semgrep_wrapper_signal "$semgrep_wrapper_signal"
    launch_attempts=0
    while [ ! -f "$watchdog_launch_dir/ready" ] && [ "$launch_attempts" -lt 100 ]; do
        kill -0 "$watchdog_pid" 2>/dev/null || break
        /bin/sleep 0.01
        launch_attempts=$((launch_attempts + 1))
    done
    if [ ! -f "$watchdog_launch_dir/ready" ]; then
        stop_semgrep_watchdog
        stop_semgrep_group
        echo "Error: Could not initialize the Semgrep timeout watcher." >&2
        return 125
    fi
    : > "$watchdog_launch_dir/go"
    launch_attempts=0
    while [ ! -f "$watchdog_launch_dir/started" ] && [ "$launch_attempts" -lt 100 ]; do
        kill -0 "$watchdog_pid" 2>/dev/null || break
        /bin/sleep 0.01
        launch_attempts=$((launch_attempts + 1))
    done
    if [ ! -f "$watchdog_launch_dir/started" ]; then
        stop_semgrep_watchdog
        stop_semgrep_group
        echo "Error: Could not start the Semgrep timeout watcher." >&2
        return 125
    fi

    wait "$semgrep_pid" || semgrep_rc=$?
    semgrep_pid=""
    cleanup_semgrep_launch
    if [ -n "$watchdog_pid" ]; then
        if ! : > "$watchdog_launch_dir/completed"; then
            stop_semgrep_watchdog
            echo "Error: Could not notify the Semgrep timeout watcher of scan completion." >&2
            return 125
        fi
        wait "$watchdog_pid" 2>/dev/null || watchdog_rc=$?
        watchdog_pid=""
    fi
    cleanup_semgrep_watchdog_launch
    if [ "$watchdog_rc" -eq 124 ]; then
        return 124
    fi
    if [ "$watchdog_rc" -ne 0 ]; then
        echo "Error: Semgrep timeout watcher failed (exit $watchdog_rc)." >&2
        return 125
    fi
    return "$semgrep_rc"
}

collect_sast_findings() {
    local output_dir="$1"
    local config="${GH_PR_ENRICH_SEMGREP_CONFIG:-auto}"
    local timeout_secs requested_timeout="${GH_PR_ENRICH_SEMGREP_TIMEOUT:-}"
    if [ -n "$requested_timeout" ]; then
        timeout_secs="$(positive_integer_or_default \
            "$requested_timeout" "" 86400)"
        if [ -z "$timeout_secs" ]; then
            echo "⚠️  GH_PR_ENRICH_SEMGREP_TIMEOUT must be an integer from 1 to 86400; using 180 seconds." >&2
            timeout_secs=180
        fi
    else
        timeout_secs=180
    fi
    local output_file="$output_dir/sast-findings.json"
    local status_file="$output_dir/sast-status.json"
    local sast_workspace_fingerprint=""
    local raw_file="$output_dir/semgrep-raw.json"
    local rc=0 semgrep_wrapper_pid="" semgrep_signal=""
    local semgrep_wrapper_starting=false
    local sast_previous_term_trap sast_previous_int_trap
    sast_previous_term_trap="$(trap -p TERM)"
    sast_previous_int_trap="$(trap -p INT)"
    write_sast_status() {
        local requested="$1" status="$2" reason="$3"
        jq -n --argjson requested "$requested" --arg status "$status" \
            --arg reason "$reason" \
            --arg workspace_fingerprint "$sast_workspace_fingerprint" '
            {requested: $requested, status: $status, reason: $reason}
            + if $workspace_fingerprint == "" then {}
              else {workspace_source: "immutable_snapshot",
                    workspace_fingerprint: $workspace_fingerprint}
              end
        ' > "$status_file"
    }
    stop_owned_semgrep_wrapper() {
        [ -n "$semgrep_wrapper_pid" ] || return 0
        kill -TERM "$semgrep_wrapper_pid" 2>/dev/null || true
        wait "$semgrep_wrapper_pid" 2>/dev/null || true
        semgrep_wrapper_pid=""
    }
    restore_sast_signal_traps() {
        restore_code_access_cleanup_traps || true
        trap - TERM INT
        [ -z "$sast_previous_term_trap" ] || eval "$sast_previous_term_trap"
        [ -z "$sast_previous_int_trap" ] || eval "$sast_previous_int_trap"
    }
    finish_sast_cancellation() {
        local signal_name="$1" signal_exit="$2"
        # Repeated signals and report-write failures cannot interrupt cleanup or
        # replace the conventional signal status. The private snapshot is the
        # authoritative cleanup boundary; report artifacts are best-effort.
        trap '' TERM INT
        stop_owned_semgrep_wrapper || true
        cleanup_code_access_artifacts || true
        trap '' TERM INT
        rm -f "$raw_file" 2>/dev/null || true
        printf '[]\n' > "$output_file" 2>/dev/null || true
        write_sast_status true "failed" \
            "semgrep scan cancelled by $signal_name" 2>/dev/null || true
        restore_sast_signal_traps
        trap '' TERM INT
        exit "$signal_exit"
    }
    handle_sast_signal() {
        local signal_name="$1"
        [ -n "$semgrep_signal" ] || semgrep_signal="$signal_name"
        [ "$semgrep_wrapper_starting" != true ] || return 0
        case "$semgrep_signal" in
            TERM) finish_sast_cancellation TERM 143 ;;
            INT) finish_sast_cancellation INT 130 ;;
        esac
    }
    install_sast_signal_traps() {
        trap 'handle_sast_signal TERM' TERM
        trap 'handle_sast_signal INT' INT
    }

    echo '[]' > "$output_file"
    write_sast_status true "running" ""
    install_sast_signal_traps

    if ! command -v semgrep > /dev/null 2>&1; then
        echo "⚠️  semgrep not found — skipping the static-analysis pre-pass." >&2
        echo "   Install it (pip install semgrep) or drop --sast." >&2
        write_sast_status true "skipped" "semgrep executable not found"
        restore_sast_signal_traps
        return 0
    fi

    # The scan reads the working tree, so it is bound by the same revision rule as
    # the analyzer. Scanning an unrelated revision produces findings with line
    # anchors for code the PR does not contain — and they enter the context
    # presented as snapshot-bound rule matches, which is worse than having none.
    local pr_head_sha access_line declared_changed_files captured_changed_files
    local snapshot_source="git_index"
    [ "${GH_PR_ENRICH_CODE_ACCESS:-}" != true ] || snapshot_source="working_tree"
    # The SAST pass runs before analysis-context.json is built. Bind it directly
    # to the immutable GitHub snapshot that was fetched earlier in this run.
    pr_head_sha="$(jq -r '.headRefOid // ""' \
        "$output_dir/pr-summary.json" 2>/dev/null || echo "")"
    access_line="$(resolve_code_access "$pr_head_sha" "$output_dir")"
    if [ "${access_line%%:*}" = "disabled" ]; then
        echo "⚠️  Skipping the semgrep pre-pass: ${access_line#*: }" >&2
        write_sast_status true "skipped" "${access_line#*: }"
        restore_sast_signal_traps
        return 0
    fi

    # `gh pr view` caps its changed-file connection at 100. The main collector
    # replaces a capped array with a validated paginated connection; enforce
    # that invariant again at the scan boundary so a partial summary can never
    # produce deterministic-looking SAST coverage.
    declared_changed_files="$(jq -r '.changedFiles // empty' \
        "$output_dir/pr-summary.json" 2>/dev/null || echo "")"
    captured_changed_files="$(jq -r '(.files // []) | length' \
        "$output_dir/pr-summary.json" 2>/dev/null || echo "")"
    if [ -n "$declared_changed_files" ] && \
       { ! [[ "$declared_changed_files" =~ ^[0-9]+$ ]] || \
         [ "$captured_changed_files" != "$declared_changed_files" ]; }; then
        echo "⚠️  Changed-file collection is incomplete; refusing the semgrep pre-pass." >&2
        write_sast_status true "failed" \
            "complete changed-file pagination was not available"
        restore_sast_signal_traps
        return 0
    fi

    # Freeze the exact granted workspace before Semgrep reads any code. Paths in
    # the findings remain repository-relative, but every byte comes from this
    # private read-only snapshot rather than the mutable checkout.
    sast_workspace_fingerprint="$(code_access_workspace_fingerprint \
        "$output_dir" "" "$snapshot_source" 2>/dev/null || echo "")"
    if [ -z "$sast_workspace_fingerprint" ] || \
       ! create_code_access_snapshot "$output_dir" "$sast_workspace_fingerprint" \
            "$snapshot_source"; then
        cleanup_code_access_snapshot
        echo "⚠️  Could not create an immutable workspace snapshot for semgrep." >&2
        write_sast_status true "failed" \
            "immutable workspace snapshot could not be created"
        restore_sast_signal_traps
        return 0
    fi
    local sast_snapshot_path="$CODE_ACCESS_SNAPSHOT_DIR"
    install_sast_signal_traps

    # Scan only changed regular files represented by the captured manifest.
    local -a targets=()
    local path
    while IFS= read -r -d '' path; do
        case "$path" in ""|/*|../*|*/../*|*/..) continue ;; esac
        [ -f "$sast_snapshot_path/$path" ] && targets+=("./$path")
    done < <(jq -j '(.files // [])[] | .path, "\u0000"' \
        "$output_dir/pr-summary.json" 2>/dev/null)

    if [ "${#targets[@]}" -eq 0 ]; then
        echo "ℹ️  No changed files present in the immutable workspace snapshot — skipping semgrep." >&2
        write_sast_status true "skipped" \
            "no changed files were present in the matched workspace snapshot"
        cleanup_code_access_snapshot
        restore_sast_signal_traps
        return 0
    fi

    semgrep_wrapper_starting=true
    run_semgrep_with_watchdog "$timeout_secs" "$raw_file" \
        "$output_dir/semgrep-stderr.log" "$config" "$sast_snapshot_path" \
        "${targets[@]}" &
    semgrep_wrapper_pid=$!
    semgrep_wrapper_starting=false
    [ -z "$semgrep_signal" ] || handle_sast_signal "$semgrep_signal"
    wait "$semgrep_wrapper_pid" || rc=$?
    semgrep_wrapper_pid=""

    local current_workspace_fingerprint
    current_workspace_fingerprint="$(code_access_workspace_fingerprint \
        "$output_dir" "" "$snapshot_source" 2>/dev/null || echo "")"
    cleanup_code_access_artifacts
    if [ -z "$current_workspace_fingerprint" ] || \
       [ "$current_workspace_fingerprint" != "$sast_workspace_fingerprint" ]; then
        rm -f "$raw_file"
        echo "⚠️  Workspace changed during the semgrep pre-pass; discarding its output." >&2
        write_sast_status true "failed" \
            "workspace fingerprint changed during immutable snapshot scan"
        restore_sast_signal_traps
        return 0
    fi

    if [ "$rc" -eq 124 ]; then
        rm -f "$raw_file"
        echo '[]' > "$output_file"
        echo "⚠️  semgrep timed out after $timeout_secs seconds; discarding partial output." >&2
        write_sast_status true "failed" \
            "semgrep timed out after $timeout_secs seconds"
        restore_sast_signal_traps
        return 0
    fi

    if [ "$rc" -eq 125 ]; then
        rm -f "$raw_file"
        echo '[]' > "$output_file"
        echo "⚠️  Semgrep execution wrapper failed; discarding partial output." >&2
        write_sast_status true "failed" \
            "semgrep execution wrapper failed before scan completion"
        restore_sast_signal_traps
        return 0
    fi

    if [ "$rc" -eq 130 ] || [ "$rc" -eq 143 ]; then
        rm -f "$raw_file"
        echo '[]' > "$output_file"
        write_sast_status true "failed" \
            "semgrep execution wrapper was interrupted before scan completion"
        restore_sast_signal_traps
        return 0
    fi

    if [ "$rc" -ne 0 ] && [ ! -s "$raw_file" ]; then
        echo "⚠️  semgrep failed (exit $rc). See $output_dir/semgrep-stderr.log" >&2
        write_sast_status true "failed" "semgrep exited $rc without usable JSON"
        restore_sast_signal_traps
        return 0
    fi

    if ! jq -e 'type == "object" and has("results") and
            (.results | type == "array")' \
            "$raw_file" > /dev/null 2>&1; then
        echo '[]' > "$output_file"
        write_sast_status true "failed" \
            "semgrep output root was not an object with a results array"
        restore_sast_signal_traps
        return 0
    fi

    if ! jq --arg snapshot_root "$sast_snapshot_path" '[
        .results[] |
        (.path // "") as $raw_path |
        (if ($raw_path | startswith($snapshot_root + "/")) then
            $raw_path[($snapshot_root | length) + 1:]
         elif ($raw_path | startswith("./")) then
            $raw_path[2:]
         elif ($raw_path | startswith("/")) or
              ($raw_path == "..") or ($raw_path | startswith("../")) or
              ($raw_path | contains("/../")) then
            error("semgrep returned a path outside the immutable snapshot")
         else $raw_path end) as $repository_path |
        {
        check_id: .check_id,
        path: $repository_path,
        line: (.start.line // 0),
        severity: (.extra.severity // "INFO"),
        message: (.extra.message // ""),
        cwe: ((.extra.metadata.cwe // []) | if type == "array" then . else [.] end)
    }]' "$raw_file" > "$output_file" 2>/dev/null; then
        echo '[]' > "$output_file"
        write_sast_status true "failed" "semgrep output was not valid snapshot-bound result JSON"
        restore_sast_signal_traps
        return 0
    fi

    local count
    count=$(jq 'length' "$output_file" 2>/dev/null || echo 0)
    echo "🔍 semgrep: $count finding(s) across ${#targets[@]} changed file(s)" >&2
    if [ "$rc" -eq 0 ]; then
        write_sast_status true "completed" ""
    else
        write_sast_status true "completed_with_errors" \
            "semgrep exited $rc after returning parseable results"
    fi
    restore_sast_signal_traps
    return 0
}


# Decide whether the analyzer may read the working tree.
#
# Reading files only helps if those files are the PR's files. Analyzing PR #123
# from `main` would let the model "verify" against code the PR does not contain
# and emit confirmed verdicts with file:line anchors that point at the wrong
# revision — worse than not reading at all, because the output looks verified.
#
# Prints "enabled" or "disabled" followed by the reason. Honors an explicit
# GH_PR_ENRICH_CODE_ACCESS setting in both directions.
resolve_code_access() {
    local pr_head_sha="${1:-}"
    local ignored_output_dir="${2:-}"
    local explicit="${GH_PR_ENRICH_CODE_ACCESS:-}"

    if [ "$explicit" = "false" ]; then
        echo "disabled: repository access turned off by --no-code-access"
        return 0
    fi

    local local_head=""
    if command -v git > /dev/null 2>&1; then
        local_head="$(git rev-parse HEAD 2>/dev/null || echo "")"
    fi

    if [ -z "$local_head" ]; then
        if [ "$explicit" = "true" ]; then
            echo "enabled: not a git checkout, but access was requested explicitly"
            return 0
        fi
        echo "disabled: not a git checkout, so the working tree cannot be matched to the PR"
        return 0
    fi

    local dirty_state tracked_state repo_root output_abs output_rel index_modes
    repo_root="$(git rev-parse --show-toplevel 2>/dev/null || echo "")"
    dirty_state=""
    tracked_state=""
    if [ -n "$repo_root" ]; then
        if ! index_modes="$(git -C "$repo_root" ls-files --stage -- . \
                2>/dev/null | cut -d ' ' -f 1 | LC_ALL=C sort -u)"; then
            echo "disabled: Git index modes could not be inspected safely"
            return 0
        fi
        if [ -n "$index_modes" ] && \
           printf '%s\n' "$index_modes" | grep -Evq '^(100644|100755)$'; then
            echo "disabled: tracked symlinks, gitlinks, and other non-regular index entries are not supported by immutable code snapshots"
            return 0
        fi
        # Generated report paths are never allowed to hide modifications to
        # tracked files. Check tracked state independently before considering
        # any output-directory exclusion.
        if ! tracked_state="$(git -C "$repo_root" status --porcelain --untracked-files=no 2>/dev/null)"; then
            echo "disabled: git status failed, so workspace cleanliness cannot be verified"
            return 0
        fi
    fi
    if [ -n "$tracked_state" ]; then
        dirty_state="$tracked_state"
    fi
    if [ -n "$repo_root" ] && [ -n "$ignored_output_dir" ]; then
        output_abs="$(canonicalize_path "$ignored_output_dir")"
        case "$output_abs/" in
            "$repo_root/"*)
                output_rel="${output_abs#"$repo_root/"}"
                if [ -z "$dirty_state" ] && [ "$output_abs" = "$repo_root" ]; then
                    if ! dirty_state="$(git -C "$repo_root" status --porcelain \
                            --untracked-files=all --ignored=matching 2>/dev/null)"; then
                        echo "disabled: git status failed, so workspace cleanliness cannot be verified"
                        return 0
                    fi
                elif [ -z "$dirty_state" ]; then
                    # Git collapses ignored directories to one status entry, so
                    # exact pathspec exclusions cannot distinguish generated
                    # files from user files inside that directory. Inspect every
                    # output file against the closed generated-artifact allowlist
                    # first; only then may the directory itself be excluded.
                    local candidate relative unexpected_output="" output_inventory=""
                    if [ -d "$output_abs" ]; then
                        output_inventory="$(mktemp "${TMPDIR:-/tmp}/gh-pr-enrich-output.XXXXXX")"
                        if ! find "$output_abs" -mindepth 1 \( -type f -o -type l \) \
                                -print > "$output_inventory" 2>/dev/null; then
                            rm -f "$output_inventory"
                            echo "disabled: report output directory could not be inspected safely"
                            return 0
                        fi
                        while IFS= read -r candidate; do
                            relative="${candidate#"$output_abs/"}"
                            if [ -L "$candidate" ]; then
                                unexpected_output="$relative (symbolic link)"
                                break
                            fi
                            if ! is_generated_report_artifact "$relative"; then
                                unexpected_output="$relative"
                                break
                            fi
                        done < "$output_inventory"
                        rm -f "$output_inventory"
                    fi
                    if [ -n "$unexpected_output" ]; then
                        dirty_state="?? $output_rel/$unexpected_output"
                    else
                        if ! dirty_state="$(git -C "$repo_root" status --porcelain \
                                --untracked-files=all --ignored=matching -- . \
                                ":(exclude,literal)$output_rel" 2>/dev/null)"; then
                            echo "disabled: git status failed, so workspace cleanliness cannot be verified"
                            return 0
                        fi
                    fi
                fi
                ;;
            *)
                if [ -z "$dirty_state" ] && ! dirty_state="$(git -C "$repo_root" status --porcelain \
                        --untracked-files=all --ignored=matching 2>/dev/null)"; then
                    echo "disabled: git status failed, so workspace cleanliness cannot be verified"
                    return 0
                fi
                ;;
        esac
    else
        if [ -z "$dirty_state" ] && ! dirty_state="$(git status --porcelain \
                --untracked-files=all --ignored=matching 2>/dev/null)"; then
            echo "disabled: git status failed, so workspace cleanliness cannot be verified"
            return 0
        fi
    fi
    if [ -n "$dirty_state" ]; then
        if [ "$explicit" = "true" ]; then
            echo "enabled: working tree has uncommitted or untracked files; explicit code-access override exposes that workspace to the analyzer"
            return 0
        fi
        echo "disabled: working tree has uncommitted or untracked files, so external tools cannot be confined to the reviewed PR snapshot"
        return 0
    fi

    if [ -z "$pr_head_sha" ] || [ "$pr_head_sha" = "null" ]; then
        if [ "$explicit" = "true" ]; then
            echo "enabled: PR head revision unknown, but access was requested explicitly"
            return 0
        fi
        echo "disabled: PR head revision unknown, so the working tree cannot be matched to the PR"
        return 0
    fi

    if [ "$local_head" = "$pr_head_sha" ]; then
        echo "enabled: working tree is at the PR head (${local_head:0:7})"
        return 0
    fi

    if [ "$explicit" = "true" ]; then
        echo "enabled: working tree is at ${local_head:0:7}, not the PR head ${pr_head_sha:0:7} — findings may cite local-only code (override in effect)"
        return 0
    fi

    # A clean descendant can still contain local-only code, secrets, or unrelated
    # commits that are absent from the hosted PR snapshot. Only an explicit
    # override may widen external analyzer access beyond the exact PR head.
    if git merge-base --is-ancestor "$pr_head_sha" HEAD 2>/dev/null; then
        local ahead
        ahead="$(git rev-list --count "$pr_head_sha..HEAD" 2>/dev/null || echo "?")"
        echo "disabled: working tree is ${ahead} commit(s) ahead of the PR head (${pr_head_sha:0:7}); use --code-access only to expose those local commits explicitly"
        return 0
    fi

    echo "disabled: working tree is at ${local_head:0:7} but the PR head is ${pr_head_sha:0:7}. Run 'gh pr checkout <PR>' first, or pass --code-access to analyze the tree as it is."
    return 0
}

CLAUDE_CAPTURED_PR_HEAD=""
CLAUDE_CAPTURED_CONTEXT_FINGERPRINT=""
CLAUDE_CAPTURED_WORKSPACE_FINGERPRINT=""
CLAUDE_DISCLOSURE_GATE_FAILED=false

# Re-query every public repository whose content is about to cross the external
# provider boundary without an explicit disclosure override. Linked issues are
# resolved by immutable node ID so a transfer to another repository cannot
# preserve a stale PUBLIC authorization from the original source name.
verify_external_disclosure_sources() {
    local primary_visibility="$1"
    local allow_external="$2"
    local context_payload linked_issue_ids expected_linked_issues
    local primary_repository primary_owner primary_name
    local live_repository live_visibility linked_issue_id
    local visibility_query
    local -a linked_issue_args=()

    # PRIVATE, INTERNAL, and indeterminate sources are allowed only through the
    # user's explicit override. That authorization does not depend on a cached
    # visibility value, so no live visibility lookup is required in this path.
    [ "$allow_external" != true ] || return 0

    if ! context_payload="$(cat)"; then
        echo "Error: External repository visibility sources could not be frozen; Claude enrichment is blocked." >&2
        return 1
    fi

    primary_visibility="$(printf '%s' "$primary_visibility" | \
        tr '[:lower:]' '[:upper:]')"
    if [ "$primary_visibility" != "PUBLIC" ] || ! printf '%s' "$context_payload" | jq -e '
        (.pr.repository | type) == "string" and
        (.pr.repository | test("^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")) and
        ((.pr.linked_issues // []) | type) == "array" and
        all((.pr.linked_issues // [])[];
          ((.id | type) == "string") and (.id | length) > 0 and
          ((.repository.name_with_owner | type) == "string") and
          (.repository.name_with_owner |
            test("^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")) and
          (((.repository.visibility // "UNKNOWN") | ascii_upcase) == "PUBLIC")) and
        ([((.pr.linked_issues // [])[].id)] | unique | length) ==
          ((.pr.linked_issues // []) | length)
    ' > /dev/null 2>&1; then
        echo "Error: External repository visibility sources are incomplete or inconsistent; Claude enrichment is blocked." >&2
        return 1
    fi
    primary_repository="$(printf '%s' "$context_payload" | jq -r '.pr.repository')"
    primary_owner="${primary_repository%%/*}"
    primary_name="${primary_repository#*/}"

    cleanup_external_visibility_temp
    EXTERNAL_VISIBILITY_TEMP_FILE="$(mktemp \
        "${TMPDIR:-/tmp}/gh-pr-enrich-external-visibility.XXXXXX")" || return 1
    if ! chmod 600 "$EXTERNAL_VISIBILITY_TEMP_FILE"; then
        cleanup_external_visibility_temp
        return 1
    fi

    if ! linked_issue_ids="$(printf '%s' "$context_payload" | \
            jq -r '(.pr.linked_issues // [])[].id')" || \
       ! expected_linked_issues="$(printf '%s' "$context_payload" | jq -c '
            (.pr.linked_issues // []) | map({
              id: .id,
              repository: .repository.name_with_owner,
              visibility: ((.repository.visibility // "UNKNOWN") | ascii_upcase)
            }) | sort_by(.id)
        ')"; then
        cleanup_external_visibility_temp
        echo "Error: External linked issue visibility sources could not be frozen; Claude enrichment is blocked." >&2
        return 1
    fi
    while IFS= read -r linked_issue_id; do
        [ -n "$linked_issue_id" ] || continue
        linked_issue_args+=("-F" "ids[]=$linked_issue_id")
    done <<< "$linked_issue_ids"

    if [ "${#linked_issue_args[@]}" -gt 0 ]; then
        visibility_query='query ExternalDisclosureVisibility(
          $owner: String!, $name: String!, $ids: [ID!]!
        ) {
          repository(owner: $owner, name: $name) { nameWithOwner visibility }
          nodes(ids: $ids) {
            id
            ... on Issue { repository { nameWithOwner visibility } }
          }
        }'
    else
        # `gh api graphql` supplies an omitted list variable as null instead of
        # applying a GraphQL default. Use a literal empty list so the live
        # attestation succeeds for the common no-linked-issues case.
        visibility_query='query ExternalDisclosureVisibility(
          $owner: String!, $name: String!
        ) {
          repository(owner: $owner, name: $name) { nameWithOwner visibility }
          nodes(ids: []) {
            id
            ... on Issue { repository { nameWithOwner visibility } }
          }
        }'
    fi
    : > "$EXTERNAL_VISIBILITY_TEMP_FILE"
    if ! run_report_command gh api graphql \
            -F owner="$primary_owner" -F name="$primary_name" \
            "${linked_issue_args[@]}" -f query="$visibility_query" \
            > "$EXTERNAL_VISIBILITY_TEMP_FILE" 2>/dev/null || \
       ! jq -e '
            ((.errors // []) | length) == 0 and
            (.data.repository | type) == "object" and
            ((.data.nodes // null) | type) == "array"
        ' "$EXTERNAL_VISIBILITY_TEMP_FILE" > /dev/null 2>&1; then
        cleanup_external_visibility_temp
        echo "Error: Current external repository visibility could not be verified; Claude enrichment is blocked." >&2
        return 1
    fi

    live_repository="$(jq -r '.data.repository.nameWithOwner // ""' \
        "$EXTERNAL_VISIBILITY_TEMP_FILE" 2>/dev/null || echo "")"
    live_visibility="$(jq -r \
        '(.data.repository.visibility // "UNKNOWN") | ascii_upcase' \
        "$EXTERNAL_VISIBILITY_TEMP_FILE" 2>/dev/null || echo "UNKNOWN")"
    if [ "$live_repository" != "$primary_repository" ] || \
       [ "$live_visibility" != "PUBLIC" ]; then
        cleanup_external_visibility_temp
        echo "Error: Repository visibility for $primary_repository changed from PUBLIC to $live_visibility; Claude enrichment is blocked." >&2
        echo "Re-run with --allow-external only after the user explicitly authorizes disclosure." >&2
        return 1
    fi

    if [ "${#linked_issue_args[@]}" -gt 0 ] && \
       ! printf '%s' "$expected_linked_issues" | \
         jq -e --slurpfile live "$EXTERNAL_VISIBILITY_TEMP_FILE" '
            . as $expected
            | ($live[0].data.nodes // []) as $nodes
            | ($expected == ($nodes | map({
                id: (.id // ""),
                repository: (.repository.nameWithOwner // ""),
                visibility: ((.repository.visibility // "UNKNOWN") | ascii_upcase)
              }) | sort_by(.id)))
        ' > /dev/null 2>&1; then
        cleanup_external_visibility_temp
        echo "Error: Current linked issue repository visibility or identity could not be verified; Claude enrichment is blocked." >&2
        return 1
    fi

    cleanup_external_visibility_temp
}

run_claude_analysis() {
    local context_file="$1"
    local output_file="$2"
    local analysis_output_file="$output_file"
    local context_dir
    CLAUDE_CAPTURED_PR_HEAD=""
    CLAUDE_CAPTURED_CONTEXT_FINGERPRINT=""
    CLAUDE_CAPTURED_WORKSPACE_FINGERPRINT=""
    CLAUDE_DISCLOSURE_GATE_FAILED=false
    ANALYZER_WORKING_DIRECTORY=""
    ANALYZER_SETTINGS_FILE=""
    cleanup_code_access_snapshot

    local system_prompt
    if ! system_prompt="$(load_system_prompt)"; then
        return 1
    fi

    # The prompt and every captured grant field must come from one immutable
    # context copy. Binding only the live fingerprint before and after prompt
    # construction permits an A->B->A swap to feed B to Claude while the result
    # is stamped with A's provenance.
    local context_digest context_mode frozen_context_digest frozen_context_mode
    local immediate_context_digest immediate_context_mode
    context_dir="$(dirname "$context_file")"
    if [ ! -f "$context_file" ] || [ -L "$context_file" ]; then
        echo "Error: Analysis context is missing or unsafe before Claude analysis." >&2
        return 1
    fi
    context_digest="$(sha256_file "$context_file" 2>/dev/null || echo "")"
    context_mode="$(workspace_file_mode "$context_file" 2>/dev/null || echo "")"
    if [ -z "$context_digest" ] || [ -z "$context_mode" ]; then
        echo "Error: Analysis context identity could not be captured before Claude analysis." >&2
        return 1
    fi
    ANALYZER_CONTEXT_FILE="$(mktemp "/tmp/gh-pr-enrich-claude-context.XXXXXX")" || \
        return 1
    install_code_access_cleanup_traps
    if ! cp -p "$context_file" "$ANALYZER_CONTEXT_FILE"; then
        cleanup_code_access_snapshot
        echo "Error: Analysis context could not be frozen before Claude analysis." >&2
        return 1
    fi
    frozen_context_digest="$(sha256_file "$ANALYZER_CONTEXT_FILE" 2>/dev/null || echo "")"
    frozen_context_mode="$(workspace_file_mode "$ANALYZER_CONTEXT_FILE" 2>/dev/null || echo "")"
    immediate_context_digest="$(sha256_file "$context_file" 2>/dev/null || echo "")"
    immediate_context_mode="$(workspace_file_mode "$context_file" 2>/dev/null || echo "")"
    if [ "$frozen_context_digest" != "$context_digest" ] || \
       [ "$frozen_context_mode" != "$context_mode" ] || \
       [ "$immediate_context_digest" != "$context_digest" ] || \
       [ "$immediate_context_mode" != "$context_mode" ]; then
        cleanup_code_access_snapshot
        echo "Error: Analysis context changed while its immutable copy was captured." >&2
        return 1
    fi

    local context_access_state access_reason captured_pr_head snapshot_source
    local captured_context_fingerprint embedded_context_fingerprint
    context_access_state="$(jq -r '.coverage.code_access.state // "disabled"' \
        "$ANALYZER_CONTEXT_FILE" 2>/dev/null || echo "disabled")"
    access_reason="$(jq -r '.coverage.code_access.reason // ""' \
        "$ANALYZER_CONTEXT_FILE" 2>/dev/null || echo "")"
    captured_pr_head="$(jq -r '.coverage.code_access.pr_head_sha // ""' \
        "$ANALYZER_CONTEXT_FILE" 2>/dev/null || echo "")"
    snapshot_source="$(jq -r \
        '.coverage.code_access.snapshot_source // "git_index"' \
        "$ANALYZER_CONTEXT_FILE" 2>/dev/null || echo "")"
    embedded_context_fingerprint="$(jq -r '.coverage.context_fingerprint // ""' \
        "$ANALYZER_CONTEXT_FILE" 2>/dev/null || echo "")"
    captured_context_fingerprint="$(analysis_context_fingerprint \
        "$ANALYZER_CONTEXT_FILE" 2>/dev/null || echo "")"
    if [ -z "$captured_pr_head" ] || [ -z "$captured_context_fingerprint" ] || \
       [ "$embedded_context_fingerprint" != "$captured_context_fingerprint" ]; then
        cleanup_code_access_snapshot
        echo "Error: Analysis context identity is missing or invalid before Claude analysis." >&2
        return 1
    fi

    local code_access="false"
    if [ "$context_access_state" = "enabled" ]; then
        if ! validate_code_access_grant "$ANALYZER_CONTEXT_FILE" "$context_dir"; then
            cleanup_code_access_snapshot
            return 1
        fi
        code_access="true"
    fi
    local timeout_secs="${CLAUDE_TIMEOUT:-600}"
    local model="${GH_PR_ENRICH_MODEL:-sonnet}"

    local context_payload
    if ! context_payload="$(cat "$ANALYZER_CONTEXT_FILE")"; then
        cleanup_code_access_snapshot
        echo "Error: Immutable analysis context could not be read before Claude analysis." >&2
        return 1
    fi
    local user_prompt="Analyze these unresolved PR comment threads and issue comments (including CI/bot reports) and provide structured analysis.

Verify each claim against the code before reporting it, sweep every category in the taxonomy, and anchor every finding and task to a file and line.

$context_payload"

    local -a tools=()
    if [ "$code_access" = "true" ]; then
        tools=("Read(./**)")
        echo "🧠 Running Claude analysis with read-only repository access (model: $model, timeout: ${timeout_secs}s)..." >&2
    else
        echo "🧠 Running Claude analysis WITHOUT repository access (model: $model, timeout: ${timeout_secs}s)..." >&2
        echo "   Findings cannot be verified against code and will be reported as 'plausible' at best." >&2
    fi
    [ -n "$access_reason" ] && echo "   Code access: $access_reason" >&2

    if [ "$code_access" = "true" ]; then
        local expected_workspace_fingerprint current_workspace_fingerprint repository_root
        expected_workspace_fingerprint="$(jq -r \
            '.coverage.code_access.workspace_fingerprint // ""' \
            "$ANALYZER_CONTEXT_FILE" 2>/dev/null || echo "")"
        if ! create_code_access_snapshot "$context_dir" \
                "$expected_workspace_fingerprint" "$snapshot_source"; then
            cleanup_code_access_snapshot
            echo "Error: Could not create a verified immutable repository snapshot for Claude analysis." >&2
            return 1
        fi
        current_workspace_fingerprint="$(code_access_workspace_fingerprint \
            "$context_dir" "" "$snapshot_source" 2>/dev/null || echo "")"
        if [ -z "$current_workspace_fingerprint" ] || \
           [ "$current_workspace_fingerprint" != "$expected_workspace_fingerprint" ]; then
            cleanup_code_access_snapshot
            echo "Error: Local workspace changed while the immutable analyzer snapshot was being built." >&2
            return 1
        fi
        if ! analysis_output_file="$(absolute_path_for_write "$output_file")"; then
            cleanup_code_access_snapshot
            return 1
        fi
        repository_root="$(git rev-parse --show-toplevel 2>/dev/null || echo "")"
        if [ -z "$repository_root" ] || \
           ! create_claude_code_access_settings "$repository_root"; then
            cleanup_code_access_snapshot
            echo "Error: Could not create isolated Claude code-access settings." >&2
            return 1
        fi
        ANALYZER_WORKING_DIRECTORY="$CODE_ACCESS_SNAPSHOT_DIR"
        ANALYZER_SETTINGS_FILE="$CODE_ACCESS_SETTINGS_FILE"
    fi

    if ! verify_external_disclosure_sources \
            "${REPOSITORY_VISIBILITY:-UNKNOWN}" \
            "${ALLOW_EXTERNAL:-false}" <<< "$context_payload"; then
        cleanup_code_access_snapshot
        # Distinguish a disclosure-authorization failure from an ordinary
        # provider failure: callers must not report a successful unenriched run.
        CLAUDE_DISCLOSURE_GATE_FAILED=true
        return 1
    fi

    local invoke_rc=0
    invoke_claude "Claude analysis" "$timeout_secs" "$analysis_output_file" \
        "$system_prompt" "$ANALYSIS_SCHEMA" "$user_prompt" \
        "${tools[@]+"${tools[@]}"}" || invoke_rc=$?
    ANALYZER_WORKING_DIRECTORY=""
    ANALYZER_SETTINGS_FILE=""
    cleanup_code_access_snapshot
    [ "$invoke_rc" -eq 0 ] || return "$invoke_rc"

    local current_pr_head current_embedded_fingerprint current_context_fingerprint
    current_pr_head="$(jq -r '.coverage.code_access.pr_head_sha // ""' \
        "$context_file" 2>/dev/null || echo "")"
    current_embedded_fingerprint="$(jq -r '.coverage.context_fingerprint // ""' \
        "$context_file" 2>/dev/null || echo "")"
    current_context_fingerprint="$(analysis_context_fingerprint \
        "$context_file" 2>/dev/null || echo "")"
    if [ "$current_pr_head" != "$captured_pr_head" ] || \
       [ "$current_embedded_fingerprint" != "$captured_context_fingerprint" ] || \
       [ "$current_context_fingerprint" != "$captured_context_fingerprint" ]; then
        rm -f "$analysis_output_file"
        echo "Error: Analysis context changed during Claude analysis; the response was rejected." >&2
        return 1
    fi
    if [ "$code_access" = "true" ] && \
       ! validate_code_access_grant "$context_file" "$(dirname "$context_file")"; then
        rm -f "$analysis_output_file"
        echo "Error: Local workspace changed during Claude analysis; the response was rejected. Rebuild the analysis context." >&2
        return 1
    fi

    CLAUDE_CAPTURED_PR_HEAD="$captured_pr_head"
    CLAUDE_CAPTURED_CONTEXT_FINGERPRINT="$captured_context_fingerprint"
    if [ "$code_access" = "true" ]; then
        CLAUDE_CAPTURED_WORKSPACE_FINGERPRINT="$expected_workspace_fingerprint"
    fi
}

# Add provenance without changing the analyzer's task-list contract. Source
# artifacts remain provider-specific; analysis.json is the selected result that
# downstream commands consume.
write_claude_analysis_artifact() {
    local raw_analysis="$1"
    local output_file="$2"
    local visibility="${3:-UNKNOWN}"
    local pr_head_sha="${4:-}"
    local context_fingerprint="${5:-}"
    local workspace_fingerprint="${6:-}"
    local provider="claude"
    local model="${GH_PR_ENRICH_MODEL:-sonnet}"
    if [ -z "$pr_head_sha" ] || [ -z "$context_fingerprint" ]; then
        echo "Error: Claude analysis provenance was not captured before invocation." >&2
        return 1
    fi

    jq \
        --arg schema_version "2.1" \
        --arg provider "$provider" \
        --arg model "$model" \
        --arg repository "${REPO:-unknown}" \
        --arg visibility "$visibility" \
        --arg pr_number "${PR_NUMBER:-}" \
        --arg pr_head_sha "$pr_head_sha" \
        --arg context_fingerprint "$context_fingerprint" \
        --arg workspace_fingerprint "$workspace_fingerprint" \
        --arg generated_at "${TIMESTAMP:-$(date -u +"%Y-%m-%dT%H:%M:%SZ")}" \
        '. + {
            _metadata: {
                schema_version: $schema_version,
                provider: $provider,
                analyzers: [{provider: $provider, model: $model, role: "external"}],
                repository: $repository,
                repository_visibility: $visibility,
                pr_number: ($pr_number | tonumber?),
                pr_head_sha: (if $pr_head_sha == "" then null else $pr_head_sha end),
                context_fingerprint: (if $context_fingerprint == "" then null else $context_fingerprint end),
                workspace_fingerprint: (if $workspace_fingerprint == "" then null else $workspace_fingerprint end),
                generated_at: $generated_at,
                context_file: "analysis-context.json"
            }
        }' "$raw_analysis" > "$output_file"
}

# Promote a root-verified result to the provider-neutral selected artifact and
# refresh every derived view. The source must declare the same exact PR head as
# the immutable analysis context, preventing a stale or cross-PR synthesis from
# becoming the selected result.
select_analysis_artifact() {
    local report_dir="$1"
    local source_file="$2"
    local live_context_file="$report_dir/analysis-context.json"
    local frozen_source frozen_context frozen_path frozen_abs report_abs repo_root
    local captured_context_fingerprint rc=0
    local stale_selected_identity=""
    local source_digest="" source_mode="" frozen_digest="" frozen_mode=""
    local live_digest="" live_mode=""
    if path_has_symlink_component "$report_dir" || [ -L "$source_file" ] || \
       [ -L "$live_context_file" ] || path_is_git_tracked "$source_file" || \
       path_is_git_tracked "$live_context_file" || [ ! -f "$source_file" ] || \
       [ ! -f "$live_context_file" ]; then
        echo "Error: Refusing unsafe analysis source artifact: $source_file" >&2
        return 1
    fi
    # Bind deferred invalidation to the views that existed before this stale
    # selection began. A newer publication that lands while inputs are frozen
    # must never become the invalidation target.
    stale_selected_identity="$(selected_analysis_live_identity \
        "$report_dir" 2>/dev/null || echo "")"
    source_digest="$(sha256_file "$source_file" 2>/dev/null || echo "")"
    source_mode="$(workspace_file_mode "$source_file" 2>/dev/null || echo "")"
    [ -n "$source_digest" ] && [ -n "$source_mode" ] || return 1
    frozen_source="$(mktemp "/tmp/gh-pr-enrich-analysis-source.XXXXXX")" || return 1
    frozen_context="$(mktemp "/tmp/gh-pr-enrich-analysis-context.XXXXXX")" || {
        rm -f "$frozen_source"
        return 1
    }
    report_abs="$(canonicalize_path "$report_dir")"
    repo_root="$(git -C "$report_dir" rev-parse --show-toplevel 2>/dev/null || echo "")"
    for frozen_path in "$frozen_source" "$frozen_context"; do
        frozen_abs="$(canonicalize_path "$frozen_path")"
        case "$frozen_abs" in
            "$report_abs"|"$report_abs"/*)
                rm -f "$frozen_source" "$frozen_context"
                echo "Error: Could not freeze analysis inputs outside the report directory." >&2
                return 1
                ;;
        esac
        if [ -n "$repo_root" ]; then
            case "$frozen_abs" in
                "$repo_root"|"$repo_root"/*)
                    rm -f "$frozen_source" "$frozen_context"
                    echo "Error: Could not freeze analysis inputs outside the repository." >&2
                    return 1
                    ;;
            esac
        fi
    done
    if ! cp -p "$source_file" "$frozen_source" || \
       ! cp -p "$live_context_file" "$frozen_context"; then
        rm -f "$frozen_source" "$frozen_context"
        return 1
    fi
    frozen_digest="$(sha256_file "$frozen_source" 2>/dev/null || echo "")"
    frozen_mode="$(workspace_file_mode "$frozen_source" 2>/dev/null || echo "")"
    live_digest="$(sha256_file "$source_file" 2>/dev/null || echo "")"
    live_mode="$(workspace_file_mode "$source_file" 2>/dev/null || echo "")"
    if [ "$frozen_digest" != "$source_digest" ] || \
       [ "$frozen_mode" != "$source_mode" ] || \
       [ "$live_digest" != "$source_digest" ] || \
       [ "$live_mode" != "$source_mode" ]; then
        rm -f "$frozen_source" "$frozen_context"
        echo "Error: Analysis source changed while its immutable copy was captured." >&2
        return 1
    fi
    captured_context_fingerprint="$(analysis_context_fingerprint \
        "$frozen_context" 2>/dev/null || echo "")"
    _select_analysis_artifact "$report_dir" "$frozen_source" "$frozen_context" \
        "$captured_context_fingerprint" || rc=$?
    rm -f "$frozen_source" "$frozen_context"
    if [ "$rc" -eq 42 ]; then
        [ -n "$stale_selected_identity" ] || return 1
        invalidate_selected_analysis "$report_dir" \
            "$stale_selected_identity" || return 1
        return 1
    fi
    return "$rc"
}

_select_analysis_artifact() (
    local report_dir="$1"
    local source_file="$2"
    local context_file="$3"
    local captured_context_fingerprint="$4"
    local live_context_file="$report_dir/analysis-context.json"
    local selected_file="$report_dir/analysis.json"
    local guarded_path
    local selection_backup_dir="" replacement_dir=""
    local selected_lock_dir="" selected_lock_token="" selected_lock_owned=false
    local selected_writer_signal=""
    local publication_rc=0
    local replacement_identity="" current_replacement_identity=""
    cleanup_selection_transaction() {
        terminate_report_run_child
        cleanup_live_analysis_discussion_temps
        REPORT_RUN_MANAGED=false
        REPORT_RUN_OWNER_PID=""
        [ -z "$selection_backup_dir" ] || \
            rm -rf "$selection_backup_dir" 2>/dev/null || true
        [ -z "$replacement_dir" ] || \
            rm -rf "$replacement_dir" 2>/dev/null || true
        if [ "$selected_lock_owned" = true ] && [ -n "$selected_lock_dir" ]; then
            if ! release_selected_analysis_lock \
                    "$selected_lock_dir" "$selected_lock_token"; then
                echo "Error: Selected-analysis writer lock remains after selection cleanup." >&2
            fi
        fi
    }
    handle_selection_signal() {
        selected_writer_signal="$1"
        terminate_report_run_child
    }
    trap cleanup_selection_transaction EXIT
    trap 'handle_selection_signal INT' INT
    trap 'handle_selection_signal TERM' TERM

    # Bound both hosted-head checks, including the initial pre-lock request.
    # Child ownership belongs to this selection worker; lock ownership is a
    # separate concern acquired only immediately before publication staging.
    selected_analysis_worker_pid || return 1
    REPORT_RUN_OWNER_PID="$SELECTED_ANALYSIS_WORKER_PID"
    REPORT_RUN_MANAGED=true

    if path_has_symlink_component "$report_dir"; then
        echo "Error: Analysis report path contains a symbolic-link component: $report_dir" >&2
        return 1
    fi
    for guarded_path in "$context_file" "$live_context_file" "$report_dir/pr-summary.json" \
            "$source_file" "$selected_file" \
            "$report_dir/analysis.md" "$report_dir/context-coverage.md" \
            "$report_dir/combined-data.json" "$report_dir/comprehensive-report.md" \
            "$report_dir/claude-analysis.json" "$report_dir/claude-analysis.md"; do
        if [ -L "$guarded_path" ] || path_is_git_tracked "$guarded_path"; then
            echo "Error: Refusing tracked or symlinked analysis artifact: $guarded_path" >&2
            return 1
        fi
    done

    if [ ! -f "$context_file" ] || ! jq -e . "$context_file" > /dev/null 2>&1; then
        echo "Error: Valid analysis context not found at $context_file" >&2
        return 1
    fi
    if ! jq -e '
        ["issue_comments", "review_comments", "inline_comments", "review_threads", "checks", "linked_issues"] as $required
        | (.coverage.sources // {}) as $sources
        | (($sources | keys | sort) == ($required | sort)) and
          ($sources | to_entries | all(
            .value.requested == true and .value.status == "completed"))
    ' "$context_file" > /dev/null 2>&1; then
        echo "Error: Required GitHub analysis inputs failed; no clean selected verdict can be published." >&2
        return 1
    fi
    if [ ! -f "$source_file" ] || ! jq -e '
        ["logic_error", "boundary_condition", "concurrency", "error_handling", "resource_lifecycle", "security", "secrets_exposure", "data_integrity", "api_contract", "performance", "test_gap", "observability", "maintainability", "documentation", "build_ci", "dependency_risk"] as $required_categories |
        def derived_severity:
            if .impact == "severe" then
                if (.likelihood == "certain" or .likelihood == "likely") then "critical"
                elif .likelihood == "possible" then "high"
                else "medium" end
            elif .impact == "moderate" then
                if (.likelihood == "certain" or .likelihood == "likely") then "high"
                elif .likelihood == "possible" then "medium"
                else "low" end
            else
                if .likelihood == "certain" then "medium" else "low" end
            end;
        . as $analysis |
        ((._metadata.analyzers // []) | map((.provider // "") + ":" + (.role // ""))) as $analyzer_ids |
        (.issue_categories | type == "array") and
        (all(.issue_categories[];
            (.name | type == "string") and
            (.category | IN("logic_error", "boundary_condition", "concurrency", "error_handling", "resource_lifecycle", "security", "secrets_exposure", "data_integrity", "api_contract", "performance", "test_gap", "observability", "maintainability", "documentation", "build_ci", "dependency_risk")) and
            (.severity | IN("critical", "high", "medium", "low")) and
            (.impact | IN("severe", "moderate", "minor")) and
            (.likelihood | IN("certain", "likely", "possible", "unlikely")) and
            (.severity == derived_severity) and
            (.severity_rationale | type == "string") and
            (.verdict | IN("confirmed", "plausible", "refuted")) and
            (.confidence | IN("high", "medium", "low")) and
            (.description | type == "string") and
            (.evidence | type == "array") and (.evidence | length > 0) and
            (all(.evidence[]; (.file | type == "string") and
                (.line | (type == "number" and . == floor)) and
                (.detail | type == "string"))) and
            (.thread_ids | type == "array") and (all(.thread_ids[]; type == "string")))) and
        (.category_coverage | type == "array") and
        (all(.category_coverage[];
            (.category | type == "string") and
            (.verdict | IN("findings_reported", "reviewed_none_found", "not_applicable", "not_reviewable")) and
            (.note | type == "string"))) and
        (([.category_coverage[].category] | sort) == ($required_categories | sort)) and
        (all(.category_coverage[]; . as $coverage |
            (([$analysis.issue_categories[] | select(.category == $coverage.category)] | length) > 0
                and $coverage.verdict == "findings_reported") or
            (([$analysis.issue_categories[] | select(.category == $coverage.category)] | length) == 0
                and $coverage.verdict != "findings_reported"))) and
        (.disputed_comments | type == "array") and
        (all(.disputed_comments[];
            (.thread_id | type == "string") and (.claim | type == "string") and
            (.why_incorrect | type == "string") and (.confidence | IN("high", "medium", "low")))) and
        (.systemic_issues | type == "array") and
        (all(.systemic_issues[];
            (.pattern | type == "string") and
            (.finding_ids | type == "array" and length >= 2) and
            ((.finding_ids | unique | length) == (.finding_ids | length)) and
            (all(.finding_ids[]; type == "string" and length > 0)) and
            (all(.finding_ids[]; . as $finding_id |
                [$analysis.issue_categories[] |
                    select(.finding_id == $finding_id and .verdict == "confirmed")]
                | length == 1)) and
            (.evidence | type == "array" and length > 0) and
            (all(.evidence[]; type == "string" and length > 0)) and
            (.recommendation | type == "string"))) and
        (.adjacent_problems | type == "array") and
        (all(.adjacent_problems[];
            (.area | type == "string") and (.risk | type == "string") and
            (.investigation_hint | type == "string") and (.checked | type == "boolean"))) and
        (.task_list | type == "array") and
        (all(.task_list[];
            (.priority | IN("critical", "high", "medium", "low")) and
            (.task | type == "string") and (.file | type == "string") and
            (.line | (type == "number" and . == floor)) and (.suggested_fix | type == "string") and
            (.verification | type == "string"))) and
        (.process_improvements | type == "array") and
        (all(.process_improvements[];
            (.category | IN("documentation", "automation", "testing", "review_process", "tooling")) and
            (.suggestion | type == "string") and (.rationale | type == "string"))) and
        (.pr_template_suggestions | type == "array") and
        (all(.pr_template_suggestions[];
            (.section | type == "string") and (.checkbox_or_question | type == "string") and
            (.why | type == "string"))) and
        (._metadata.provider | IN("claude", "codex", "claude-code", "hybrid")) and
        (._metadata.repository | type == "string" and length > 0) and
        (._metadata.pr_number | type == "number" and . == floor and . > 0) and
        (._metadata.generated_at | type == "string") and
        (._metadata.context_fingerprint | type == "string") and
        (._metadata.analyzers | type == "array") and
        (._metadata.analyzers | length > 0) and
        (all(._metadata.analyzers[];
            (.provider | IN("claude", "codex", "claude-code")) and
            (.role | type == "string") and (.role | length > 0) and
            (if .provider == "claude" then .role == "external"
             else .role != "external" end))) and
        ((._metadata.provider != "claude") or
            ((all(._metadata.analyzers[]; .provider == "claude")) and
             (any(._metadata.analyzers[]; .provider == "claude" and .role == "external")))) and
        ((._metadata.provider != "codex") or
            ((all(._metadata.analyzers[]; .provider == "codex")) and
             (any(._metadata.analyzers[]; .provider == "codex" and .role == "orchestrator")))) and
        ((._metadata.provider != "claude-code") or
            ((all(._metadata.analyzers[]; .provider == "claude-code")) and
             (any(._metadata.analyzers[]; .provider == "claude-code" and .role == "orchestrator")))) and
        ((._metadata.provider != "hybrid") or
            ((all(._metadata.analyzers[]; .provider == "codex" or .provider == "claude")) and
             (any(._metadata.analyzers[]; .provider == "codex" and .role == "orchestrator")) and
             (any(._metadata.analyzers[]; .provider == "claude" and .role == "external")))) and
        ((._metadata.provider != "hybrid") or
            (all(.issue_categories[];
                (.sources | type == "array") and (.sources | length > 0) and
                (all(.sources[]; type == "string" and (. as $source | $analyzer_ids | index($source) != null))))))
    ' "$source_file" > /dev/null 2>&1; then
        echo "Error: Selected analysis is missing required findings or provenance: $source_file" >&2
        return 1
    fi
    if ! validate_analysis_task_links "$source_file"; then
        echo "Error: Selected analysis is missing required findings or provenance: $source_file" >&2
        return 1
    fi
    # A definitive clean verdict is impossible when evidence was shortened or
    # omitted. Because the schema does not map each omitted byte to individual
    # categories, every category without a finding must be explicitly marked
    # not_reviewable until the analyzer receives complete inputs.
    if ! jq -e --slurpfile analysis "$source_file" '
        (.coverage // {}) as $coverage
        | [
            $coverage.issue_comments.truncated,
            $coverage.review_comments.truncated,
            $coverage.inline_comments.truncated,
            $coverage.unresolved_threads.truncated,
            $coverage.unresolved_threads.incomplete_comment_threads,
            $coverage.diff.files_truncated,
            $coverage.commits.truncated,
            $coverage.linked_issues.truncated,
            $coverage.pr_description.truncated
          ] as $omissions
        | ($analysis[0] // {}) as $result
        | ([$result.issue_categories[].category] | unique) as $finding_categories
        | (($coverage.diff.included // false) == true and
           ($coverage.diff.status // "unknown") == "completed" and
           ($coverage.diff.files_included // -1) ==
             ($coverage.diff.files_total // -2)) as $complete_diff
        | (($coverage.code_access.state // "disabled") != "enabled" and
           ($complete_diff | not)) as $code_unavailable
        | all($omissions[]; type == "array") and
          ((([$omissions[] | length] | add) == 0 and ($code_unavailable | not)) or
           all($result.category_coverage[];
             . as $category_coverage
             | if ($finding_categories | index($category_coverage.category)) != null
             then $category_coverage.verdict == "findings_reported"
             else $category_coverage.verdict == "not_reviewable"
             end))
    ' "$context_file" > /dev/null 2>&1; then
        echo "Error: Incomplete or truncated analysis inputs require every category without findings to be marked not_reviewable." >&2
        return 1
    fi

    local context_head source_head context_fingerprint embedded_fingerprint source_fingerprint
    local context_pr_number context_repository source_pr_number source_repository
    context_head="$(jq -r '.coverage.code_access.pr_head_sha // ""' "$context_file")"
    source_head="$(jq -r '._metadata.pr_head_sha // ""' "$source_file")"
    if [ -z "$context_head" ] || [ "$source_head" != "$context_head" ]; then
        echo "Error: Selected analysis PR head '$source_head' does not match context PR head '$context_head'." >&2
        return 1
    fi
    embedded_fingerprint="$(jq -r '.coverage.context_fingerprint // ""' "$context_file")"
    context_fingerprint="$(analysis_context_fingerprint "$context_file" 2>/dev/null || echo "")"
    source_fingerprint="$(jq -r '._metadata.context_fingerprint // ""' "$source_file")"
    if [ -z "$context_fingerprint" ] || \
       [ "$context_fingerprint" != "$captured_context_fingerprint" ] || \
       [ "$embedded_fingerprint" != "$context_fingerprint" ]; then
        echo "Error: Analysis context fingerprint is missing or does not match the snapshot content." >&2
        return 1
    fi
    if [ "$source_fingerprint" != "$context_fingerprint" ]; then
        echo "Error: Selected analysis context fingerprint does not match the current snapshot." >&2
        return 1
    fi
    context_pr_number="$(jq -r '.pr.number // ""' "$context_file")"
    context_repository="$(jq -r '.pr.repository // ""' "$context_file")"
    source_pr_number="$(jq -r '._metadata.pr_number' "$source_file")"
    source_repository="$(jq -r '._metadata.repository' "$source_file")"
    if [ -z "$context_pr_number" ] || [ -z "$context_repository" ] || \
       [ "$source_pr_number" != "$context_pr_number" ] || \
       [ "$source_repository" != "$context_repository" ]; then
        echo "Error: Selected analysis repository or PR number does not match the fingerprinted context." >&2
        return 1
    fi
    if ! verify_pr_head_unchanged "$context_pr_number" "$context_head" "$context_repository"; then
        invalidate_on_confirmed_hosted_head_mismatch "$report_dir" || return 1
        if [ "$HOSTED_HEAD_VERIFICATION_STATUS" = "mismatch" ]; then
            echo "Error: Hosted PR head changed before selection (expected $context_head, found $CURRENT_HOSTED_HEAD). Rebuild the analysis context." >&2
        else
            echo "Error: Hosted PR head could not be revalidated before selection; prior selected artifacts were preserved." >&2
        fi
        return 1
    fi
    if ! verify_analysis_discussion_unchanged "$context_file"; then
        case "$selected_writer_signal" in
            INT) return 130 ;;
            TERM) return 143 ;;
        esac
        if [ "$DISCUSSION_VERIFICATION_STATUS" = "mismatch" ]; then
            echo "Error: GitHub discussion state changed before selection; stale selected artifacts will be invalidated. Rebuild the analysis context." >&2
            return 42
        else
            echo "Error: GitHub discussion state could not be revalidated before selection; prior selected artifacts were preserved." >&2
        fi
        return 1
    fi
    if ! verify_analysis_checks_unchanged "$context_file"; then
        case "$selected_writer_signal" in
            INT) return 130 ;;
            TERM) return 143 ;;
        esac
        if [ "$CHECKS_VERIFICATION_STATUS" = "mismatch" ]; then
            echo "Error: GitHub checks state changed before selection; stale selected artifacts will be invalidated. Rebuild the analysis context." >&2
            return 42
        else
            echo "Error: GitHub checks state could not be revalidated before selection; prior selected artifacts were preserved." >&2
        fi
        return 1
    fi
    if ! validate_selected_workspace "$report_dir" "$source_file" "$context_file"; then
        echo "Error: Selected analysis contains confirmed findings without enabled repository code access in a current matching fingerprinted context." >&2
        return 1
    fi

    acquire_selected_analysis_lock "$report_dir" || return 1
    selected_lock_dir="$SELECTED_ANALYSIS_LOCK_DIR"
    selected_lock_token="$SELECTED_ANALYSIS_LOCK_TOKEN"
    selected_lock_owned="$SELECTED_ANALYSIS_LOCK_OWNED"
    REPORT_RUN_OWNER_PID="${selected_lock_token%%.*}"
    selection_backup_dir="$(mktemp -d \
        "/tmp/gh-pr-enrich-selection.XXXXXX")" || return 1
    replacement_dir="$(mktemp -d \
        "$report_dir/.selected-analysis-replacements.XXXXXX")" || return 1
    chmod 700 "$replacement_dir" || return 1

    local selection_artifact selection_backup source_digest backup_digest source_mode
    local -a selection_artifacts=(
        "$report_dir/analysis.json"
        "$report_dir/analysis.md"
        "$report_dir/context-coverage.md"
        "$report_dir/combined-data.json"
        "$report_dir/comprehensive-report.md"
        "$report_dir/claude-analysis.json"
        "$report_dir/claude-analysis.md"
    )
    for selection_artifact in "${selection_artifacts[@]}"; do
        [ -f "$selection_artifact" ] || continue
        source_digest="$(sha256_file "$selection_artifact")" || return 1
        selection_backup="$selection_backup_dir/$(basename "$selection_artifact")"
        cp -p "$selection_artifact" "$selection_backup" || return 1
        backup_digest="$(sha256_file "$selection_backup")" || return 1
        if [ "$backup_digest" != "$source_digest" ] || \
           [ "$(sha256_file "$selection_artifact" 2>/dev/null || echo "")" != \
             "$source_digest" ]; then
            echo "Error: Selected-analysis views changed while selection was staged." >&2
            return 1
        fi
    done

    local selected_tmp="$replacement_dir/analysis.json"
    local report_tmp="$replacement_dir/analysis.md"
    local coverage_tmp="$replacement_dir/context-coverage.md"
    local combined_tmp="$replacement_dir/combined-data.json"
    local comprehensive_base="$replacement_dir/comprehensive-report.base.md"
    local comprehensive_tmp="$replacement_dir/comprehensive-report.md"

    # Render and validate every derived view before replacing the trusted
    # selected artifact. A malformed candidate must leave the prior selection
    # and its reports untouched.
    if ! generate_analysis_report "$source_file" "$report_tmp"; then
        return 1
    fi
    if ! generate_coverage_section "$context_file" "$coverage_tmp"; then
        return 1
    fi
    if [ -f "$selection_backup_dir/combined-data.json" ]; then
        if ! jq --slurpfile selected "$source_file" --slurpfile context "$context_file" \
            '.analysis = $selected[0]
             | .analysis_context_coverage = ($context[0].coverage // {})' \
            "$selection_backup_dir/combined-data.json" > "$combined_tmp"; then
            return 1
        fi
    fi

    if [ -f "$selection_backup_dir/comprehensive-report.md" ]; then
        if ! awk '$0 == "<!-- BEGIN SELECTED ANALYSIS -->" {exit} {print}' \
            "$selection_backup_dir/comprehensive-report.md" > "$comprehensive_base"; then
            return 1
        fi
        if ! {
            cat "$comprehensive_base"
            printf '\n<!-- BEGIN SELECTED ANALYSIS -->\n\n---\n\n'
            cat "$report_tmp"
            printf '\n---\n\n'
            cat "$coverage_tmp"
            printf '\n<!-- END SELECTED ANALYSIS -->\n'
        } > "$comprehensive_tmp"; then
            return 1
        fi
    fi

    if ! cp "$source_file" "$selected_tmp"; then
        return 1
    fi
    for selection_artifact in analysis.json analysis.md context-coverage.md \
            combined-data.json comprehensive-report.md; do
        [ -f "$replacement_dir/$selection_artifact" ] || continue
        if [ -f "$selection_backup_dir/$selection_artifact" ]; then
            source_mode="$(workspace_file_mode \
                "$selection_backup_dir/$selection_artifact")" || return 1
        elif [ "$selection_artifact" = "analysis.json" ]; then
            source_mode="$(workspace_file_mode "$source_file")" || return 1
        else
            continue
        fi
        chmod "$source_mode" "$replacement_dir/$selection_artifact" || return 1
    done

    for selection_artifact in claude-analysis.json claude-analysis.md; do
        [ ! -f "$selection_backup_dir/$selection_artifact" ] || \
            cp -p "$selection_backup_dir/$selection_artifact" \
                "$replacement_dir/$selection_artifact" || return 1
    done

    local live_context_fingerprint live_embedded_fingerprint
    live_context_fingerprint="$(analysis_context_fingerprint \
        "$live_context_file" 2>/dev/null || echo "")"
    live_embedded_fingerprint="$(jq -r '.coverage.context_fingerprint // ""' \
        "$live_context_file" 2>/dev/null || echo "")"
    if [ -L "$live_context_file" ] || path_is_git_tracked "$live_context_file" || \
       [ -z "$captured_context_fingerprint" ] || \
       [ "$live_context_fingerprint" != "$captured_context_fingerprint" ] || \
       [ "$live_embedded_fingerprint" != "$captured_context_fingerprint" ]; then
        echo "Error: Analysis context changed during selection; no selected artifacts were published." >&2
        return 1
    fi

    rm -f "$comprehensive_base"
    replacement_identity="$(selected_analysis_replacement_identity \
        "$replacement_dir" 2>/dev/null || echo "")"
    [ -n "$replacement_identity" ] || return 1
    if ! validate_selected_workspace "$report_dir" "$source_file" "$context_file" \
            "$replacement_dir"; then
        echo "Error: Local workspace changed during selection; no selected artifacts were published. Rebuild the analysis context." >&2
        return 1
    fi
    if ! verify_pr_head_unchanged "$context_pr_number" "$context_head" \
            "$context_repository"; then
        case "$selected_writer_signal" in
            INT) return 130 ;;
            TERM) return 143 ;;
        esac
        invalidate_on_confirmed_hosted_head_mismatch "$report_dir" || return 1
        if [ "$HOSTED_HEAD_VERIFICATION_STATUS" = "mismatch" ]; then
            echo "Error: Hosted PR head changed during selection; no selected artifacts were published (expected $context_head, found $CURRENT_HOSTED_HEAD). Rebuild the analysis context." >&2
        else
            echo "Error: Hosted PR head could not be revalidated during selection; prior selected artifacts were preserved." >&2
        fi
        return 1
    fi
    live_context_fingerprint="$(analysis_context_fingerprint \
        "$live_context_file" 2>/dev/null || echo "")"
    live_embedded_fingerprint="$(jq -r '.coverage.context_fingerprint // ""' \
        "$live_context_file" 2>/dev/null || echo "")"
    if [ -L "$live_context_file" ] || path_is_git_tracked "$live_context_file" || \
       [ -z "$captured_context_fingerprint" ] || \
       [ "$live_context_fingerprint" != "$captured_context_fingerprint" ] || \
       [ "$live_embedded_fingerprint" != "$captured_context_fingerprint" ]; then
        echo "Error: Analysis context changed during the final hosted-head check; no selected artifacts were published." >&2
        return 1
    fi
    if ! validate_selected_workspace "$report_dir" "$source_file" "$context_file" \
            "$replacement_dir"; then
        echo "Error: Local workspace changed during the final hosted-head check; no selected artifacts were published. Rebuild the analysis context." >&2
        return 1
    fi
    current_replacement_identity="$(selected_analysis_replacement_identity \
        "$replacement_dir" 2>/dev/null || echo "")"
    if [ "$current_replacement_identity" != "$replacement_identity" ]; then
        echo "Error: Staged selected-analysis views changed before publication; prior selected artifacts were preserved." >&2
        return 1
    fi
    if ! verify_analysis_hosted_attestation "$context_file"; then
        case "$selected_writer_signal" in
            INT) return 130 ;;
            TERM) return 143 ;;
        esac
        if [ "$HOSTED_ATTESTATION_COMPONENT" = "discussion" ] && \
           [ "$DISCUSSION_VERIFICATION_STATUS" = "mismatch" ]; then
            echo "Error: GitHub discussion state changed during selection; no selected artifacts were published and stale selected artifacts will be invalidated. Rebuild the analysis context." >&2
            return 42
        elif [ "$HOSTED_ATTESTATION_COMPONENT" = "checks" ] && \
             [ "$CHECKS_VERIFICATION_STATUS" = "mismatch" ]; then
            echo "Error: GitHub checks state changed during selection; no selected artifacts were published and stale selected artifacts will be invalidated. Rebuild the analysis context." >&2
            return 42
        elif [ "$HOSTED_ATTESTATION_COMPONENT" = "head" ]; then
            invalidate_on_confirmed_hosted_head_mismatch "$report_dir" || return 1
            if [ "$HOSTED_HEAD_VERIFICATION_STATUS" = "mismatch" ]; then
                echo "Error: Hosted PR head changed during final hosted-state attestation; no selected artifacts were published (expected $context_head, found $CURRENT_HOSTED_HEAD). Rebuild the analysis context." >&2
            else
                echo "Error: Hosted PR head could not be revalidated during final hosted-state attestation; prior selected artifacts were preserved." >&2
            fi
        elif [ "$HOSTED_ATTESTATION_COMPONENT" = "checks" ]; then
            echo "Error: GitHub checks state could not be revalidated during selection; prior selected artifacts were preserved." >&2
        else
            echo "Error: GitHub discussion state could not be revalidated during selection; prior selected artifacts were preserved." >&2
        fi
        return 1
    fi
    if [ -n "$selected_writer_signal" ]; then
        echo "Error: Selected-analysis publication was cancelled before commit." >&2
        case "$selected_writer_signal" in
            INT) return 130 ;;
            TERM) return 143 ;;
        esac
    fi
    publish_selected_analysis_transaction \
        "$report_dir" "$selection_backup_dir" "$replacement_dir" \
        "$replacement_identity" || \
        publication_rc=$?
    if [ "$publication_rc" -ne 0 ]; then
        echo "Error: Selected analysis could not be published safely." >&2
        return "$publication_rc"
    fi
    if [ "$selected_lock_owned" = true ]; then
        if ! release_selected_analysis_lock \
                "$selected_lock_dir" "$selected_lock_token"; then
            echo "Error: Selected analysis was published, but its writer lock could not be released." >&2
            return 1
        fi
        selected_lock_owned=false
        selected_lock_dir=""
        selected_lock_token=""
    fi

    case "$selected_writer_signal" in
        INT) return 130 ;;
        TERM) return 143 ;;
    esac

    echo "✅ Selected $(jq -r '._metadata.provider' "$selected_file") analysis at $selected_file"
)

# Render what the analyzer was and was not shown. A bounded input that reads as a
# complete one is how a review misses things without anyone noticing.
generate_coverage_section() {
    local context_file="$1"
    local output_file="$2"

    jq -r '
    (.coverage // {}) as $c
    | "## 📥 Analysis Context Coverage\n\n" +
      "_What the analyzer was shown. Anything listed as truncated or dropped was not fully analyzed._\n\n" +
      "| Input | Included | Notes |\n|---|---|---|\n" +
      "| Review threads | " + (($c.unresolved_threads.total // 0) | tostring) + " unresolved (all pages) | " +
        (($c.unresolved_threads.outdated // 0) | tostring) + " outdated; " +
        "nested comments truncated: " + ((($c.unresolved_threads.truncated // []) | length) | tostring) + "; " +
        ((($c.unresolved_threads.incomplete_comment_threads // []) | length) | tostring) + " with replies beyond the " +
        (($c.unresolved_threads.comments_per_thread_limit // 0) | tostring) + "-reply page (later replies not analyzed) |\n" +
      "| Issue comments | " + (($c.issue_comments.included // 0) | tostring) + " of " + (($c.issue_comments.total // 0) | tostring) + " | " +
        (($c.issue_comments.superseded_bot_duplicates // 0) | tostring) + " superseded bot reposts dropped; " +
        ((($c.issue_comments.truncated // []) | length) | tostring) + " truncated |\n" +
      "| Review summaries | " + (($c.review_comments.total // 0) | tostring) + " | " +
        ((($c.review_comments.truncated // []) | length) | tostring) + " truncated |\n" +
      "| Inline comments | " + (($c.inline_comments.total // 0) | tostring) + " | " +
        ((($c.inline_comments.truncated // []) | length) | tostring) + " truncated |\n" +
      "| PR description | 1 | " +
        ((($c.pr_description.truncated // []) | length) | tostring) + " body truncated |\n" +
      "| Diff | " + (if ($c.diff.included // false) then (($c.diff.files_included // 0) | tostring) + " of " + (($c.diff.files_total // 0) | tostring) + " files" elif ($c.diff.requested // false) then "requested, " + ($c.diff.status // "unknown") else "not requested (run with --diff)" end) + " | " +
        (if (($c.diff.files_truncated // []) | length) > 0
            then "truncated: " + (($c.diff.files_truncated // []) | join(", "))
            elif (($c.diff.reason // "") | length) > 0 then ($c.diff.reason | gsub("\\|"; "\\\\|"))
            else "no files truncated" end) + " |\n" +
      "| Commits | " + (($c.inputs.commits // 0) | tostring) + " | commit messages supplied as intent; " +
        ((($c.commits.truncated // []) | length) | tostring) + " bodies truncated |\n" +
      "| Linked issues | " + (($c.inputs.linked_issues // 0) | tostring) + " | " +
        (if (($c.sources.linked_issues.status // "unknown") == "completed")
         then "all pages fetched; " + ((($c.linked_issues.truncated // []) | length) | tostring) + " bodies truncated"
         else "fetch " + ($c.sources.linked_issues.status // "unknown") +
              (if (($c.sources.linked_issues.reason // "") | length) > 0
               then ": " + ($c.sources.linked_issues.reason | gsub("\\|"; "\\\\|")) else "" end)
         end) + " |\n" +
      "| Failing checks | " + (($c.inputs.failing_checks // 0) | tostring) + " | CI failures supplied as evidence |\n" +
      "| SAST findings | " + (($c.inputs.sast_findings // 0) | tostring) + " | " +
        (if ($c.sast.requested // false) then ($c.sast.status // "unknown") +
          (if (($c.sast.reason // "") | length) > 0 then ": " + ($c.sast.reason | gsub("\\|"; "\\\\|")) else "" end)
         else "not requested (run with --sast)" end) + " |\n" +
      ((($c.sources // {}) | to_entries | map(
        "| GitHub source: " + (.key | gsub("_"; " ")) + " | " +
        (.value.status // "unknown") + " | " + ((.value.reason // "") | gsub("\\|"; "\\\\|")) + " |"
      ) | join("\n")) + (if (($c.sources // {}) | length) > 0 then "\n" else "" end)) +
      "| Code access | " + (($c.code_access.state // "unknown")) + " | " + (($c.code_access.reason // "") | gsub("\\|"; "\\\\|")) + " |\n\n" +
      (if ($c.code_access.state // "enabled") == "disabled"
       then "**The analyzer could not read the repository**, so no finding was verified against code: " + ($c.code_access.reason // "") + "\n\n"
       else "" end) +
      "_Truncation limit: " + (($c.truncation_limit_chars // 0) | tostring) + " characters per PR description, comment, thread reply, commit body, linked issue body and file diff._\n"
    ' "$context_file" > "$output_file" 2>/dev/null || echo "" > "$output_file"
}

generate_analysis_report() {
    local analysis_file="$1"
    local output_file="$2"

    # Findings lead with verdict, severity and its derivation so a reader can tell
    # a traced defect from a repeated reviewer opinion without opening the JSON.
    jq -r '
    def anchor(e): (if (e.file // "") == "" or e.file == "n/a" then "" else e.file + ":" + ((e.line // 0) | tostring) end);
    def verdict_mark(v): (if v == "confirmed" then "✅ confirmed" elif v == "refuted" then "❌ refuted" else "🟡 plausible" end);
    # Evidence is strings in systemic_issues and objects in issue_categories.
    # Render either shape rather than aborting the report over a type mismatch:
    # by this point the analysis has already been paid for.
    def evidence_line: (if type == "object"
        then ((if anchor(.) == "" then "" else "`" + anchor(.) + "` — " end) + (.detail // ""))
        else tostring end);

    "# PR Analysis Report\n\n" +
    "## Issue Categories\n\n" +
    (if (.issue_categories | length) == 0 then
        "_No issue categories identified._\n\n"
    else
        (.issue_categories | map(
            "### " + .name + "\n\n" +
            "**Finding ID:** `" + (.finding_id // "") + "`\n\n" +
            "**Verdict:** " + verdict_mark(.verdict // "plausible") +
            " · **Confidence:** " + (.confidence // "unknown") +
            " · **Severity:** " + (.severity // "unknown") +
            " (" + (.impact // "?") + " impact × " + (.likelihood // "?") + " likelihood)" +
            " · **Category:** `" + (.category // "uncategorized") + "`\n\n" +
            (.description // "") + "\n\n" +
            (if (.severity_rationale // "") != "" then "**Why this severity:** " + .severity_rationale + "\n\n" else "" end) +
            (if ((.evidence // []) | length) > 0 then
                "**Evidence:**\n" + ((.evidence // []) | map("- " + evidence_line) | join("\n")) + "\n\n"
            else "" end) +
            "**Threads:** " + (if ((.thread_ids // []) | length) > 0 then (.thread_ids | join(", ")) else "N/A" end) + "\n"
        ) | join("\n"))
    end) +
    "\n## Disputed Review Comments\n\n" +
    "_Reviewer or bot claims that did not survive verification:_\n\n" +
    (if ((.disputed_comments // []) | length) == 0 then
        "_No claims were refuted._\n"
    else
        ((.disputed_comments // []) | map(
            "- **" + (.thread_id // "unknown comment") + "** (confidence: " + (.confidence // "unknown") + ")\n" +
            "  - Claim: " + (.claim // "") + "\n" +
            "  - Why it is incorrect: " + (.why_incorrect // "")
        ) | join("\n"))
    end) +
    "\n\n## Category Coverage\n\n" +
    "_Every category the analyzer swept, and what it concluded:_\n\n" +
    (if ((.category_coverage // []) | length) == 0 then
        "_No coverage reported — treat this analysis as incomplete._\n"
    else
        ("| Category | Verdict | Note |\n|---|---|---|\n" +
         ((.category_coverage // []) | map(
            "| `" + (.category // "?") + "` | " + (.verdict // "?") + " | " + ((.note // "") | gsub("\\|"; "\\\\|")) + " |"
         ) | join("\n")))
    end) +
    "\n\n## Systemic Issues\n\n" +
    (if ((.systemic_issues // []) | length) == 0 then
        "_No systemic patterns identified._\n"
    else
        ((.systemic_issues // []) | map(
            "### " + (.pattern // "") + "\n\n" +
            "**Confirmed findings:** " + ((.finding_ids // []) | join(", ")) + "\n\n" +
            "**Evidence:**\n" + ((.evidence // []) | map("- " + evidence_line) | join("\n")) + "\n\n" +
            "**Recommendation:** " + (.recommendation // "") + "\n"
        ) | join("\n"))
    end) +
    "\n## Adjacent Problems to Investigate\n\n" +
    (if ((.adjacent_problems // []) | length) == 0 then
        "_No adjacent problem areas identified._\n"
    else
        ((.adjacent_problems // []) | map(
            "- " + (if .checked == true then "🔎 **checked**" else "⬜ **not checked — investigate**" end) +
            " **" + (.area // "") + "** (" + (.risk // "") + "): " + (.investigation_hint // "")
        ) | join("\n"))
    end) +
    "\n\n## Task List\n\n" +
    (if ((.task_list // []) | length) == 0 then
        "_No tasks generated._\n"
    else
        ((.task_list // []) | map(
            "### [" + (.priority // "?") + "] " + (.task // "") + "\n" +
            "- **Confirmed findings:** " + ((.finding_ids // []) | join(", ")) + "\n" +
            (if anchor(.) == "" then "" else "- **Location:** `" + anchor(.) + "`\n" end) +
            (if (.suggested_fix // "") != "" then "- **Suggested fix:** " + .suggested_fix + "\n" else "" end) +
            (if (.verification // "") != "" then "- **Verify with:** `" + .verification + "`\n" else "" end) +
            (if ((.thread_ids // []) | length) > 0 then "- **Threads:** " + (.thread_ids | join(", ")) + "\n" else "" end)
        ) | join("\n"))
    end) +
    "\n\n## Process Improvements\n\n" +
    "_Suggestions to prevent similar issues in future PRs:_\n\n" +
    (if ((.process_improvements // []) | length) == 0 then
        "_No process improvements suggested._\n"
    else
        ((.process_improvements // []) | map(
            "### " + (.suggestion // "") + "\n" +
            "**Category:** " + (.category // "") + "\n\n" +
            (.rationale // "") + "\n" +
            (if .implementation_hint then "\n**How to implement:** " + .implementation_hint + "\n" else "" end)
        ) | join("\n"))
    end) +
    "\n\n## PR Template Suggestions\n\n" +
    "_Additions to the PR template that would catch these issues earlier:_\n\n" +
    (if ((.pr_template_suggestions // []) | length) == 0 then
        "_No PR template changes suggested._\n"
    else
        ((.pr_template_suggestions // []) | map(
            "### " + (.section // "") + "\n" +
            "```\n" + (.checkbox_or_question // "") + "\n```\n" +
            "_Why:_ " + (.why // "") + "\n"
        ) | join("\n"))
    end)
    ' "$analysis_file" > "$output_file"
}

