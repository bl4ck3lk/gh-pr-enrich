        > "$REVIEW_COMMENTS_PAGES" 2>/dev/null && \
   jq -s 'if length > 0 and all(.[]; type == "array")
        then (add // []) else error("invalid review pagination") end
      | if all(.[];
            type == "object" and
            (.id | type == "number" and . > 0) and
