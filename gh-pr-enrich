# Get the directory where this extension is installed
get_extension_dir() {
    local script_path
    script_path="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    echo "$script_path"
}

# Load system prompt from file, filtering out comments
# Priority: --prompt arg > $GH_PR_ENRICH_PROMPT > default-prompt.txt.
# Repository-owned files never become system prompts implicitly: PR branches are
# untrusted input, and an override there could remove the bundled injection and
# tool-safety rules before external analysis begins.
load_system_prompt() {
    local prompt_file=""
    local extension_dir
    extension_dir="$(get_extension_dir)"

    # Check --prompt argument first (highest priority)
    if [ -n "$CUSTOM_PROMPT_FILE" ] && [ -f "$CUSTOM_PROMPT_FILE" ]; then
        prompt_file="$CUSTOM_PROMPT_FILE"
    # Check environment variable
    elif [ -n "${GH_PR_ENRICH_PROMPT:-}" ] && [ -f "$GH_PR_ENRICH_PROMPT" ]; then
        prompt_file="$GH_PR_ENRICH_PROMPT"
    # Fall back to bundled default
    elif [ -f "$extension_dir/default-prompt.txt" ]; then
        prompt_file="$extension_dir/default-prompt.txt"
    fi

    if [ -z "$prompt_file" ]; then
        # No inline fallback: the prompt and the JSON schema are one contract, and
        # a built-in prompt describing a different one would steer the model one
        # way while validating it another. A missing bundled prompt means a broken
        # install, which is worth failing on.
        echo "❌ No analysis prompt found: $extension_dir/default-prompt.txt is missing." >&2
        echo "   Reinstall the extension (gh extension upgrade pr-enrich), or pass --prompt FILE." >&2
        return 1
    fi

    # Filter out comment lines and leading blank lines (portable: works on BSD and GNU)
    grep -v '^#' "$prompt_file" | awk 'NF{found=1} found'
}

