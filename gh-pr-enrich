    }

    # Generate special format outputs
    generate_format_output() {
        local format="$1"
        local questions="$2"
        local summary="$3"
        local claude_analysis="${4:-}"

        case "$format" in
            claude-md)
                cat << 'CLAUDE_MD_HEADER'
## Lessons Learned from PR Reviews

<!-- Add this section to your CLAUDE.md -->

