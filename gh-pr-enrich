# One report directory is one input/publication transaction. Hold the existing
# crash-recoverable lock from before the first shared input write until every
# consumer and provider has finished. Inner selected-analysis transactions are
# re-entrant and must leave this outer owner responsible for final release.
RUN_LOCK_DIR=""
RUN_LOCK_TOKEN=""
RUN_LOCK_OWNED=false
RUN_LOCK_ACQUIRING=false
RUN_LOCK_PENDING_SIGNAL=""
RUN_LOCK_PENDING_EXIT_CODE=""
cleanup_report_run_lock() {
    cleanup_external_visibility_temp
    if ! cleanup_pr_summary_connection_temps; then
        echo "Error: PR-summary connection staging remains after cleanup." >&2
        return 1
    fi
    cleanup_live_analysis_discussion_temps
    if [ "$RUN_LOCK_OWNED" = true ]; then
        if ! cleanup_report_run_temp_files; then
            echo "Error: Report pagination staging remains after cleanup in $OUTPUT_DIR." >&2
            return 1
        fi
        if ! release_selected_analysis_lock "$RUN_LOCK_DIR" "$RUN_LOCK_TOKEN"; then
            echo "Error: Report run lock remains after cleanup: $RUN_LOCK_DIR" >&2
            return 1
        fi
        RUN_LOCK_OWNED=false
    fi
}
handle_report_run_signal() {
    local signal="$1" exit_code="$2"
    if [ "$RUN_LOCK_ACQUIRING" = true ] || \
       [ "$REPORT_RUN_CHILD_STARTING" = true ] || \
       [ "$REPORT_RUN_WATCHDOG_STARTING" = true ]; then
        if [ -z "$RUN_LOCK_PENDING_SIGNAL" ]; then
            RUN_LOCK_PENDING_SIGNAL="$signal"
            RUN_LOCK_PENDING_EXIT_CODE="$exit_code"
        fi
        return 0
    fi
    # Ignore a second signal while terminating the active child and performing
    # the ownership-sensitive release. Keep EXIT installed so a transient
    # release failure is retried from its authenticated release state.
    trap '' INT TERM
    terminate_report_run_child
    cleanup_report_run_lock || true
    echo "Error: Report generation was cancelled by $signal." >&2
    exit "$exit_code"
}
RUN_LOCK_ACQUIRING=true
trap cleanup_report_run_lock EXIT
trap 'handle_report_run_signal INT 130' INT
trap 'handle_report_run_signal TERM 143' TERM
if ! acquire_selected_analysis_lock "$OUTPUT_DIR"; then
    RUN_LOCK_ACQUIRING=false
    if [ -n "$RUN_LOCK_PENDING_SIGNAL" ]; then
        handle_report_run_signal "$RUN_LOCK_PENDING_SIGNAL" \
            "$RUN_LOCK_PENDING_EXIT_CODE"
    fi
    echo "Error: Report input collection is already active for $OUTPUT_DIR." >&2
    exit 1
fi
RUN_LOCK_DIR="$SELECTED_ANALYSIS_LOCK_DIR"
