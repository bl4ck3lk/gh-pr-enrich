# Hidden test dispatcher (checked before PR_NUMBER validation).
#
#   gh-pr-enrich --test-call <function> [args...]
#
# Invokes one internal function directly so test suites exercise shipped code
# instead of a copy. Only functions named in TEST_CALLABLE_FUNCTIONS are
# dispatchable — argv must never be able to call arbitrary shell functions.
TEST_CALL_FN=""
TEST_CALL_ARGS=()
if [ "${1:-}" = "--test-call" ]; then
    if [ -z "${2:-}" ]; then
        echo "Error: --test-call requires a function name." >&2
        exit 1
    fi
    TEST_CALL_FN="$2"
    shift 2
    TEST_CALL_ARGS=("$@")
fi

# Skip CLI argument handling in test-call mode ($1 is not a PR number there)
