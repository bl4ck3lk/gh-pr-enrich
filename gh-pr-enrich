    if [ "${1:-}" = "--help" ] || [ $# -ne 2 ]; then
        echo "Usage: gh pr-enrich select-analysis <REPORT_DIR> <SOURCE_JSON>"
        echo "Promote a Codex, Claude, or hybrid result to analysis.json and refresh derived views."
        [ "${1:-}" = "--help" ] && exit 0
        exit 1
    fi
    run_standalone_analysis_selection "$1" "$2"
    exit $?
fi

# Handle install-skill subcommand
if [ "$1" = "install-skill" ]; then
    shift
    SKILL_RUNTIME="both"
    while [ $# -gt 0 ]; do
        case "$1" in
            --runtime)
                [ -n "${2:-}" ] || { echo "Error: --runtime requires codex, claude, or both"; exit 1; }
                SKILL_RUNTIME="$2"
                shift 2
                ;;
            -h|--help)
                echo "Usage: gh pr-enrich install-skill [--runtime codex|claude|both]"
                exit 0
                ;;
            *) echo "Error: Unknown install-skill option: $1"; exit 1 ;;
        esac
    done
    case "$SKILL_RUNTIME" in codex|claude|both) ;; *) echo "Error: Invalid runtime '$SKILL_RUNTIME'"; exit 1 ;; esac

    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
    SKILL_SOURCE="$SCRIPT_DIR/.claude/skills/gh-pr-enrich"

    # Check if skill exists in extension
    if [ ! -d "$SKILL_SOURCE" ]; then
        echo "Error: Skill not found at $SKILL_SOURCE"
        echo "Try upgrading the extension: gh extension upgrade pr-enrich"
        exit 1
    fi

    install_skill_for_runtime() {
        local runtime_label="$1"
        local skills_dir="$2"
        local skill_target="$skills_dir/gh-pr-enrich"

        if [ -f "$skills_dir" ]; then
            echo "Error: $skills_dir exists as a regular file, not a directory."
            return 1
        fi
        mkdir -p "$skills_dir" 2>/dev/null || {
            echo "Error: Could not create directory $skills_dir"
            return 1
        }
        if [ -e "$skill_target" ] && [ ! -L "$skill_target" ]; then
            echo "Error: $skill_target exists and is not a symlink."
            return 1
        fi
        if [ -L "$skill_target" ]; then
            if [ "$(canonicalize_path "$skill_target")" = "$(canonicalize_path "$SKILL_SOURCE")" ]; then
                echo "✅ $runtime_label skill already installed at $skill_target" || true
                return 0
            fi
            echo "Error: $skill_target points to another skill source; leaving it untouched."
            return 1
        fi
        ln -s "$SKILL_SOURCE" "$skill_target" 2>/dev/null || {
            echo "Error: Could not create symlink at $skill_target"
            return 1
        }
        echo "✅ $runtime_label skill installed at $skill_target" || true
        return 0
    }

    preflight_skill_for_runtime() {
        local runtime_label="$1"
        local skills_dir="$2"
        local skill_target="$skills_dir/gh-pr-enrich"
        if [ -f "$skills_dir" ]; then
            echo "Error: $skills_dir exists as a regular file, not a directory."
            return 1
        fi
        if [ -e "$skill_target" ] && [ ! -L "$skill_target" ]; then
            echo "Error: $skill_target exists and is not a symlink."
            return 1
        fi
        if [ -L "$skill_target" ] && \
           [ "$(canonicalize_path "$skill_target")" != "$(canonicalize_path "$SKILL_SOURCE")" ]; then
            echo "Error: $runtime_label target $skill_target points to another skill source."
            return 1
        fi
    }

    skill_symlink_identity() {
        local skill_target="$1"
        [ -L "$skill_target" ] || return 1
        stat -c '%d:%i' "$skill_target" 2>/dev/null || \
            stat -f '%d:%i' "$skill_target" 2>/dev/null
    }

    cleanup_skill_install_reference() {
        local reference_path="$1" reference_dir="$2"
        [ -n "$reference_path" ] && [ -n "$reference_dir" ] || return 0
        [ ! -e "$reference_path" ] && [ ! -L "$reference_path" ] || \
            rm "$reference_path" 2>/dev/null || return 1
        [ ! -d "$reference_dir" ] || \
        rmdir "$reference_dir" 2>/dev/null
    }

    install_skill_with_reference() {
        local runtime_label="$1" skills_dir="$2" skill_target="$3"
        local reference_dir reference_path created_payload created_identity

        mkdir -p "$skills_dir" 2>/dev/null || {
            echo "Error: Could not create directory $skills_dir"
            return 1
        }
        reference_dir="$(mktemp -d \
            "$skills_dir/.gh-pr-enrich-install.XXXXXX")" || {
            echo "Error: Could not create a private $runtime_label install reference"
            return 1
        }
        # Match the public basename so linking into skills_dir atomically
        # targets exactly skills_dir/gh-pr-enrich. This fails without writing
        # inside a concurrently created directory at that public path.
        reference_path="$reference_dir/gh-pr-enrich"
        case "$runtime_label" in
            Codex)
                CODEX_INSTALL_REFERENCE_DIR="$reference_dir"
                CODEX_INSTALL_REFERENCE="$reference_path"
                ;;
            Claude)
                CLAUDE_INSTALL_REFERENCE_DIR="$reference_dir"
                CLAUDE_INSTALL_REFERENCE="$reference_path"
                ;;
        esac
        ln -s "$SKILL_SOURCE" "$reference_path" 2>/dev/null || {
            echo "Error: Could not create a private $runtime_label install reference"
            rmdir "$reference_dir" 2>/dev/null || true
            return 1
        }
        created_payload="$(readlink "$reference_path")" || {
            cleanup_skill_install_reference "$reference_path" \
                "$reference_dir" || true
            return 1
        }
        created_identity="$(skill_symlink_identity "$reference_path")" || {
            cleanup_skill_install_reference "$reference_path" \
                "$reference_dir" || true
            return 1
        }
        case "$runtime_label" in
            Codex)
                CODEX_CREATED_PAYLOAD="$created_payload"
                CODEX_CREATED_IDENTITY="$created_identity"
                CODEX_INSTALL_ATTEMPTED=true
                ;;
            Claude)
                CLAUDE_CREATED_PAYLOAD="$created_payload"
                CLAUDE_CREATED_IDENTITY="$created_identity"
                CLAUDE_INSTALL_ATTEMPTED=true
                ;;
        esac

        # Publish a hard link to the prepared symlink inode. The retained
        # private name is a stable ownership reference even if another
        # installer replaces the public registration before this call returns.
        if ! ln -P "$reference_path" "$skills_dir" 2>/dev/null; then
            echo "Error: Could not create symlink at $skill_target"
            return 1
        fi
        echo "✅ $runtime_label skill installed at $skill_target" || true
        return 0
    }

    validate_skill_install_commit() {
        local runtime_label="$1" skill_target="$2" install_attempted="$3"
        local expected_payload="$4" expected_identity="$5"
        local actual_payload actual_identity actual_source canonical_source

        if [ "$install_attempted" = true ]; then
            actual_payload="$(readlink "$skill_target" 2>/dev/null)" || {
                echo "Error: $runtime_label registration changed before install commit"
                return 1
            }
            actual_identity="$(skill_symlink_identity "$skill_target")" || {
                echo "Error: $runtime_label registration changed before install commit"
                return 1
            }
            if [ "$actual_payload" != "$expected_payload" ] || \
               [ "$actual_identity" != "$expected_identity" ]; then
                echo "Error: $runtime_label registration changed before install commit"
                return 1
            fi
            return 0
        fi

        [ -L "$skill_target" ] || {
            echo "Error: $runtime_label registration changed before install commit"
            return 1
        }
        actual_source="$(canonicalize_path "$skill_target")" || {
            echo "Error: $runtime_label registration changed before install commit"
            return 1
        }
        canonical_source="$(canonicalize_path "$SKILL_SOURCE")" || return 1
        if [ "$actual_source" != "$canonical_source" ]; then
            echo "Error: $runtime_label registration changed before install commit"
            return 1
        fi
    }

    rollback_created_skill() {
        local runtime_label="$1" skill_target="$2" expected_payload="$3"
        local expected_identity="$4" reference_path="$5" reference_dir="$6"
        local claim_dir="$reference_dir/claim"
        local claimed_path="$claim_dir/gh-pr-enrich"
        local skill_parent claimed_payload claimed_identity

        # A directory cannot be restored with an atomic create-if-absent
        # primitive. If one already won the public path, never detach it.
        if [ -d "$skill_target" ] && [ ! -L "$skill_target" ]; then
            echo "Error: $runtime_label registration was replaced concurrently by a directory; leaving it untouched"
            cleanup_skill_install_reference "$reference_path" "$reference_dir" || true
            return 1
        fi

        mkdir "$claim_dir" 2>/dev/null || {
            echo "Error: Could not create a private $runtime_label rollback claim"
            return 1
        }

        # Atomically detach the current public name before inspecting it. This
        # closes the check-to-unlink race: later replacements at skill_target
        # are never touched by this rollback.
        if ! mv "$skill_target" "$claimed_path" 2>/dev/null; then
            if [ ! -e "$claimed_path" ] && [ ! -L "$claimed_path" ]; then
                echo "Error: $runtime_label registration changed before install rollback; leaving it untouched"
                rmdir "$claim_dir" 2>/dev/null || true
                cleanup_skill_install_reference "$reference_path" "$reference_dir" || true
                return 1
            fi
            echo "Error: $runtime_label rollback claim reported failure after detaching the registration; recovering the claim"
        fi
        if [ -L "$claimed_path" ]; then
            claimed_payload="$(readlink "$claimed_path")" || {
                echo "Error: Could not inspect the claimed $runtime_label registration; preserved at $claimed_path"
                rm "$reference_path" 2>/dev/null || true
                return 1
            }
            claimed_identity="$(skill_symlink_identity "$claimed_path")" || {
                echo "Error: Could not identify the claimed $runtime_label registration; preserved at $claimed_path"
                rm "$reference_path" 2>/dev/null || true
                return 1
            }
        else
            claimed_payload=""
            claimed_identity=""
        fi

        if [ "$claimed_payload" = "$expected_payload" ] && \
           [ "$claimed_identity" = "$expected_identity" ]; then
            rm "$claimed_path" 2>/dev/null || {
                echo "Error: Could not remove the claimed $runtime_label registration"
                return 1
            }
        else
            # The claim captured another installer's object. Symlinks and
            # regular files can be restored atomically with an exact-basename
            # hard link into the parent. A directory caught in the narrow race
            # after the pre-claim check remains recoverable at claimed_path.
            skill_parent="$(dirname "$skill_target")"
            if { [ -L "$claimed_path" ] || [ -f "$claimed_path" ]; } && \
               ln -P "$claimed_path" "$skill_parent" 2>/dev/null; then
                rm "$claimed_path" 2>/dev/null || return 1
                echo "Error: $runtime_label registration was replaced concurrently; restored it unchanged"
            else
                echo "Error: $runtime_label registration was replaced concurrently; preserved at $claimed_path"
                rm "$reference_path" 2>/dev/null || true
                return 1
            fi
        fi
        rmdir "$claim_dir" 2>/dev/null || return 1
        cleanup_skill_install_reference "$reference_path" "$reference_dir"
    }

    record_install_signal() {
        case "$1" in
            INT) INSTALL_TRANSACTION_SIGNAL_STATUS=130 ;;
            TERM) INSTALL_TRANSACTION_SIGNAL_STATUS=143 ;;
        esac
    }

    exit_if_install_signaled() {
        [ -z "$INSTALL_TRANSACTION_SIGNAL_STATUS" ] || \
            exit "$INSTALL_TRANSACTION_SIGNAL_STATUS"
    }

    cleanup_install_transaction_on_exit() {
        local exit_status="$1"
        # Rollback temporarily detaches public registrations. Ignore repeated
        # cancellation while cleanup owns those private claims; the original
        # signal status is already captured in exit_status.
        trap - EXIT
        trap '' INT TERM
        if [ "$INSTALL_TRANSACTION_ACTIVE" = true ]; then
            if [ "$INSTALL_TRANSACTION_BOTH_INSTALLED" = true ]; then
                cleanup_skill_install_reference "$CLAUDE_INSTALL_REFERENCE" \
                    "$CLAUDE_INSTALL_REFERENCE_DIR" || true
                cleanup_skill_install_reference "$CODEX_INSTALL_REFERENCE" \
                    "$CODEX_INSTALL_REFERENCE_DIR" || true
            else
                if [ "$CLAUDE_INSTALL_ATTEMPTED" = true ]; then
                    rollback_created_skill "Claude" "$CLAUDE_SKILL_TARGET" \
                        "$CLAUDE_CREATED_PAYLOAD" \
                        "$CLAUDE_CREATED_IDENTITY" \
                        "$CLAUDE_INSTALL_REFERENCE" \
                        "$CLAUDE_INSTALL_REFERENCE_DIR" || true
                else
                    cleanup_skill_install_reference \
                        "$CLAUDE_INSTALL_REFERENCE" \
                        "$CLAUDE_INSTALL_REFERENCE_DIR" || true
                fi
                if [ "$CODEX_INSTALL_ATTEMPTED" = true ]; then
                    rollback_created_skill "Codex" "$CODEX_SKILL_TARGET" \
                        "$CODEX_CREATED_PAYLOAD" "$CODEX_CREATED_IDENTITY" \
                        "$CODEX_INSTALL_REFERENCE" \
                        "$CODEX_INSTALL_REFERENCE_DIR" || true
                else
                    cleanup_skill_install_reference "$CODEX_INSTALL_REFERENCE" \
                        "$CODEX_INSTALL_REFERENCE_DIR" || true
                fi
            fi
        fi
        exit "$exit_status"
    }

    codex_config_root="${CODEX_HOME:-$HOME/.codex}"
    claude_config_root="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
    CODEX_SKILLS_DIR="$codex_config_root/skills"
    CLAUDE_SKILLS_DIR="$claude_config_root/skills"
    CODEX_SKILL_TARGET="$CODEX_SKILLS_DIR/gh-pr-enrich"
    CLAUDE_SKILL_TARGET="$CLAUDE_SKILLS_DIR/gh-pr-enrich"

    if [ "$SKILL_RUNTIME" = "both" ]; then
        preflight_skill_for_runtime "Codex" "$CODEX_SKILLS_DIR" || exit 1
        preflight_skill_for_runtime "Claude" "$CLAUDE_SKILLS_DIR" || exit 1

        CODEX_ALREADY_INSTALLED=false
        [ ! -L "$CODEX_SKILL_TARGET" ] || CODEX_ALREADY_INSTALLED=true
        CLAUDE_ALREADY_INSTALLED=false
        [ ! -L "$CLAUDE_SKILL_TARGET" ] || CLAUDE_ALREADY_INSTALLED=true
        CODEX_INSTALL_REFERENCE_DIR=""
        CODEX_INSTALL_REFERENCE=""
        CODEX_CREATED_PAYLOAD=""
        CODEX_CREATED_IDENTITY=""
        CODEX_INSTALL_ATTEMPTED=false
        CLAUDE_INSTALL_REFERENCE_DIR=""
        CLAUDE_INSTALL_REFERENCE=""
        CLAUDE_CREATED_PAYLOAD=""
        CLAUDE_CREATED_IDENTITY=""
        CLAUDE_INSTALL_ATTEMPTED=false
        INSTALL_TRANSACTION_ACTIVE=false
        INSTALL_TRANSACTION_BOTH_INSTALLED=false
        INSTALL_TRANSACTION_SIGNAL_STATUS=""
        if [ "$CODEX_ALREADY_INSTALLED" = false ] || \
           [ "$CLAUDE_ALREADY_INSTALLED" = false ]; then
            INSTALL_TRANSACTION_ACTIVE=true
            trap 'record_install_signal INT' INT
            trap 'record_install_signal TERM' TERM
            trap 'cleanup_install_transaction_on_exit $?' EXIT
        fi
        if [ "$CODEX_ALREADY_INSTALLED" = true ]; then
            install_skill_for_runtime "Codex" "$CODEX_SKILLS_DIR" || exit 1
        else
            if ! install_skill_with_reference "Codex" "$CODEX_SKILLS_DIR" \
                    "$CODEX_SKILL_TARGET"; then
                exit_if_install_signaled
                exit 1
            fi
        fi
        exit_if_install_signaled
        if [ "$CLAUDE_ALREADY_INSTALLED" = true ]; then
            install_skill_for_runtime "Claude" "$CLAUDE_SKILLS_DIR" || exit 1
        else
            if ! install_skill_with_reference "Claude" "$CLAUDE_SKILLS_DIR" \
                    "$CLAUDE_SKILL_TARGET"; then
                exit_if_install_signaled
                exit 1
            fi
        fi
        if ! validate_skill_install_commit "Codex" "$CODEX_SKILL_TARGET" \
                "$CODEX_INSTALL_ATTEMPTED" "$CODEX_CREATED_PAYLOAD" \
                "$CODEX_CREATED_IDENTITY"; then
            exit_if_install_signaled
            exit 1
        fi
        if ! validate_skill_install_commit "Claude" "$CLAUDE_SKILL_TARGET" \
                "$CLAUDE_INSTALL_ATTEMPTED" "$CLAUDE_CREATED_PAYLOAD" \
                "$CLAUDE_CREATED_IDENTITY"; then
            exit_if_install_signaled
            exit 1
        fi
        exit_if_install_signaled
        if [ "$INSTALL_TRANSACTION_ACTIVE" = true ]; then
            INSTALL_TRANSACTION_BOTH_INSTALLED=true
            exit_if_install_signaled
            cleanup_skill_install_reference "$CLAUDE_INSTALL_REFERENCE" \
                "$CLAUDE_INSTALL_REFERENCE_DIR" || {
                echo "Error: Could not clean the private Claude install reference"
                exit 1
            }
            cleanup_skill_install_reference "$CODEX_INSTALL_REFERENCE" \
                "$CODEX_INSTALL_REFERENCE_DIR" || {
                echo "Error: Could not clean the private Codex install reference"
                exit 1
            }
            INSTALL_TRANSACTION_ACTIVE=false
            trap - EXIT INT TERM
            exit_if_install_signaled
        fi
    elif [ "$SKILL_RUNTIME" = "codex" ]; then
        preflight_skill_for_runtime "Codex" "$CODEX_SKILLS_DIR" || exit 1
        install_skill_for_runtime "Codex" "$CODEX_SKILLS_DIR"
    else
        preflight_skill_for_runtime "Claude" "$CLAUDE_SKILLS_DIR" || exit 1
        install_skill_for_runtime "Claude" "$CLAUDE_SKILLS_DIR"
    fi
    echo "   Canonical source: $SKILL_SOURCE" || true
    echo "" || true
    echo "The skill will auto-update when you run: gh extension upgrade pr-enrich" || true
    exit 0
fi

# Handle retrospective subcommand - analyze patterns across all PR reports
if [ "$1" = "retrospective" ]; then
    shift

    # Default values
    RETRO_SINCE=""
    RETRO_AUTHOR=""
    RETRO_REPORTS_DIR="${PR_REVIEW_OUTPUT_ROOT:-.reports/pr-reviews}"
    RETRO_OUTPUT_DIR=".reports/retrospectives"
    RETRO_ENRICH=false
    RETRO_ALLOW_EXTERNAL=false
    RETRO_MIN_PRS=3
    RETRO_FORMAT=""
    RETRO_OUTPUT_FORMAT="combined"
    PR_REPORTS=()
    RETRO_SNAPSHOT_ROOT=""
    RETRO_SNAPSHOT_LEASE_FD=""
    RETRO_SNAPSHOT_BOOTSTRAP_FD=""
    RETRO_SNAPSHOT_JANITOR_PID=""
    RETRO_SNAPSHOT_JANITOR_JOB=""
    RETRO_SNAPSHOT_WORKER_PID=""
    RETRO_SNAPSHOT_WORKER_GROUP_OWNED=false
    RETRO_SNAPSHOT_WORKER_STARTING=false
    RETRO_PENDING_SIGNAL_STATUS=""
    close_retrospective_snapshot_lease() {
        case "$RETRO_SNAPSHOT_LEASE_FD" in
            9) exec 9>&- ;;
            8) exec 8>&- ;;
            7) exec 7>&- ;;
            6) exec 6>&- ;;
            5) exec 5>&- ;;
            "") return 0 ;;
            *) return 1 ;;
        esac
        RETRO_SNAPSHOT_LEASE_FD=""
    }
    close_retrospective_snapshot_bootstrap() {
        case "$RETRO_SNAPSHOT_BOOTSTRAP_FD" in
            9) exec 9>&- ;;
            8) exec 8>&- ;;
            7) exec 7>&- ;;
            6) exec 6>&- ;;
            5) exec 5>&- ;;
            "") return 0 ;;
            *) return 1 ;;
        esac
        RETRO_SNAPSHOT_BOOTSTRAP_FD=""
    }
    retrospective_snapshot_worker_alive() {
        [ -n "$RETRO_SNAPSHOT_WORKER_PID" ] || return 1
        if [ "$RETRO_SNAPSHOT_WORKER_GROUP_OWNED" = true ]; then
            kill -0 -- "-$RETRO_SNAPSHOT_WORKER_PID" 2>/dev/null
        else
            kill -0 "$RETRO_SNAPSHOT_WORKER_PID" 2>/dev/null
        fi
    }
    stop_retrospective_snapshot_worker() {
        local wait_attempt=0
        [ -n "$RETRO_SNAPSHOT_WORKER_PID" ] || return 0
        if [ "$RETRO_SNAPSHOT_WORKER_GROUP_OWNED" = true ]; then
            kill -TERM -- "-$RETRO_SNAPSHOT_WORKER_PID" 2>/dev/null || true
        else
            kill -TERM "$RETRO_SNAPSHOT_WORKER_PID" 2>/dev/null || true
        fi
        while [ "$wait_attempt" -lt 10 ] && \
              retrospective_snapshot_worker_alive; do
            sleep 0.01
            wait_attempt=$((wait_attempt + 1))
        done
        if retrospective_snapshot_worker_alive; then
            if [ "$RETRO_SNAPSHOT_WORKER_GROUP_OWNED" = true ]; then
                kill -KILL -- "-$RETRO_SNAPSHOT_WORKER_PID" 2>/dev/null || true
            else
                kill -KILL "$RETRO_SNAPSHOT_WORKER_PID" 2>/dev/null || true
            fi
        fi
        wait "$RETRO_SNAPSHOT_WORKER_PID" 2>/dev/null || true
        RETRO_SNAPSHOT_WORKER_PID=""
        RETRO_SNAPSHOT_WORKER_GROUP_OWNED=false
    }
    cleanup_retrospective_snapshots() {
        local snapshot_root="$RETRO_SNAPSHOT_ROOT"
        local wait_attempt=0
        [ -n "$RETRO_SNAPSHOT_ROOT" ] || return 0
        stop_retrospective_snapshot_worker || true
        close_retrospective_snapshot_lease || true
        close_retrospective_snapshot_bootstrap || true
        if [ -n "$RETRO_SNAPSHOT_JANITOR_PID" ]; then
            while [ "$wait_attempt" -lt 100 ] && \
                  { [ -e "$snapshot_root" ] || \
                    [ -e "$snapshot_root.janitor" ]; } && \
                  jobs -p "$RETRO_SNAPSHOT_JANITOR_JOB" \
                    >/dev/null 2>&1; do
                sleep 0.01
                wait_attempt=$((wait_attempt + 1))
            done
            if jobs -p "$RETRO_SNAPSHOT_JANITOR_JOB" \
                    >/dev/null 2>&1 && \
               { [ -e "$snapshot_root" ] || \
                 [ -e "$snapshot_root.janitor" ]; }; then
                kill -TERM "$RETRO_SNAPSHOT_JANITOR_JOB" 2>/dev/null || true
            fi
            if [ -n "$RETRO_SNAPSHOT_JANITOR_JOB" ]; then
                wait_attempt=0
                while [ "$wait_attempt" -lt 100 ] && \
                      jobs -p "$RETRO_SNAPSHOT_JANITOR_JOB" \
                        >/dev/null 2>&1; do
                    sleep 0.01
                    wait_attempt=$((wait_attempt + 1))
                done
                if jobs -p "$RETRO_SNAPSHOT_JANITOR_JOB" \
                        >/dev/null 2>&1; then
                    kill -KILL "$RETRO_SNAPSHOT_JANITOR_JOB" 2>/dev/null || true
                fi
                wait "$RETRO_SNAPSHOT_JANITOR_PID" 2>/dev/null || true
            fi
            RETRO_SNAPSHOT_JANITOR_PID=""
            RETRO_SNAPSHOT_JANITOR_JOB=""
        fi
        case "$snapshot_root" in
            /tmp/gh-pr-enrich-analysis-snapshot.*|\
            /private/tmp/gh-pr-enrich-analysis-snapshot.*)
                chmod -R u+w "$snapshot_root" 2>/dev/null || true
                rm -rf "$snapshot_root"
                rm -f "$snapshot_root.janitor"
                ;;
            *) ;;
        esac
        if [ ! -e "$snapshot_root" ] && [ ! -e "$snapshot_root.janitor" ]; then
            RETRO_SNAPSHOT_ROOT=""
            return 0
        fi
        echo "Error: Retrospective snapshot cleanup is incomplete; recovery path retained: $snapshot_root" >&2
        return 1
    }
    terminate_retrospective() {
        local signal_status="$1"
        if [ "$RETRO_SNAPSHOT_WORKER_STARTING" = true ]; then
            [ -n "$RETRO_PENDING_SIGNAL_STATUS" ] || \
                RETRO_PENDING_SIGNAL_STATUS="$signal_status"
            return 0
        fi
        # An explicit signal trap interrupts Bash's synchronous wait for a
        # snapshot-copy child. The child has already closed the lease writer,
        # so cleanup can revoke the shared root without waiting for that copy.
        cleanup_retrospective_snapshots || true
        trap - EXIT HUP INT TERM
        exit "$signal_status"
    }
    cleanup_retrospective_report_snapshot() {
        local selected_file="$1" snapshot_dir snapshot_parent snapshot_name
        [ -n "$RETRO_SNAPSHOT_ROOT" ] && [ -n "$selected_file" ] || return 1
        snapshot_dir="$(dirname "$(dirname "$selected_file")")" || return 1
        snapshot_parent="$(canonicalize_path "$(dirname "$snapshot_dir")")" || return 1
        snapshot_name="$(basename "$snapshot_dir")"
        [ "$snapshot_parent" = "$(canonicalize_path "$RETRO_SNAPSHOT_ROOT")" ] && \
            [[ "$snapshot_name" =~ ^report\.[A-Za-z0-9]+$ ]] && \
            [ -d "$snapshot_dir" ] && [ ! -L "$snapshot_dir" ] || return 1
        chmod -R u+w "$snapshot_dir" 2>/dev/null || true
        rm -rf "$snapshot_dir"
        [ ! -e "$snapshot_dir" ]
    }
    trap cleanup_retrospective_snapshots EXIT
    trap 'terminate_retrospective 129' HUP
    trap 'terminate_retrospective 130' INT
    trap 'terminate_retrospective 143' TERM

    # Show help
    if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
        cat << 'RETRO_HELP'
Usage: gh pr-enrich retrospective [OPTIONS]

Analyze patterns across all PRs in the reports folder to identify systemic
issues, generate guiding questions, and help prevent recurring problems.

OPTIONS:
  --since DATE        Analyze PRs from this date (ISO 8601 or "30d", "2w", "3m")
  --author LOGIN      Filter by PR author(s), comma-separated
  --reports-dir DIR   Path to reports directory (default: .reports/pr-reviews)
  --output-dir DIR    Where to save output (default: .reports/retrospectives)
  --enrich            Use Claude for meta-analysis
  --allow-external    Authorize sending aggregated report data to external Claude
  --min-prs N         Warn if fewer than N PRs found (default: 3)
  --format TYPE       Extra output format: claude-md, pr-template, checklist
  --json              Output JSON only
  --markdown          Output Markdown only
  -h, --help          Show this help

EXAMPLES:
  gh pr-enrich retrospective                    # Analyze all PRs
  gh pr-enrich retrospective --since 30d        # Last 30 days
  gh pr-enrich retrospective --author octocat   # Single author
  gh pr-enrich retrospective --enrich --allow-external # With Claude meta-analysis
  gh pr-enrich retrospective --format claude-md # Output CLAUDE.md section

OUTPUT:
  The retrospective generates:
  - Cross-PR systemic patterns (issues that repeat across PRs)
  - File/component hotspots (areas receiving most feedback)
  - Guiding questions checklist (derived from recurring issues)
  - Improvement tracking (suggestions made vs adopted)
  - Team retrospective summary (for sprint retros)

  With --enrich, Claude provides:
  - Meta-patterns and root causes
  - Knowledge gap identification
  - Automation opportunities
  - Refined guiding questions
RETRO_HELP
        exit 0
    fi

    # Parse retrospective options
    while [[ $# -gt 0 ]]; do
        case $1 in
            --since)
                if [ -z "${2:-}" ]; then
                    echo "Error: --since requires a date value"
                    exit 1
                fi
                RETRO_SINCE="$2"
                shift 2
                ;;
            --author)
                if [ -z "${2:-}" ]; then
                    echo "Error: --author requires a login value"
                    exit 1
                fi
                RETRO_AUTHOR="$2"
                shift 2
                ;;
            --reports-dir)
                if [ -z "${2:-}" ]; then
                    echo "Error: --reports-dir requires a directory path"
                    exit 1
                fi
                RETRO_REPORTS_DIR="$2"
                shift 2
                ;;
            --output-dir)
                if [ -z "${2:-}" ]; then
                    echo "Error: --output-dir requires a directory path"
                    exit 1
                fi
                RETRO_OUTPUT_DIR="$2"
                shift 2
                ;;
            --enrich)
                RETRO_ENRICH=true
                shift
                ;;
            --allow-external)
                RETRO_ALLOW_EXTERNAL=true
                shift
                ;;
            --min-prs)
                if [ -z "${2:-}" ]; then
                    echo "Error: --min-prs requires a numeric value"
                    exit 1
                fi
                if ! [[ "$2" =~ ^[0-9]+$ ]] || [ "$2" -lt 1 ]; then
                    echo "Error: --min-prs must be a positive integer (got: '$2')"
                    exit 1
                fi
                RETRO_MIN_PRS="$2"
                shift 2
                ;;
            --format)
                if [ -z "${2:-}" ]; then
                    echo "Error: --format requires a type (claude-md, pr-template, checklist)"
                    exit 1
                fi
                case "$2" in
                    claude-md|pr-template|checklist)
                        RETRO_FORMAT="$2"
                        ;;
                    *)
                        echo "Error: --format must be one of: claude-md, pr-template, checklist"
                        exit 1
                        ;;
                esac
                shift 2
                ;;
            --json)
                RETRO_OUTPUT_FORMAT="json"
                shift
                ;;
            --markdown)
                RETRO_OUTPUT_FORMAT="markdown"
                shift
                ;;
            *)
                echo "Unknown option: $1"
                echo "Run 'gh pr-enrich retrospective --help' for usage"
                exit 1
                ;;
        esac
    done

    if [ "$RETRO_ENRICH" = true ] && [ "$RETRO_ALLOW_EXTERNAL" != true ]; then
        echo "Error: Retrospective data may include private PR content." >&2
        echo "Re-run with --allow-external only after the user explicitly authorizes disclosure." >&2
        exit 1
    fi

    # Validate reports directory exists
    if [ ! -d "$RETRO_REPORTS_DIR" ]; then
        echo "Error: Reports directory not found: $RETRO_REPORTS_DIR"
        echo "Run 'gh pr-enrich <PR_NUMBER> --enrich' to generate PR reports first."
        exit 1
    fi

    # Ensure jq is available
    if ! command -v jq &> /dev/null; then
        echo "Error: jq is required but not installed."
        echo "Install with: brew install jq (macOS) or apt-get install jq (Linux)"
        exit 1
    fi

    # Check Claude CLI if enrichment was requested.
    check_claude_cli() {
        if [ "$RETRO_ENRICH" = true ]; then
            if ! command -v claude &> /dev/null; then
                echo "Warning: Claude CLI not found. Skipping enrichment." >&2
                echo "Install from: https://claude.ai/code" >&2
                RETRO_ENRICH=false
            fi
        fi
    }

    start_retrospective_snapshot_lease() {
        local cleanup_command fifo_path token_file token janitor_pid
        local recorded_token recorded_pid state ready=false wait_attempt=0
        local candidate_fd janitor_job_number
        RETRO_SNAPSHOT_ROOT="$(mktemp -d \
            "/tmp/gh-pr-enrich-analysis-snapshot.XXXXXX")" || return 1
        fifo_path="$RETRO_SNAPSHOT_ROOT/.owner"
        token_file="$(mktemp "/tmp/gh-pr-enrich-retro-token.XXXXXX")" || {
            cleanup_retrospective_snapshots || true
            return 1
        }
        token="${token_file##*.}"
        rm -f "$token_file"
        if ! (umask 077; mkfifo "$fifo_path") 2>/dev/null; then
            cleanup_retrospective_snapshots || true
            return 1
        fi
        for candidate_fd in 9 8 7 6 5; do
            case "$candidate_fd" in
                9) { : >&9; } 2>/dev/null && continue ;;
                8) { : >&8; } 2>/dev/null && continue ;;
                7) { : >&7; } 2>/dev/null && continue ;;
                6) { : >&6; } 2>/dev/null && continue ;;
                5) { : >&5; } 2>/dev/null && continue ;;
            esac
            if [ -z "$RETRO_SNAPSHOT_LEASE_FD" ]; then
                RETRO_SNAPSHOT_LEASE_FD="$candidate_fd"
            else
                RETRO_SNAPSHOT_BOOTSTRAP_FD="$candidate_fd"
                break
            fi
        done
        [ -n "$RETRO_SNAPSHOT_LEASE_FD" ] && \
            [ -n "$RETRO_SNAPSHOT_BOOTSTRAP_FD" ] || {
            cleanup_retrospective_snapshots || true
            return 1
        }
        case "$RETRO_SNAPSHOT_BOOTSTRAP_FD" in
            9) exec 9<>"$fifo_path" ;;
            8) exec 8<>"$fifo_path" ;;
            7) exec 7<>"$fifo_path" ;;
            6) exec 6<>"$fifo_path" ;;
            5) exec 5<>"$fifo_path" ;;
        esac
        # Open the durable writer while the bootstrap descriptor still keeps
        # both FIFO ends available. The janitor may unlink the pathname once
        # launched; neither side needs to reopen it after this point.
        case "$RETRO_SNAPSHOT_LEASE_FD" in
            9) exec 9>"$fifo_path" ;;
            8) exec 8>"$fifo_path" ;;
            7) exec 7>"$fifo_path" ;;
            6) exec 6>"$fifo_path" ;;
            5) exec 5>"$fifo_path" ;;
        esac
        cleanup_command="$(canonicalize_path "${BASH_SOURCE[0]}")"
        "$cleanup_command" __retrospective-snapshot-janitor \
            "$RETRO_SNAPSHOT_ROOT" "$RETRO_SNAPSHOT_ROOT.janitor" \
            "$token" "$fifo_path" "$RETRO_SNAPSHOT_LEASE_FD" \
            "$RETRO_SNAPSHOT_BOOTSTRAP_FD" < "$fifo_path" \
            >/dev/null 2>&1 &
        janitor_pid=$!
        RETRO_SNAPSHOT_JANITOR_PID="$janitor_pid"
        janitor_job_number="$(jobs -l | awk -v target="$janitor_pid" \
            '$2 == target {job = $1; gsub(/[^0-9]/, "", job); print job; exit}')"
        if ! [[ "$janitor_job_number" =~ ^[1-9][0-9]*$ ]]; then
            cleanup_retrospective_snapshots || true
            return 1
        fi
        RETRO_SNAPSHOT_JANITOR_JOB="%$janitor_job_number"
        close_retrospective_snapshot_bootstrap || {
            cleanup_retrospective_snapshots || true
            return 1
        }
        while [ "$wait_attempt" -lt 300 ]; do
            if analysis_snapshot_sidecar_matches "$RETRO_SNAPSHOT_ROOT" \
                    "$RETRO_SNAPSHOT_ROOT.janitor" "$token" active; then
                IFS=$'\t' read -r recorded_token recorded_pid state \
                    < "$RETRO_SNAPSHOT_ROOT.janitor" || break
                if [ "$recorded_pid" = "$janitor_pid" ]; then
                    ready=true
                    break
                fi
            fi
            jobs -p "$RETRO_SNAPSHOT_JANITOR_JOB" >/dev/null 2>&1 || break
            sleep 0.01
            wait_attempt=$((wait_attempt + 1))
        done
        if [ "$ready" != true ] || \
           ! retrospective_snapshot_lease_active "$RETRO_SNAPSHOT_ROOT" \
                "$RETRO_SNAPSHOT_LEASE_FD"; then
            close_retrospective_snapshot_lease || true
            kill -TERM "$RETRO_SNAPSHOT_JANITOR_JOB" 2>/dev/null || true
            cleanup_retrospective_snapshots || true
            return 1
        fi
    }

    # ============================================================================
    # Retrospective Helper Functions
    # ============================================================================

    # Convert relative date (30d, 2w) to ISO 8601 date
    # Args: $1 - date string (ISO 8601 or relative like "30d", "2w")
    # Output: ISO 8601 date string
    parse_since_date() {
        local input="$1"

        # If already ISO 8601 format, return as-is
        if [[ "$input" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2} ]]; then
            echo "$input"
            return 0
        fi

        # Parse relative format (e.g., 30d, 2w)
        local num unit
        if [[ "$input" =~ ^([0-9]+)([dwm])$ ]]; then
            num="${BASH_REMATCH[1]}"
            unit="${BASH_REMATCH[2]}"

            case "$unit" in
                d) # days
                    if [[ "$OSTYPE" == "darwin"* ]]; then
                        date -v-${num}d +%Y-%m-%d
                    else
                        date -d "$num days ago" +%Y-%m-%d
                    fi
                    ;;
                w) # weeks
                    local days=$((num * 7))
                    if [[ "$OSTYPE" == "darwin"* ]]; then
                        date -v-${days}d +%Y-%m-%d
                    else
                        date -d "$days days ago" +%Y-%m-%d
                    fi
                    ;;
                m) # months
                    if [[ "$OSTYPE" == "darwin"* ]]; then
                        date -v-${num}m +%Y-%m-%d
                    else
                        date -d "$num months ago" +%Y-%m-%d
                    fi
                    ;;
            esac
            return 0
        fi

        echo "Error: Invalid date format '$input'. Use ISO 8601 (2024-01-15) or relative (30d, 2w, 3m)." >&2
        return 1
    }

    # Discover PR reports with optional filtering
    # Sets: PR_REPORTS array with paths to provider-neutral analysis files.
    discover_pr_reports() {
        local reports_dir="$1"
        local since_date="$2"
        local author_filter="$3"

        PR_REPORTS=()
        local pr_count=0
        local skipped_no_analysis=0
        local skipped_date=0
        local skipped_author=0
        local legacy_reports=()

        # Find all PR directories
        for pr_dir in "$reports_dir"/pr-*/; do
            [ -d "$pr_dir" ] || continue

            if ! retrospective_snapshot_lease_active "$RETRO_SNAPSHOT_ROOT" \
                    "$RETRO_SNAPSHOT_LEASE_FD"; then
                echo "Error: Retrospective snapshot lease was lost during report discovery." >&2
                return 1
            fi

            local analysis_file selection_output selection_status=0
            selection_output="$(mktemp \
                "$RETRO_SNAPSHOT_ROOT/.selection.XXXXXX")" || return 1
            RETRO_SNAPSHOT_WORKER_STARTING=true
            set -m
            (
                # Only the top-level retrospective owns the FIFO writer. A
                # snapshot worker or tool child must not keep the lease
                # alive after an ungraceful owner exit.
                close_retrospective_snapshot_lease || exit 1
                select_analysis_file "$pr_dir" read-only \
                    "$RETRO_SNAPSHOT_ROOT" 2>/dev/null || true
            ) > "$selection_output" &
            RETRO_SNAPSHOT_WORKER_PID=$!
            if kill -0 -- "-$RETRO_SNAPSHOT_WORKER_PID" 2>/dev/null; then
                RETRO_SNAPSHOT_WORKER_GROUP_OWNED=true
            fi
            set +m
            RETRO_SNAPSHOT_WORKER_STARTING=false
            if [ -n "$RETRO_PENDING_SIGNAL_STATUS" ]; then
                terminate_retrospective "$RETRO_PENDING_SIGNAL_STATUS"
            fi
            wait "$RETRO_SNAPSHOT_WORKER_PID" || selection_status=$?
            RETRO_SNAPSHOT_WORKER_PID=""
            RETRO_SNAPSHOT_WORKER_GROUP_OWNED=false
            if [ "$selection_status" -ne 0 ]; then
                rm -f "$selection_output"
                return 1
            fi
            analysis_file="$(cat "$selection_output")"
            rm -f "$selection_output"
            local summary_file
            summary_file="$(dirname "$analysis_file")/pr-summary.json"

            if ! retrospective_snapshot_lease_active "$RETRO_SNAPSHOT_ROOT" \
                    "$RETRO_SNAPSHOT_LEASE_FD"; then
                echo "Error: Retrospective snapshot lease was lost while freezing a report." >&2
                return 1
            fi

            if [ -z "$analysis_file" ] || [ ! -f "$analysis_file" ]; then
                ((skipped_no_analysis++)) || true
                continue
            fi

            # Apply date filter
            if [ -n "$since_date" ] && [ -f "$summary_file" ]; then
                local pr_date
                pr_date=$(jq -r '.createdAt // .updatedAt // ""' "$summary_file" 2>/dev/null | cut -d'T' -f1)
                if [ -n "$pr_date" ] && [[ "$pr_date" < "$since_date" ]]; then
                    cleanup_retrospective_report_snapshot "$analysis_file" || return 1
                    ((skipped_date++)) || true
                    continue
                fi
            fi

            # Apply author filter
            if [ -n "$author_filter" ] && [ -f "$summary_file" ]; then
                local pr_author
                pr_author=$(jq -r '.author.login // ""' "$summary_file" 2>/dev/null)
                # Check if author matches any in comma-separated list
                local author_match=false
                IFS=',' read -ra AUTHORS <<< "$author_filter"
                for auth in "${AUTHORS[@]}"; do
                    auth=$(echo "$auth" | xargs)  # trim whitespace
                    if [ "$pr_author" = "$auth" ]; then
                        author_match=true
                        break
                    fi
                done
                if [ "$author_match" = false ]; then
                    cleanup_retrospective_report_snapshot "$analysis_file" || return 1
                    ((skipped_author++)) || true
                    continue
                fi
            fi

            # Reports written before the finding taxonomy existed carry no
            # .category. Mixing them in would collapse every one of their findings
            # into a single "uncategorized" hotspot — a confident, useless answer.
            # Name them and leave them out instead.
            if jq -e '(.issue_categories // []) | length > 0 and (map(has("category")) | any | not)' \
                    "$analysis_file" > /dev/null 2>&1; then
                legacy_reports+=("$(basename "$pr_dir")")
                cleanup_retrospective_report_snapshot "$analysis_file" || return 1
                continue
            fi

            PR_REPORTS+=("$analysis_file")
            ((pr_count++)) || true
        done

        echo "Found $pr_count PR reports with structured analysis" >&2
        [ "$skipped_no_analysis" -gt 0 ] && echo "  Skipped $skipped_no_analysis PRs without analysis.json or claude-analysis.json" >&2 || true
        [ "$skipped_date" -gt 0 ] && echo "  Skipped $skipped_date PRs before $since_date" >&2 || true
        [ "$skipped_author" -gt 0 ] && echo "  Skipped $skipped_author PRs by other authors" >&2 || true
        if [ "${#legacy_reports[@]}" -gt 0 ]; then
            echo "  Excluded ${#legacy_reports[@]} report(s) in the older format (no finding categories): ${legacy_reports[*]}" >&2
            echo "  Re-run 'gh pr-enrich <PR> --enrich' on those PRs to include them." >&2
        fi
    }

    # Aggregate data from all PR reports
    # Args: PR_REPORTS array (global)
    # Output: Aggregated JSON to stdout
    aggregate_pr_data() {
        if [ ${#PR_REPORTS[@]} -eq 0 ]; then
            echo '{"prs": [], "total_prs": 0}'
            return
        fi

        # Combine all analysis files with PR metadata
        local combined="[]"
        for report in "${PR_REPORTS[@]}"; do
            local pr_dir
            pr_dir=$(dirname "$report")
            local summary_file="$pr_dir/pr-summary.json"

            local pr_meta="{}"
            if [ -f "$summary_file" ]; then
                pr_meta=$(jq -c '{
                    number: .number,
                    title: .title,
                    author: .author.login,
                    created_at: .createdAt,
                    files: [.files[].path]
                }' "$summary_file" 2>/dev/null || echo '{}')
            fi

            # Merge analysis with metadata
            local pr_data
            pr_data=$(jq -c --argjson meta "$pr_meta" '. + {pr_meta: $meta}' "$report" 2>/dev/null)

            combined=$(echo "$combined" | jq -c --argjson pr "$pr_data" '. + [$pr]')
        done

        # Output aggregated structure
        jq -n --argjson prs "$combined" '{
            prs: $prs,
            total_prs: ($prs | length)
        }'
    }

    # Calculate cross-PR patterns (issues that repeat across PRs)
    # Args: $1 - aggregated data JSON
    # Output: Patterns JSON to stdout
    calculate_cross_pr_patterns() {
        local aggregated="$1"

        echo "$aggregated" | jq '
            # Extract all systemic issues with PR context
            [.prs[] |
                .pr_meta.number as $pr_num |
                . as $analysis |
                (.systemic_issues // [])[] |
                select((.finding_ids | type) == "array" and
                    (.finding_ids | length) >= 2 and
                    ((.finding_ids | unique | length) == (.finding_ids | length)) and
                    (.evidence | type) == "array" and
                    (.evidence | length) > 0 and
                    all(.evidence[]; type == "string" and length > 0) and
                    all(.finding_ids[]; . as $finding_id |
                        [$analysis.issue_categories[]? |
                            select(.finding_id == $finding_id and
                                .verdict == "confirmed")]
                        | length == 1)) |
                {pattern: .pattern, pr: $pr_num, recommendation: .recommendation}
            ] |
            # Group by pattern (normalize to lowercase for matching)
            sort_by(.pattern | ascii_downcase) |
            group_by(.pattern | ascii_downcase) |
            # Create pattern summary
            map({
                pattern: .[0].pattern,
                occurrences: length,
                pr_numbers: [.[].pr] | unique,
                severity: (if length >= 3 then "high" elif length >= 2 then "medium" else "low" end),
                prevention_strategy: .[0].recommendation
            }) |
            # Sort by occurrences descending
            sort_by(-.occurrences)
        '
    }

    # Calculate issue/task category hotspots
    # Args: $1 - aggregated data JSON
    # Output: Hotspots JSON to stdout
    calculate_category_hotspots() {
        local aggregated="$1"

        echo "$aggregated" | jq '
            # Collect all issue-category and task-category references across PRs.
            # Group on the taxonomy category, not the free-text finding name:
            # "Missing error handling in parse" and "Swallowed exception in sync"
            # are one hotspot, and grouping by name would report them as two.
            [.prs[] |
                .pr_meta.number as $pr_num |
                (
                    # From issue categories
                    # Retrospective hotspots are defect metrics, so only
                    # independently confirmed findings may affect their counts,
                    # severities, or generated remediation questions.
                    ((.issue_categories // [])[] | select(.verdict == "confirmed") | {
                        category: (.category // "uncategorized"),
                        severity: .severity,
                        pr: $pr_num
                    }),
                    # From task list
                    ((.task_list // [])[] | {
                        category: "task",
                        severity: .priority,
                        pr: $pr_num
                    })
                )
            ] |
            # Group by category
            sort_by(.category) |
            group_by(.category) |
            map({
                category: .[0].category,
                issue_count: length,
                prs: [.[].pr] | unique,
                severities: (sort_by(.severity) | group_by(.severity) | map({severity: .[0].severity, count: length}))
            }) |
            sort_by(-.issue_count)
        '
    }

    # Generate guiding questions from patterns
    # Args: $1 - patterns JSON, $2 - hotspots JSON
    # Output: Questions checklist to stdout
    generate_guiding_questions() {
        local patterns="$1"
        local hotspots="$2"

        # Combine patterns and hotspots to generate questions
        jq -n --argjson patterns "$patterns" --argjson hotspots "$hotspots" '
        {
            before_implementation: [
                ($patterns[] | select(.occurrences >= 2) |
                    "Have I addressed the pattern: \(.pattern)?"
                ),
                ($hotspots[:5][] |
                    "Have I checked \(.category) for similar issues?"
                )
            ] | unique,

            before_review: [
                ($patterns[] | select(.severity == "high") |
                    "Does this change avoid: \(.pattern)?"
                )
            ] | unique,

            after_review: [
                "Have I updated the team on systemic patterns found?",
                "Should this pattern be added to our documentation?"
            ]
        }'
    }

    # Generate improvement tracking
    # Args: $1 - aggregated data JSON
    # Output: Tracking JSON to stdout
    generate_improvement_tracking() {
        local aggregated="$1"

        echo "$aggregated" | jq '
            # Count process improvements suggested
            {
                suggestions_made: [.prs[] | (.process_improvements // []) | length] | add,
                by_category: (
                    [.prs[] | (.process_improvements // [])[]] |
                    sort_by(.category) |
                    group_by(.category) |
                    map({category: .[0].category, count: length})
                ),
                pr_template_suggestions: [.prs[] | (.pr_template_suggestions // []) | length] | add
            }
        '
    }

    # Generate team retrospective summary
    # Args: $1 - aggregated data, $2 - patterns, $3 - hotspots
    # Output: Summary JSON to stdout
    generate_retro_summary() {
        local aggregated="$1"
        local patterns="$2"
        local hotspots="$3"

        jq -n \
            --argjson agg "$aggregated" \
            --argjson patterns "$patterns" \
            --argjson hotspots "$hotspots" '
        {
            overview: {
                total_prs_analyzed: $agg.total_prs,
                total_issues: [
                    $agg.prs[]
                    | [(.issue_categories // [])[] | select(.verdict == "confirmed")]
                    | length
                ] | add,
                total_tasks: [$agg.prs[] | (.task_list // []) | length] | add,
                total_patterns: ($patterns | length)
            },
            top_issue_categories: (
                [$agg.prs[] | (.issue_categories // [])[]
                    | select(.verdict == "confirmed")] |
                sort_by(.name) |
                group_by(.name) |
                map({name: .[0].name, count: length, severities: (sort_by(.severity) | group_by(.severity) | map({s: .[0].severity, c: length}))}) |
                sort_by(-.count) |
                .[0:5]
            ),
            recurring_patterns: ($patterns | .[0:5]),
            hotspot_areas: ($hotspots | .[0:5]),
            recommended_actions: [
                ($patterns[:3][] | {
                    action: .prevention_strategy,
                    effort: "medium",
                    impact: (if .occurrences >= 3 then "high" else "medium" end),
                    addresses_prs: .pr_numbers
                })
            ]
        }'
    }

    # Claude meta-analysis schema for retrospectives
    RETRO_CLAUDE_SCHEMA='{
      "type": "object",
      "properties": {
        "meta_patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
