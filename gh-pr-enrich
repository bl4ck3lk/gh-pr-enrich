    REPO=$(printf '%s' "$REPO_INFO" | jq -r '.nameWithOwner // "current-repo"' 2>/dev/null || echo "current-repo")
    REPOSITORY_VISIBILITY=$(printf '%s' "$REPO_INFO" | jq -r '.visibility // "UNKNOWN"' 2>/dev/null || echo "UNKNOWN")
    REPOSITORY_VISIBILITY=$(printf '%s' "$REPOSITORY_VISIBILITY" | tr '[:lower:]' '[:upper:]')
