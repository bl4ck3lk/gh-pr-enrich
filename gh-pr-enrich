        DISCUSSION_STABILITY_FIRST=""
        return 1
    }
    if ! fetch_live_analysis_discussion_fingerprint_once \
            "$repository" "$pr_number" > "$DISCUSSION_STABILITY_FIRST" || \
       ! fetch_live_analysis_discussion_fingerprint_once \
            "$repository" "$pr_number" > "$DISCUSSION_STABILITY_SECOND" || \
       ! cmp -s "$DISCUSSION_STABILITY_FIRST" "$DISCUSSION_STABILITY_SECOND"; then
        rm -f "$DISCUSSION_STABILITY_FIRST" "$DISCUSSION_STABILITY_SECOND"
        DISCUSSION_STABILITY_FIRST=""
        DISCUSSION_STABILITY_SECOND=""
        return 1
