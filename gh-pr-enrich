#!/bin/bash
# gh-pr-enrich - GitHub CLI extension for comprehensive PR analysis
# Fetches PR details and prepares provider-neutral analysis context. Claude is an
# optional external analyzer; Codex can orchestrate native subagents over the
# same snapshot.
#
# Installation:
#   gh extension install bl4ck3lk/gh-pr-enrich
#
# Usage:
#   gh pr-enrich <PR_NUMBER> [--json] [--markdown] [--output-dir <DIR>] [--prepare-analysis] [--enrich] [--diff] [--sast]
#   gh pr-enrich resolve <THREAD_ID> [THREAD_ID...]
#   gh pr-enrich watch <PR_NUMBER> [--interval MIN] [--enrich] [--notify]
#   gh pr-enrich address <PR_NUMBER>
#   gh pr-enrich install-skill | uninstall-skill
#
# Examples:
#   gh pr-enrich 123                    # Fetch PR details
#   gh pr-enrich 123 --enrich           # Fetch + Claude analysis
#   gh pr-enrich 123 --enrich --diff    # Analysis with code context
#   gh pr-enrich 123 --enrich --sast    # Analysis with a semgrep pre-pass
#   gh pr-enrich 123 --json             # Output JSON only
#   gh pr-enrich resolve PRRT_xxx       # Resolve a comment thread
#   gh pr-enrich watch 123 --enrich     # Monitor PR for changes
#   gh pr-enrich address 123            # Interactive issue fixing

set -e

VERSION="2.1.0"

# Handle --version flag
if [ "$1" = "--version" ] || [ "$1" = "-v" ]; then
    echo "gh-pr-enrich version $VERSION"
    exit 0
fi

# Cross-platform path canonicalization (works on both BSD/macOS and GNU/Linux)
# Returns absolute path, resolving symlinks
canonicalize_path() {
    local path="$1"
    if [ -d "$path" ]; then
        (cd "$path" && pwd -P)
    elif [ -L "$path" ]; then
        local target
        target=$(readlink "$path")
        if [[ "$target" = /* ]]; then
            # Absolute symlink target
            canonicalize_path "$target"
        else
            # Relative symlink target - resolve from symlink's directory
            local dir
            dir=$(dirname "$path")
            canonicalize_path "$dir/$target"
        fi
    elif [ -f "$path" ]; then
        local dir
        dir=$(cd "$(dirname "$path")" && pwd -P)
        echo "$dir/$(basename "$path")"
    else
        # Path doesn't exist, just normalize it
        echo "$path"
    fi
}

absolute_path_for_write() {
    local path="$1" parent
    case "$path" in
        /*) printf '%s\n' "$path" ;;
        *)
            parent="$(cd "$(dirname "$path")" && pwd -P)" || return 1
            printf '%s/%s\n' "$parent" "$(basename "$path")"
            ;;
    esac
}

# Keep the legacy compatibility artifact byte-identical but inode-independent.
# A hard link lets an old consumer mutate the canonical immutable snapshot.
copy_compatibility_file() {
    local source_file="$1"
    local target_file="$2"
    cp "$source_file" "$target_file.tmp"
    mv "$target_file.tmp" "$target_file"
}

sha256_file() {
    local source_file="$1"
    if command -v shasum > /dev/null 2>&1; then
        shasum -a 256 "$source_file" | awk '{print $1}'
    elif command -v sha256sum > /dev/null 2>&1; then
        sha256sum "$source_file" | awk '{print $1}'
    elif command -v openssl > /dev/null 2>&1; then
        openssl dgst -sha256 "$source_file" | awk '{print $NF}'
    else
        return 1
    fi
}

sha256_stream() {
    if command -v shasum > /dev/null 2>&1; then
        shasum -a 256 | awk '{print $1}'
    elif command -v sha256sum > /dev/null 2>&1; then
        sha256sum | awk '{print $1}'
    elif command -v openssl > /dev/null 2>&1; then
        openssl dgst -sha256 | awk '{print $NF}'
    else
        return 1
    fi
}

positive_integer_or_default() {
    local value="${1:-}" fallback="$2" maximum="${3:-2147483647}"
    local value_length=${#value} maximum_length=${#maximum}
    if [[ "$value" =~ ^[1-9][0-9]*$ ]] && \
       { [ "$value_length" -lt "$maximum_length" ] || \
         { [ "$value_length" -eq "$maximum_length" ] && \
           { [ "$value" = "$maximum" ] || [[ "$value" < "$maximum" ]]; }; }; }; then
        printf '%s\n' "$value"
    else
        printf '%s\n' "$fallback"
    fi
}

fetch_watch_state() (
    local owner="$1" repository="$2" pr_number="$3"
    local watch_tmp_dir issue_lines_file review_lines_file
    local issue_ids_file review_ids_file thread_pages_file threads_file
    local thread_records_file overflow_threads_file overflow_thread
    local thread_index thread_id is_resolved comment_total comment_pages_file
    watch_tmp_dir="$(mktemp -d "/tmp/gh-pr-enrich-watch-state.XXXXXX")" || return 1
    chmod 700 "$watch_tmp_dir" || {
        rmdir "$watch_tmp_dir" 2>/dev/null || true
        return 1
    }
    cleanup_watch_state() { rm -rf "$watch_tmp_dir"; }
    trap cleanup_watch_state EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM

    issue_lines_file="$watch_tmp_dir/issue-comment-ids.txt"
    review_lines_file="$watch_tmp_dir/review-ids.txt"
    issue_ids_file="$watch_tmp_dir/issue-comment-ids.json"
    review_ids_file="$watch_tmp_dir/review-ids.json"
    thread_pages_file="$watch_tmp_dir/thread-pages.json"
    threads_file="$watch_tmp_dir/threads.json"
    thread_records_file="$watch_tmp_dir/thread-records.jsonl"
    overflow_threads_file="$watch_tmp_dir/overflow-threads.jsonl"

    run_watch_github_command gh api --paginate \
        "repos/$owner/$repository/issues/$pr_number/comments?per_page=100" \
        --jq '.[] | if .id == null then error("missing issue-comment id")
              else (.id | tostring) end' \
        > "$issue_lines_file" 2>/dev/null || return 1
    jq -Rsc '
        (split("\n") | map(select(length > 0))) as $ids
        | if all($ids[]; test("^[1-9][0-9]*$")) then ($ids | unique | sort)
          else error("issue-comment pagination returned an invalid id") end
    ' < "$issue_lines_file" > "$issue_ids_file" || return 1

    run_watch_github_command gh api --paginate \
        "repos/$owner/$repository/pulls/$pr_number/reviews?per_page=100" \
        --jq '.[] | if .id == null then error("missing review id")
              else (.id | tostring) end' \
        > "$review_lines_file" 2>/dev/null || return 1
    jq -Rsc '
        (split("\n") | map(select(length > 0))) as $ids
        | if all($ids[]; test("^[1-9][0-9]*$")) then ($ids | unique | sort)
          else error("review pagination returned an invalid id") end
    ' < "$review_lines_file" > "$review_ids_file" || return 1

    # gh follows the first pageInfo in a GraphQL query. Keep reviewThreads'
    # pageInfo before nodes and omit nested comments.pageInfo so --paginate
    # advances the thread connection rather than one thread's replies.
    run_watch_github_command gh api graphql --paginate \
        -F owner="$owner" \
        -F name="$repository" \
        -F prNumber="$pr_number" \
        -f query='query WatchReviewThreads(
            $owner: String!, $name: String!, $prNumber: Int!, $endCursor: String
        ) {
            repository(owner: $owner, name: $name) {
                pullRequest(number: $prNumber) {
                    reviewThreads(first: 100, after: $endCursor) {
                        pageInfo { hasNextPage endCursor }
                        totalCount
                        nodes {
                            id
                            isResolved
                            comments(first: 100) { totalCount nodes { id } }
                        }
                    }
                }
            }
        }' > "$thread_pages_file" 2>/dev/null || return 1

    jq -s -e '
        def connection: .data.repository.pullRequest.reviewThreads;
        map(connection.nodes[]) as $nodes
        | ([.[] | connection.totalCount] | unique) as $totals
        | if length == 0 or
             any(.[]; ((.errors // []) | length) != 0) or
             any(.[];
                (.data.repository.pullRequest | type) != "object" or
                (connection.pageInfo.hasNextPage | type) != "boolean" or
                ((connection.pageInfo.endCursor == null or
                  (connection.pageInfo.endCursor | type) == "string") | not) or
                (connection.totalCount | type) != "number" or
                connection.totalCount < 0 or
                (connection.totalCount | floor) != connection.totalCount or
                (connection.nodes | type) != "array") or
             ($totals | length) != 1 or
             (.[-1] | connection.pageInfo.hasNextPage) != false or
             (length > 1 and any(.[0:-1][]; connection.pageInfo.hasNextPage != true)) or
             $totals[0] != ($nodes | length) or
             ([$nodes[].id] | length) != ([$nodes[].id] | unique | length) or
             any($nodes[];
                (.id | type) != "string" or (.id | length) == 0 or
                (.isResolved | type) != "boolean" or
                (.comments.totalCount | type) != "number" or
                .comments.totalCount < 0 or
                (.comments.totalCount | floor) != .comments.totalCount or
                (.comments.nodes | type) != "array" or
                (.comments.nodes | length) != ([.comments.totalCount, 100] | min) or
                any(.comments.nodes[];
                    (.id | type) != "string" or (.id | length) == 0) or
                ([.comments.nodes[].id] | length) !=
                    ([.comments.nodes[].id] | unique | length))
          then error("review-thread pagination was incomplete or inconsistent")
          else {
            total_count: $totals[0],
            threads: [$nodes[] | {
                id, isResolved,
                comment_total: .comments.totalCount,
                initial_comment_ids: [.comments.nodes[].id]
            }]
          }
          end
    ' "$thread_pages_file" > "$threads_file" || return 1

    # Normalize the common case in bulk. Only threads whose reply connection
    # overflowed the embedded first page need another API request or jq process.
    jq -c '
        .threads[]
        | select(.comment_total <= (.initial_comment_ids | length))
        | {id, isResolved, comment_ids:(.initial_comment_ids | unique | sort)}
    ' "$threads_file" > "$thread_records_file" || return 1
    jq -c '
        .threads | to_entries[]
        | select(.value.comment_total > (.value.initial_comment_ids | length))
        | {index:.key, id:.value.id, isResolved:.value.isResolved,
           comment_total:.value.comment_total}
    ' "$threads_file" > "$overflow_threads_file" || return 1

    while IFS= read -r overflow_thread; do
        thread_index="$(printf '%s\n' "$overflow_thread" | jq -r '.index')" || return 1
        thread_id="$(printf '%s\n' "$overflow_thread" | jq -r '.id')" || return 1
        is_resolved="$(printf '%s\n' "$overflow_thread" | jq -r '.isResolved')" || return 1
        comment_total="$(printf '%s\n' "$overflow_thread" | jq -r '.comment_total')" || return 1
        [ -n "$thread_index" ] && [ -n "$thread_id" ] && \
            [ -n "$is_resolved" ] && [ -n "$comment_total" ] || return 1
        comment_pages_file="$watch_tmp_dir/comment-pages-$thread_index.json"
        # This query contains only the comments pageInfo, so gh's automatic
        # cursor advances the reply connection for this one overflow thread.
        run_watch_github_command gh api graphql --paginate \
            -F threadId="$thread_id" \
            -f query='query WatchThreadComments(
                $threadId: ID!, $endCursor: String
            ) {
                node(id: $threadId) {
                    ... on PullRequestReviewThread {
                        id
                        isResolved
                        comments(first: 100, after: $endCursor) {
                            pageInfo { hasNextPage endCursor }
                            totalCount
                            nodes { id }
                        }
                    }
                }
            }' > "$comment_pages_file" 2>/dev/null || return 1
        jq -c -s -e --arg thread_id "$thread_id" \
            --argjson expected_total "$comment_total" \
            --argjson expected_is_resolved "$is_resolved" \
            --argjson thread_index "$thread_index" \
            --slurpfile top_threads "$threads_file" '
            map(.data.node.comments.nodes[]) as $comments
            | ([.[] | .data.node.comments.totalCount] | unique) as $totals
            | ($top_threads[0].threads[$thread_index].initial_comment_ids | sort) as $initial_ids
            | if length == 0 or
                 any(.[]; ((.errors // []) | length) != 0) or
                 any(.[];
                    .data.node.id != $thread_id or
                    .data.node.isResolved != $expected_is_resolved or
                    (.data.node.comments.pageInfo.hasNextPage | type) != "boolean" or
                    ((.data.node.comments.pageInfo.endCursor == null or
                      (.data.node.comments.pageInfo.endCursor | type) == "string") | not) or
                    (.data.node.comments.totalCount | type) != "number" or
                    (.data.node.comments.nodes | type) != "array") or
                 ($totals | length) != 1 or $totals[0] != $expected_total or
                 (.[-1].data.node.comments.pageInfo.hasNextPage != false) or
                 (length > 1 and any(.[0:-1][];
                    .data.node.comments.pageInfo.hasNextPage != true)) or
                 ([.[0].data.node.comments.nodes[].id] | sort) != $initial_ids or
                 ($comments | length) != $expected_total or
                 any($comments[]; (.id | type) != "string" or (.id | length) == 0) or
                 ([$comments[].id] | length) !=
                    ([$comments[].id] | unique | length)
              then error("review-thread comment pagination was incomplete or inconsistent")
              else {id:$thread_id, isResolved:$expected_is_resolved,
                    comment_ids:([$comments[].id] | unique | sort)}
              end
        ' "$comment_pages_file" >> "$thread_records_file" || return 1
    done < "$overflow_threads_file"

    jq -n -e \
        --slurpfile issue_comment_ids "$issue_ids_file" \
        --slurpfile review_ids "$review_ids_file" \
        --slurpfile threads "$thread_records_file" '
        {
            issue_comment_ids: $issue_comment_ids[0],
            review_ids: $review_ids[0],
            inline_comment_ids: ([$threads[].comment_ids[]] | unique | sort),
            unresolved: ([$threads[] | select(.isResolved == false)] | length)
        }
    '
)

watch_selected_analysis_identity() {
    local report_dir="$1" repository="$2" pr_number="$3" selected_file digest
    selected_file="$(select_analysis_file "$report_dir" read-only 2>/dev/null)" || \
        return 1
    if [ "$(basename "$selected_file")" != "analysis.json" ] || \
       ! jq -e --arg repository "$repository" --argjson pr_number "$pr_number" '
        ._metadata.repository == $repository
        and ._metadata.pr_number == $pr_number
        and (._metadata.context_fingerprint | type == "string" and length > 0)
    ' "$selected_file" > /dev/null 2>&1 || \
       ! digest="$(sha256_file "$selected_file")"; then
        cleanup_read_only_analysis_snapshot "$selected_file"
        return 1
    fi
    cleanup_read_only_analysis_snapshot "$selected_file"
    printf '%s\n' "$digest"
}

# Stable content identity for one analysis snapshot. Recompute this digest at
# every trust boundary; the value embedded in the context is only a claim until
# it matches the canonical snapshot bytes.
analysis_context_fingerprint() {
    local canonical_file digest=""
    canonical_file="$(mktemp "${TMPDIR:-/tmp}/gh-pr-enrich-context.XXXXXX")"
    if ! jq -cS 'del(.coverage.context_fingerprint)' "$1" > "$canonical_file"; then
        rm -f "$canonical_file"
        return 1
    fi
    if ! digest="$(sha256_file "$canonical_file")"; then
        echo "Error: SHA-256 implementation not found (need shasum, sha256sum, or openssl)." >&2
        rm -f "$canonical_file"
        return 1
    fi
    rm -f "$canonical_file"
    [ -n "$digest" ] || return 1
    printf 'sha256:%s\n' "$digest"
}

# Return the working-tree permission bits on both BSD and GNU stat.
workspace_file_mode() {
    local mode=""
    if mode="$(stat -c '%a' "$1" 2>/dev/null)" && \
       [[ "$mode" =~ ^[0-7]+$ ]]; then
        printf '%s\n' "$mode"
        return 0
    fi
    if mode="$(stat -f '%Lp' "$1" 2>/dev/null)" && \
       [[ "$mode" =~ ^[0-7]+$ ]]; then
        printf '%s\n' "$mode"
        return 0
    fi
    return 1
}

# Write a canonical NUL-delimited manifest for every repository-visible path.
# HEAD and index identity bind staged state. Tracked files whose clean-filtered
# content matches the index are bound to that exact blob, so smudge filters cannot
# turn a Git-clean public checkout into authorization to disclose local plaintext.
# Actually dirty tracked files and untracked/ignored files remain bound to their
# literal working-tree bytes for an explicit --code-access override.
build_code_access_workspace_manifest() {
    local ignored_output_dir="${1:-}"
    local manifest="$2"
    local ignored_transaction_dir="${3:-}"
    local snapshot_source="${4:-}"
    local repo_root output_abs="" output_rel="" output_is_repo_root=false
    local transaction_abs="" transaction_rel="" transaction_name="" lock_abs=""
    local records index_state head index_digest record metadata index_mode index_stage
    local index_metadata_rest index_oid source_identity
    local relative origin file_hash file_mode artifact_relative
    if [ -z "$snapshot_source" ]; then
        if [ "${GH_PR_ENRICH_CODE_ACCESS:-}" = true ]; then
            snapshot_source="working_tree"
        else
            snapshot_source="git_index"
        fi
    fi
    case "$snapshot_source" in
        git_index|working_tree) ;;
        *) return 1 ;;
    esac
    repo_root="$(git rev-parse --show-toplevel 2>/dev/null || echo "")"
    [ -n "$repo_root" ] || return 1

    if [ -n "$ignored_output_dir" ]; then
        output_abs="$(canonicalize_path "$ignored_output_dir")"
        case "$output_abs" in
            "$repo_root") output_is_repo_root=true ;;
            "$repo_root"/*) output_rel="${output_abs#"$repo_root/"}" ;;
        esac
    fi
    if [ -n "$SELECTED_ANALYSIS_LOCK_DIR" ] && \
       [ -d "$SELECTED_ANALYSIS_LOCK_DIR" ] && \
       [ ! -L "$SELECTED_ANALYSIS_LOCK_DIR" ] && \
       ! path_has_symlink_component "$SELECTED_ANALYSIS_LOCK_DIR"; then
        lock_abs="$(canonicalize_path "$SELECTED_ANALYSIS_LOCK_DIR")"
    fi
    if [ -n "$ignored_transaction_dir" ] && [ -n "$output_abs" ] && \
       [ "$lock_abs" = "$output_abs/.selected-analysis.lock" ] && \
       [ -n "$SELECTED_ANALYSIS_LOCK_TOKEN" ] && \
       [ -f "$SELECTED_ANALYSIS_LOCK_DIR/owner" ] && \
       [ ! -L "$SELECTED_ANALYSIS_LOCK_DIR/owner" ] && \
       [ "$(cat "$SELECTED_ANALYSIS_LOCK_DIR/owner" 2>/dev/null || echo "")" = \
         "$SELECTED_ANALYSIS_LOCK_TOKEN" ]; then
        transaction_abs="$(canonicalize_path "$ignored_transaction_dir")"
        transaction_name="$(basename "$transaction_abs")"
        if [[ "$transaction_name" =~ ^\.selected-analysis-replacements\.[A-Za-z0-9]{6}$ ]] && \
           [ "$transaction_abs" = "$output_abs/$transaction_name" ] && \
           [ -d "$transaction_abs" ] && [ ! -L "$transaction_abs" ]; then
            transaction_rel="${transaction_abs#"$repo_root/"}"
        fi
    fi

    records="$(mktemp "/tmp/gh-pr-enrich-workspace-records.XXXXXX")" || return 1
    index_state="$(mktemp "/tmp/gh-pr-enrich-index-state.XXXXXX")" || {
        rm -f "$records"
        return 1
    }
    if ! head="$(git -C "$repo_root" rev-parse HEAD 2>/dev/null)" || \
       ! { git -C "$repo_root" ls-files --stage -z -- .; \
           git -C "$repo_root" ls-files -v -z -- .; } > "$index_state" 2>/dev/null || \
       ! index_digest="$(sha256_file "$index_state")"; then
        rm -f "$records" "$index_state"
        return 1
    fi
    printf 'head\0%s\0index\0sha256:%s\0' "$head" "$index_digest" > "$manifest"

    if ! git -C "$repo_root" ls-files --stage -z -- . > "$records" 2>/dev/null; then
        rm -f "$records" "$index_state" "$manifest"
        return 1
    fi
    while IFS= read -r -d '' record; do
        metadata="${record%%$'\t'*}"
        relative="${record#*$'\t'}"
        index_mode="${metadata%% *}"
        index_metadata_rest="${metadata#* }"
        index_oid="${index_metadata_rest%% *}"
        index_stage="${metadata##* }"
        if [ "$index_stage" != "0" ] || \
           { [ "$index_mode" != "100644" ] && [ "$index_mode" != "100755" ]; } || \
           { ! [[ "$index_oid" =~ ^[0-9a-fA-F]{40}$ ]] && \
             ! [[ "$index_oid" =~ ^[0-9a-fA-F]{64}$ ]]; } || \
           path_has_symlink_component "$repo_root/$relative"; then
            rm -f "$records" "$index_state" "$manifest"
            return 1
        fi
        if [ ! -e "$repo_root/$relative" ]; then
            # A sparse checkout or skip-worktree deletion must not turn a
            # tracked path into an invisible omission from a code snapshot.
            # Code access is granted only when every index entry can be
            # inspected and fingerprinted from the working tree.
            rm -f "$records" "$index_state" "$manifest"
            return 1
        fi
        if [ ! -f "$repo_root/$relative" ]; then
            rm -f "$records" "$index_state" "$manifest"
            return 1
        fi
        if [ "$snapshot_source" = "git_index" ]; then
            source_identity="git:$index_oid"
            case "$index_mode" in
                100644) file_mode="644" ;;
                100755) file_mode="755" ;;
            esac
            if ! file_hash="$(
                    set -o pipefail
                    git -C "$repo_root" cat-file blob "$index_oid" 2>/dev/null | \
                        sha256_stream
                )" || [ -z "$file_hash" ]; then
                rm -f "$records" "$index_state" "$manifest"
                return 1
            fi
        else
            source_identity="workspace"
            if ! file_mode="$(workspace_file_mode "$repo_root/$relative")" || \
               ! file_hash="$(sha256_file "$repo_root/$relative")"; then
                rm -f "$records" "$index_state" "$manifest"
                return 1
            fi
        fi
        printf 'file\0tracked\0%s\0%s\0%s\0%s\0' \
            "$relative" "$file_mode" "$source_identity" "$file_hash" >> "$manifest"
    done < "$records"

    for origin in untracked ignored; do
        if [ "$origin" = "untracked" ]; then
            git -C "$repo_root" ls-files --others --exclude-standard -z -- . \
                > "$records" 2>/dev/null || {
                    rm -f "$records" "$index_state" "$manifest"
                    return 1
                }
        else
            git -C "$repo_root" ls-files --others --ignored --exclude-standard -z -- . \
                > "$records" 2>/dev/null || {
                    rm -f "$records" "$index_state" "$manifest"
                    return 1
                }
        fi
        while IFS= read -r -d '' relative; do
            if [ -n "$transaction_rel" ]; then
                case "$relative" in
                    "$transaction_rel"/*) continue ;;
                esac
            fi
            if path_has_symlink_component "$repo_root/$relative" || \
               [ ! -f "$repo_root/$relative" ]; then
                # Includes nested repositories, which Git reports as directory
                # entries whose mutable descendants are otherwise invisible.
                rm -f "$records" "$index_state" "$manifest"
                return 1
            fi
            artifact_relative=""
            if [ "$output_is_repo_root" = true ]; then
                artifact_relative="$relative"
            elif [ -n "$output_rel" ]; then
                case "$relative" in
                    "$output_rel"/*) artifact_relative="${relative#"$output_rel/"}" ;;
                esac
            fi
            if [ -n "$artifact_relative" ] && \
               is_generated_report_artifact "$artifact_relative"; then
                continue
            fi
            if ! file_mode="$(workspace_file_mode "$repo_root/$relative")" || \
               ! file_hash="$(sha256_file "$repo_root/$relative")"; then
                rm -f "$records" "$index_state" "$manifest"
                return 1
            fi
            printf 'file\0%s\0%s\0%s\0workspace\0%s\0' \
                "$origin" "$relative" "$file_mode" "$file_hash" >> "$manifest"
        done < "$records"
    done
    rm -f "$records" "$index_state"
}

# Bind repository tools to one exact local workspace. Generated report
# artifacts are excluded individually; every other visible path is manifested.
code_access_workspace_fingerprint() {
    local manifest digest ignored_transaction_dir="${2:-}"
    local snapshot_source="${3:-}"
    manifest="$(mktemp "/tmp/gh-pr-enrich-workspace.XXXXXX")" || return 1
    if ! build_code_access_workspace_manifest "${1:-}" "$manifest" \
            "$ignored_transaction_dir" "$snapshot_source" || \
       ! digest="$(sha256_file "$manifest")"; then
        rm -f "$manifest"
        return 1
    fi
    rm -f "$manifest"
    printf 'sha256:%s\n' "$digest"
}

CODE_ACCESS_SNAPSHOT_DIR=""
CODE_ACCESS_SETTINGS_FILE=""
CODE_ACCESS_TRAPS_ACTIVE=false
CODE_ACCESS_PREVIOUS_EXIT_TRAP=""
CODE_ACCESS_PREVIOUS_INT_TRAP=""
CODE_ACCESS_PREVIOUS_TERM_TRAP=""
ANALYZER_CHILD_PID=""
ANALYZER_HEARTBEAT_PID=""
ANALYZER_PROMPT_FILE=""
ANALYZER_CONTEXT_FILE=""
ANALYZER_CHILD_STARTING=false
ANALYZER_HEARTBEAT_STARTING=false
ANALYZER_PENDING_SIGNAL=""

terminate_analyzer_child() {
    local analyzer_pid="$ANALYZER_CHILD_PID"
    [ -n "$analyzer_pid" ] || return 0
    kill -TERM "$analyzer_pid" 2>/dev/null || true
    wait "$analyzer_pid" 2>/dev/null || true
    ANALYZER_CHILD_PID=""
}

terminate_analyzer_heartbeat() {
    [ -n "$ANALYZER_HEARTBEAT_PID" ] || return 0
    kill -TERM "$ANALYZER_HEARTBEAT_PID" 2>/dev/null || true
    wait "$ANALYZER_HEARTBEAT_PID" 2>/dev/null || true
    ANALYZER_HEARTBEAT_PID=""
}

is_private_code_snapshot_path() {
    local candidate="$1" parent expected_parent basename
    case "$candidate" in
        /tmp/gh-pr-enrich-code-snapshot.*|/private/tmp/gh-pr-enrich-code-snapshot.*|\
        /tmp/gh-pr-enrich-analysis-snapshot.*|/private/tmp/gh-pr-enrich-analysis-snapshot.*) ;;
        *) return 1 ;;
    esac
    [ -d "$candidate" ] && [ ! -L "$candidate" ] || return 1
    parent="$(cd "$(dirname "$candidate")" && pwd -P)" || return 1
    expected_parent="$(cd /tmp && pwd -P)" || return 1
    basename="$(basename "$candidate")"
    [ "$parent" = "$expected_parent" ] && \
    [[ "$basename" =~ ^gh-pr-enrich-(code|analysis)-snapshot\.[A-Za-z0-9]+$ ]]
}

restore_code_access_cleanup_traps() {
    [ "$CODE_ACCESS_TRAPS_ACTIVE" = true ] || return 0
    trap - EXIT INT TERM
    [ -z "$CODE_ACCESS_PREVIOUS_EXIT_TRAP" ] || eval "$CODE_ACCESS_PREVIOUS_EXIT_TRAP"
    [ -z "$CODE_ACCESS_PREVIOUS_INT_TRAP" ] || eval "$CODE_ACCESS_PREVIOUS_INT_TRAP"
    [ -z "$CODE_ACCESS_PREVIOUS_TERM_TRAP" ] || eval "$CODE_ACCESS_PREVIOUS_TERM_TRAP"
    CODE_ACCESS_TRAPS_ACTIVE=false
    CODE_ACCESS_PREVIOUS_EXIT_TRAP=""
    CODE_ACCESS_PREVIOUS_INT_TRAP=""
    CODE_ACCESS_PREVIOUS_TERM_TRAP=""
}

cleanup_code_access_artifacts() {
    if is_private_code_snapshot_path "$CODE_ACCESS_SNAPSHOT_DIR"; then
        chmod -R u+w "$CODE_ACCESS_SNAPSHOT_DIR" 2>/dev/null || true
        rm -rf "$CODE_ACCESS_SNAPSHOT_DIR"
    fi
    case "$CODE_ACCESS_SETTINGS_FILE" in
        /tmp/gh-pr-enrich-claude-settings.*|/private/tmp/gh-pr-enrich-claude-settings.*)
            rm -f "$CODE_ACCESS_SETTINGS_FILE"
            ;;
    esac
    case "$ANALYZER_PROMPT_FILE" in
        /tmp/gh-pr-enrich-claude-prompt.*|/private/tmp/gh-pr-enrich-claude-prompt.*)
            rm -f "$ANALYZER_PROMPT_FILE"
            ;;
    esac
    case "$ANALYZER_CONTEXT_FILE" in
        /tmp/gh-pr-enrich-claude-context.*|/private/tmp/gh-pr-enrich-claude-context.*)
            rm -f "$ANALYZER_CONTEXT_FILE"
            ;;
    esac
    CODE_ACCESS_SNAPSHOT_DIR=""
    CODE_ACCESS_SETTINGS_FILE=""
    ANALYZER_PROMPT_FILE=""
    ANALYZER_CONTEXT_FILE=""
}

handle_code_access_cleanup_signal() {
    local signal_name="$1"
    local exit_status="${2:-0}"
    if [ "$signal_name" != "EXIT" ] && \
       { [ "$ANALYZER_CHILD_STARTING" = true ] || \
         [ "$ANALYZER_HEARTBEAT_STARTING" = true ]; }; then
        [ -n "$ANALYZER_PENDING_SIGNAL" ] || \
            ANALYZER_PENDING_SIGNAL="$signal_name"
        return 0
    fi
    terminate_analyzer_child
    terminate_analyzer_heartbeat
    cleanup_code_access_artifacts
    restore_code_access_cleanup_traps
    if [ "$signal_name" = "EXIT" ]; then
        return "$exit_status"
    fi
    kill -s "$signal_name" "$$"
}

install_code_access_cleanup_traps() {
    [ "$CODE_ACCESS_TRAPS_ACTIVE" != true ] || return 0
    CODE_ACCESS_PREVIOUS_EXIT_TRAP="$(trap -p EXIT)"
    CODE_ACCESS_PREVIOUS_INT_TRAP="$(trap -p INT)"
    CODE_ACCESS_PREVIOUS_TERM_TRAP="$(trap -p TERM)"
    CODE_ACCESS_TRAPS_ACTIVE=true
    trap 'handle_code_access_cleanup_signal EXIT $?' EXIT
    trap 'handle_code_access_cleanup_signal INT 130' INT
    trap 'handle_code_access_cleanup_signal TERM 143' TERM
}

cleanup_code_access_snapshot() {
    cleanup_code_access_artifacts
    restore_code_access_cleanup_traps
}

create_code_access_snapshot() {
    local ignored_output_dir="$1"
    local expected_fingerprint="$2"
    local snapshot_source="${3:-}"
    local repo_root manifest manifest_digest kind origin relative mode source_identity
    local source_oid expected_hash destination destination_hash destination_mode
    cleanup_code_access_snapshot
    repo_root="$(git rev-parse --show-toplevel 2>/dev/null || echo "")"
    [ -n "$repo_root" ] || return 1
    manifest="$(mktemp "/tmp/gh-pr-enrich-snapshot-manifest.XXXXXX")" || return 1
    if ! build_code_access_workspace_manifest "$ignored_output_dir" "$manifest" "" \
            "$snapshot_source" || \
       ! manifest_digest="$(sha256_file "$manifest")" || \
       [ "sha256:$manifest_digest" != "$expected_fingerprint" ]; then
        rm -f "$manifest"
        return 1
    fi
    CODE_ACCESS_SNAPSHOT_DIR="$(mktemp -d "/tmp/gh-pr-enrich-code-snapshot.XXXXXX")" || {
        rm -f "$manifest"
        return 1
    }
    install_code_access_cleanup_traps
    while IFS= read -r -d '' kind <&3; do
        case "$kind" in
            head|index)
                IFS= read -r -d '' _ <&3 || {
                    rm -f "$manifest"
                    cleanup_code_access_snapshot
                    return 1
                }
                ;;
            missing)
                IFS= read -r -d '' origin <&3 && \
                    IFS= read -r -d '' relative <&3 || {
                        rm -f "$manifest"
                        cleanup_code_access_snapshot
                        return 1
                    }
                ;;
            file)
                IFS= read -r -d '' origin <&3 && \
                    IFS= read -r -d '' relative <&3 && \
                    IFS= read -r -d '' mode <&3 && \
                    IFS= read -r -d '' source_identity <&3 && \
                    IFS= read -r -d '' expected_hash <&3 || {
                        rm -f "$manifest"
                        cleanup_code_access_snapshot
                        return 1
                    }
                case "$relative" in ""|/*|../*|*/../*|*/..)
                    rm -f "$manifest"
                    cleanup_code_access_snapshot
                    return 1
                    ;;
                esac
                destination="$CODE_ACCESS_SNAPSHOT_DIR/$relative"
                mkdir -p "$(dirname "$destination")" || {
                    rm -f "$manifest"
                    cleanup_code_access_snapshot
                    return 1
                }
                if [ -L "$repo_root/$relative" ] || [ ! -f "$repo_root/$relative" ]; then
                    rm -f "$manifest"
                    cleanup_code_access_snapshot
                    return 1
                fi
                case "$source_identity" in
                    git:*)
                        source_oid="${source_identity#git:}"
                        if { ! [[ "$source_oid" =~ ^[0-9a-fA-F]{40}$ ]] && \
                             ! [[ "$source_oid" =~ ^[0-9a-fA-F]{64}$ ]]; } || \
                           ! git -C "$repo_root" cat-file blob "$source_oid" \
                                > "$destination" 2>/dev/null; then
                            rm -f "$manifest"
                            cleanup_code_access_snapshot
                            return 1
                        fi
                        ;;
                    workspace)
                        if ! cp "$repo_root/$relative" "$destination"; then
                            rm -f "$manifest"
                            cleanup_code_access_snapshot
                            return 1
                        fi
                        ;;
                    *)
                        rm -f "$manifest"
                        cleanup_code_access_snapshot
                        return 1
                        ;;
                esac
                if ! chmod "$mode" "$destination" || \
                   ! destination_hash="$(sha256_file "$destination")" || \
                   ! destination_mode="$(workspace_file_mode "$destination")" || \
                   [ "$destination_hash" != "$expected_hash" ] || \
                   [ "$destination_mode" != "$mode" ]; then
                    rm -f "$manifest"
                    cleanup_code_access_snapshot
                    return 1
                fi
                ;;
            *)
                rm -f "$manifest"
                cleanup_code_access_snapshot
                return 1
                ;;
        esac
    done 3< "$manifest"
    rm -f "$manifest"
    chmod -R a-w "$CODE_ACCESS_SNAPSHOT_DIR" || {
        cleanup_code_access_snapshot
        return 1
    }
}

create_claude_code_access_settings() {
    local repository_root="$1" claude_absolute_root
    [ -n "$repository_root" ] || return 1
    claude_absolute_root="//${repository_root#/}"
    CODE_ACCESS_SETTINGS_FILE="$(mktemp "/tmp/gh-pr-enrich-claude-settings.XXXXXX")" || return 1
    install_code_access_cleanup_traps
    if ! jq -n --arg repository_root "$claude_absolute_root" '{
        permissions: {
            deny: ["Read(" + $repository_root + "/**)"]
        }
    }' > "$CODE_ACCESS_SETTINGS_FILE" || \
       ! chmod 600 "$CODE_ACCESS_SETTINGS_FILE"; then
        cleanup_code_access_snapshot
        return 1
    fi
}

write_input_status() {
    local output_file="$1"
    local requested="$2"
    local status="$3"
    local reason="$4"
    jq -n --argjson requested "$requested" --arg status "$status" --arg reason "$reason" \
        '{requested: $requested, status: $status, reason: $reason}' > "$output_file"
}

# Run a GitHub CLI request as a managed child so the report-level signal
# handler can terminate a stalled network operation before releasing the
# shared report lock. Redirections applied by callers are inherited by the
# child, preserving the existing fetch and normalization contracts.
REPORT_RUN_CHILD_PID=""
REPORT_RUN_CHILD_STARTING=false
REPORT_RUN_CHILD_GROUP_OWNED=false
REPORT_RUN_CHILD_SUPERVISOR=false
REPORT_RUN_MANAGED=false
REPORT_RUN_STANDALONE=false
REPORT_RUN_OWNER_PID=""
REPORT_RUN_WATCHDOG_PID=""
REPORT_RUN_WATCHDOG_STARTING=false
REPORT_RUN_WATCHDOG_STATUS=0
EXTERNAL_VISIBILITY_TEMP_FILE=""
PARENT_CAPTURE_CONTROL_DIR=""

publish_parent_capture_child() {
    local control_dir="$1" child_pid="$2" group_owned="$3"
    [ -n "$control_dir" ] || return 0
    [ -d "$control_dir" ] && [ ! -L "$control_dir" ] || return 1
    printf '%s\t%s\n' "$child_pid" "$group_owned" \
        > "$control_dir/active-child.tmp" || return 1
    mv "$control_dir/active-child.tmp" "$control_dir/active-child"
}

clear_parent_capture_child() {
    local control_dir="${1:-${PARENT_CAPTURE_CONTROL_DIR:-}}"
    [ -z "$control_dir" ] || rm -f "$control_dir/active-child" \
        "$control_dir/active-child.tmp"
}

cleanup_external_visibility_temp() {
    [ -z "$EXTERNAL_VISIBILITY_TEMP_FILE" ] || \
        rm -f "$EXTERNAL_VISIBILITY_TEMP_FILE"
    EXTERNAL_VISIBILITY_TEMP_FILE=""
}

report_run_is_owner_shell() {
    [ "$REPORT_RUN_STANDALONE" != true ] || return 0
    [ "$REPORT_RUN_MANAGED" = true ] && [ -n "$REPORT_RUN_OWNER_PID" ] || \
        return 1
    selected_analysis_worker_pid || return 1
    [ "$SELECTED_ANALYSIS_WORKER_PID" = "$REPORT_RUN_OWNER_PID" ]
}

run_report_command() {
    local command_pid command_rc=0 timeout_seconds
    local parent_capture_control_dir="${PARENT_CAPTURE_CONTROL_DIR:-}"
    local command_group_owned=false
    if ! report_run_is_owner_shell; then
        "$@"
        return $?
    fi
    REPORT_RUN_CHILD_STARTING=true
    set -m
    PARENT_CAPTURE_CONTROL_DIR="" "$@" &
    command_pid=$!
    if kill -0 -- "-$command_pid" 2>/dev/null; then
        command_group_owned=true
    fi
    set +m
    REPORT_RUN_CHILD_PID="$command_pid"
    REPORT_RUN_CHILD_GROUP_OWNED="$command_group_owned"
    REPORT_RUN_CHILD_SUPERVISOR=false
    REPORT_RUN_CHILD_STARTING=false
    if ! publish_parent_capture_child "$parent_capture_control_dir" \
            "$command_pid" "$command_group_owned"; then
        terminate_report_run_child
        return 125
    fi
    if [ -n "${selected_writer_signal:-}" ]; then
        terminate_report_run_child
        case "$selected_writer_signal" in
            INT) return 130 ;;
            TERM) return 143 ;;
        esac
    fi
    if [ -n "${RUN_LOCK_PENDING_SIGNAL:-}" ]; then
        handle_report_run_signal "$RUN_LOCK_PENDING_SIGNAL" \
            "$RUN_LOCK_PENDING_EXIT_CODE"
    fi
    timeout_seconds="$(positive_integer_or_default \
        "${GH_PR_ENRICH_GITHUB_TIMEOUT:-}" 60 3600)"
    REPORT_RUN_WATCHDOG_STATUS=0
    REPORT_RUN_WATCHDOG_STARTING=true
    (
        watchdog_fired=false watchdog_attempt=0
        trap '[ "$watchdog_fired" = true ] || exit 0' TERM INT
        while [ "$watchdog_attempt" -lt $((timeout_seconds * 5)) ]; do
            sleep 0.2
            watchdog_attempt=$((watchdog_attempt + 1))
        done
        watchdog_fired=true
        if [ "$command_group_owned" = true ]; then
            kill -TERM -- "-$command_pid" 2>/dev/null || true
        else
            kill -TERM "$command_pid" 2>/dev/null || true
        fi
        sleep 1 || true
        if [ "$command_group_owned" = true ]; then
            kill -KILL -- "-$command_pid" 2>/dev/null || true
        else
            kill -KILL "$command_pid" 2>/dev/null || true
        fi
        exit 124
    ) &
    REPORT_RUN_WATCHDOG_PID=$!
    REPORT_RUN_WATCHDOG_STARTING=false
    if [ -n "${RUN_LOCK_PENDING_SIGNAL:-}" ]; then
        handle_report_run_signal "$RUN_LOCK_PENDING_SIGNAL" \
            "$RUN_LOCK_PENDING_EXIT_CODE"
    fi
    wait "$command_pid" || command_rc=$?
    stop_report_run_watchdog
    clear_parent_capture_child "$parent_capture_control_dir"
    if [ "$REPORT_RUN_WATCHDOG_STATUS" -eq 124 ]; then
        if [ "$REPORT_RUN_CHILD_PID" = "$command_pid" ]; then
            REPORT_RUN_CHILD_PID=""
            REPORT_RUN_CHILD_GROUP_OWNED=false
            REPORT_RUN_CHILD_SUPERVISOR=false
        fi
        REPORT_RUN_WATCHDOG_STATUS=0
        return 124
    fi
    if [ "$REPORT_RUN_WATCHDOG_STATUS" -ne 0 ]; then
        terminate_report_run_child
        REPORT_RUN_WATCHDOG_STATUS=0
        return 125
    fi
    if [ "$REPORT_RUN_CHILD_PID" = "$command_pid" ]; then
        REPORT_RUN_CHILD_PID=""
        REPORT_RUN_CHILD_GROUP_OWNED=false
        REPORT_RUN_CHILD_SUPERVISOR=false
    fi
    return "$command_rc"
}

stop_report_run_watchdog() {
    local watchdog_rc=0
    if [ -n "$REPORT_RUN_WATCHDOG_PID" ]; then
        kill -TERM "$REPORT_RUN_WATCHDOG_PID" 2>/dev/null || true
        wait "$REPORT_RUN_WATCHDOG_PID" 2>/dev/null || watchdog_rc=$?
        # A fast request can finish before the watcher installs its TERM trap.
        # The parent owns this TERM, so either conventional signal status means
        # the not-yet-armed watcher was still stopped successfully.
        case "$watchdog_rc" in 130|143) watchdog_rc=0 ;; esac
        REPORT_RUN_WATCHDOG_STATUS="$watchdog_rc"
        REPORT_RUN_WATCHDOG_PID=""
    fi
}

terminate_report_run_child() {
    local command_pid="$REPORT_RUN_CHILD_PID"
    local command_group_owned="$REPORT_RUN_CHILD_GROUP_OWNED"
    local command_supervisor="$REPORT_RUN_CHILD_SUPERVISOR"
    local terminate_attempt=0 terminate_limit=20
    # A provider supervisor must outlive the nested command's own watchdog,
    # TERM grace, KILL/reap, and EXIT cleanup. Its longer bound is still finite
    # but prevents the parent from killing the cleanup owner prematurely.
    [ "$command_supervisor" != true ] || terminate_limit=100
    stop_report_run_watchdog
    if [ -z "$command_pid" ]; then
        return 0
    fi
    if [ "$command_group_owned" = true ]; then
        kill -TERM -- "-$command_pid" 2>/dev/null || true
    else
        kill -TERM "$command_pid" 2>/dev/null || true
    fi
    while [ "$terminate_attempt" -lt "$terminate_limit" ]; do
        if [ "$command_group_owned" = true ]; then
            kill -0 -- "-$command_pid" 2>/dev/null || break
        else
            kill -0 "$command_pid" 2>/dev/null || break
        fi
        sleep 0.05
        terminate_attempt=$((terminate_attempt + 1))
    done
    if [ "$command_group_owned" = true ]; then
        if kill -0 -- "-$command_pid" 2>/dev/null; then
            kill -KILL -- "-$command_pid" 2>/dev/null || true
        fi
    else
        if kill -0 "$command_pid" 2>/dev/null; then
            kill -KILL "$command_pid" 2>/dev/null || true
        fi
    fi
    wait "$command_pid" 2>/dev/null || true
    clear_parent_capture_child
    REPORT_RUN_CHILD_PID=""
    REPORT_RUN_CHILD_GROUP_OWNED=false
    REPORT_RUN_CHILD_SUPERVISOR=false
}

# Watch mode has no report-directory lease, but it still needs the same bounded,
# signal-aware GitHub request supervisor. Run it in a subshell so these ownership
# globals and traps cannot interfere with the surrounding watch loop.
run_watch_github_command() (
    REPORT_RUN_STANDALONE=true
    RUN_LOCK_PENDING_SIGNAL=""
    RUN_LOCK_PENDING_EXIT_CODE=""
    handle_report_run_signal() {
        local signal="$1" exit_code="$2"
        if [ "$REPORT_RUN_CHILD_STARTING" = true ] || \
           [ "$REPORT_RUN_WATCHDOG_STARTING" = true ]; then
            if [ -z "$RUN_LOCK_PENDING_SIGNAL" ]; then
                RUN_LOCK_PENDING_SIGNAL="$signal"
                RUN_LOCK_PENDING_EXIT_CODE="$exit_code"
            fi
            return 0
        fi
        trap '' INT TERM
        terminate_report_run_child
        exit "$exit_code"
    }
    trap 'handle_report_run_signal INT 130' INT
    trap 'handle_report_run_signal TERM 143' TERM
    run_report_command "$@"
)

# Command substitution hides child ownership in a subshell: a service manager
# that signals only the advertised CLI PID can then leave the GitHub request
# running until its timeout. Capture pre-lock and watch commands through a
# parent-owned process group so INT/TERM always reaches and reaps the active
# supervisor tree.
PARENT_CAPTURE_PID=""
PARENT_CAPTURE_GROUP_OWNED=false
PARENT_CAPTURE_STARTING=false
PARENT_CAPTURE_PENDING_SIGNAL=""
PARENT_CAPTURE_PENDING_STATUS=""
PARENT_CAPTURE_OUTPUT_FILE=""

cleanup_parent_capture_control() {
    [ -z "$PARENT_CAPTURE_CONTROL_DIR" ] || {
        clear_parent_capture_child "$PARENT_CAPTURE_CONTROL_DIR"
        rmdir "$PARENT_CAPTURE_CONTROL_DIR" 2>/dev/null || true
    }
    PARENT_CAPTURE_CONTROL_DIR=""
}

terminate_parent_capture_active_child() {
    local child_pid="" group_owned="" attempt=0
    [ -n "$PARENT_CAPTURE_CONTROL_DIR" ] && \
        [ -f "$PARENT_CAPTURE_CONTROL_DIR/active-child" ] && \
        [ ! -L "$PARENT_CAPTURE_CONTROL_DIR/active-child" ] || return 0
    IFS=$'\t' read -r child_pid group_owned \
        < "$PARENT_CAPTURE_CONTROL_DIR/active-child" || return 0
    [[ "$child_pid" =~ ^[1-9][0-9]*$ ]] || return 0
    case "$group_owned" in true|false) ;; *) return 0 ;; esac
    if [ "$group_owned" = true ]; then
        kill -TERM -- "-$child_pid" 2>/dev/null || true
        while kill -0 -- "-$child_pid" 2>/dev/null && \
              [ "$attempt" -lt 40 ]; do
            sleep 0.05
            attempt=$((attempt + 1))
        done
        kill -0 -- "-$child_pid" 2>/dev/null && \
            kill -KILL -- "-$child_pid" 2>/dev/null || true
    else
        kill -TERM "$child_pid" 2>/dev/null || true
        while kill -0 "$child_pid" 2>/dev/null && \
              [ "$attempt" -lt 40 ]; do
            sleep 0.05
            attempt=$((attempt + 1))
        done
        kill -0 "$child_pid" 2>/dev/null && \
            kill -KILL "$child_pid" 2>/dev/null || true
    fi
}

terminate_parent_capture() {
    local capture_pid="$PARENT_CAPTURE_PID"
    local attempt=0 fallback_pid=""
    [ -n "$capture_pid" ] || return 0
    # The direct request group is published in a private control directory.
    # Terminate it independently so a stopped or wedged supervisor cannot be
    # killed together with the request's only watchdog.
    terminate_parent_capture_active_child
    if [ "$PARENT_CAPTURE_GROUP_OWNED" = true ]; then
        kill -TERM -- "-$capture_pid" 2>/dev/null || true
        kill -CONT -- "-$capture_pid" 2>/dev/null || true
    else
        kill -TERM "$capture_pid" 2>/dev/null || true
        kill -CONT "$capture_pid" 2>/dev/null || true
    fi
    # Bound the supervisor wait even if its shell is wedged. The separately
    # grouped request has already received TERM/KILL through its direct handle.
    (
        trap 'exit 0' TERM INT
        sleep 5
        if [ "$PARENT_CAPTURE_GROUP_OWNED" = true ]; then
            kill -KILL -- "-$capture_pid" 2>/dev/null || true
        else
            kill -KILL "$capture_pid" 2>/dev/null || true
        fi
    ) &
    fallback_pid=$!
    wait "$capture_pid" 2>/dev/null || true
    kill -TERM "$fallback_pid" 2>/dev/null || true
    wait "$fallback_pid" 2>/dev/null || true
    if [ "$PARENT_CAPTURE_GROUP_OWNED" = true ]; then
        while kill -0 -- "-$capture_pid" 2>/dev/null && \
              [ "$attempt" -lt 40 ]; do
            sleep 0.05
            attempt=$((attempt + 1))
        done
        if kill -0 -- "-$capture_pid" 2>/dev/null; then
            kill -KILL -- "-$capture_pid" 2>/dev/null || true
        fi
    else
        if kill -0 "$capture_pid" 2>/dev/null; then
            kill -KILL "$capture_pid" 2>/dev/null || true
        fi
    fi
    terminate_parent_capture_active_child
    cleanup_parent_capture_control
    PARENT_CAPTURE_PID=""
    PARENT_CAPTURE_GROUP_OWNED=false
}

handle_parent_capture_signal() {
    local signal="$1" status="$2"
    if [ "$PARENT_CAPTURE_STARTING" = true ]; then
        if [ -z "$PARENT_CAPTURE_PENDING_SIGNAL" ]; then
            PARENT_CAPTURE_PENDING_SIGNAL="$signal"
            PARENT_CAPTURE_PENDING_STATUS="$status"
        fi
        return 0
    fi
    trap '' INT TERM
    terminate_parent_capture
    [ -z "$PARENT_CAPTURE_OUTPUT_FILE" ] || \
        rm -f "$PARENT_CAPTURE_OUTPUT_FILE"
    exit "$status"
}

run_parent_managed_capture() {
    local output_file="$1" capture_rc=0
    local previous_int_trap previous_term_trap
    shift
    previous_int_trap="$(trap -p INT)"
    previous_term_trap="$(trap -p TERM)"
    PARENT_CAPTURE_PID=""
    PARENT_CAPTURE_GROUP_OWNED=false
    PARENT_CAPTURE_STARTING=true
    PARENT_CAPTURE_PENDING_SIGNAL=""
    PARENT_CAPTURE_PENDING_STATUS=""
    PARENT_CAPTURE_OUTPUT_FILE="$output_file"
    PARENT_CAPTURE_CONTROL_DIR="$(mktemp -d \
        "${TMPDIR:-/tmp}/gh-pr-enrich-parent-capture.XXXXXX")" || return 1
    if ! chmod 700 "$PARENT_CAPTURE_CONTROL_DIR"; then
        rmdir "$PARENT_CAPTURE_CONTROL_DIR" 2>/dev/null || true
        PARENT_CAPTURE_CONTROL_DIR=""
        return 1
    fi
    trap 'handle_parent_capture_signal INT 130' INT
    trap 'handle_parent_capture_signal TERM 143' TERM
    set -m
    "$@" > "$output_file" &
    PARENT_CAPTURE_PID=$!
    if kill -0 -- "-$PARENT_CAPTURE_PID" 2>/dev/null; then
        PARENT_CAPTURE_GROUP_OWNED=true
    fi
    set +m
    [ -z "${GH_PR_ENRICH_DEBUG_PARENT_CAPTURE_PID_FILE:-}" ] || \
        printf '%s\n' "$PARENT_CAPTURE_PID" >> \
            "$GH_PR_ENRICH_DEBUG_PARENT_CAPTURE_PID_FILE"
    PARENT_CAPTURE_STARTING=false
    if [ -n "$PARENT_CAPTURE_PENDING_SIGNAL" ]; then
        handle_parent_capture_signal "$PARENT_CAPTURE_PENDING_SIGNAL" \
            "$PARENT_CAPTURE_PENDING_STATUS"
    fi
    wait "$PARENT_CAPTURE_PID" || capture_rc=$?
    PARENT_CAPTURE_PID=""
    PARENT_CAPTURE_GROUP_OWNED=false
    PARENT_CAPTURE_OUTPUT_FILE=""
    cleanup_parent_capture_control
    trap - INT TERM
    [ -z "$previous_int_trap" ] || eval "$previous_int_trap"
    [ -z "$previous_term_trap" ] || eval "$previous_term_trap"
    return "$capture_rc"
}

cleanup_report_run_temp_files() {
    local temp_file temp_dir temp_name temp_suffix restore_nullglob=false cleanup_failed=false
    local -a temp_files=() temp_dirs=()
    shopt -q nullglob || { shopt -s nullglob; restore_nullglob=true; }
    temp_files=("$OUTPUT_DIR"/linked-issues.json.pages.* \
        "$OUTPUT_DIR"/linked-issues.json.normalized.*)
    temp_dirs=("$OUTPUT_DIR"/.pr-summary-connections.??????)
    [ "$restore_nullglob" = false ] || shopt -u nullglob
    for temp_file in "${temp_files[@]}"; do
        [ -f "$temp_file" ] && [ ! -L "$temp_file" ] && \
            is_generated_report_artifact "$(basename "$temp_file")" || continue
        rm -f "$temp_file" || cleanup_failed=true
    done
    for temp_dir in "${temp_dirs[@]}"; do
        [ -d "$temp_dir" ] && [ ! -L "$temp_dir" ] || continue
        temp_name="$(basename "$temp_dir")"
        temp_suffix="${temp_name##*.}"
        [[ "$temp_suffix" =~ ^[A-Za-z0-9]{6}$ ]] || continue
        rm -f "$temp_dir/files.json" "$temp_dir/files.json.pages" \
            "$temp_dir/files.json.normalized" "$temp_dir/commits.json" \
            "$temp_dir/commits.json.pages" "$temp_dir/commits.json.normalized" \
            "$temp_dir/pr-summary.json" || cleanup_failed=true
        rmdir "$temp_dir" 2>/dev/null || cleanup_failed=true
    done
    [ "$cleanup_failed" = false ]
}

CURRENT_HOSTED_HEAD=""
HOSTED_HEAD_VERIFICATION_STATUS="unavailable"
verify_pr_head_unchanged() {
    local pr_number="$1" expected_head="$2" repository="${3:-}" head_json
    local head_json_file
    CURRENT_HOSTED_HEAD=""
    HOSTED_HEAD_VERIFICATION_STATUS="unavailable"
    head_json_file="$(mktemp "${TMPDIR:-/tmp}/gh-pr-enrich-hosted-head.XXXXXX")" || return 1
    if [ -n "$repository" ]; then
        if [ "${ADDRESS_COMMAND_MANAGEMENT_ENABLED:-false}" = true ]; then
            run_address_hosted_command "$head_json_file" gh pr view \
                "$pr_number" --repo "$repository" --json headRefOid || {
                rm -f "$head_json_file"
                return 1
            }
        elif ! run_report_command gh pr view "$pr_number" --repo "$repository" \
                --json headRefOid > "$head_json_file" 2>/dev/null; then
            rm -f "$head_json_file"
            return 1
        fi
    else
        if [ "${ADDRESS_COMMAND_MANAGEMENT_ENABLED:-false}" = true ]; then
            run_address_hosted_command "$head_json_file" gh pr view \
                "$pr_number" --json headRefOid || {
                rm -f "$head_json_file"
                return 1
            }
        elif ! run_report_command gh pr view "$pr_number" --json headRefOid \
                > "$head_json_file" 2>/dev/null; then
            rm -f "$head_json_file"
            return 1
        fi
    fi
    if ! head_json="$(cat "$head_json_file")"; then
        rm -f "$head_json_file"
        return 1
    fi
    rm -f "$head_json_file"
    CURRENT_HOSTED_HEAD="$(printf '%s' "$head_json" | jq -r '.headRefOid // ""' 2>/dev/null || echo "")"
    [ -n "$expected_head" ] && [ -n "$CURRENT_HOSTED_HEAD" ] || return 1
    if [ "$CURRENT_HOSTED_HEAD" = "$expected_head" ]; then
        HOSTED_HEAD_VERIFICATION_STATUS="unchanged"
        return 0
    fi
    HOSTED_HEAD_VERIFICATION_STATUS="mismatch"
    return 1
}

invalidate_on_confirmed_hosted_head_mismatch() {
    local report_dir="$1"
    [ "$HOSTED_HEAD_VERIFICATION_STATUS" != "mismatch" ] || \
        invalidate_selected_analysis "$report_dir"
}

ADDRESS_LIVE_THREAD_RAW_FILE=""
ADDRESS_LIVE_THREAD_OUTPUT_FILE=""

cleanup_address_live_thread_stages() {
    [ -z "$ADDRESS_LIVE_THREAD_RAW_FILE" ] || \
        rm -f "$ADDRESS_LIVE_THREAD_RAW_FILE"
    [ -z "$ADDRESS_LIVE_THREAD_OUTPUT_FILE" ] || \
        rm -f "$ADDRESS_LIVE_THREAD_OUTPUT_FILE"
    ADDRESS_LIVE_THREAD_RAW_FILE=""
    ADDRESS_LIVE_THREAD_OUTPUT_FILE=""
}

fetch_live_review_thread() {
    local thread_id="$1"
    local output_file="$2"
    local comment_limit raw_file
    comment_limit="$(positive_integer_or_default \
        "${THREAD_COMMENT_LIMIT:-}" 20 100)"
    raw_file="$(mktemp "${TMPDIR:-/tmp}/gh-pr-enrich-live-thread-pages.XXXXXX")" || \
        return 1
    ADDRESS_LIVE_THREAD_RAW_FILE="$raw_file"
    ADDRESS_LIVE_THREAD_OUTPUT_FILE="$output_file"
    local query='query($threadId: ID!, $pageSize: Int!, $endCursor: String) {
      node(id: $threadId) {
        __typename
        ... on PullRequestReviewThread {
          id
          isResolved
          resolvedBy { login }
          comments(first: $pageSize, after: $endCursor) {
            pageInfo { hasNextPage endCursor }
            totalCount
            nodes {
              id
              databaseId
              author { login }
              createdAt
              lastEditedAt
              url
            }
          }
        }
      }
    }'
    if { [ "${ADDRESS_COMMAND_MANAGEMENT_ENABLED:-false}" = true ] && \
         ! run_address_hosted_command "$raw_file" gh api graphql --paginate \
            -F threadId="$thread_id" -F pageSize="$comment_limit" \
            -f query="$query"; } || \
       { [ "${ADDRESS_COMMAND_MANAGEMENT_ENABLED:-false}" != true ] && \
         ! gh api graphql --paginate -F threadId="$thread_id" \
            -F pageSize="$comment_limit" -f query="$query" \
            > "$raw_file" 2>/dev/null; } || \
       ! jq -s -e --arg thread_id "$thread_id" '
            map(.data.node.comments.nodes[]?) as $comments
            | ([.[] | .data.node.comments.totalCount] | unique) as $totals
            | ([.[] | .data.node.isResolved] | unique) as $states
            | ([.[] | (.data.node.resolvedBy.login // null)] | unique) as $resolvers
            | if length == 0 or
                 any(.[];
                    ((.errors // []) | length) != 0 or
                    .data.node.__typename != "PullRequestReviewThread" or
                    .data.node.id != $thread_id or
                    (.data.node.isResolved | type) != "boolean" or
                    (.data.node.resolvedBy != null and
                     ((.data.node.resolvedBy.login | type) != "string" or
                      (.data.node.resolvedBy.login | length) == 0)) or
                    (.data.node.comments.pageInfo.hasNextPage | type) != "boolean" or
                    (.data.node.comments.pageInfo.endCursor != null and
                     (.data.node.comments.pageInfo.endCursor | type) != "string") or
                    (if .data.node.comments.pageInfo.hasNextPage then
                        ((.data.node.comments.pageInfo.endCursor | type) != "string" or
                         (.data.node.comments.pageInfo.endCursor | length) == 0)
                     else false end) or
                    (.data.node.comments.totalCount | type) != "number" or
                    .data.node.comments.totalCount < 0 or
                    (.data.node.comments.totalCount | floor) !=
                        .data.node.comments.totalCount or
                    (.data.node.comments.nodes | type) != "array") or
                 ($totals | length) != 1 or
                 ($states | length) != 1 or
                 ($resolvers | length) != 1 or
                 (.[-1].data.node.comments.pageInfo.hasNextPage != false) or
                 (length > 1 and any(.[0:-1][];
                    .data.node.comments.pageInfo.hasNextPage != true)) or
                 ($comments | length) != $totals[0] or
                 ([$comments[].id] | length) !=
                    ([$comments[].id] | unique | length)
              then error("live review-thread pagination was incomplete or inconsistent")
              else (.[0].data.node) as $node
              | {data:{node:($node | .comments = {
                    pageInfo:{hasNextPage:false,endCursor:null},
                    totalCount:$totals[0],nodes:$comments
                })}}
              end
       ' "$raw_file" > "$output_file" 2>/dev/null; then
        cleanup_address_live_thread_stages
        return 1
    fi
    rm -f "$raw_file"
    [ "$ADDRESS_HOSTED_RESULT_FILE" != "$raw_file" ] || \
        ADDRESS_HOSTED_RESULT_FILE=""
    ADDRESS_LIVE_THREAD_RAW_FILE=""
    ADDRESS_LIVE_THREAD_OUTPUT_FILE=""
}

live_review_thread_identity_matches_context() {
    local context_file="$1"
    local thread_id="$2"
    local live_file="$3"
    jq -e -n \
            --arg thread_id "$thread_id" \
            --slurpfile context "$context_file" \
            --slurpfile live "$live_file" '
          def identity_is_complete:
            (.id | type == "string" and length > 0) and
            (.database_id | type == "number") and
            (.author | type == "string" and length > 0) and
            (.created_at | type == "string" and length > 0) and
            (.last_edited_at == null or (.last_edited_at | type == "string")) and
            (.url | type == "string" and startswith("https://"));
          [($context[0].unresolved_threads // [])[]
            | select(.thread_id == $thread_id)] as $captured
          | ($live[0].data.node) as $current
          | ($current.comments.nodes | map({
                id: (.id // null),
                database_id: (.databaseId // null),
                author: (.author.login // "unknown"),
                created_at: (.createdAt // null),
                last_edited_at: (.lastEditedAt // null),
                url: (.url // null)
            })) as $live_identity
          | ($captured | length) == 1 and
            ($captured[0].comments_complete == true) and
            (($captured[0].comment_identity | type) == "array") and
            (all($captured[0].comment_identity[]; identity_is_complete)) and
            ($current.id == $thread_id) and
            ($current.comments.pageInfo.hasNextPage == false) and
            (all($live_identity[]; identity_is_complete)) and
            (($captured[0].comment_identity | sort_by(.id)) ==
                ($live_identity | sort_by(.id)))
       ' > /dev/null 2>&1
}

validate_live_review_thread_snapshot() {
    local context_file="$1"
    local thread_id="$2"
    local expected_resolved="$3"
    local live_file="$4"
    live_review_thread_identity_matches_context "$context_file" "$thread_id" \
        "$live_file" || return 1
    jq -e --arg thread_id "$thread_id" --argjson expected "$expected_resolved" '
        .data.node.id == $thread_id and .data.node.isResolved == $expected
    ' "$live_file" > /dev/null 2>&1
}

validate_live_review_thread() {
    local context_file="$1"
    local thread_id="$2"
    local expected_resolved="$3"
    local live_file
    live_file="$(mktemp "${TMPDIR:-/tmp}/gh-pr-enrich-live-thread.XXXXXX")" || return 1
    if ! fetch_live_review_thread "$thread_id" "$live_file" || \
       ! validate_live_review_thread_snapshot "$context_file" "$thread_id" \
            "$expected_resolved" "$live_file"; then
        rm -f "$live_file"
        return 1
    fi
    rm -f "$live_file"
}

ADDRESS_MUTATION_CHILD_PID=""
ADDRESS_MUTATION_CHILD_JOB_SPEC=""
ADDRESS_MUTATION_CHILD_STARTING=false
ADDRESS_MUTATION_CHILD_TERMINATING=false
ADDRESS_MUTATION_RESULT_FILE=""
ADDRESS_HOSTED_RESULT_FILE=""
ADDRESS_HOSTED_CONTROL_DIR=""
ADDRESS_COMMAND_MANAGEMENT_ENABLED=false
ADDRESS_PENDING_SIGNAL_STATUS=""
ADDRESS_BATCH_ACTIVE=false
ADDRESS_BATCH_ATTEMPTED_THREAD_IDS=()
ADDRESS_BATCH_CONFIRMED_THREAD_IDS=()

address_job_is_running() {
    local job_spec="$1" running_pid
    [ -n "$job_spec" ] || return 1
    while IFS= read -r running_pid; do
        [ -z "$running_pid" ] || return 0
    done < <(jobs -pr "$job_spec" 2>/dev/null)
    return 1
}

cleanup_address_hosted_control() {
    local control_dir="${1:-$ADDRESS_HOSTED_CONTROL_DIR}"
    [ -n "$control_dir" ] || return 0
    rm -f "$control_dir/ack" "$control_dir/complete" \
        "$control_dir/status" "$control_dir/status.tmp" 2>/dev/null || true
    rmdir "$control_dir" 2>/dev/null || true
    [ "$ADDRESS_HOSTED_CONTROL_DIR" != "$control_dir" ] || \
        ADDRESS_HOSTED_CONTROL_DIR=""
}

signal_address_mutation_job() {
    local signal_name="$1" job_spec="$2"
    case "$signal_name" in
        TERM|KILL) ;;
        *) return 2 ;;
    esac
    # Hosted cleanup is allowed to target only the current owned Bash job.
    # Numeric PIDs/PGIDs can be reused after a completed child is reaped.
    [ "$job_spec" = "%+" ] || return 2
    kill "-$signal_name" "$job_spec"
}

terminate_address_mutation_child() {
    local termination_mode="${1:-graceful}"
    local child_pid="$ADDRESS_MUTATION_CHILD_PID" attempt=0
    local job_spec="$ADDRESS_MUTATION_CHILD_JOB_SPEC"
    [ -n "$child_pid" ] || return 0
    [ "$ADDRESS_MUTATION_CHILD_TERMINATING" != true ] || return 0
    ADDRESS_MUTATION_CHILD_TERMINATING=true
    # A captured Bash job spec remains bound to this owned job until wait. It
    # cannot target a reused numeric PID or process-group identifier.
    if [ "$termination_mode" = "graceful" ]; then
        [ -z "$job_spec" ] || \
            signal_address_mutation_job TERM "$job_spec" 2>/dev/null || true
        while [ "$attempt" -lt 20 ]; do
            address_job_is_running "$job_spec" || break
            sleep 0.05
            attempt=$((attempt + 1))
        done
    fi
    [ -z "$job_spec" ] || \
        signal_address_mutation_job KILL "$job_spec" 2>/dev/null || true
    wait "$child_pid" 2>/dev/null || true
    set +m
    cleanup_address_hosted_control
    ADDRESS_MUTATION_CHILD_PID=""
    ADDRESS_MUTATION_CHILD_JOB_SPEC=""
    ADDRESS_MUTATION_CHILD_TERMINATING=false
}

handle_address_signal() {
    local signal_name="$1"
    case "$signal_name" in
        INT) ADDRESS_PENDING_SIGNAL_STATUS=130 ;;
        TERM) ADDRESS_PENDING_SIGNAL_STATUS=143 ;;
    esac
    # One signal establishes the final status. Ignore repeats while the owned
    # request is brought to a deterministic boundary.
    trap '' INT TERM
    [ "$ADDRESS_MUTATION_CHILD_STARTING" = true ] || \
        [ "$ADDRESS_MUTATION_CHILD_TERMINATING" = true ] || \
        terminate_address_mutation_child
    if [ "$ADDRESS_MUTATION_CHILD_STARTING" != true ] && \
       [ "$ADDRESS_MUTATION_CHILD_TERMINATING" != true ]; then
        exit "$ADDRESS_PENDING_SIGNAL_STATUS"
    fi
}

run_address_hosted_command() {
    local output_file="$1"
    shift
    local child_pid command_rc=0 timeout_seconds control_dir owner_pid
    local timeout_attempt=0 timeout_limit status_value=""
    ADDRESS_MUTATION_CHILD_STARTING=true
    ADDRESS_HOSTED_RESULT_FILE="$output_file"
    control_dir="$(mktemp -d \
        "${TMPDIR:-/tmp}/gh-pr-enrich-hosted-control.XXXXXX")" || {
        ADDRESS_MUTATION_CHILD_STARTING=false
        return 1
    }
    ADDRESS_HOSTED_CONTROL_DIR="$control_dir"
    owner_pid="$$"
    set -m
    (
        supervisor_rc=0
        trap ':' TERM INT
        GH_PR_ENRICH_ADDRESS_OWNER_PID="$owner_pid" \
            "$@" > "$output_file" 2>&1 || supervisor_rc=$?
        if ! printf '%s\n' "$supervisor_rc" > "$control_dir/status.tmp" || \
           ! mv "$control_dir/status.tmp" "$control_dir/status" || \
           ! : > "$control_dir/complete"; then
            supervisor_rc=125
        fi
        # Retain the owned job even if status publication fails. The parent
        # always terminates and reaps this supervisor group after consuming a
        # response or reaching its bounded timeout.
        while :; do
            kill -0 "$owner_pid" 2>/dev/null || exit "$supervisor_rc"
            sleep 0.05
        done
    ) &
    child_pid=$!
    ADDRESS_MUTATION_CHILD_JOB_SPEC="%+"
    ADDRESS_MUTATION_CHILD_PID="$child_pid"
    timeout_seconds="$(positive_integer_or_default \
        "${GH_PR_ENRICH_GITHUB_TIMEOUT:-}" 60 3600)"
    ADDRESS_MUTATION_CHILD_STARTING=false
    if [ -n "$ADDRESS_PENDING_SIGNAL_STATUS" ]; then
        terminate_address_mutation_child
        exit "$ADDRESS_PENDING_SIGNAL_STATUS"
    fi
    timeout_limit=$((timeout_seconds * 5))
    while [ ! -f "$control_dir/complete" ] && \
          address_job_is_running "$ADDRESS_MUTATION_CHILD_JOB_SPEC" && \
          [ "$timeout_attempt" -lt "$timeout_limit" ]; do
        sleep 0.2
        timeout_attempt=$((timeout_attempt + 1))
    done
    if [ ! -f "$control_dir/complete" ] && \
       address_job_is_running "$ADDRESS_MUTATION_CHILD_JOB_SPEC"; then
        terminate_address_mutation_child
        echo "Error: GitHub request timed out after ${timeout_seconds}s" >&2
        return 124
    fi
    if [ ! -f "$control_dir/complete" ] || \
       [ ! -f "$control_dir/status" ]; then
        terminate_address_mutation_child
        echo "Error: Managed GitHub request supervisor failed" >&2
        return 125
    fi
    status_value="$(cat "$control_dir/status" 2>/dev/null || echo invalid)"
    [[ "$status_value" =~ ^[0-9]+$ ]] || {
        terminate_address_mutation_child immediate
        echo "Error: Managed GitHub request status is invalid" >&2
        return 125
    }
    # Keep the supervisor job alive until the parent terminates the complete
    # group. This closes both the final-wait signal race and descendant leaks
    # after the direct hosted command exits.
    terminate_address_mutation_child immediate
    command_rc="$status_value"
    if [ -n "$ADDRESS_PENDING_SIGNAL_STATUS" ]; then
        exit "$ADDRESS_PENDING_SIGNAL_STATUS"
    fi
    return "$command_rc"
}

rollback_active_address_thread_batch() {
    [ "$ADDRESS_BATCH_ACTIVE" = true ] || return 0
    ADDRESS_BATCH_ACTIVE=false
    if [ "${#ADDRESS_BATCH_ATTEMPTED_THREAD_IDS[@]}" -gt 0 ]; then
        # Once any forward-only mutation has been dispatched, the captured
        # unresolved-thread context may no longer describe hosted state. Every
        # non-commit path, including signal cleanup and head-read failure, must
        # invalidate the selected artifact before reporting reconciliation.
        [ -z "${ANALYSIS_DIR:-}" ] || \
            invalidate_selected_analysis "$ANALYSIS_DIR" || true
        echo "  ❌ Hosted thread resolution may be partial. No thread was reopened automatically. Manual reconciliation is required for: ${ADDRESS_BATCH_ATTEMPTED_THREAD_IDS[*]}"
        ADDRESS_BATCH_ATTEMPTED_THREAD_IDS=()
        ADDRESS_BATCH_CONFIRMED_THREAD_IDS=()
        return 1
    fi
    ADDRESS_BATCH_ATTEMPTED_THREAD_IDS=()
    ADDRESS_BATCH_CONFIRMED_THREAD_IDS=()
    return 0
}

SELECTED_ANALYSIS_LOCK_DIR=""
SELECTED_ANALYSIS_LOCK_TOKEN=""
SELECTED_ANALYSIS_LOCK_OWNED=false
SELECTED_ANALYSIS_WORKER_PID=""

selected_analysis_lock_mtime() {
    local lock_dir="$1" value=""
    value="$(stat -c '%Y' "$lock_dir" 2>/dev/null)" || \
        value="$(stat -f '%m' "$lock_dir" 2>/dev/null)" || return 1
    case "$value" in ''|*[!0-9]*) return 1 ;; esac
    printf '%s\n' "$value"
}

selected_analysis_worker_pid() {
    local worker_pid="" pid_file=""
    # Bash 3.2 keeps $$ fixed at the top-level shell inside function
    # subshells. A direct child's PPID is the actual transaction worker. Do not
    # capture the child through command substitution: that would report the
    # short-lived command-substitution shell instead.
    pid_file="$(mktemp "/tmp/gh-pr-enrich-writer-pid.XXXXXX")" || return 1
    if ! /bin/sh -c 'printf "%s\n" "$PPID" > "$1"' sh "$pid_file" || \
       ! IFS= read -r worker_pid < "$pid_file"; then
        rm -f "$pid_file"
        return 1
    fi
    rm -f "$pid_file"
    case "$worker_pid" in ''|0|0*|*[!0-9]*) return 1 ;; esac
    SELECTED_ANALYSIS_WORKER_PID="$worker_pid"
}

recover_empty_selected_analysis_residues() {
    local report_dir="$1" candidate="" candidate_name=""
    local restore_nullglob=false
    local -a candidates=()
    shopt -q nullglob || { shopt -s nullglob; restore_nullglob=true; }
    candidates=("$report_dir"/.selected-analysis-stale.* \
        "$report_dir"/.selected-analysis-release.* \
        "$report_dir"/.selected-analysis-replacements.*)
    [ "$restore_nullglob" = false ] || shopt -u nullglob
    for candidate in "${candidates[@]}"; do
        candidate_name="$(basename "$candidate")"
        if [[ "$candidate_name" =~ ^\.selected-analysis-(stale|release)\.[1-9][0-9]*\.[0-9]+\.[0-9]+$ ]]; then
            :
        elif [[ "$candidate_name" =~ ^\.selected-analysis-replacements\.[A-Za-z0-9]{6}$ ]]; then
            :
        else
            continue
        fi
        [ -d "$candidate" ] && [ ! -L "$candidate" ] && \
            ! path_has_symlink_component "$candidate" || continue
        # rmdir is the ownership-safe recovery primitive here: it can remove
        # only a completely empty claimed directory and cannot destroy an
        # owner record or concurrent recovery data.
        rmdir "$candidate" 2>/dev/null || true
    done
}

acquire_selected_analysis_lock() {
    local report_dir="$1" lock_dir="$1/.selected-analysis.lock"
    local worker_pid="" token="" recovery_residue=""
    local recorded_token="" recorded_pid="" recorded_rest=""
    local recorded_random="" recorded_epoch="" stale_dir=""
    local ownerless_lock=false lock_mtime="" current_time="" lock_entry=""
    SELECTED_ANALYSIS_LOCK_OWNED=false
    if [ "$SELECTED_ANALYSIS_LOCK_DIR" = "$lock_dir" ] && \
       [ -n "$SELECTED_ANALYSIS_LOCK_TOKEN" ] && \
       [ -d "$lock_dir" ] && [ ! -L "$lock_dir" ] && \
       ! path_has_symlink_component "$lock_dir" && \
       [ -f "$lock_dir/owner" ] && [ ! -L "$lock_dir/owner" ] && \
       [ "$(cat "$lock_dir/owner" 2>/dev/null || echo "")" = \
         "$SELECTED_ANALYSIS_LOCK_TOKEN" ]; then
        return 0
    fi
    if [ -L "$lock_dir" ] || path_has_symlink_component "$lock_dir"; then
        echo "Error: Another selected-analysis writer is active for $report_dir." >&2
        return 1
    fi
    if [ -e "$lock_dir" ]; then
        if [ ! -d "$lock_dir" ] || [ -L "$lock_dir/owner" ]; then
            echo "Error: Selected-analysis writer lock is malformed: $lock_dir" >&2
            return 1
        fi
        if [ -f "$lock_dir/owner" ]; then
            recorded_token="$(cat "$lock_dir/owner" 2>/dev/null || echo "")"
            recorded_pid="${recorded_token%%.*}"
            recorded_rest="${recorded_token#*.}"
            recorded_random="${recorded_rest%%.*}"
            recorded_epoch="${recorded_rest#*.}"
            case "$recorded_pid" in ''|0|0*|*[!0-9]*) recorded_pid="" ;; esac
            case "$recorded_random" in ''|*[!0-9]*) recorded_pid="" ;; esac
            case "$recorded_epoch" in ''|*[!0-9]*|*.*) recorded_pid="" ;; esac
            if [ -z "$recorded_pid" ] || \
               [ "$recorded_rest" = "$recorded_token" ] || \
               [ "$recorded_epoch" = "$recorded_rest" ]; then
                echo "Error: Selected-analysis writer lock has an invalid owner: $lock_dir" >&2
                return 1
            fi
            # PID reuse conservatively keeps the lock live. A dead owner's lock
            # is atomically moved aside and token-checked before removal.
            if kill -0 "$recorded_pid" 2>/dev/null; then
                echo "Error: Another selected-analysis writer is active for $report_dir." >&2
                return 1
            fi
        else
            lock_entry="$(find "$lock_dir" -mindepth 1 -maxdepth 1 \
                -print -quit 2>/dev/null || echo find-failed)"
            if [ -n "$lock_entry" ]; then
                echo "Error: Selected-analysis writer lock is malformed: $lock_dir" >&2
                return 1
            fi
            lock_mtime="$(selected_analysis_lock_mtime "$lock_dir" 2>/dev/null || echo "")"
            current_time="$(date +%s)"
            case "$current_time" in ''|*[!0-9]*) current_time="" ;; esac
            if [ -z "$lock_mtime" ] || [ -z "$current_time" ] || \
               [ $((current_time - lock_mtime)) -lt 60 ]; then
                echo "Error: Selected-analysis writer lock is awaiting its owner record: $lock_dir" >&2
                return 1
            fi
            ownerless_lock=true
        fi
        stale_dir="$report_dir/.selected-analysis-stale.$$.$RANDOM.$(date +%s)"
        if [ -e "$stale_dir" ] || [ -L "$stale_dir" ] || \
           ! mv "$lock_dir" "$stale_dir"; then
            echo "Error: Could not claim stale selected-analysis lock: $lock_dir" >&2
            return 1
        fi
        if [ "$ownerless_lock" = true ]; then
            lock_entry="$(find "$stale_dir" -mindepth 1 -maxdepth 1 \
                -print -quit 2>/dev/null || echo find-failed)"
            if [ -n "$lock_entry" ] || \
               [ "$(selected_analysis_lock_mtime "$stale_dir" 2>/dev/null || echo "")" != \
                 "$lock_mtime" ] || ! rmdir "$stale_dir"; then
                echo "Error: Ownerless selected-analysis lock changed during stale recovery; preserved at $stale_dir." >&2
                return 1
            fi
        else
            if [ -L "$stale_dir/owner" ] || [ ! -f "$stale_dir/owner" ] || \
               [ "$(cat "$stale_dir/owner" 2>/dev/null || echo "")" != \
                 "$recorded_token" ]; then
                echo "Error: Selected-analysis lock changed while stale recovery claimed it; preserved at $stale_dir." >&2
                return 1
            fi
            if ! rm -f "$stale_dir/owner" || ! rmdir "$stale_dir"; then
                echo "Error: Stale selected-analysis lock could not be removed: $stale_dir" >&2
                return 1
            fi
        fi
    fi
    recover_empty_selected_analysis_residues "$report_dir"
    recovery_residue="$(find "$report_dir" -mindepth 1 -maxdepth 1 \
        \( -name '.selected-analysis-quarantine.*' \
           -o -name '.selected-analysis-replacements.*' \
           -o -name '.selected-analysis-release.*' \
           -o -name '.selected-analysis-stale.*' \) \
        -print -quit 2>/dev/null || echo find-failed)"
    if [ -n "$recovery_residue" ]; then
        echo "Error: Selected-analysis recovery residue requires manual reconciliation: $recovery_residue" >&2
        return 1
    fi
    if ! (umask 077; mkdir "$lock_dir"); then
        echo "Error: Another selected-analysis writer is active for $report_dir." >&2
        return 1
    fi
    if ! selected_analysis_worker_pid; then
        rmdir "$lock_dir" 2>/dev/null || true
        return 1
    fi
    worker_pid="$SELECTED_ANALYSIS_WORKER_PID"
    token="$worker_pid.$RANDOM.$(date +%s)"
    if ! (set -C; umask 077; printf '%s\n' "$token" > "$lock_dir/owner") || \
       [ -L "$lock_dir" ] || [ ! -d "$lock_dir" ] || \
       path_has_symlink_component "$lock_dir" || \
       [ -L "$lock_dir/owner" ] || [ ! -f "$lock_dir/owner" ] || \
       [ "$(cat "$lock_dir/owner" 2>/dev/null || echo "")" != "$token" ]; then
        echo "Error: Selected-analysis writer lock changed while its owner was recorded: $lock_dir" >&2
        return 1
    fi
    SELECTED_ANALYSIS_LOCK_DIR="$lock_dir"
    SELECTED_ANALYSIS_LOCK_TOKEN="$token"
    SELECTED_ANALYSIS_LOCK_OWNED=true
}

release_selected_analysis_lock() {
    local lock_dir="$1" token="$2"
    local report_dir release_dir="" candidate="" candidate_token=""
    local entry="" token_pid="" token_rest="" token_random="" token_epoch=""
    local restore_nullglob=false
    local -a release_candidates=()
    [ -n "$lock_dir" ] || return 0
    report_dir="$(dirname "$lock_dir")"
    token_pid="${token%%.*}"
    token_rest="${token#*.}"
    token_random="${token_rest%%.*}"
    token_epoch="${token_rest#*.}"
    case "$token_pid" in ''|0|0*|*[!0-9]*) return 1 ;; esac
    case "$token_random" in ''|*[!0-9]*) return 1 ;; esac
    case "$token_epoch" in ''|*[!0-9]*|*.*) return 1 ;; esac
    [ "$token_rest" != "$token" ] && [ "$token_epoch" != "$token_rest" ] || \
        return 1
    release_dir="$report_dir/.selected-analysis-release.$token"

    # A prior transient cleanup failure may already have atomically claimed the
    # lock. Its deterministic, token-authenticated pathname permits an EXIT
    # retry after owner unlink without trusting an unrelated residue.
    shopt -q nullglob || { shopt -s nullglob; restore_nullglob=true; }
    release_candidates=("$report_dir"/.selected-analysis-release.*)
    [ "$restore_nullglob" = false ] || shopt -u nullglob
    for candidate in "${release_candidates[@]}"; do
        if [ -L "$candidate" ] || [ ! -d "$candidate" ] || \
           path_has_symlink_component "$candidate"; then
            echo "Error: Unsafe selected-analysis release residue requires manual reconciliation: $candidate" >&2
            return 1
        fi
        if [ "$candidate" != "$release_dir" ]; then
            echo "Error: Selected-analysis release residue requires manual reconciliation: $candidate" >&2
            return 1
        fi
        if [ -e "$lock_dir" ] || [ -L "$lock_dir" ]; then
            echo "Error: Selected-analysis release residue exists beside the active writer lock; manual reconciliation is required: $candidate" >&2
            return 1
        fi
        if [ ! -e "$candidate/owner" ] && [ ! -L "$candidate/owner" ]; then
            entry="$(find "$candidate" -mindepth 1 -maxdepth 1 \
                -print -quit 2>/dev/null || echo find-failed)"
            if [ -n "$entry" ] || ! rmdir "$candidate"; then
                echo "Error: Ownerless selected-analysis release could not be safely resumed: $candidate" >&2
                return 1
            fi
            return 0
        fi
        if [ -L "$candidate/owner" ] || [ ! -f "$candidate/owner" ]; then
            echo "Error: Unsafe selected-analysis release residue requires manual reconciliation: $candidate" >&2
            return 1
        fi
        candidate_token="$(cat "$candidate/owner" 2>/dev/null || echo "")"
        if [ "$candidate_token" != "$token" ]; then
            echo "Error: Selected-analysis release residue requires manual reconciliation: $candidate" >&2
            return 1
        fi
    done

    if [ ! -d "$release_dir" ]; then
        if [ -L "$lock_dir" ] || [ ! -d "$lock_dir" ] || \
           [ -L "$lock_dir/owner" ] || [ ! -f "$lock_dir/owner" ] || \
           [ "$(cat "$lock_dir/owner" 2>/dev/null || echo "")" != "$token" ]; then
            echo "Error: Selected-analysis writer lock ownership changed: $lock_dir" >&2
            return 1
        fi
        if [ -e "$release_dir" ] || [ -L "$release_dir" ] || \
           ! mv "$lock_dir" "$release_dir"; then
            echo "Error: Could not atomically claim selected-analysis writer lock for release: $lock_dir" >&2
            return 1
        fi
        if [ -L "$release_dir" ] || [ ! -d "$release_dir" ] || \
           path_has_symlink_component "$release_dir" || \
           [ -L "$release_dir/owner" ] || [ ! -f "$release_dir/owner" ] || \
           [ "$(cat "$release_dir/owner" 2>/dev/null || echo "")" != "$token" ]; then
            echo "Error: Selected-analysis lock changed during release; preserved at $release_dir." >&2
            return 1
        fi
    fi

    entry="$(find "$release_dir" -mindepth 1 -maxdepth 1 \
        ! -name owner -print -quit 2>/dev/null || echo find-failed)"
    if [ -n "$entry" ]; then
        echo "Error: Selected-analysis release directory contains unexpected content; preserved at $release_dir." >&2
        return 1
    fi
    if ! rm -f "$release_dir/owner"; then
        echo "Error: Could not remove selected-analysis claimed lock owner: $release_dir/owner" >&2
        return 1
    fi
    if ! rmdir "$release_dir"; then
        echo "Error: Could not remove selected-analysis claimed lock directory: $release_dir" >&2
        return 1
    fi
}

# Return an exact identity for the fixed selected-analysis replacement set.
# Any extra entry, symlink, directory, mode change, or byte change fails closed.
selected_analysis_replacement_identity() (
    local replacement_dir="$1" entry name digest mode
    local -a names=(
        analysis.json analysis.md context-coverage.md
        combined-data.json comprehensive-report.md
        claude-analysis.json claude-analysis.md
    )
    [ -d "$replacement_dir" ] && [ ! -L "$replacement_dir" ] && \
        ! path_has_symlink_component "$replacement_dir" || return 1
    while IFS= read -r -d '' entry; do
        name="$(basename "$entry")"
        case "$name" in
            analysis.json|analysis.md|context-coverage.md|\
            combined-data.json|comprehensive-report.md|\
            claude-analysis.json|claude-analysis.md) ;;
            *) return 1 ;;
        esac
        [ -f "$entry" ] && [ ! -L "$entry" ] || return 1
    done < <(find "$replacement_dir" -mindepth 1 -maxdepth 1 -print0 2>/dev/null)
    for name in "${names[@]}"; do
        entry="$replacement_dir/$name"
        if [ -e "$entry" ] || [ -L "$entry" ]; then
            [ -f "$entry" ] && [ ! -L "$entry" ] || return 1
            digest="$(sha256_file "$entry" 2>/dev/null || echo "")"
            mode="$(workspace_file_mode "$entry" 2>/dev/null || echo "")"
            [ -n "$digest" ] && [ -n "$mode" ] || return 1
            printf '%s\tfile\t%s\t%s\n' "$name" "$mode" "$digest"
        else
            printf '%s\tabsent\n' "$name"
        fi
    done
)

# Identity of the public analysis view set without rejecting unrelated report
# inputs in the same directory. Used to make deferred invalidation conditional:
# a fresh concurrent publication must never be deleted for an older mismatch.
selected_analysis_live_identity() (
    local report_dir="$1" name entry digest mode
    local -a names=(
        analysis.json analysis.md context-coverage.md
        combined-data.json comprehensive-report.md
        claude-analysis.json claude-analysis.md
    )
    [ -d "$report_dir" ] && [ ! -L "$report_dir" ] && \
        ! path_has_symlink_component "$report_dir" || return 1
    for name in "${names[@]}"; do
        entry="$report_dir/$name"
        if [ -e "$entry" ] || [ -L "$entry" ]; then
            [ -f "$entry" ] && [ ! -L "$entry" ] && \
                ! path_is_git_tracked "$entry" || return 1
            digest="$(sha256_file "$entry" 2>/dev/null || echo "")"
            mode="$(workspace_file_mode "$entry" 2>/dev/null || echo "")"
            [ -n "$digest" ] && [ -n "$mode" ] || return 1
            printf '%s\tfile\t%s\t%s\n' "$name" "$mode" "$digest"
        else
            printf '%s\tabsent\n' "$name"
        fi
    done
)

# Replace or delete the seven selected-analysis views as one recoverable
# transaction. Live originals are atomically quarantined and verified against
# the caller's capture. Hard-link publication and restoration fail rather than
# clobbering a pathname that reappears at a boundary.
publish_selected_analysis_transaction() (
    local report_dir="$1" expected_dir="$2" replacement_dir="$3"
    local expected_replacement_identity="$4" current_replacement_identity=""
    local quarantine_dir name destination expected replacement quarantine
    local published_reference
    local expected_digest quarantine_digest expected_mode quarantine_mode
    local transaction_failed=false rollback_failed=false transaction_signal=""
    local quarantined_names=" " published_names=" "
    local -a names=(
        analysis.json analysis.md context-coverage.md
        combined-data.json comprehensive-report.md
        claude-analysis.json claude-analysis.md
    )
    current_replacement_identity="$(selected_analysis_replacement_identity \
        "$replacement_dir" 2>/dev/null || echo "")"
    if [ -z "$expected_replacement_identity" ] || \
       [ "$current_replacement_identity" != "$expected_replacement_identity" ]; then
        return 1
    fi
    quarantine_dir="$(mktemp -d \
        "$report_dir/.selected-analysis-quarantine.XXXXXX")" || return 1
    trap 'transaction_signal=INT; transaction_failed=true' INT
    trap 'transaction_signal=TERM; transaction_failed=true' TERM

    rollback_selected_publication() {
        local rollback_name rollback_destination
        local rollback_quarantine rollback_published rollback_reference
        local index
        for ((index=${#names[@]}-1; index>=0; index--)); do
            rollback_name="${names[$index]}"
            case "$published_names" in
                *" $rollback_name "*) ;;
                *) continue ;;
            esac
            rollback_destination="$report_dir/$rollback_name"
            rollback_reference="$quarantine_dir/.replacement-$rollback_name"
            if [ -e "$rollback_destination" ]; then
                rollback_published="$quarantine_dir/.published-$rollback_name"
                if [ -e "$rollback_published" ] || [ -L "$rollback_published" ] || \
                   ! mv "$rollback_destination" "$rollback_published"; then
                    rollback_failed=true
                elif [ -f "$rollback_reference" ] && \
                     [ ! -L "$rollback_reference" ] && \
                     [ "$rollback_published" -ef "$rollback_reference" ]; then
                    : # Owned publication is now safely quarantined for discard.
                else
                    # The destination changed before rollback could claim it.
                    # Put that concurrent content back only if the pathname is
                    # still absent, and retain every original for reconciliation.
                    if [ -e "$rollback_destination" ] || \
                       [ -L "$rollback_destination" ] || \
                       ! ln "$rollback_published" "$rollback_destination"; then
                        :
                    fi
                    rollback_failed=true
                fi
            fi
        done
        for rollback_name in "${names[@]}"; do
            case "$quarantined_names" in
                *" $rollback_name "*) ;;
                *) continue ;;
            esac
            rollback_destination="$report_dir/$rollback_name"
            rollback_quarantine="$quarantine_dir/$rollback_name"
            [ -f "$rollback_quarantine" ] || continue
            if [ -e "$rollback_destination" ] || [ -L "$rollback_destination" ] || \
               ! ln "$rollback_quarantine" "$rollback_destination"; then
                rollback_failed=true
            fi
        done
        if [ "$rollback_failed" = false ]; then
            if ! rm -rf "$quarantine_dir"; then
                echo "Error: Rollback restored selected-analysis views, but quarantined copies could not be removed from $quarantine_dir; manual cleanup is required." >&2
                rollback_failed=true
            fi
        else
            echo "Error: Original selected-analysis artifacts were preserved at $quarantine_dir; manual reconciliation is required." >&2
        fi
        [ "$rollback_failed" = false ]
    }

    for name in "${names[@]}"; do
        current_replacement_identity="$(selected_analysis_replacement_identity \
            "$replacement_dir" 2>/dev/null || echo "")"
        if [ "$current_replacement_identity" != \
             "$expected_replacement_identity" ]; then
            transaction_failed=true
            break
        fi
        destination="$report_dir/$name"
        expected="$expected_dir/$name"
        quarantine="$quarantine_dir/$name"
        if [ -f "$expected" ]; then
            if [ -L "$destination" ] || path_is_git_tracked "$destination" || \
               [ ! -f "$destination" ] || ! mv "$destination" "$quarantine"; then
                transaction_failed=true
                break
            fi
            quarantined_names+="$name "
            expected_digest="$(sha256_file "$expected" 2>/dev/null || echo "")"
            quarantine_digest="$(sha256_file "$quarantine" 2>/dev/null || echo "")"
            expected_mode="$(workspace_file_mode "$expected" 2>/dev/null || echo "")"
            quarantine_mode="$(workspace_file_mode "$quarantine" 2>/dev/null || echo "")"
            if [ -z "$expected_digest" ] || \
               [ "$quarantine_digest" != "$expected_digest" ] || \
               [ -z "$expected_mode" ] || [ "$quarantine_mode" != "$expected_mode" ]; then
                transaction_failed=true
                break
            fi
        elif [ -e "$destination" ] || [ -L "$destination" ]; then
            transaction_failed=true
            break
        fi
        if [ -n "$transaction_signal" ]; then
            transaction_failed=true
            break
        fi
    done
    if [ "$transaction_failed" = true ]; then
        rollback_selected_publication || true
        [ -z "$transaction_signal" ] || \
            echo "Error: Selected-analysis publication was cancelled and rolled back." >&2
        case "$transaction_signal" in
            INT) return 130 ;;
            TERM) return 143 ;;
            *) return 1 ;;
        esac
    fi

    for name in "${names[@]}"; do
        destination="$report_dir/$name"
        replacement="$replacement_dir/$name"
        if [ -f "$replacement" ]; then
            published_reference="$quarantine_dir/.replacement-$name"
            if [ -e "$published_reference" ] || [ -L "$published_reference" ] || \
               ! ln "$replacement" "$published_reference"; then
                transaction_failed=true
                break
            fi
            if [ -e "$destination" ] || [ -L "$destination" ] || \
               ! ln "$replacement" "$destination"; then
                transaction_failed=true
                break
            fi
            published_names+="$name "
        elif [ -e "$destination" ] || [ -L "$destination" ]; then
            transaction_failed=true
            break
        fi
        if [ -n "$transaction_signal" ]; then
            transaction_failed=true
            break
        fi
    done
    if [ "$transaction_failed" = false ]; then
        current_replacement_identity="$(selected_analysis_replacement_identity \
            "$replacement_dir" 2>/dev/null || echo "")"
        [ "$current_replacement_identity" = "$expected_replacement_identity" ] || \
            transaction_failed=true
    fi
    if [ "$transaction_failed" = false ]; then
        for name in "${names[@]}"; do
            destination="$report_dir/$name"
            replacement="$replacement_dir/$name"
            if [ -f "$replacement" ]; then
                [ -e "$destination" ] && \
                    [ "$destination" -ef "$replacement" ] || \
                    transaction_failed=true
            elif [ -e "$destination" ] || [ -L "$destination" ]; then
                transaction_failed=true
            fi
        done
    fi
    if [ "$transaction_failed" = true ]; then
        rollback_selected_publication || true
        [ -z "$transaction_signal" ] || \
            echo "Error: Selected-analysis publication was cancelled and rolled back." >&2
        case "$transaction_signal" in
            INT) return 130 ;;
            TERM) return 143 ;;
            *) return 1 ;;
        esac
    fi

    if ! rm -rf "$quarantine_dir"; then
        echo "Error: Published selected-analysis views, but stale originals could not be removed from $quarantine_dir; manual cleanup is required." >&2
        return 1
    fi
    case "$transaction_signal" in
        INT)
            echo "Error: Selected-analysis publication completed coherently before interrupt cancellation." >&2
            return 130
            ;;
        TERM)
            echo "Error: Selected-analysis publication completed coherently before termination." >&2
            return 143
            ;;
    esac
    return 0
)

invalidate_selected_analysis() (
    local report_dir="$1" expected_live_identity="${2:-}"
    local invalidation_backup_dir="" replacement_dir=""
    local selected_lock_dir="" selected_lock_token="" selected_lock_owned=false
    local selected_writer_signal=""
    local publication_rc=0
    local replacement_identity=""
    local artifact backup_file backup_digest source_digest source_mode
    local -a invalidation_artifacts=(
        "$report_dir/analysis.json"
        "$report_dir/analysis.md"
        "$report_dir/context-coverage.md"
        "$report_dir/combined-data.json"
        "$report_dir/comprehensive-report.md"
        "$report_dir/claude-analysis.json"
        "$report_dir/claude-analysis.md"
    )
    cleanup_invalidation_temps() {
        [ -z "$invalidation_backup_dir" ] || \
            rm -rf "$invalidation_backup_dir" 2>/dev/null || true
        [ -z "$replacement_dir" ] || \
            rm -rf "$replacement_dir" 2>/dev/null || true
        if [ "$selected_lock_owned" = true ] && [ -n "$selected_lock_dir" ]; then
            if ! release_selected_analysis_lock \
                    "$selected_lock_dir" "$selected_lock_token"; then
                echo "Error: Selected-analysis writer lock remains after invalidation cleanup." >&2
            fi
        fi
    }
    validate_invalidation_artifacts() {
        for artifact in "${invalidation_artifacts[@]}"; do
            if [ -L "$artifact" ] || path_has_symlink_component "$artifact" || \
               path_is_git_tracked "$artifact" || \
               { [ -e "$artifact" ] && [ ! -f "$artifact" ]; }; then
                echo "Error: Refusing unsafe selected-analysis artifact during invalidation: $artifact" >&2
                return 1
            fi
        done
    }
    trap cleanup_invalidation_temps EXIT
    trap 'selected_writer_signal=INT' INT
    trap 'selected_writer_signal=TERM' TERM
    validate_invalidation_artifacts || return 1
    acquire_selected_analysis_lock "$report_dir" || return 1
    selected_lock_dir="$SELECTED_ANALYSIS_LOCK_DIR"
    selected_lock_token="$SELECTED_ANALYSIS_LOCK_TOKEN"
    selected_lock_owned="$SELECTED_ANALYSIS_LOCK_OWNED"
    if [ -n "$expected_live_identity" ] && \
       [ "$(selected_analysis_live_identity "$report_dir" 2>/dev/null || echo "")" != \
         "$expected_live_identity" ]; then
        echo "Error: Selected-analysis views changed before stale invalidation; the newer publication was preserved." >&2
        return 1
    fi

    # Capture every current view before deriving replacements. Rendering from
    # these verified backups ensures a source that changes before its own copy
    # is never overwritten by output derived from older bytes.
    invalidation_backup_dir="$(mktemp -d \
        "/tmp/gh-pr-enrich-invalidation.XXXXXX")" || return 1
    replacement_dir="$(mktemp -d \
        "$report_dir/.selected-analysis-replacements.XXXXXX")" || return 1
    chmod 700 "$replacement_dir" || return 1
    for artifact in "${invalidation_artifacts[@]}"; do
        [ -f "$artifact" ] || continue
        source_digest="$(sha256_file "$artifact")" || return 1
        backup_file="$invalidation_backup_dir/$(basename "$artifact")"
        cp -p "$artifact" "$backup_file" || return 1
        backup_digest="$(sha256_file "$backup_file")" || return 1
        if [ "$backup_digest" != "$source_digest" ] || \
           [ "$(sha256_file "$artifact" 2>/dev/null || echo "")" != \
             "$source_digest" ]; then
            echo "Error: Selected-analysis artifacts changed while invalidation was staged." >&2
            return 1
        fi
    done

    backup_file="$invalidation_backup_dir/comprehensive-report.md"
    if [ -f "$backup_file" ]; then
        if grep -Fxq -e '<!-- BEGIN SELECTED ANALYSIS -->' \
                -e '<!-- END SELECTED ANALYSIS -->' "$backup_file"; then
            if ! awk '
            BEGIN { in_selected = 0; selected_blocks = 0 }
            $0 == "<!-- BEGIN SELECTED ANALYSIS -->" {
                if (in_selected || selected_blocks > 0) exit 2
                in_selected = 1
                selected_blocks++
                next
            }
            $0 == "<!-- END SELECTED ANALYSIS -->" {
                if (!in_selected) exit 2
                in_selected = 0
                next
            }
            !in_selected { print }
            END { if (in_selected) exit 2 }
            ' "$backup_file" > "$replacement_dir/comprehensive-report.md"; then
                echo "Error: Comprehensive report has malformed selected-analysis markers." >&2
                return 1
            fi
        elif ! cp -p "$backup_file" \
                "$replacement_dir/comprehensive-report.md"; then
            return 1
        fi
        source_mode="$(workspace_file_mode "$backup_file")" || return 1
        chmod "$source_mode" "$replacement_dir/comprehensive-report.md" || return 1
    fi

    backup_file="$invalidation_backup_dir/combined-data.json"
    if [ -f "$backup_file" ]; then
        if ! jq 'del(.analysis, .analysis_context_coverage, .claude_analysis)' \
                "$backup_file" > "$replacement_dir/combined-data.json" 2>/dev/null; then
            return 1
        fi
        source_mode="$(workspace_file_mode "$backup_file")" || return 1
        chmod "$source_mode" "$replacement_dir/combined-data.json" || return 1
    fi
    # Close the render-phase TOCTOU window and verify that paths which were
    # absent when captured remain absent immediately before publication.
    validate_invalidation_artifacts || return 1
    for artifact in "${invalidation_artifacts[@]}"; do
        backup_file="$invalidation_backup_dir/$(basename "$artifact")"
        if [ -f "$backup_file" ]; then
            if [ ! -f "$artifact" ] || \
               [ "$(sha256_file "$artifact" 2>/dev/null || echo "")" != \
                 "$(sha256_file "$backup_file" 2>/dev/null || echo "")" ]; then
                echo "Error: Selected-analysis artifacts changed before invalidation was published." >&2
                return 1
            fi
        elif [ -e "$artifact" ] || [ -L "$artifact" ]; then
            echo "Error: A selected-analysis artifact appeared while invalidation was staged." >&2
            return 1
        fi
    done
    if [ -n "$selected_writer_signal" ]; then
        echo "Error: Selected-analysis invalidation was cancelled before publication." >&2
        case "$selected_writer_signal" in
            INT) return 130 ;;
            TERM) return 143 ;;
        esac
    fi
    replacement_identity="$(selected_analysis_replacement_identity \
        "$replacement_dir" 2>/dev/null || echo "")"
    [ -n "$replacement_identity" ] || return 1
    publish_selected_analysis_transaction \
        "$report_dir" "$invalidation_backup_dir" "$replacement_dir" \
        "$replacement_identity" || \
        publication_rc=$?
    if [ "$publication_rc" -ne 0 ]; then
        echo "Error: Selected-analysis invalidation could not be published safely." >&2
        return "$publication_rc"
    fi
    if [ "$selected_lock_owned" = true ]; then
        if ! release_selected_analysis_lock \
                "$selected_lock_dir" "$selected_lock_token"; then
            echo "Error: Selected-analysis invalidation was published, but its writer lock could not be released." >&2
            return 1
        fi
        selected_lock_owned=false
        selected_lock_dir=""
        selected_lock_token=""
    fi
    case "$selected_writer_signal" in
        INT) return 130 ;;
        TERM) return 143 ;;
    esac
    return 0
)

is_generated_report_artifact() {
    local temp_suffix="" temp_dir=""
    case "$1" in
        linked-issues.json.pages.*|linked-issues.json.normalized.*)
            temp_suffix="${1##*.}"
            [[ "$temp_suffix" =~ ^[A-Za-z0-9]{6}$ ]]
            return $?
            ;;
        .pr-summary-connections.??????/files.json|\
        .pr-summary-connections.??????/files.json.pages|\
        .pr-summary-connections.??????/files.json.normalized|\
        .pr-summary-connections.??????/commits.json|\
        .pr-summary-connections.??????/commits.json.pages|\
        .pr-summary-connections.??????/commits.json.normalized|\
        .pr-summary-connections.??????/pr-summary.json)
            temp_dir="${1%%/*}"
            temp_suffix="${temp_dir##*.}"
            [[ "$temp_suffix" =~ ^[A-Za-z0-9]{6}$ ]]
            return $?
            ;;
    esac
    case "$1" in
        .selected-analysis.lock/owner|\
        pr-summary.json|comment-threads.json|comment-threads.json.pages|unresolved-threads.json|id-mapping.txt|\
        issue-comments.json|review-comments.json|inline-comments.json|\
        issue-comments.pages|review-comments.pages|inline-comments.pages|\
        issue-comments.tmp.json|review-comments.tmp.json|inline-comments.tmp.json|\
        issue-comments-with-graphql.json|review-comments-with-graphql.json|inline-comments-with-graphql.json|\
        issue-comments-deduped.json|all-comments.json|all-comments-with-graphql.json|\
        checks.json|linked-issues.json|linked-issues.json.raw|pr-diff.txt|pr-diff.json|\
        sast-findings.json|semgrep-raw.json|\
        issue-comments-status.json|review-comments-status.json|inline-comments-status.json|\
        review-threads-status.json|checks-status.json|linked-issues-status.json|\
        diff-status.json|sast-status.json|analysis-context.json|\
        claude-context.json|analysis-schema.json|\
        analysis.json|codex-analysis.json|claude-analysis.json|claude-analysis.raw.tmp.json|\
        claude-code-analysis.json|hybrid-analysis.json|analysis.md|codex-analysis.md|\
        claude-analysis.md|claude-code-analysis.md|hybrid-analysis.md|context-coverage.md|\
        combined-data.json|combined-data.tmp.json|comprehensive-report.md|\
        claude-raw-response.json|claude-stderr.log|semgrep-stderr.log)
            return 0
            ;;
    esac
    return 1
}

path_is_git_tracked() {
    local path="$1" path_abs parent repo_root relative
    [ -e "$path" ] || [ -L "$path" ] || return 1
    path_abs="$(canonicalize_path "$path")"
    parent="$(dirname "$path_abs")"
    repo_root="$(git -C "$parent" rev-parse --show-toplevel 2>/dev/null || echo "")"
    [ -n "$repo_root" ] || return 1
    case "$path_abs" in
        "$repo_root"/*)
            relative="${path_abs#"$repo_root/"}"
            git -C "$repo_root" ls-files --error-unmatch -- "$relative" > /dev/null 2>&1
            ;;
        *) return 1 ;;
    esac
}

path_has_symlink_component() {
    local probe="$1" parent
    # `test -L path/` follows the final link on Bash/macOS. Strip trailing
    # separators first so they cannot hide the output link itself.
    while [ "$probe" != "/" ] && [[ "$probe" = */ ]]; do
        probe="${probe%/}"
    done
    while [ "$probe" != "." ] && [ "$probe" != "/" ] && [ -n "$probe" ]; do
        parent="$(dirname "$probe")"
        if [ -L "$probe" ]; then
            # macOS exposes system directories such as /tmp and /var through
            # root-level aliases into /private. Those links are outside a
            # checkout's control; nested links remain unsafe because a reviewed
            # branch can supply them and redirect report writes.
            [ "$parent" = "/" ] || return 0
        fi
        [ "$parent" != "$probe" ] || break
        probe="$parent"
    done
    return 1
}

# Validate an existing report directory before any redirection can follow a
# branch-supplied symlink or overwrite unrelated user content.
validate_output_directory_for_writes() {
    local output_dir="$1" candidate relative repo_root output_abs output_rel tracked=""
    local inventory invalid_reason=""
    if [ -L "$output_dir" ]; then
        echo "Error: Report output directory cannot be a symbolic link: $output_dir" >&2
        return 1
    fi
    output_abs="$(canonicalize_path "$output_dir")"
    [ -d "$output_abs" ] || return 1

    inventory="$(mktemp "${TMPDIR:-/tmp}/gh-pr-enrich-preflight.XXXXXX")"
    if ! find "$output_abs" -mindepth 1 \( -type f -o -type l \) \
            -print > "$inventory" 2>/dev/null; then
        rm -f "$inventory"
        echo "Error: Report output directory could not be inspected safely." >&2
        return 1
    fi
    while IFS= read -r candidate; do
        relative="${candidate#"$output_abs/"}"
        if [ -L "$candidate" ]; then
            invalid_reason="symbolic link: $relative"
            break
        elif ! is_generated_report_artifact "$relative"; then
            invalid_reason="unrelated file: $relative"
            break
        fi
    done < "$inventory"
    rm -f "$inventory"
    if [ -n "$invalid_reason" ]; then
        echo "Error: Report output contains a $invalid_reason" >&2
        return 1
    fi

    repo_root="$(git -C "$output_abs" rev-parse --show-toplevel 2>/dev/null || echo "")"
    if [ -n "$repo_root" ]; then
        if [ "$output_abs" = "$repo_root" ]; then
            tracked="$(git -C "$repo_root" ls-files 2>/dev/null || echo "")"
        else
            output_rel="${output_abs#"$repo_root/"}"
            tracked="$(git -C "$repo_root" ls-files -- ":(literal)$output_rel" 2>/dev/null || echo "")"
        fi
    fi
    if [ -n "$tracked" ]; then
        echo "Error: Report output contains files tracked by the reviewed branch." >&2
        return 1
    fi
}

# Strip terminal control sequences from analyzer-controlled text.
#
# Task text, priorities and fixes come from analysis.json, which may be shaped
# by PR content. Escape sequences printed straight to a terminal can repaint the
# screen or fake this tool's own prompts, misrepresenting what the user is
# approving. Newlines and tabs are kept; every other control byte is dropped.
sanitize_for_terminal() {
    printf '%s' "$1" | LC_ALL=C tr -d '\000-\010\013-\037\177'
}

# The fingerprinted context is the grant. Later boundaries require the same
# workspace; they never replay the override that created the grant. A current
# explicit opt-out can still revoke it.
validate_code_access_grant() {
    local context_file="$1"
    local report_dir="$2"
    local ignored_transaction_dir="${3:-}"
    local expected_fingerprint current_fingerprint snapshot_source
    if [ "${GH_PR_ENRICH_CODE_ACCESS:-}" = "false" ]; then
        echo "Error: Repository code access was revoked by --no-code-access." >&2
        return 1
    fi
    if [ "$(jq -r '.coverage.code_access.state // "disabled"' \
            "$context_file" 2>/dev/null || echo "disabled")" != "enabled" ]; then
        echo "Error: Repository code access is not enabled in the fingerprinted context." >&2
        return 1
    fi
    expected_fingerprint="$(jq -r \
        '.coverage.code_access.workspace_fingerprint // ""' \
        "$context_file" 2>/dev/null || echo "")"
    snapshot_source="$(jq -r \
        '.coverage.code_access.snapshot_source // "git_index"' \
        "$context_file" 2>/dev/null || echo "")"
    case "$snapshot_source" in
        git_index|working_tree) ;;
        *)
            echo "Error: Fingerprinted context has an invalid code snapshot source." >&2
            return 1
            ;;
    esac
    current_fingerprint="$(code_access_workspace_fingerprint \
        "$report_dir" "$ignored_transaction_dir" "$snapshot_source" \
        2>/dev/null || echo "")"
    if [ -z "$expected_fingerprint" ] || \
       [ "$current_fingerprint" != "$expected_fingerprint" ]; then
        echo "Error: Current local code access no longer matches the fingerprinted context." >&2
        return 1
    fi
}

analysis_snapshot_sidecar_matches() {
    local snapshot_path="$1" sidecar_path="$2" expected_token="${3:-}"
    local expected_state="${4:-}" token janitor_pid state parent expected_parent
    [ "$sidecar_path" = "$snapshot_path.janitor" ] || return 1
    [ -f "$sidecar_path" ] && [ ! -L "$sidecar_path" ] || return 1
    parent="$(cd "$(dirname "$sidecar_path")" && pwd -P)" || return 1
    expected_parent="$(cd /tmp && pwd -P)" || return 1
    [ "$parent" = "$expected_parent" ] || return 1
    IFS=$'\t' read -r token janitor_pid state < "$sidecar_path" || return 1
    [[ "$token" =~ ^[A-Za-z0-9]+$ ]] || return 1
    [[ "$janitor_pid" =~ ^[1-9][0-9]*$ ]] || return 1
    case "$state" in active|cancel) ;; *) return 1 ;; esac
    { [ -z "$expected_token" ] || [ "$token" = "$expected_token" ]; } && \
        { [ -z "$expected_state" ] || [ "$state" = "$expected_state" ]; }
}

run_analysis_snapshot_janitor() {
    local snapshot_path="$1" sidecar_path="$2" token="$3" ttl_seconds="$4"
    local poll_seconds="${GH_PR_ENRICH_SNAPSHOT_POLL_SECONDS:-0.1}"
    local recorded_token recorded_pid state sleep_pid="" deadline
    is_private_code_snapshot_path "$snapshot_path" || return 1
    [[ "$ttl_seconds" =~ ^[1-9][0-9]*$ ]] || return 1
    [[ "$poll_seconds" =~ ^[0-9]+([.][0-9]+)?$ ]] || return 1
    [ "$poll_seconds" != "0" ] && [ "$poll_seconds" != "0.0" ] || return 1
    if ! (umask 077; set -o noclobber; \
            printf '%s\t%s\tactive\n' "$token" "$$" > "$sidecar_path") \
            2>/dev/null; then
        return 1
    fi
    trap '' HUP
    trap '[ -n "$sleep_pid" ] && kill "$sleep_pid" 2>/dev/null; [ -z "$sleep_pid" ] || wait "$sleep_pid" 2>/dev/null; exit 0' TERM INT
    deadline=$((SECONDS + ttl_seconds))
    while [ "$SECONDS" -lt "$deadline" ]; do
        analysis_snapshot_sidecar_matches "$snapshot_path" "$sidecar_path" \
            "$token" || return 0
        IFS=$'\t' read -r recorded_token recorded_pid state \
            < "$sidecar_path" || return 0
        [ "$recorded_pid" = "$$" ] || return 0
        if [ "$state" = "cancel" ]; then
            rm -f "$sidecar_path"
            return 0
        fi
        sleep "$poll_seconds" &
        sleep_pid=$!
        wait "$sleep_pid" 2>/dev/null || return 0
        heartbeat_sleep_pid=""
    done
    trap - TERM INT
    analysis_snapshot_sidecar_matches "$snapshot_path" "$sidecar_path" \
        "$token" active || return 0
    IFS=$'\t' read -r recorded_token recorded_pid state \
        < "$sidecar_path" || return 0
    [ "$recorded_pid" = "$$" ] || return 0
    chmod -R u+w "$snapshot_path" 2>/dev/null || true
    rm -rf "$snapshot_path"
    rm -f "$sidecar_path"
}

stop_analysis_snapshot_janitor() {
    local snapshot_path="$1"
    local sidecar_path="$snapshot_path.janitor"
    local token janitor_pid state cancel_tmp wait_attempt=0
    if ! analysis_snapshot_sidecar_matches "$snapshot_path" "$sidecar_path"; then
        rm -f "$sidecar_path" 2>/dev/null || true
        return 0
    fi
    IFS=$'\t' read -r token janitor_pid state < "$sidecar_path" || return 0
    cancel_tmp="$(mktemp "$sidecar_path.cancel.XXXXXX")" || return 1
    if ! printf '%s\t%s\tcancel\n' "$token" "$janitor_pid" > "$cancel_tmp" || \
       ! chmod 600 "$cancel_tmp" || ! mv "$cancel_tmp" "$sidecar_path"; then
        rm -f "$cancel_tmp"
        return 1
    fi
    while [ "$wait_attempt" -lt 300 ]; do
        [ ! -e "$sidecar_path" ] && return 0
        sleep 0.01
        wait_attempt=$((wait_attempt + 1))
    done
    rm -f "$sidecar_path"
}

start_analysis_snapshot_janitor() {
    local snapshot_path="$1" ttl_seconds="$2"
    local cleanup_command sidecar_path token_file token janitor_pid
    local recorded_token recorded_pid state ready=false wait_attempt=0
    is_private_code_snapshot_path "$snapshot_path" || return 1
    [[ "$ttl_seconds" =~ ^[1-9][0-9]*$ ]] || return 1
    cleanup_command="$(canonicalize_path "${BASH_SOURCE[0]}")"
    [ -f "$cleanup_command" ] && [ -x "$cleanup_command" ] || return 1
    sidecar_path="$snapshot_path.janitor"
    token_file="$(mktemp "/tmp/gh-pr-enrich-janitor-token.XXXXXX")" || return 1
    token="${token_file##*.}"
    rm -f "$token_file"
    "$cleanup_command" __snapshot-janitor "$snapshot_path" "$sidecar_path" \
        "$token" "$ttl_seconds" </dev/null >/dev/null 2>&1 &
    janitor_pid=$!
    while [ "$wait_attempt" -lt 300 ]; do
        if analysis_snapshot_sidecar_matches "$snapshot_path" "$sidecar_path" \
                "$token" active; then
            IFS=$'\t' read -r recorded_token recorded_pid state \
                < "$sidecar_path" || break
            if [ "$recorded_pid" = "$janitor_pid" ]; then
                ready=true
                break
            fi
        fi
        kill -0 "$janitor_pid" 2>/dev/null || break
        sleep 0.01
        wait_attempt=$((wait_attempt + 1))
    done
    if [ "$ready" != true ]; then
        stop_analysis_snapshot_janitor "$snapshot_path" || true
        wait "$janitor_pid" 2>/dev/null || true
        return 1
    fi
    disown "$janitor_pid" 2>/dev/null || true
}

RETROSPECTIVE_JANITOR_SNAPSHOT=""
RETROSPECTIVE_JANITOR_SIDECAR=""
RETROSPECTIVE_JANITOR_TOKEN=""
cleanup_owned_retrospective_snapshot() {
    local token janitor_pid state cleanup_attempt=0
    [ -n "$RETROSPECTIVE_JANITOR_SNAPSHOT" ] && \
        is_private_code_snapshot_path "$RETROSPECTIVE_JANITOR_SNAPSHOT" || return 0
    [ "$RETROSPECTIVE_JANITOR_SIDECAR" = \
        "$RETROSPECTIVE_JANITOR_SNAPSHOT.janitor" ] || return 0
    [ -f "$RETROSPECTIVE_JANITOR_SIDECAR" ] && \
        [ ! -L "$RETROSPECTIVE_JANITOR_SIDECAR" ] || return 0
    IFS=$'\t' read -r token janitor_pid state \
        < "$RETROSPECTIVE_JANITOR_SIDECAR" || return 0
    [ "$token" = "$RETROSPECTIVE_JANITOR_TOKEN" ] && \
        [ "$janitor_pid" = "$$" ] && [ "$state" = active ] || return 0
    while [ "$cleanup_attempt" -lt 300 ] && \
          [ -e "$RETROSPECTIVE_JANITOR_SNAPSHOT" ]; do
        chmod -R u+w "$RETROSPECTIVE_JANITOR_SNAPSHOT" 2>/dev/null || true
        rm -rf "$RETROSPECTIVE_JANITOR_SNAPSHOT" 2>/dev/null || true
        [ ! -e "$RETROSPECTIVE_JANITOR_SNAPSHOT" ] || sleep 0.01
        cleanup_attempt=$((cleanup_attempt + 1))
    done
    [ -e "$RETROSPECTIVE_JANITOR_SNAPSHOT" ] || \
        rm -f "$RETROSPECTIVE_JANITOR_SIDECAR"
}

run_retrospective_snapshot_janitor() {
    local snapshot_path="$1" sidecar_path="$2" token="$3" fifo_path="$4"
    local inherited_lease_fd="$5" inherited_bootstrap_fd="$6"
    local heartbeat
    is_private_code_snapshot_path "$snapshot_path" || return 1
    [ "$sidecar_path" = "$snapshot_path.janitor" ] || return 1
    [ "$fifo_path" = "$snapshot_path/.owner" ] && \
        [ -p "$fifo_path" ] && [ ! -L "$fifo_path" ] || return 1
    case "$inherited_lease_fd" in
        9) exec 9>&- ;;
        8) exec 8>&- ;;
        7) exec 7>&- ;;
        6) exec 6>&- ;;
        5) exec 5>&- ;;
        *) return 1 ;;
    esac
    case "$inherited_bootstrap_fd" in
        9) exec 9>&- ;;
        8) exec 8>&- ;;
        7) exec 7>&- ;;
        6) exec 6>&- ;;
        5) exec 5>&- ;;
        *) return 1 ;;
    esac
    rm -f "$fifo_path" || return 1
    if ! (umask 077; set -o noclobber; \
            printf '%s\t%s\tactive\n' "$token" "$$" > "$sidecar_path") \
            2>/dev/null; then
        return 1
    fi
    RETROSPECTIVE_JANITOR_SNAPSHOT="$snapshot_path"
    RETROSPECTIVE_JANITOR_SIDECAR="$sidecar_path"
    RETROSPECTIVE_JANITOR_TOKEN="$token"
    trap cleanup_owned_retrospective_snapshot EXIT
    trap 'exit 0' HUP INT TERM
    while IFS= read -r heartbeat; do
        [ "$heartbeat" = "$token" ] || return 1
    done
}

retrospective_snapshot_lease_active() {
    local snapshot_root="$1" lease_fd="$2" token janitor_pid state
    local previous_pipe_trap write_status=1
    is_private_code_snapshot_path "$snapshot_root" || return 1
    analysis_snapshot_sidecar_matches "$snapshot_root" \
        "$snapshot_root.janitor" "" active || return 1
    IFS=$'\t' read -r token janitor_pid state \
        < "$snapshot_root.janitor" || return 1
    previous_pipe_trap="$(trap -p PIPE)"
    trap '' PIPE
    case "$lease_fd" in
        9) printf '%s\n' "$token" >&9 2>/dev/null; write_status=$? ;;
        8) printf '%s\n' "$token" >&8 2>/dev/null; write_status=$? ;;
        7) printf '%s\n' "$token" >&7 2>/dev/null; write_status=$? ;;
        6) printf '%s\n' "$token" >&6 2>/dev/null; write_status=$? ;;
        5) printf '%s\n' "$token" >&5 2>/dev/null; write_status=$? ;;
        *) write_status=1 ;;
    esac
    trap - PIPE
    [ -z "$previous_pipe_trap" ] || eval "$previous_pipe_trap"
    [ "$write_status" -eq 0 ]
}

materialize_analysis_snapshot() {
    local report_dir="$1"
    local context_file="$report_dir/analysis-context.json"
    local embedded_context_fingerprint current_context_fingerprint
    local expected_workspace_fingerprint current_workspace_fingerprint
    local captured_pr_head snapshot_path result snapshot_source
    local snapshot_ttl_seconds
    snapshot_ttl_seconds="$(positive_integer_or_default \
        "${GH_PR_ENRICH_SNAPSHOT_TTL_SECONDS:-3600}" 3600 86400)"
    if [ ! -f "$context_file" ] || [ -L "$context_file" ] || \
       path_is_git_tracked "$context_file"; then
        echo "Error: A safe analysis-context.json is required to materialize a snapshot." >&2
        return 1
    fi
    embedded_context_fingerprint="$(jq -r '.coverage.context_fingerprint // ""' \
        "$context_file" 2>/dev/null || echo "")"
    current_context_fingerprint="$(analysis_context_fingerprint \
        "$context_file" 2>/dev/null || echo "")"
    if [ -z "$current_context_fingerprint" ] || \
       [ "$embedded_context_fingerprint" != "$current_context_fingerprint" ]; then
        echo "Error: Analysis context fingerprint is missing or invalid." >&2
        return 1
    fi
    validate_code_access_grant "$context_file" "$report_dir" || return 1
    expected_workspace_fingerprint="$(jq -r \
        '.coverage.code_access.workspace_fingerprint // ""' "$context_file")"
    snapshot_source="$(jq -r \
        '.coverage.code_access.snapshot_source // "git_index"' "$context_file")"
    captured_pr_head="$(jq -r '.coverage.code_access.pr_head_sha // ""' \
        "$context_file")"
    if [ -z "$captured_pr_head" ] || \
       ! create_code_access_snapshot "$report_dir" "$expected_workspace_fingerprint" \
            "$snapshot_source"; then
        echo "Error: Could not materialize a verified immutable analysis snapshot." >&2
        return 1
    fi
    current_workspace_fingerprint="$(code_access_workspace_fingerprint \
        "$report_dir" "" "$snapshot_source" 2>/dev/null || echo "")"
    if [ "$current_workspace_fingerprint" != "$expected_workspace_fingerprint" ]; then
        cleanup_code_access_snapshot
        echo "Error: Local workspace changed while the analysis snapshot was materialized." >&2
        return 1
    fi
    snapshot_path="$CODE_ACCESS_SNAPSHOT_DIR"
    if ! start_analysis_snapshot_janitor "$snapshot_path" \
            "$snapshot_ttl_seconds"; then
        cleanup_code_access_snapshot
        echo "Error: Could not start the bounded analysis-snapshot lease." >&2
        return 1
    fi
    result="$(jq -n \
        --arg path "$snapshot_path" \
        --arg workspace_fingerprint "$expected_workspace_fingerprint" \
        --arg context_fingerprint "$current_context_fingerprint" \
        --arg pr_head_sha "$captured_pr_head" \
        --argjson expires_in_seconds "$snapshot_ttl_seconds" \
        '{path:$path, workspace_fingerprint:$workspace_fingerprint,
          context_fingerprint:$context_fingerprint, pr_head_sha:$pr_head_sha,
          expires_in_seconds:$expires_in_seconds}')" || {
        cleanup_code_access_snapshot
        return 1
    }

    # The native orchestrator owns this lease after the command returns and
    # must call cleanup-analysis-snapshot when every subagent is done.
    CODE_ACCESS_SNAPSHOT_DIR=""
    restore_code_access_cleanup_traps
    printf '%s\n' "$result"
}

cleanup_materialized_analysis_snapshot() {
    local snapshot_path="$1"
    if ! is_private_code_snapshot_path "$snapshot_path"; then
        echo "Error: Refusing to remove an invalid analysis snapshot path." >&2
        return 1
    fi
    stop_analysis_snapshot_janitor "$snapshot_path"
    chmod -R u+w "$snapshot_path" 2>/dev/null || true
    rm -rf "$snapshot_path"
}

cleanup_read_only_analysis_snapshot() {
    local selected_file="$1" report_copy snapshot_path
    report_copy="$(dirname "$selected_file")"
    snapshot_path="$(dirname "$report_copy")"
    cleanup_materialized_analysis_snapshot "$snapshot_path"
}

validate_analysis_thread_ids() {
    local context_file="$1"
    local analysis_file="$2"
    [ -f "$context_file" ] && [ -f "$analysis_file" ] || return 1
    jq -e --slurpfile analysis "$analysis_file" '
        [(.unresolved_threads // [])[] | .thread_id
            | select(type == "string" and test("^PRRT_[A-Za-z0-9_-]+$"))] as $allowed
        | [(.issue_comments // [])[]?.url,
           (.review_comments // [])[]?.url,
           (.inline_comments // [])[]?.url
           | select(type == "string" and length > 0)] as $comment_urls
        | ($analysis[0]) as $a
        | def known_thread:
            type == "string" and test("^PRRT_[A-Za-z0-9_-]+$") and
            (. as $id | $allowed | index($id) != null);
          def known_comment_reference:
            type == "string" and length > 0 and
            ((known_thread) or
             (. as $url | $comment_urls | index($url) != null));
          all($a.task_list[]?.thread_ids[]?; known_thread) and
          all($a.issue_categories[]?.thread_ids[]?; known_thread) and
          all($a.disputed_comments[]?.thread_id; known_comment_reference)
    ' "$context_file" > /dev/null 2>&1
}

# Tasks are actionable only when every one maps to an exact confirmed finding
# in the same immutable result. Mutation-bearing thread IDs must be inherited
# from those findings rather than introduced independently by a task.
validate_analysis_task_links() {
    local analysis_file="$1"
    [ -f "$analysis_file" ] || return 1
    jq -e '
        if ((.issue_categories | type) != "array" or
            (.task_list | type) != "array") then false
        else
          . as $analysis
          | ([.issue_categories[].finding_id]) as $finding_ids
          | ([.task_list[]?.thread_ids[]?]) as $task_thread_ids
          | (all(.issue_categories[];
                (.finding_id | type == "string" and length > 0) and
                (.verdict | IN("confirmed", "plausible", "refuted")) and
                (.thread_ids | type == "array") and
                all(.thread_ids[]; type == "string"))) and
             (($finding_ids | unique | length) == ($finding_ids | length)) and
             (($task_thread_ids | unique | length) == ($task_thread_ids | length)) and
             all(.task_list[]; . as $task |
                if ((.finding_ids | type) != "array" or
                    (.thread_ids | type) != "array") then false
                else
                  [$analysis.issue_categories[] |
                    select(.finding_id as $finding_id |
                      $task.finding_ids | index($finding_id) != null)] as $mapped
                  | ([$mapped[] | .thread_ids[]] | unique) as $confirmed_threads
                  | (.finding_ids | length > 0) and
                    ((.finding_ids | unique | length) == (.finding_ids | length)) and
                    all(.finding_ids[]; type == "string" and length > 0) and
                    all(.thread_ids[]; type == "string") and
                    (($mapped | map(.finding_id) | unique) ==
                      (.finding_ids | unique)) and
                    all($mapped[]; .verdict == "confirmed") and
                    all(.thread_ids[]; . as $thread_id |
                      $confirmed_threads | index($thread_id) != null)
                end)
        end
    ' "$analysis_file" > /dev/null 2>&1
}

validate_selected_provenance() {
    local report_dir="$1"
    local analysis_file="$2"
    local context_file="${3:-$report_dir/analysis-context.json}"
    local context_fingerprint embedded_fingerprint
    local context_repository context_pr context_head
    local analysis_repository analysis_pr analysis_head analysis_fingerprint
    local expected_workspace_fingerprint analysis_workspace_fingerprint
    if [ ! -f "$analysis_file" ] || [ ! -f "$context_file" ] || \
       [ -L "$analysis_file" ] || [ -L "$context_file" ] || \
       path_is_git_tracked "$analysis_file" || path_is_git_tracked "$context_file" || \
       ! jq -e 'type == "object" and (._metadata | type == "object")' \
            "$analysis_file" > /dev/null 2>&1 || \
       ! jq -e 'type == "object" and (.pr | type == "object") and
            (.coverage | type == "object")' "$context_file" > /dev/null 2>&1; then
        return 1
    fi
    context_fingerprint="$(analysis_context_fingerprint "$context_file" 2>/dev/null || echo "")"
    embedded_fingerprint="$(jq -r '.coverage.context_fingerprint // ""' "$context_file")"
    context_repository="$(jq -r '.pr.repository // ""' "$context_file")"
    context_pr="$(jq -r '.pr.number // ""' "$context_file")"
    context_head="$(jq -r '.coverage.code_access.pr_head_sha // ""' "$context_file")"
    analysis_repository="$(jq -r '._metadata.repository // ""' "$analysis_file")"
    analysis_pr="$(jq -r '._metadata.pr_number // ""' "$analysis_file")"
    analysis_head="$(jq -r '._metadata.pr_head_sha // ""' "$analysis_file")"
    analysis_fingerprint="$(jq -r '._metadata.context_fingerprint // ""' "$analysis_file")"
    expected_workspace_fingerprint="$(jq -r \
        '.coverage.code_access.workspace_fingerprint // ""' "$context_file")"
    analysis_workspace_fingerprint="$(jq -r \
        '._metadata.workspace_fingerprint // ""' "$analysis_file")"
    if [ -z "$context_fingerprint" ] || [ "$embedded_fingerprint" != "$context_fingerprint" ] || \
       [ -z "$context_repository" ] || [ -z "$context_pr" ] || [ -z "$context_head" ] || \
       [ "$analysis_repository" != "$context_repository" ] || \
       [ "$analysis_pr" != "$context_pr" ] || [ "$analysis_head" != "$context_head" ] || \
       [ "$analysis_fingerprint" != "$context_fingerprint" ]; then
        return 1
    fi
    if { [ "$(jq -r '.coverage.code_access.state // "disabled"' \
                    "$context_file" 2>/dev/null || echo disabled)" = "enabled" ] || \
         jq -e 'any((.issue_categories // [])[]; .verdict == "confirmed")' \
            "$analysis_file" > /dev/null 2>&1; } && \
       { [ -z "$expected_workspace_fingerprint" ] || \
         [ "$analysis_workspace_fingerprint" != "$expected_workspace_fingerprint" ]; }; then
        return 1
    fi
    validate_analysis_thread_ids "$context_file" "$analysis_file" &&
        validate_analysis_task_links "$analysis_file"
}

validate_selected_workspace() {
    local report_dir="$1"
    local analysis_file="$2"
    local context_file="${3:-$report_dir/analysis-context.json}"
    local ignored_transaction_dir="${4:-}"
    validate_selected_provenance "$report_dir" "$analysis_file" "$context_file" || return 1
    if [ "$(jq -r '.coverage.code_access.state // "disabled"' \
            "$context_file" 2>/dev/null || echo disabled)" = "enabled" ] || \
       jq -e 'any((.issue_categories // [])[]; .verdict == "confirmed")' \
            "$analysis_file" > /dev/null 2>&1; then
        validate_code_access_grant "$context_file" "$report_dir" \
            "$ignored_transaction_dir"
    fi
}

validate_address_selection_pair() {
    local report_dir="$1"
    local frozen_analysis_file="$2"
    local live_analysis_file="$3"
    local frozen_context_file="$4"
    local live_context_file="$5"
    validate_selected_provenance "$report_dir" "$frozen_analysis_file" \
        "$frozen_context_file" || return 1
    validate_selected_provenance "$report_dir" "$live_analysis_file" \
        "$live_context_file"
}

# Prefer the provider-neutral selected analysis while retaining compatibility
# with reports generated before v2.1.
select_analysis_file() (
    local report_dir="$1"
    local selection_mode="${2:-read-only}"
    local managed_read_snapshot_root="${3:-}"
    local expected_head="" expected_fingerprint="" expected_repository=""
    local expected_pr_number="" has_current_context=false
    local selected_path="" reader_lock_dir="" reader_lock_token=""
    local reader_lock_owned=false
    local analysis_identity="" claude_identity="" context_identity=""
    local summary_identity=""
    local selection_root="$report_dir" read_snapshot_dir=""
    local read_snapshot_report="" read_snapshot_handed_off=false
    local snapshot_ttl_seconds=""
    stable_read_identity() {
        local path="$1" digest="" mode=""
        if [ -L "$path" ] || path_has_symlink_component "$path" || \
           { [ -e "$path" ] && [ ! -f "$path" ]; }; then
            return 1
        fi
        if [ ! -f "$path" ]; then
            printf '%s\n' absent
            return 0
        fi
        digest="$(sha256_file "$path" 2>/dev/null || echo "")"
        mode="$(workspace_file_mode "$path" 2>/dev/null || echo "")"
        [ -n "$digest" ] && [ -n "$mode" ] || return 1
        printf '%s:%s\n' "$mode" "$digest"
    }
    cleanup_analysis_reader_lock() {
        if [ -n "$read_snapshot_dir" ] && \
           [ "$read_snapshot_handed_off" != true ]; then
            rm -rf "$read_snapshot_dir" 2>/dev/null || true
        fi
        if [ "$reader_lock_owned" = true ]; then
            if ! release_selected_analysis_lock \
                    "$reader_lock_dir" "$reader_lock_token"; then
                echo "Error: Selected-analysis reader lock remains after validation." >&2
            fi
        fi
    }
    trap cleanup_analysis_reader_lock EXIT
    case "$selection_mode" in
        read-only|require-current-workspace) ;;
        *) return 1 ;;
    esac
    if [ "$selection_mode" = "require-current-workspace" ]; then
        acquire_selected_analysis_lock "$report_dir" || return 1
        reader_lock_dir="$SELECTED_ANALYSIS_LOCK_DIR"
        reader_lock_token="$SELECTED_ANALYSIS_LOCK_TOKEN"
        reader_lock_owned="$SELECTED_ANALYSIS_LOCK_OWNED"
    else
        # Historical discovery must work in immutable archives. Bind the
        # complete set of paths that can affect selection before validating,
        # then require the same bytes/modes and absence states afterward.
        analysis_identity="$(stable_read_identity \
            "$report_dir/analysis.json")" || return 1
        claude_identity="$(stable_read_identity \
            "$report_dir/claude-analysis.json")" || return 1
        context_identity="$(stable_read_identity \
            "$report_dir/analysis-context.json")" || return 1
        summary_identity="$(stable_read_identity \
            "$report_dir/pr-summary.json")" || return 1
        if [ -n "$managed_read_snapshot_root" ]; then
            is_private_code_snapshot_path "$managed_read_snapshot_root" && \
                analysis_snapshot_sidecar_matches \
                    "$managed_read_snapshot_root" \
                    "$managed_read_snapshot_root.janitor" "" active || return 1
            read_snapshot_dir="$(mktemp -d \
                "$managed_read_snapshot_root/report.XXXXXX")" || return 1
        else
            read_snapshot_dir="$(mktemp -d \
                "/tmp/gh-pr-enrich-analysis-snapshot.XXXXXX")" || return 1
        fi
        read_snapshot_report="$read_snapshot_dir/$(basename "${report_dir%/}")"
        mkdir "$read_snapshot_report" || return 1
        local snapshot_name snapshot_identity
        for snapshot_name in analysis.json claude-analysis.json \
                analysis-context.json pr-summary.json; do
            case "$snapshot_name" in
                analysis.json) snapshot_identity="$analysis_identity" ;;
                claude-analysis.json) snapshot_identity="$claude_identity" ;;
                analysis-context.json) snapshot_identity="$context_identity" ;;
                pr-summary.json) snapshot_identity="$summary_identity" ;;
            esac
            [ "$snapshot_identity" != absent ] || continue
            cp -p "$report_dir/$snapshot_name" \
                "$read_snapshot_report/$snapshot_name" || return 1
            [ "$(stable_read_identity \
                "$read_snapshot_report/$snapshot_name")" = \
              "$snapshot_identity" ] || return 1
        done
        selection_root="$read_snapshot_report"
    fi
    if [ -f "$selection_root/analysis-context.json" ]; then
        local embedded_fingerprint
        has_current_context=true
        expected_head="$(jq -r '.coverage.code_access.pr_head_sha // ""' \
            "$selection_root/analysis-context.json" 2>/dev/null || echo "")"
        expected_repository="$(jq -r '.pr.repository // ""' \
            "$selection_root/analysis-context.json" 2>/dev/null || echo "")"
        expected_pr_number="$(jq -r '.pr.number // ""' \
            "$selection_root/analysis-context.json" 2>/dev/null || echo "")"
        embedded_fingerprint="$(jq -r '.coverage.context_fingerprint // ""' \
            "$selection_root/analysis-context.json" 2>/dev/null || echo "")"
        expected_fingerprint="$(analysis_context_fingerprint \
            "$selection_root/analysis-context.json" 2>/dev/null || echo "")"
        if [ -z "$embedded_fingerprint" ] || \
           [ "$embedded_fingerprint" != "$expected_fingerprint" ]; then
            return 1
        fi
        if [ -f "$selection_root/pr-summary.json" ]; then
            local summary_head
            summary_head="$(jq -r '.headRefOid // ""' \
                "$selection_root/pr-summary.json" 2>/dev/null || echo "")"
            if [ -n "$summary_head" ] && [ "$summary_head" != "$expected_head" ]; then
                return 1
            fi
        fi
    elif [ -f "$selection_root/pr-summary.json" ]; then
        expected_head="$(jq -r '.headRefOid // ""' \
            "$selection_root/pr-summary.json" 2>/dev/null || echo "")"
    fi

    if [ -f "$selection_root/analysis.json" ]; then
        local selected_has_metadata
        selected_has_metadata="$(jq -r 'type == "object" and has("_metadata")' \
            "$selection_root/analysis.json" 2>/dev/null || echo false)"
        # Provider-neutral analysis.json exists only in the v2.1 selection
        # workflow. Context-free compatibility applies solely to the old
        # claude-analysis.json name below; otherwise a reviewed branch could
        # plant a metadata-less selected result for address/retrospective.
        [ "$selected_has_metadata" = true ] || return 1
        [ "$has_current_context" = true ] || return 1
        [ -n "$expected_head" ] && [ -n "$expected_fingerprint" ] && \
            [ -n "$expected_repository" ] && [ -n "$expected_pr_number" ] || return 1
        if [ -L "$report_dir/analysis.json" ] || \
           [ -L "$report_dir/analysis-context.json" ] || \
           path_is_git_tracked "$report_dir/analysis.json" || \
           path_is_git_tracked "$report_dir/analysis-context.json"; then
            return 1
        fi
        if [ "$selection_mode" = "require-current-workspace" ]; then
            if ! validate_selected_workspace "$report_dir" "$report_dir/analysis.json"; then
                invalidate_selected_analysis "$report_dir" || true
                return 1
            fi
        elif ! validate_selected_provenance "$report_dir" \
                "$selection_root/analysis.json" \
                "$selection_root/analysis-context.json"; then
            return 1
        fi
        selected_path="$selection_root/analysis.json"
    elif [ -f "$selection_root/claude-analysis.json" ]; then
        # Old Claude-only reports had no provider-neutral provenance metadata.
        # Read-only retrospective discovery may still inspect them, but strict
        # mutation consumers cannot prove their workspace or PR identity.
        [ "$selection_mode" = "read-only" ] || return 1
        # A current source file can exist even when selection rejected it (for
        # example, incomplete category coverage or failed source fetches). Never
        # let a downstream consumer bypass that rejection by treating the source
        # artifact as a legacy selected result.
        if [ "$has_current_context" = true ] || \
           [ -L "$report_dir/claude-analysis.json" ] || \
           path_is_git_tracked "$report_dir/claude-analysis.json" || \
           ! jq -e 'type == "object" and (has("_metadata") | not)' \
                "$selection_root/claude-analysis.json" > /dev/null 2>&1; then
            return 1
        fi
        selected_path="$selection_root/claude-analysis.json"
    else
        return 1
    fi
    if [ "$selection_mode" = "read-only" ]; then
        [ "$(stable_read_identity "$report_dir/analysis.json")" = \
          "$analysis_identity" ] && \
        [ "$(stable_read_identity "$report_dir/claude-analysis.json")" = \
          "$claude_identity" ] && \
        [ "$(stable_read_identity "$report_dir/analysis-context.json")" = \
          "$context_identity" ] && \
        [ "$(stable_read_identity "$report_dir/pr-summary.json")" = \
          "$summary_identity" ] || return 1
        if [ -n "$managed_read_snapshot_root" ]; then
            analysis_snapshot_sidecar_matches \
                "$managed_read_snapshot_root" \
                "$managed_read_snapshot_root.janitor" "" active || return 1
        else
            snapshot_ttl_seconds="$(positive_integer_or_default \
                "${GH_PR_ENRICH_SNAPSHOT_TTL_SECONDS:-3600}" 3600 86400)"
            start_analysis_snapshot_janitor "$read_snapshot_dir" \
                "$snapshot_ttl_seconds" || return 1
        fi
        read_snapshot_handed_off=true
    fi
    if [ "$reader_lock_owned" = true ]; then
        release_selected_analysis_lock \
            "$reader_lock_dir" "$reader_lock_token" || return 1
        reader_lock_owned=false
    fi
    printf '%s\n' "$selected_path"
)

# Invoke the Claude CLI for a structured-output analysis.
#
# Shared by the PR analysis and the retrospective meta-analysis. Both need the
# same handling for nested invocation, plugin bypass, timeouts, stderr capture
# and progress reporting; keeping one implementation means a fix to any of that
# reaches both.
#
# Usage: invoke_claude LABEL TIMEOUT OUT_FILE SYSTEM_PROMPT SCHEMA USER_PROMPT [TOOL...]
ANALYZER_WORKING_DIRECTORY=""
ANALYZER_SETTINGS_FILE=""
invoke_claude() {
    local label="$1"
    local timeout_secs="$2"
    local output_file="$3"
    local system_prompt="$4"
    local schema="$5"
    local user_prompt="$6"
    shift 6
    local -a tools=("$@")
    ANALYZER_CHILD_STARTING=false
    ANALYZER_HEARTBEAT_STARTING=false
    ANALYZER_PENDING_SIGNAL=""

    local model="${GH_PR_ENRICH_MODEL:-sonnet}"
    local stderr_log
    stderr_log="$(dirname "$output_file")/claude-stderr.log"

    local -a tool_args=(--tools "")
    if [ "${#tools[@]}" -gt 0 ]; then
        local -a available_tools=()
        local tool_rule
        for tool_rule in "${tools[@]}"; do
            case "$tool_rule" in
                Read\(*\)) available_tools+=("Read") ;;
                *) available_tools+=("$tool_rule") ;;
            esac
        done
        tool_args=(--tools "${available_tools[@]}" \
            --allowedTools "${tools[@]}")
    fi
    local -a settings_args=()
    if [ -n "$ANALYZER_SETTINGS_FILE" ]; then
        settings_args=(--settings "$ANALYZER_SETTINGS_FILE")
    fi
    [[ "$timeout_secs" =~ ^[1-9][0-9]*$ ]] || {
        echo "Error: Analyzer timeout must be a positive integer." >&2
        return 1
    }
    ANALYZER_PROMPT_FILE="$(mktemp "/tmp/gh-pr-enrich-claude-prompt.XXXXXX")" || \
        return 1
    install_code_access_cleanup_traps
    if ! chmod 600 "$ANALYZER_PROMPT_FILE" || \
       ! printf '%s\n' "$user_prompt" > "$ANALYZER_PROMPT_FILE"; then
        cleanup_code_access_artifacts
        return 1
    fi

    # Elapsed time is the only progress signal available: --output-format json
    # writes nothing until the run completes. The heartbeat is the background job
    # and the analyzer runs in the foreground, because backgrounding the analyzer
    # makes the shell print its own job-death notice on an external kill.
    local heartbeat_interval
    heartbeat_interval="$(positive_integer_or_default \
        "${GH_PR_ENRICH_HEARTBEAT_SECONDS:-}" 60 86400)"
    local start_ts=$SECONDS
    ANALYZER_HEARTBEAT_STARTING=true
    (
        # The sleep runs as a killable child: terminating only the subshell would
        # orphan a sleeping process that still holds this function's stderr open,
        # which stalls any caller reading the output through a pipe.
        sleep_pid=""
        sleep_starting=false
        heartbeat_signal=""
        stop_heartbeat_sleep() {
            [ -n "$heartbeat_signal" ] || heartbeat_signal="$1"
            [ "$sleep_starting" != true ] || return 0
            if [ -n "$heartbeat_sleep_pid" ]; then
                kill "$heartbeat_sleep_pid" 2>/dev/null || true
                wait "$heartbeat_sleep_pid" 2>/dev/null || true
                heartbeat_sleep_pid=""
            fi
            exit 0
        }
        # Guard the empty case explicitly: `kill 0` signals the entire process
        # group, which would take the parent script and the analyzer with it.
        trap 'stop_heartbeat_sleep TERM' TERM
        trap 'stop_heartbeat_sleep INT' INT
        waited=0
        while true; do
            sleep_starting=true
            sleep "$heartbeat_interval" &
            heartbeat_sleep_pid=$!
            sleep_starting=false
            [ -z "$heartbeat_signal" ] || \
                stop_heartbeat_sleep "$heartbeat_signal"
            if ! wait "$heartbeat_sleep_pid" 2>/dev/null; then
                heartbeat_sleep_pid=""
                exit 0
            fi
            heartbeat_sleep_pid=""
            waited=$((waited + heartbeat_interval))
            echo "   ⏳ still running ${label} — ${waited}s elapsed of ${timeout_secs}s" >&2
        done
    ) &
    ANALYZER_HEARTBEAT_PID=$!
    ANALYZER_HEARTBEAT_STARTING=false
    if [ -n "$ANALYZER_PENDING_SIGNAL" ]; then
        handle_code_access_cleanup_signal "$ANALYZER_PENDING_SIGNAL"
    fi
    disown "$ANALYZER_HEARTBEAT_PID" 2>/dev/null || true

    local exit_code=0
    # --safe-mode disables snapshot-owned CLAUDE.md, skills, hooks, plugins,
    # MCP servers, and other repository customizations. Auto memory is disabled
    # separately so untrusted PR content cannot influence or persist into later
    # sessions. --setting-sources "" also bypasses settings-source loading.
    # CLAUDECODE is unset so this can run nested inside a Claude Code session.
    # stderr goes to a log rather than /dev/null: a discarded error message is the
    # difference between a diagnosable failure and a mysterious empty analysis.
    # The subshell's own stderr is dropped so the shell's job-death diagnostic
    # ("Killed: 9" plus the whole command line) never reaches the user.
    ANALYZER_CHILD_STARTING=true
    (
        claude_pid=""
        timeout_watcher_pid=""
        claude_starting=false
        timeout_watcher_starting=false
        analyzer_wrapper_signal=""
        stop_timeout_watcher() {
            [ -n "$timeout_watcher_pid" ] || return 0
            kill -TERM "$timeout_watcher_pid" 2>/dev/null || true
            wait "$timeout_watcher_pid" 2>/dev/null || true
            timeout_watcher_pid=""
        }
        stop_claude_child() {
            [ -n "$claude_pid" ] || return 0
            kill -KILL "$claude_pid" 2>/dev/null || true
            wait "$claude_pid" 2>/dev/null || true
            claude_pid=""
        }
        stop_analyzer_wrapper() {
            local signal_exit="$1"
            [ -n "$analyzer_wrapper_signal" ] || \
                analyzer_wrapper_signal="$signal_exit"
            if [ "$claude_starting" = true ] || \
               [ "$timeout_watcher_starting" = true ]; then
                return 0
            fi
            stop_timeout_watcher
            stop_claude_child
            exit "$analyzer_wrapper_signal"
        }
        trap 'stop_analyzer_wrapper 143' TERM
        trap 'stop_analyzer_wrapper 130' INT

        if [ -n "$ANALYZER_WORKING_DIRECTORY" ]; then
            cd "$ANALYZER_WORKING_DIRECTORY" || exit 1
        fi
        claude_starting=true
        env -u CLAUDECODE -u CLAUDE_CODE_ENTRYPOINT \
            CLAUDE_CODE_DISABLE_AUTO_MEMORY=1 \
            GH_PR_ENRICH_CLEANUP_OWNER_PID="$$" \
            GH_PR_ENRICH_ANALYZER_TIMEOUT_SECONDS="$timeout_secs" \
            claude --print \
            --safe-mode \
            --setting-sources "" \
            "${settings_args[@]+"${settings_args[@]}"}" \
            --permission-mode dontAsk \
            --disallowedTools "mcp__*" \
            --no-session-persistence \
            --model "$model" \
            --output-format json \
            --json-schema "$schema" \
            --system-prompt "$system_prompt" \
            "${tool_args[@]+"${tool_args[@]}"}" \
            < "$ANALYZER_PROMPT_FILE" > "$output_file" 2> "$stderr_log" &
        claude_pid=$!
        claude_starting=false
        [ -z "$analyzer_wrapper_signal" ] || \
            stop_analyzer_wrapper "$analyzer_wrapper_signal"

        timeout_watcher_starting=true
        (
            watcher_sleep_pid=""
            watcher_sleep_starting=false
            timeout_sleep_signal=""
            stop_timeout_sleep() {
                [ -n "$timeout_sleep_signal" ] || timeout_sleep_signal="$1"
                [ "$watcher_sleep_starting" != true ] || return 0
                if [ -n "$watcher_sleep_pid" ]; then
                    kill "$watcher_sleep_pid" 2>/dev/null || true
                    wait "$watcher_sleep_pid" 2>/dev/null || true
                    watcher_sleep_pid=""
                fi
                exit 0
            }
            trap 'stop_timeout_sleep TERM' TERM
            trap 'stop_timeout_sleep INT' INT
            watcher_sleep_starting=true
            sleep "$timeout_secs" &
            watcher_sleep_pid=$!
            watcher_sleep_starting=false
            [ -z "$timeout_sleep_signal" ] || \
                stop_timeout_sleep "$timeout_sleep_signal"
            wait "$watcher_sleep_pid" 2>/dev/null || exit 0
            watcher_sleep_pid=""
            kill -KILL "$claude_pid" 2>/dev/null || true
        ) &
        timeout_watcher_pid=$!
        timeout_watcher_starting=false
        [ -z "$analyzer_wrapper_signal" ] || \
            stop_analyzer_wrapper "$analyzer_wrapper_signal"

        claude_exit=0
        wait "$claude_pid" || claude_exit=$?
        claude_pid=""
        stop_timeout_watcher
        exit "$claude_exit"
    ) 2>/dev/null &
    ANALYZER_CHILD_PID=$!
    ANALYZER_CHILD_STARTING=false
    if [ -n "$ANALYZER_PENDING_SIGNAL" ]; then
        handle_code_access_cleanup_signal "$ANALYZER_PENDING_SIGNAL"
    fi
    if wait "$ANALYZER_CHILD_PID"; then
        ANALYZER_CHILD_PID=""
        terminate_analyzer_heartbeat
        echo "✅ ${label} complete ($((SECONDS - start_ts))s)" >&2
    else
        exit_code=$?
        ANALYZER_CHILD_PID=""
        terminate_analyzer_heartbeat
        # 124 = timeout with SIGTERM, 137 = timeout with SIGKILL (128 + 9)
        if [ "$exit_code" -eq 124 ] || [ "$exit_code" -eq 137 ]; then
            echo "⏱️  ${label} timed out after ${timeout_secs}s (set CLAUDE_TIMEOUT to increase)" >&2
        else
            echo "❌ ${label} failed (exit code: $exit_code)" >&2
        fi
        if [ -s "$stderr_log" ]; then
            echo "   Analyzer stderr (tail): $(tail -3 "$stderr_log" | tr '\n' ' ')" >&2
            echo "   Full log: $stderr_log" >&2
        fi
    fi

    rm -f "$ANALYZER_PROMPT_FILE"
    ANALYZER_PROMPT_FILE=""

    return $exit_code
}

# Re-enter through the function dispatcher after all helpers are defined.
if [ "$1" = "__snapshot-janitor" ]; then
    shift
    [ $# -eq 4 ] || exit 1
    run_analysis_snapshot_janitor "$1" "$2" "$3" "$4"
    exit $?
fi

if [ "$1" = "__retrospective-snapshot-janitor" ]; then
    shift
    [ $# -eq 6 ] || exit 1
    run_retrospective_snapshot_janitor "$1" "$2" "$3" "$4" "$5" "$6"
    exit $?
fi

if [ "$1" = "materialize-analysis-snapshot" ]; then
    shift
    if [ "${1:-}" = "--help" ] || [ $# -ne 1 ]; then
        echo "Usage: gh pr-enrich materialize-analysis-snapshot <REPORT_DIR>"
        echo "Validate the recorded code-access grant and create a private immutable workspace snapshot."
        [ "${1:-}" = "--help" ] && exit 0
        exit 1
    fi
    materialize_analysis_snapshot "$1"
    exit $?
fi

if [ "$1" = "cleanup-analysis-snapshot" ]; then
    shift
    if [ "${1:-}" = "--help" ] || [ $# -ne 1 ]; then
        echo "Usage: gh pr-enrich cleanup-analysis-snapshot <SNAPSHOT_PATH>"
        [ "${1:-}" = "--help" ] && exit 0
        exit 1
    fi
    cleanup_materialized_analysis_snapshot "$1"
    exit $?
fi

run_standalone_analysis_selection() {
    local report_dir="$1" source_file="$2"
    local selection_pid="" selection_rc=0 selection_signal=""
    local selection_group_owned=false selection_wait_attempt=0

    forward_selection_signal() {
        [ -n "$selection_signal" ] || selection_signal="$1"
        [ -n "$selection_pid" ] || return 0
        if [ "$selection_group_owned" = true ]; then
            kill -"$1" -- "-$selection_pid" 2>/dev/null || true
        else
            kill -"$1" "$selection_pid" 2>/dev/null || true
        fi
    }

    trap 'forward_selection_signal INT' INT
    trap 'forward_selection_signal TERM' TERM
    set -m
    "$0" --test-call select_analysis_artifact "$report_dir" "$source_file" &
    selection_pid=$!
    if kill -0 -- "-$selection_pid" 2>/dev/null; then
        selection_group_owned=true
    fi
    set +m
    if [ -n "$selection_signal" ]; then
        forward_selection_signal "$selection_signal"
    fi
    wait "$selection_pid" || selection_rc=$?

    # The dispatcher is the process-group leader, but the selection worker is
    # the lock owner. Wait for that worker to finish its signal-aware cleanup
    # before the public command returns the conventional signal status.
    if [ -n "$selection_signal" ] && [ "$selection_group_owned" = true ]; then
        while [ "$selection_wait_attempt" -lt 200 ]; do
            kill -0 -- "-$selection_pid" 2>/dev/null || break
            sleep 0.05
            selection_wait_attempt=$((selection_wait_attempt + 1))
        done
        if kill -0 -- "-$selection_pid" 2>/dev/null; then
            kill -KILL -- "-$selection_pid" 2>/dev/null || true
        fi
    fi
    trap - INT TERM
    case "$selection_signal" in
        INT) return 130 ;;
        TERM) return 143 ;;
    esac
    return "$selection_rc"
}

if [ "$1" = "select-analysis" ]; then
